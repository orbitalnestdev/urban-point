---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getClientProfile } from '../lib/server/auth';
import { saldoDisponible } from '../lib/server/creditos';
import { formatearCentavos } from '../lib/pricing';

export const prerender = false;

export interface Props {
	title: string;
	activeTab?: 'dashboard' | 'pedidos' | 'perfil' | 'saldo';
}

const { title, activeTab = 'dashboard' } = Astro.props;

const profile = await getClientProfile(Astro);

if (!profile) {
	// getClientProfile devuelve null para todo rol que no compre (cliente y
	// distribuidor), así que acá caen admin, gestión y canillita. Borrar la
	// cookie los deslogueaba: entrar a "Mi cuenta" desde el panel cerraba la
	// sesión.
	const usuario = Astro.locals.user;

	if (usuario) {
		if (usuario.role === 'canillita') return Astro.redirect('/canillita');
		if (usuario.role === 'admin' || usuario.role === 'gestion') return Astro.redirect('/admin');
		return Astro.redirect('/');
	}

	// Sin sesión válida: no hay nada que borrar acá, el middleware ya limpia
	// las cookies inválidas.
	return Astro.redirect('/login');
}

// Devuelve 0 mientras la colección del ledger no exista (ver creditos.ts), así
// que el panel del cliente sigue funcionando antes de correr la migración.
const saldoCentavos = await saldoDisponible(profile.$id);
---

<Layout title={title}>
	<Header />
	
	<div class="bg-slate-50 min-h-screen py-10">
		<div class="max-w-6xl mx-auto px-6">
			<!-- Client Dashboard Header -->
			<div class="bg-[#2D5A27] rounded-3xl p-8 text-white mb-8 shadow-lg flex flex-col md:flex-row items-center justify-between">
				<div>
					<h1 class="text-3xl font-extrabold mb-1">¡Hola, {profile.nombre.split(' ')[0]}!</h1>
					<p class="text-emerald-100/80 text-sm">Gestioná tus pedidos y datos desde acá.</p>
					{saldoCentavos > 0 && (
						<a href="/mi-cuenta/saldo" class="inline-flex items-center gap-2 mt-3 px-3 py-1.5 bg-white/15 hover:bg-white/25 border border-white/20 rounded-xl text-sm font-bold transition-colors">
							<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/></svg>
							Saldo a favor: {formatearCentavos(saldoCentavos)}
						</a>
					)}
				</div>

				<div class="mt-4 md:mt-0 flex gap-3">
					<a href="/productos" class="px-5 py-2.5 bg-white text-[#2D5A27] font-bold text-sm rounded-xl hover:bg-slate-100 transition-colors shadow-sm">
						Nuevo Pedido
					</a>
					<form method="POST" action="/api/logout">
						<button type="submit" class="px-5 py-2.5 bg-[#1E3E1B] text-white font-bold text-sm rounded-xl hover:bg-black/30 transition-colors border border-white/10">
							Cerrar Sesión
						</button>
					</form>
				</div>
			</div>

			<div class="flex flex-col md:flex-row gap-8">
				<!-- Sidebar Navigation -->
				<div class="w-full md:w-64 shrink-0">
					<nav class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden sticky top-24">
						<a href="/mi-cuenta" class={`flex items-center gap-3 px-5 py-4 font-bold text-sm border-l-4 transition-all ${activeTab === 'dashboard' ? 'border-[#2D5A27] text-[#2D5A27] bg-[#F2F7F3]' : 'border-transparent text-slate-600 hover:bg-slate-50'}`}>
							<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
							Resumen
						</a>
						<a href="/mi-cuenta/pedidos" class={`flex items-center gap-3 px-5 py-4 font-bold text-sm border-l-4 border-t border-t-slate-100 transition-all ${activeTab === 'pedidos' ? 'border-l-[#2D5A27] text-[#2D5A27] bg-[#F2F7F3]' : 'border-l-transparent text-slate-600 hover:bg-slate-50'}`}>
							<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
							Mis Pedidos
						</a>
						<a href="/mi-cuenta/saldo" class={`flex items-center gap-3 px-5 py-4 font-bold text-sm border-l-4 border-t border-t-slate-100 transition-all ${activeTab === 'saldo' ? 'border-l-[#2D5A27] text-[#2D5A27] bg-[#F2F7F3]' : 'border-l-transparent text-slate-600 hover:bg-slate-50'}`}>
							<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/></svg>
							Mi Saldo
						</a>
						<a href="/mi-cuenta/perfil" class={`flex items-center gap-3 px-5 py-4 font-bold text-sm border-l-4 border-t border-t-slate-100 transition-all ${activeTab === 'perfil' ? 'border-l-[#2D5A27] text-[#2D5A27] bg-[#F2F7F3]' : 'border-l-transparent text-slate-600 hover:bg-slate-50'}`}>
							<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
							Mi Perfil
						</a>
					</nav>
				</div>
				
				<!-- Main Content -->
				<div class="flex-1">
					<slot />
				</div>
			</div>
		</div>
	</div>

	<Footer />
</Layout>
