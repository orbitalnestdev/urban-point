---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	updatedAt: string;
}

const { title, description, updatedAt } = Astro.props;

const enlacesLegales = [
	{ href: '/terminos-y-condiciones', label: 'Términos y Condiciones' },
	{ href: '/politica-de-privacidad', label: 'Política de Privacidad' },
	{ href: '/politica-de-cookies', label: 'Política de Cookies' },
	{ href: '/cambios-y-devoluciones', label: 'Cambios, Devoluciones y Botón de Arrepentimiento' },
	{ href: '/datos-de-la-empresa', label: 'Datos de la Empresa' }
];
---

<Layout title={`${title} | UrbanPoint`} description={description}>
	<Header />

	<main class="flex-1 bg-white">
		<div class="max-w-5xl mx-auto px-6 py-14 md:py-20">
			<div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
				<!-- Nav lateral de páginas legales -->
				<aside class="lg:col-span-1 order-2 lg:order-1">
					<div class="lg:sticky lg:top-24">
						<h2 class="text-xs font-extrabold text-slate-400 uppercase tracking-wider mb-3">Legales</h2>
						<nav class="flex flex-col gap-1">
							{enlacesLegales.map(link => (
								<a
									href={link.href}
									class={`text-sm font-semibold px-3 py-2 rounded-lg transition-colors ${
										Astro.url.pathname === link.href
											? 'bg-indigo-50 text-indigo-700'
											: 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
									}`}
								>
									{link.label}
								</a>
							))}
						</nav>
					</div>
				</aside>

				<!-- Contenido -->
				<article class="lg:col-span-3 order-1 lg:order-2 max-w-none">
					<h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">{title}</h1>
					<p class="text-xs font-semibold text-slate-400 mb-10">Última actualización: {updatedAt}</p>

					<div class="legal-content space-y-8 text-slate-700 leading-relaxed text-[15px]">
						<slot />
					</div>
				</article>
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style is:global>
	.legal-content h2 {
		font-size: 1.25rem;
		font-weight: 800;
		color: #0f172a;
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		scroll-margin-top: 6rem;
	}
	.legal-content h3 {
		font-size: 1.05rem;
		font-weight: 700;
		color: #1e293b;
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.legal-content p {
		margin-bottom: 0.75rem;
	}
	.legal-content ul,
	.legal-content ol {
		margin: 0.75rem 0 1rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.legal-content ul {
		list-style: disc;
	}
	.legal-content ol {
		list-style: decimal;
	}
	.legal-content a {
		color: #4f46e5;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.legal-content strong {
		color: #0f172a;
		font-weight: 700;
	}
	.legal-content .callout {
		background: #eef2ff;
		border: 1px solid #c7d2fe;
		border-radius: 0.75rem;
		padding: 1rem 1.25rem;
		font-size: 0.9rem;
	}
	.legal-content .pendiente {
		background: #fffbeb;
		border: 1px solid #fde68a;
		color: #92400e;
		border-radius: 0.5rem;
		padding: 0.15rem 0.5rem;
		font-weight: 700;
		font-size: 0.85em;
	}
</style>
