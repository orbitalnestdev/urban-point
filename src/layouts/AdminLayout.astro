---
import '../styles/global.css';
import '../styles/design-system.css';
import Logo from '../components/Logo.astro';
import DevUserSwitcher from '../components/DevUserSwitcher.astro';
import ImpersonationBanner from '../components/ImpersonationBanner.astro';

interface Props {
	title: string;
	adminName?: string;
}

const { title, adminName = Astro.locals?.user?.name ?? 'Admin' } = Astro.props;

// Obtener los datos del usuario inyectados por el middleware
const userRole = Astro.locals?.user?.role || 'admin';
const isAdmin = userRole === 'admin';
const displayAdminName = adminName ?? Astro.locals?.user?.name ?? 'Admin';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Panel de Administración UrbanPoint" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/jpeg" href="/images/favicon.jpg" />
		<title>{title} | Admin UrbanPoint</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col">
		<ImpersonationBanner />
		
		<div class="flex flex-1 min-h-0">
		{/* Backdrop del drawer mobile: clickearlo cierra la navegación. */}
		<div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-slate-900/60 backdrop-blur-xs hidden md:hidden"></div>

		{/* Sidebar (en mobile funciona como drawer superpuesto; ver .drawer-open) */}
		<aside id="admin-sidebar" class="w-64 bg-slate-900 text-white flex flex-col hidden md:flex sticky top-0 h-screen overflow-y-auto">
			<div class="p-6">
				<Logo variant="dark" height={34} />
				<p class="text-xs font-medium text-slate-400 mt-2 uppercase tracking-widest">Panel de Control</p>
			</div>
			
			<nav class="flex-1 px-3 space-y-1 mt-4">
				<a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
					Dashboard
				</a>
				
				<a href="/admin/analisis" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
					Análisis
				</a>
				
				<a href="/admin/reportes" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path></svg>
					Reportes
				</a>
				
				<div class="pt-4 pb-1">
					<p class="text-xs font-bold text-slate-500 uppercase px-3">Gestión</p>
				</div>
				
				<a href="/admin/catalogo" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
					Productos
				</a>

				<a href="/admin/categorias" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
					Categorías
				</a>
				
				<a href="/admin/pedidos" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
					Pedidos
				</a>

				<a href="/admin/clientes" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
					Clientes
				</a>
				
				<div class="pt-4 pb-1">
					<p class="text-xs font-bold text-slate-500 uppercase px-3">Red de Retiro</p>
				</div>
				<a href="/admin/canillitas" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
					Canillitas
				</a>
				<a href="/admin/canillitas/solicitudes" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
					Solicitudes
				</a>
				<a href="/admin/liquidaciones" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
					Liquidaciones
				</a>

				{isAdmin && (
					<>
						<div class="pt-4 pb-1">
							<p class="text-xs font-bold text-slate-500 uppercase px-3">Ajustes</p>
						</div>
						<a href="/admin/equipo" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
							Equipo de Trabajo
						</a>
						<a href="/admin/configuracion" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm whitespace-nowrap text-slate-300 hover:text-white hover:bg-slate-800 transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
							Configuración
						</a>
					</>
				)}

				<div class="pt-4 pb-1">
					<p class="text-xs font-bold text-slate-500 uppercase px-3">Soporte</p>
				</div>
				<a href="/admin/ayuda" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm whitespace-nowrap bg-emerald-950/60 text-emerald-300 hover:text-white hover:bg-emerald-900 border border-emerald-800/60 transition-all font-bold shadow-sm">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
					Centro de Ayuda 💡
				</a>
			</nav>
			
			<div class="p-4 mt-auto">
				<div class="bg-slate-800 rounded-xl p-4 flex items-center gap-3">
					<div class="w-10 h-10 rounded-full bg-[#2D5A27] flex items-center justify-center text-white font-bold">
						{(displayAdminName || 'Admin').substring(0,1).toUpperCase()}
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-sm font-bold text-white truncate">{displayAdminName || 'Admin'}</p>
						<p class="text-xs text-slate-400 font-medium capitalize">{userRole === 'admin' ? 'Administrador' : 'Gestión de Tienda'}</p>
					</div>
				</div>
			</div>
		</aside>
		
		<!-- Main Content -->
		<div class="flex-1 flex flex-col min-w-0">
			<!-- Topbar (Mobile o actions) -->
			<header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-6 sticky top-0 z-20">
				<div class="md:hidden flex items-center gap-4">
					<button id="btn-mobile-menu" aria-label="Abrir menú de navegación" aria-expanded="false" class="text-slate-500 hover:text-slate-700">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
					</button>
					<Logo variant="light" height={26} />
				</div>
				<div class="hidden md:block"></div>
				
				<div class="flex items-center gap-3">
					<!-- Botón Centro de Ayuda en Topbar -->
					<a href="/admin/ayuda" class="px-3 py-1.5 bg-emerald-50 border border-emerald-200 text-emerald-800 hover:bg-emerald-100 font-bold text-xs rounded-xl flex items-center gap-1.5 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
						<span>Centro de Ayuda 💡</span>
					</a>

					<!-- Botón de Monitoreo / Cambiar Usuario -->
					<div class="relative group">
						<button type="button" class="px-3 py-1.5 bg-amber-50 border border-amber-200 text-amber-800 hover:bg-amber-100 font-bold text-xs rounded-xl flex items-center gap-1.5 transition-colors cursor-pointer">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
							<span>Monitorear / Cambiar Usuario</span>
						</button>
						<div class="absolute right-0 top-full mt-1.5 w-60 bg-white border border-slate-200 rounded-2xl shadow-xl p-2 hidden group-hover:block z-50 animate-in fade-in duration-150">
							<p class="px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Monitorear perfil sintético</p>
							<a href="/api/admin/impersonate?role=canillita" class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-100 transition-colors">
								<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
								Entrar como Canillita
							</a>
							<a href="/api/admin/impersonate?role=cliente" class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-100 transition-colors">
								<span class="w-2 h-2 rounded-full bg-blue-500"></span>
								Entrar como Cliente
							</a>
							<hr class="my-1 border-slate-100" />
							<p class="px-3 py-1.5 text-[10px] text-slate-500 font-normal">También podés hacer clic en "👁️ Ver como este usuario" en las secciones Canillitas, Clientes o Equipo.</p>
						</div>
					</div>

					<form action="/api/logout" method="POST" id="logoutForm">
						<button type="submit" class="text-sm font-semibold text-slate-500 hover:text-red-500 flex items-center gap-2 transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
							Salir
						</button>
					</form>
				</div>
			</header>
			
			<div class="p-6 md:p-8 flex-1">
				<slot />
			</div>
		</div>
		</div>

		<DevUserSwitcher />

		<!--
			Drawer mobile: el botón hamburguesa convierte el sidebar en un overlay
			fijo; el backdrop (o el mismo botón) lo cierran.
		-->
		<style is:global>
			@media (max-width: 767px) {
				#admin-sidebar.drawer-open {
					display: flex !important;
					position: fixed !important;
					top: 0;
					left: 0;
					bottom: 0;
					z-index: 50;
					height: 100dvh;
					box-shadow: 0 0 40px rgba(15, 23, 42, 0.45);
				}
			}
		</style>

		<script is:inline>
			(function () {
				var btn = document.getElementById('btn-mobile-menu');
				var sidebar = document.getElementById('admin-sidebar');
				var backdrop = document.getElementById('sidebar-backdrop');
				if (!btn || !sidebar || !backdrop) return;

				function abrir() {
					sidebar.classList.add('drawer-open');
					backdrop.classList.remove('hidden');
					btn.setAttribute('aria-expanded', 'true');
				}
				function cerrar() {
					sidebar.classList.remove('drawer-open');
					backdrop.classList.add('hidden');
					btn.setAttribute('aria-expanded', 'false');
				}

				btn.addEventListener('click', function () {
					if (sidebar.classList.contains('drawer-open')) cerrar();
					else abrir();
				});
				backdrop.addEventListener('click', cerrar);
				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape') cerrar();
				});
			})();
		</script>
	</body>
</html>
