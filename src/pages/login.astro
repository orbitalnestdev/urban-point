---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Logo from '../components/Logo.astro';
import { Client, Account, Query, ID } from 'node-appwrite';
import { createAdminClient } from '../lib/server/appwrite';

import { parseActiveNodeCookie } from '../lib/nodeSession';

const DEFAULT_ENDPOINT = 'https://aw.orbitalnest.net/v1';
const DEFAULT_PROJECT_ID = '6a6a5321001439f06817';

export const prerender = false;

let loginError = '';
let loginSuccess = false;

const activeNodeSession = parseActiveNodeCookie(Astro.request.headers.get('cookie'));
const redirectParam = Astro.url.searchParams.get('redirect') || '';

if (Astro.request.method === 'GET') {
	const sessionCookie = Astro.cookies.get('up_session')?.value;
	if (sessionCookie) {
		const endpoint = process.env.PUBLIC_APPWRITE_ENDPOINT || process.env.NEXT_PUBLIC_APPWRITE_ENDPOINT || DEFAULT_ENDPOINT;
		const projectId = process.env.PUBLIC_APPWRITE_PROJECT_ID || process.env.NEXT_PUBLIC_APPWRITE_PROJECT_ID || DEFAULT_PROJECT_ID;
		try {
			const authClient = new Client().setEndpoint(endpoint).setProject(projectId).setSession(sessionCookie);
			const account = new Account(authClient);
			const user = await account.get();
			const { databases } = createAdminClient();
			const profiles = await databases.listDocuments('urbanpoint', 'profiles', [
				Query.equal('user_id', user.$id)
			]);
			const role = profiles.documents.length > 0 ? profiles.documents[0].role : 'cliente';
			if (role === 'admin') return Astro.redirect('/admin');
			if (role === 'canillita') return Astro.redirect('/canillita');
			if (redirectParam) return Astro.redirect(redirectParam);
			if (activeNodeSession && activeNodeSession.slug) return Astro.redirect(`/${activeNodeSession.slug}`);
			return Astro.redirect('/mi-cuenta');
		} catch (e) {
			Astro.cookies.delete('up_session', { path: '/' });
		}
	}
}

if (Astro.request.method === 'POST') {
	try {
		const formData = await Astro.request.formData();
		const actionType = formData.get('actionType')?.toString();
		const email = formData.get('email')?.toString() || '';
		const password = formData.get('password')?.toString() || '';
		const targetRedirect = formData.get('redirectUrl')?.toString() || redirectParam || (activeNodeSession?.slug ? `/${activeNodeSession.slug}` : '');
		
		const endpoint = process.env.PUBLIC_APPWRITE_ENDPOINT || process.env.NEXT_PUBLIC_APPWRITE_ENDPOINT || DEFAULT_ENDPOINT;
		const projectId = process.env.PUBLIC_APPWRITE_PROJECT_ID || process.env.NEXT_PUBLIC_APPWRITE_PROJECT_ID || DEFAULT_PROJECT_ID;

		const authClient = new Client().setEndpoint(endpoint).setProject(projectId);
		const account = new Account(authClient);
		const { users, databases } = createAdminClient();

		if (actionType === 'register') {
			const nombre = formData.get('nombre')?.toString() || '';
			const apellido = formData.get('apellido')?.toString() || '';
			
			if (!nombre || !apellido || !email || password.length < 8) {
				throw new Error('Todos los campos son obligatorios y la contraseña debe tener al menos 8 caracteres.');
			}

			// 1. Crear usuario en Auth
			let newUser;
			try {
				newUser = await users.create(ID.unique(), email, undefined, password, `${nombre} ${apellido}`);
			} catch (e: any) {
				// El error de Appwrite ("A user with the same email already
				// exists") se mostraba tal cual, lo que permitía averiguar qué
				// direcciones están registradas. Mensaje genérico.
				console.warn(`Registro fallido para ${email}:`, e?.message);
				throw new Error('No pudimos crear la cuenta. Verificá los datos e intentá de nuevo.');
			}

			// 2. Crear Perfil
			await databases.createDocument('urbanpoint', 'profiles', ID.unique(), {
				user_id: newUser.$id,
				role: 'cliente',
				nombre: `${nombre} ${apellido}`,
				email: email,
				telefono: '',
				saldo_disponible_centavos: 0
			});
		}

		if (actionType === 'login' || actionType === 'register') {
			// Login Manual via Fetch para extraer la cookie de sesión
			const res = await fetch(`${endpoint}/account/sessions/email`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'X-Appwrite-Project': projectId
				},
				body: JSON.stringify({ email, password })
			});

			if (!res.ok) {
				// No se reenvía el mensaje del proveedor: puede distinguir entre
				// "no existe el usuario" y "contraseña incorrecta".
				const errorData = await res.json().catch(() => ({}));
				console.warn(`Login fallido para ${email}:`, errorData?.message);
				throw new Error('Email o contraseña incorrectos.');
			}

			const fallbackHeader = res.headers.get('x-fallback-cookies');
			if (!fallbackHeader) {
				throw new Error('No se pudo obtener la sesión desde el servidor.');
			}
			
			const fallbackCookies = JSON.parse(fallbackHeader);
			const sessionSecret = fallbackCookies[`a_session_${projectId}`] || fallbackCookies[`a_session_${projectId}_legacy`];

			Astro.cookies.set('up_session', sessionSecret, {
				path: '/',
				httpOnly: true,
				secure: import.meta.env.PROD,
				sameSite: 'lax',
				maxAge: 60 * 60 * 24 * 30
			});
			
			if (actionType === 'register') {
				if (targetRedirect) return Astro.redirect(targetRedirect);
				return Astro.redirect('/mi-cuenta');
			}
			
			try {
				const { userId } = await res.json();
				const profiles = await databases.listDocuments('urbanpoint', 'profiles', [
					Query.equal('user_id', userId)
				]);
				
				const role = profiles.documents.length > 0 ? profiles.documents[0].role : 'cliente';
				let finalUrl = '/admin';
				if (role === 'canillita') finalUrl = '/canillita';
				if (role === 'cliente') finalUrl = targetRedirect || '/mi-cuenta';
				
				return Astro.redirect(finalUrl);
			} catch (dbErr) {
				// Sin el perfil no se puede saber el rol: se manda a la home del
				// cliente y el middleware resuelve el acceso real en la próxima
				// navegación. Antes había un email de admin hardcodeado acá.
				console.error('No se pudo resolver el perfil tras el login:', dbErr);
				return Astro.redirect(targetRedirect || '/mi-cuenta');
			}
		}
	} catch (e: any) {
		loginError = e.message || 'Error al procesar la solicitud.';
	}
}
---

<Layout title="Crear Cuenta / Iniciar Sesión | UrbanPoint">
	<Header />

	<div class="min-h-[85vh] bg-slate-50 flex items-center justify-center p-6 py-12">
		<div class="max-w-md w-full">
			
			<div class="text-center mb-8 flex flex-col items-center">
				<Logo variant="light" height={44} class="mb-2" />
				<p class="text-slate-500 font-medium text-sm">Comprá en tu barrio con retiro sin cargo</p>
			</div>
			
			<div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 p-8 border border-slate-200/80">
				
				{activeNodeSession && (
					<div class="mb-6 bg-[#F2F7F3] border border-[#D4E5D6] rounded-2xl p-4 flex items-center gap-3">
						<div class="w-9 h-9 rounded-full bg-[#2D5A27] text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-xs">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
						</div>
						<div class="text-left">
							<p class="text-[11px] font-extrabold uppercase tracking-wider text-[#2D5A27]">Cuenta vinculada al Punto</p>
							<p class="text-sm font-black text-slate-900 leading-tight">{activeNodeSession.nombre}</p>
							<p class="text-[11px] text-slate-500 font-medium">{activeNodeSession.direccion} ({activeNodeSession.localidad || 'CABA'})</p>
						</div>
					</div>
				)}

				<!-- Mode Selector Tabs -->
				<div class="flex bg-slate-100 p-1 rounded-2xl mb-6">
					<button id="tab-register" class="flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all bg-slate-100 text-slate-600 hover:text-slate-900">
						Crear Cuenta
					</button>
					<button id="tab-login" class="flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all bg-[#2D5A27] text-white shadow-xs">
						Ingresar
					</button>
				</div>

				{loginError && (
					<div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-xs font-semibold mb-4">
						{loginError}
					</div>
				)}

				<div id="successBox" class="hidden bg-emerald-50 border border-emerald-200 text-[#2D5A27] px-4 py-3 rounded-xl text-xs font-semibold mb-4"></div>
				<div id="clientErrorBox" class="hidden bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-xs font-semibold mb-4"></div>

				<!-- FORM CREAR CUENTA (Server Side POST) -->
				<form id="registerForm" method="POST" class="space-y-4 hidden">
					<input type="hidden" name="actionType" value="register" />
					<input type="hidden" name="redirectUrl" value={redirectParam || (activeNodeSession ? `/${activeNodeSession.slug}` : '')} />
					
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="reg-nombre" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Nombre</label>
							<input type="text" id="reg-nombre" name="nombre" required class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" placeholder="Juan" />
						</div>
						<div>
							<label for="reg-apellido" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Apellido</label>
							<input type="text" id="reg-apellido" name="apellido" required class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" placeholder="Pérez" />
						</div>
					</div>

					<div>
						<label for="reg-email" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Tu Correo Electrónico</label>
						<input type="email" id="reg-email" name="email" required class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" placeholder="ejemplo@correo.com" />
					</div>

					<div>
						<label for="reg-password" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Contraseña</label>
						<input type="password" id="reg-password" name="password" required minlength="8" class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" placeholder="Mínimo 8 caracteres" />
					</div>

					<button type="submit" id="regSubmitBtn" class="w-full bg-[#2D5A27] hover:bg-[#23471F] text-white font-extrabold py-4 px-6 rounded-xl shadow-lg shadow-[#2D5A27]/20 transition-all flex items-center justify-center gap-2 text-sm cursor-pointer mt-2">
						Crear mi cuenta
					</button>
				</form>

				<!-- FORM INGRESAR (Server Side POST) -->
				<form id="loginForm" method="POST" class="space-y-4">
					<input type="hidden" name="actionType" value="login" />
					<input type="hidden" name="redirectUrl" value={redirectParam || (activeNodeSession ? `/${activeNodeSession.slug}` : '')} />
					<div>
						<label for="login-email" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Email</label>
						<input type="email" id="login-email" name="email" required class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" placeholder="tucorreo@ejemplo.com" />
					</div>
					<div>
						<label for="login-password" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Contraseña</label>
						<input type="password" id="login-password" name="password" required class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" placeholder="••••••••" />
					</div>
					<button type="submit" id="loginSubmitBtn" class="w-full bg-[#2D5A27] hover:bg-[#23471F] text-white font-extrabold py-4 px-6 rounded-xl shadow-lg shadow-[#2D5A27]/20 transition-all flex items-center justify-center gap-2 text-sm cursor-pointer mt-2">
						Ingresar
					</button>
				</form>

				<p class="text-xs text-center text-slate-400 mt-6 font-medium">
					Al continuar aceptás los términos de servicio de UrbanPoint.
				</p>
			</div>
		</div>
	</div>
</Layout>

<script>
	const tabRegister = document.getElementById('tab-register');
	const tabLogin = document.getElementById('tab-login');
	const registerForm = document.getElementById('registerForm') as HTMLFormElement;
	const loginForm = document.getElementById('loginForm') as HTMLFormElement;

	tabRegister?.addEventListener('click', () => {
		tabRegister.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all bg-[#2D5A27] text-white shadow-xs";
		if (tabLogin) tabLogin.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all text-slate-600 hover:text-slate-900 bg-slate-100";
		registerForm?.classList.remove('hidden');
		loginForm?.classList.add('hidden');
	});

	tabLogin?.addEventListener('click', () => {
		tabLogin.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all bg-[#2D5A27] text-white shadow-xs";
		if (tabRegister) tabRegister.className = "flex-1 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all text-slate-600 hover:text-slate-900 bg-slate-100";
		loginForm?.classList.remove('hidden');
		registerForm?.classList.add('hidden');
	});

	registerForm?.addEventListener('submit', () => {
		const btn = document.getElementById('regSubmitBtn') as HTMLButtonElement;
		if (btn) btn.innerHTML = 'Creando...';
	});

	loginForm?.addEventListener('submit', () => {
		const btn = document.getElementById('loginSubmitBtn') as HTMLButtonElement;
		if (btn) btn.innerHTML = 'Ingresando...';
	});
</script>
