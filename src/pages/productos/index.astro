---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCachedCatalog, getOptimizedImageUrl } from '../../lib/server/catalogCache';

import { precioDeVentaCentavos, precioListaCentavos } from '../../lib/pricing';
import { toSafeJson } from '../../lib/safeJson';
import { getVistaCatalogo, precioParaTier } from '../../lib/server/catalogView';
import { tierDeRol } from '../../lib/pricingEngine';

let products: any[] = [];
let categories: any[] = [];
let pickupPoints: any[] = [];
// Distingue "no hay productos" de "no pudimos cargarlos": antes un fallo del
// backend se renderizaba como una tienda vacía y el cliente no se enteraba.
let catalogoDegradado = false;

// La vista derivada (conteos, agrupado y catálogo compacto) se calcula una vez
// por refresco del caché, no una vez por visita. Ver lib/server/catalogView.ts.
let vista = getVistaCatalogo(null, Astro.locals.user?.role);

try {
	const cache = await getCachedCatalog();
	vista = getVistaCatalogo(cache, Astro.locals.user?.role);

	products = cache.products;
	categories = vista.categorias;
	pickupPoints = cache.pickupPoints;
	catalogoDegradado = Boolean(cache.degradado);
} catch (e: any) {
	console.error('Error al cargar el catálogo:', e);
	catalogoDegradado = true;
}

// Nivel de precio del visitante. Un distribuidor tiene que VER el precio que
// se le va a cobrar: antes navegaba con precio público y se enteraba al pagar.
const tier = tierDeRol(Astro.locals.user?.role);

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });

/**
 * La grilla renderizaba las 3457 tarjetas en el servidor: 13 MB de HTML, con
 * una isla React por tarjeta hidratada de entrada. Ahora el servidor manda sólo
 * la primera tanda y el catálogo entero viaja como JSON compacto (~960 KB),
 * sobre el que el cliente filtra, ordena y va renderizando de a tandas.
 *
 * Los precios se calculan acá con pricing.ts, que es la única fuente de verdad:
 * duplicar esa lógica en el cliente es exactamente como se llegó a mostrar un
 * precio distinto del que se cobraba.
 */
const POR_PAGINA_DEFECTO = 48;

/**
 * Cuántas categorías quedan como pills a la vista. El resto vive en el panel
 * "Ver todas".
 *
 * Había 79 categorías de primer nivel en una sola fila con scroll horizontal:
 * 14.724 px de ancho contra 421 px de pantalla, o sea 35 pantallas de scroll
 * lateral para llegar a la última. Inutilizable, sobre todo en mobile.
 */
const CATEGORIAS_A_LA_VISTA = 8;

/**
 * Una entrada por GRUPO, no por producto.
 *
 * El catálogo trae cada variante como un producto separado: 6.185 fichas
 * activas que agrupadas quedan en 1.672. Eran decenas de tarjetas casi
 * idénticas seguidas —133 fascículos del Titanic, 138 minerales— y con el
 * buscador servía de poco.
 *
 * No se fusiona nada en la base: cada variante sigue siendo su documento, con
 * su stock y su historial. Acá sólo se elige una para representar al grupo y se
 * anota cuántas hay, para ofrecerlas dentro de la ficha.
 *
 * El agrupado y el compactado viven en la vista derivada, que se calcula una
 * vez por refresco del caché: recalcularlos por request costaba ~36 ms de CPU
 * bloqueando el event loop, para producir siempre el mismo resultado.
 */
const grupos = vista.grupos;
const catalogoCompacto = vista.compacto;

const productosIniciales = grupos.slice(0, POR_PAGINA_DEFECTO);

// Padres con productos, de mayor a menor. Las destacadas van como pills; todas
// entran al panel.
const categoriasPadre = vista.categoriasPadre;

const idsDeFamilia = (parent: any) => vista.familiaPorPadre.get(parent.$id) || parent.$id;

const categoriasDestacadas = categoriasPadre.slice(0, CATEGORIAS_A_LA_VISTA);
---

<Layout title="Tienda Minorista | UrbanPoint">
	<!-- Header Navbar -->
	<Header activePage="catalogo" />

	<main class="py-12 bg-slate-50 min-h-screen">
		<!-- El catálogo usa casi todo el ancho: con max-w-7xl quedaba clavado en
		     1280 px y en una pantalla de 1920 se desperdiciaban 640 px, dejando la
		     grilla en 912 px con tarjetas de 210 px. -->
		<div class="max-w-[1800px] mx-auto px-6 lg:px-10">
			
			<!-- Hero Banner Minorista -->
			<div class="bg-gradient-to-r from-slate-900 via-[#1E3E1B] to-slate-900 rounded-3xl p-8 md:p-12 text-white shadow-xl mb-12 relative overflow-hidden">
				<div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[#2D5A27]/25 rounded-full blur-3xl"></div>
				<div class="relative z-10 max-w-2xl">
					<span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#489243]/20 border border-[#489243]/40 text-[#489243] font-extrabold text-xs uppercase tracking-wider mb-4">
						PRODUCTOS URBANPOINT v1.0.5
					</span>
					<h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
						Productos seleccionados a <span class="text-[#489243]">precios especiales</span>
					</h1>
					<p class="text-slate-300 text-base md:text-lg mb-6 leading-relaxed">
						Encontrá productos para tu día a día, comprá online y elegí un punto UrbanPoint cercano para retirar tu pedido de forma simple y conveniente.
					</p>

					<a href="#products-grid" class="inline-flex items-center gap-2 px-6 py-3 bg-[#2D5A27] hover:bg-[#23471F] text-white font-extrabold text-sm rounded-xl transition-all shadow-md">
						Explorar productos
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
					</a>
				</div>
			</div>

			<!-- Barra superior: búsqueda, orden y, en mobile, el botón de filtros. -->
			<div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm mb-6">
				<div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
					<div class="relative flex-1 md:max-w-md">
						<input type="text" id="search-input" placeholder="Buscar por nombre, marca o modelo..." class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#2D5A27] focus:bg-white transition-all font-medium" />
						<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
					</div>

					<div class="flex items-center gap-3 justify-between md:justify-end">
						<button
							id="btn-filtros"
							class="lg:hidden inline-flex items-center gap-2 px-4 py-2.5 bg-[#2D5A27] text-white rounded-xl text-sm font-bold shadow-sm cursor-pointer"
							aria-expanded="false"
							aria-controls="sidebar-filtros"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
							Filtros
						</button>

						<div class="text-sm font-semibold text-slate-500 shrink-0">
							<span id="prod-count" class="text-slate-900 font-black">{grupos.length}</span> productos
						</div>

						<select id="sort-select" class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#2D5A27] cursor-pointer">
							<option value="default">Relevancia</option>
							<option value="price-asc">Precio: menor a mayor</option>
							<option value="price-desc">Precio: mayor a menor</option>
							<option value="name-asc">Nombre: A - Z</option>
						</select>
					</div>
				</div>
			</div>

			<div class="flex flex-col lg:flex-row gap-6 lg:gap-8 lg:items-start">

				<!-- Sidebar de filtros.
				     Antes las 78 categorías eran pills en una fila con scroll
				     horizontal: 14.724 px de ancho contra 421 px de pantalla. Una
				     lista larga se lee de arriba abajo, no de izquierda a derecha,
				     así que la columna le da el espacio vertical que necesita y deja
				     los filtros a la vista mientras se recorren los productos. -->
				<aside id="sidebar-filtros" class="hidden lg:block w-full lg:w-64 xl:w-72 shrink-0 lg:sticky lg:top-24">
					<div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm divide-y divide-slate-100">

						<div class="p-4">
							<div class="flex items-center justify-between mb-3">
								<h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Filtros</h2>
								<button id="btn-limpiar-filtros" class="text-[11px] font-bold text-[#2D5A27] hover:underline cursor-pointer">Limpiar</button>
							</div>
							<label class="flex items-center gap-2.5 cursor-pointer select-none">
								<input type="checkbox" id="solo-disponibles" class="w-4 h-4 accent-[#2D5A27] cursor-pointer" />
								<span class="text-sm font-semibold text-slate-700">Solo disponibles</span>
							</label>
						</div>

						<div class="p-4">
							<h2 class="text-xs font-extrabold uppercase tracking-wider text-slate-400 mb-3">
								Categorías <span class="text-slate-300 font-bold">({categoriasPadre.length})</span>
							</h2>

							<div class="relative mb-2.5">
								<input
									type="text"
									id="buscar-categoria"
									placeholder="Buscar categoría..."
									class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium focus:outline-none focus:ring-2 focus:ring-[#2D5A27] focus:bg-white transition-all"
								/>
								<svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
							</div>

							<div id="lista-categorias" class="space-y-0.5 max-h-[26rem] overflow-y-auto pr-1 -mr-1">
								<button
									class="cat-item activa w-full text-left px-3 py-2 rounded-lg text-xs font-bold transition-colors cursor-pointer flex items-center justify-between gap-2 bg-[#F2F7F3] text-[#2D5A27]"
									data-category="all"
									data-nombre="todos los productos"
								>
									<span class="truncate">Todos los productos</span>
									<span class="text-[10px] font-extrabold shrink-0 opacity-70">{products.length}</span>
								</button>

								{categoriasPadre.map((parent) => (
									<button
										class="cat-item w-full text-left px-3 py-2 rounded-lg text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#2D5A27] transition-colors cursor-pointer flex items-center justify-between gap-2"
										data-category={idsDeFamilia(parent)}
										data-parent-id={parent.$id}
										data-nombre={parent.nombre.toLowerCase()}
										title={parent.nombre}
									>
										<span class="truncate">{parent.nombre}</span>
										<span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded-full font-extrabold shrink-0">{parent.productCount}</span>
									</button>
								))}
							</div>

							<p id="sin-categorias" class="hidden text-xs text-slate-500 font-medium py-3">No hay categorías que coincidan.</p>

							<!-- Subcategorías del padre activo, si tiene. -->
							<div id="sub-categorias" class="hidden mt-3 pt-3 border-t border-slate-100">
								<h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-2">Subcategorías</h3>
								<div id="sub-lista" class="space-y-0.5"></div>
							</div>
						</div>
					</div>
				</aside>

				<div class="flex-1 min-w-0">
			<div id="no-results-box" class="hidden bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm mb-8">
				<div class="w-16 h-16 rounded-2xl bg-[#F2F7F3] text-[#2D5A27] flex items-center justify-center mx-auto mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				</div>
				<h3 class="text-xl font-bold text-slate-900 mb-2">No se encontraron productos</h3>
				<p class="text-slate-500 text-sm mb-6 max-w-md mx-auto">No hay artículos que coincidan con tu búsqueda. Intentá con otro término o limpiá los filtros.</p>
				<button id="btn-reset-filters" class="px-6 py-2.5 bg-[#2D5A27] hover:bg-[#23471F] text-white rounded-xl text-xs font-bold transition-all shadow-md">
					Limpiar filtros y ver todos
				</button>
			</div>

			<!-- Retail Product Grid -->
			{products.length === 0 && catalogoDegradado ? (
				<div class="bg-white rounded-2xl border-2 border-amber-200 p-16 text-center shadow-sm">
					<svg class="w-16 h-16 text-amber-500 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
					<h3 class="text-xl font-semibold text-slate-800 mb-1">No pudimos cargar el catálogo</h3>
					<p class="text-slate-500 text-sm">Estamos teniendo un problema técnico. Probá de nuevo en unos minutos.</p>
				</div>
			) : products.length === 0 ? (
				<div class="bg-white rounded-2xl border border-slate-200 p-16 text-center shadow-sm">
					<svg class="w-16 h-16 text-slate-300 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
					<h3 class="text-xl font-semibold text-slate-800 mb-1">No hay productos disponibles</h3>
					<p class="text-slate-500 text-sm">Pronto cargaremos nuevas ofertas a la tienda minorista.</p>
				</div>
			) : (
				<div id="paginacion-arriba" class="hidden mb-6"></div>

				<!-- auto-fill con un mínimo de 220px: la cantidad de columnas sale del
					     ancho real disponible, no de adivinar breakpoints. Con columnas fijas
					     las tarjetas quedaban en 186px a 1440 y 213px a 1920, que es lo que
					     se veía amontonado. -->
					<div class="grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-6" id="products-grid">
					{productosIniciales.map((grupo) => {
						const prod: any = grupo.principal;
						// Mismo precio que la entrada compacta y que el checkout:
						// precioParaTier es la única fuente para los tres niveles.
						const preciosGrupo = grupo.variantes.map((v: any) => precioParaTier(v, tier).venta).filter((n) => n > 0);
						const precioMinorista = (preciosGrupo.length ? Math.min(...preciosGrupo) : precioParaTier(prod, tier).venta) / 100;
						const hayVarias = grupo.variantes.length > 1;
						const desdeDistinto = hayVarias && Math.max(...preciosGrupo) > Math.min(...preciosGrupo);
						const listaCentavos = precioParaTier(prod, tier).lista;
						const precioLista = listaCentavos === null ? null : listaCentavos / 100;
						const catId = typeof prod.categoria_id === 'object' ? prod.categoria_id?.$id : prod.categoria_id;

						return (
							<div 
								class="product-card group bg-white rounded-3xl border border-slate-200/70 p-5 shadow-sm hover:shadow-2xl hover:border-[#2D5A27]/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between relative overflow-hidden"
								data-name={grupo.base.toLowerCase()}
								data-brand={(prod.marca || '').toLowerCase()}
								data-price={precioMinorista}
								data-category={catId || 'none'}
							>
								<div>
									<!-- Image Container -->
									<a href={`/productos/${prod.slug}`} class="block aspect-square rounded-2xl bg-slate-50 mb-4 overflow-hidden relative cursor-pointer group-hover:opacity-95 p-3 flex items-center justify-center">
										{prod.portada_url ? (
											<img 
												src={getOptimizedImageUrl(prod.portada_url, 400, 400, 80)} 
												alt={prod.nombre} 
												loading="lazy"
												decoding="async"
												class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" 
											/>

										) : (
											<div class="w-full h-full flex items-center justify-center text-slate-300">
												<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
											</div>
										)}
										<div class="absolute top-3 left-3 flex flex-col items-start gap-1 z-10 pointer-events-none">
											<span class="px-3 py-1 bg-[#2D5A27] text-white text-[10px] font-extrabold uppercase tracking-wider rounded-full shadow-md text-center leading-tight">
												3 sin interés
											</span>
											{hayVarias && (
												<span class="px-3 py-1 bg-slate-900/85 text-white text-[10px] font-extrabold uppercase tracking-wider rounded-full shadow-md">
													{grupo.variantes.length} variantes
												</span>
											)}
										</div>
									</a>

									<!-- Brand & Title -->
									<div class="mb-3">
										<span class="text-[11px] font-extrabold text-[#2D5A27] uppercase tracking-wider block mb-1">
											{prod.marca || 'UrbanPoint'}
										</span>
										<a href={`/productos/${prod.slug}`} class="font-bold text-slate-900 text-sm line-clamp-2 hover:text-[#2D5A27] transition-colors leading-snug">
											{grupo.base}
										</a>
									</div>

									<!-- Main Pricing & Payment Benefits -->
									<div class="mb-3">
										<div class="flex items-baseline gap-2 mb-1">
											{desdeDistinto && (
												<span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider self-end mb-0.5">desde</span>
											)}
											<span class="text-2xl font-black text-slate-900 tracking-tight leading-none">
												{formateador.format(precioMinorista)}
											</span>
											{precioLista !== null && (
												<span class="text-xs text-slate-400 line-through font-medium">
													{formateador.format(precioLista)}
												</span>
											)}
										</div>
										
										<p class="text-xs font-bold text-[#2D5A27] flex items-center gap-1 mt-1">
											<span>3 cuotas sin interés</span>
											<span class="text-slate-500 font-medium">de {formateador.format(Math.round(precioMinorista / 3))}</span>
										</p>
									</div>
								</div>

								<!-- Bottom CTA Section -->
								<div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-3 mt-2">
									<div class="flex flex-col">
										<span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Envío / Retiro</span>
										<span class="text-xs font-extrabold text-[#2D5A27]">GRATIS en Punto</span>
									</div>
									<button
										class="btn-add w-10 h-10 rounded-2xl border transition-all flex items-center justify-center font-bold text-xl shadow-sm shrink-0 bg-white hover:bg-[#2D5A27] text-[#2D5A27] hover:text-white border-slate-200/90 hover:border-[#2D5A27] hover:scale-105 active:scale-95 disabled:bg-slate-100 disabled:text-slate-300 disabled:border-slate-200 disabled:cursor-not-allowed disabled:hover:scale-100"
										data-id={prod.$id}
										data-nombre={prod.nombre}
										data-precio={precioMinorista}
										data-sku={prod.sku || prod.$id}
										data-imagen={getOptimizedImageUrl(prod.portada_url || '', 200, 200, 75)}
										disabled={typeof prod.stock === 'number' && prod.stock <= 0}
										aria-label="Agregar al carrito"
										title="Agregar al carrito"
									>
										<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
									</button>
								</div>
							</div>
						);
					})}
				</div>
			)}

			<!-- Paginación del lado del cliente: el catálogo entero ya viajó en el
			     JSON, así que cambiar de página no toca el servidor. El "Ver más"
			     que había antes exigía 71 clics para llegar al final. -->
			<div id="paginacion-abajo" class="mt-10"></div>

			<div class="mt-4 flex flex-wrap items-center justify-center gap-3 text-xs text-slate-500 font-semibold">
				<span>
					Mostrando <span id="rango-desde">1</span>–<span id="rango-hasta">{Math.min(POR_PAGINA_DEFECTO, grupos.length)}</span> de <span id="rango-total">{grupos.length}</span>
				</span>
				<label class="flex items-center gap-2">
					<span>Por página:</span>
					<select id="por-pagina" class="px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#2D5A27] cursor-pointer">
						<option value="48">48</option>
						<option value="96">96</option>
						<option value="192">192</option>
					</select>
					</label>
					</div>
				</div>
			</div>
		</div>
	</main>

	<!-- Footer -->
	<Footer />

	<script type="application/json" id="categories-json-data" set:html={toSafeJson(categories)} />
	<script type="application/json" id="catalogo-json-data" set:html={toSafeJson(catalogoCompacto)} />

	<script>
		import { addCartItem } from '../../store/cart';

		type Item = {
			i: string; s: string; n: string; m: string;
			// p = precio minimo del grupo, x = maximo, v = cuantas variantes tiene
			p: number; x: number; l: number | null; k: number | null;
			c: string; u: string; q: string; v: number;
		};

		document.addEventListener('DOMContentLoaded', () => {
			const $ = (id: string) => document.getElementById(id);

			const searchInput = $('search-input') as HTMLInputElement;
			const sortSelect = $('sort-select') as HTMLSelectElement;
			const porPaginaSel = $('por-pagina') as HTMLSelectElement;
			const soloDispo = $('solo-disponibles') as HTMLInputElement;
			const grid = $('products-grid');
			const countSpan = $('prod-count');
			const noResultsBox = $('no-results-box');
			const btnReset = $('btn-reset-filters');
			const btnLimpiar = $('btn-limpiar-filtros');
			const listaCategorias = $('lista-categorias');
			const subRow = $('sub-categorias');
			const subContainer = $('sub-lista');
			const btnFiltros = $('btn-filtros');
			const sidebar = $('sidebar-filtros');
			const pagArriba = $('paginacion-arriba');
			const pagAbajo = $('paginacion-abajo');
			const rangoDesde = $('rango-desde');
			const rangoHasta = $('rango-hasta');
			const rangoTotal = $('rango-total');
			const buscarCategoria = $('buscar-categoria') as HTMLInputElement;
			const sinCategorias = $('sin-categorias');

			const leerJson = (id: string) => {
				try { return JSON.parse($(id)?.textContent || '[]'); } catch { return []; }
			};
			const allCategories: any[] = leerJson('categories-json-data');
			const catalogo: Item[] = leerJson('catalogo-json-data');

			// Índice de búsqueda precalculado y sin acentos: recorrer y normalizar
			// 3439 nombres en cada tecla era trabajo tirado, y con tildes "Rock de
			// Aca" no encontraba "Rock de Acá".
			const normalizar = (t: string) => t.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
			const indice = catalogo.map((it) => ({
				it,
				n: normalizar(it.n || ''),
				m: normalizar(it.m || '')
			}));

			const moneda = new Intl.NumberFormat('es-AR', {
				style: 'currency', currency: 'ARS', maximumFractionDigits: 0
			});

			let activeCategory = 'all';
			let pagina = 1;
			let porPagina = Number(porPaginaSel?.value) || 48;
			let filtrados: Item[] = catalogo;
			// El servidor ya pintó la primera página: no se repinta hasta que el
			// usuario toca algo, para no tirar el HTML que ya está en pantalla.
			let gridEsDelServidor = true;

			const esc = (v: unknown) =>
				String(v ?? '')
					.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;').replace(/'/g, '&#39;');

			const SVG_MAS = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>';
			const SVG_OK = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
			const SVG_SIN_FOTO = '<div class="w-full h-full flex items-center justify-center text-slate-300"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg></div>';
			function tarjeta(it: Item): string {
				const sinStock = typeof it.k === 'number' && it.k <= 0;
				const hayVarias = (it.v || 1) > 1;
				const desdeDistinto = hayVarias && Number(it.x) > Number(it.p);
				const imagen = it.u
					? `<img src="${esc(it.u)}" alt="${esc(it.n)}" loading="lazy" decoding="async" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" />`
					: SVG_SIN_FOTO;
				const badgeVariantes = hayVarias
					? `<span class="px-3 py-1 bg-slate-900/85 text-white text-[10px] font-extrabold uppercase tracking-wider rounded-full shadow-md">${it.v} variantes</span>`
					: '';
				const desde = desdeDistinto
					? '<span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider self-end mb-0.5">desde</span>'
					: '';
				const tachado = it.l === null ? '' :
					`<span class="text-xs text-slate-400 line-through font-medium">${moneda.format(it.l)}</span>`;

				return `<div class="product-card group bg-white rounded-3xl border border-slate-200/70 p-5 shadow-sm hover:shadow-2xl hover:border-[#2D5A27]/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
	<div>
		<a href="/productos/${esc(it.s)}" class="block aspect-square rounded-2xl bg-slate-50 mb-4 overflow-hidden relative cursor-pointer group-hover:opacity-95 p-3 flex items-center justify-center">
			${imagen}
			<div class="absolute top-3 left-3 flex flex-col items-start gap-1 z-10 pointer-events-none">
				<span class="px-3 py-1 bg-[#2D5A27] text-white text-[10px] font-extrabold uppercase tracking-wider rounded-full shadow-md text-center leading-tight">3 sin interés</span>
				${badgeVariantes}
			</div>
		</a>
		<div class="mb-3">
			<span class="text-[11px] font-extrabold text-[#2D5A27] uppercase tracking-wider block mb-1">${esc(it.m || 'UrbanPoint')}</span>
			<a href="/productos/${esc(it.s)}" class="font-bold text-slate-900 text-sm line-clamp-2 hover:text-[#2D5A27] transition-colors leading-snug">${esc(it.n)}</a>
		</div>
		<div class="mb-3">
			<div class="flex items-baseline gap-2 mb-1">
				${desde}<span class="text-2xl font-black text-slate-900 tracking-tight leading-none">${moneda.format(it.p)}</span>
				${tachado}
			</div>
			<p class="text-xs font-bold text-[#2D5A27] flex items-center gap-1 mt-1">
				<span>3 cuotas sin interés</span>
				<span class="text-slate-500 font-medium">de ${moneda.format(Math.round(it.p / 3))}</span>
			</p>
		</div>
	</div>
	<div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-3 mt-2">
		<div class="flex flex-col">
			<span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Envío / Retiro</span>
			<span class="text-xs font-extrabold text-[#2D5A27]">GRATIS en Punto</span>
		</div>
		<button class="btn-add w-10 h-10 rounded-2xl border transition-all flex items-center justify-center font-bold text-xl shadow-sm shrink-0 bg-white hover:bg-[#2D5A27] text-[#2D5A27] hover:text-white border-slate-200/90 hover:border-[#2D5A27] hover:scale-105 active:scale-95 disabled:bg-slate-100 disabled:text-slate-300 disabled:border-slate-200 disabled:cursor-not-allowed disabled:hover:scale-100"
			data-id="${esc(it.i)}" data-nombre="${esc(it.n)}" data-precio="${it.p}" data-sku="${esc(it.q)}" data-imagen="${esc(it.u)}"
			${sinStock ? 'disabled' : ''} aria-label="Agregar al carrito" title="Agregar al carrito">${SVG_MAS}</button>
	</div>
</div>`;
			}


			const totalPaginas = () => Math.max(1, Math.ceil(filtrados.length / porPagina));

			function pintar() {
				if (!grid) return;
				const desde = (pagina - 1) * porPagina;
				grid.innerHTML = filtrados.slice(desde, desde + porPagina).map(tarjeta).join('');
				gridEsDelServidor = false;
				pintarPaginacion();
				actualizarContadores();
			}

			/**
			 * Ventana de páginas alrededor de la actual: con 72 páginas no se pueden
			 * listar todas, así que se muestran primera, última y las vecinas.
			 */
			function ventana(actual: number, total: number): (number | string)[] {
				if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
				const out: (number | string)[] = [1];
				const desde = Math.max(2, actual - 1);
				const hasta = Math.min(total - 1, actual + 1);
				if (desde > 2) out.push('...');
				for (let i = desde; i <= hasta; i++) out.push(i);
				if (hasta < total - 1) out.push('...');
				out.push(total);
				return out;
			}

			function pintarPaginacion() {
				const total = totalPaginas();
				const html = total <= 1 ? '' : [
					'<nav class="flex flex-wrap items-center justify-center gap-1.5" aria-label="Paginación">',
					botonPag(pagina - 1, '&larr;', pagina === 1, 'Página anterior'),
					...ventana(pagina, total).map((v) =>
						v === '...'
							? '<span class="px-2 text-slate-400 font-bold">…</span>'
							: botonPag(v as number, String(v), false, 'Página ' + v, v === pagina)
					),
					botonPag(pagina + 1, '&rarr;', pagina === total, 'Página siguiente'),
					'</nav>'
				].join('');

				if (pagArriba) {
					pagArriba.innerHTML = html;
					pagArriba.classList.toggle('hidden', total <= 1);
				}
				if (pagAbajo) pagAbajo.innerHTML = html;
			}

			function botonPag(destino: number, texto: string, deshabilitado: boolean, etiqueta: string, activo = false) {
				const base = 'min-w-9 h-9 px-3 rounded-xl text-xs font-extrabold transition-all cursor-pointer border';
				const estilo = activo
					? 'bg-[#2D5A27] text-white border-[#2D5A27] shadow-sm'
					: deshabilitado
						? 'bg-slate-50 text-slate-300 border-slate-100 cursor-not-allowed'
						: 'bg-white text-slate-700 border-slate-200 hover:border-[#2D5A27] hover:text-[#2D5A27]';
				return '<button class="btn-pag ' + base + ' ' + estilo + '" data-pagina="' + destino + '"' +
					(deshabilitado ? ' disabled' : '') +
					(activo ? ' aria-current="page"' : '') +
					' aria-label="' + etiqueta + '">' + texto + '</button>';
			}

			function actualizarContadores() {
				const hay = filtrados.length;
				const desde = hay === 0 ? 0 : (pagina - 1) * porPagina + 1;
				const hasta = Math.min(pagina * porPagina, hay);
				if (countSpan) countSpan.textContent = String(hay);
				if (rangoDesde) rangoDesde.textContent = String(desde);
				if (rangoHasta) rangoHasta.textContent = String(hasta);
				if (rangoTotal) rangoTotal.textContent = String(hay);
				if (noResultsBox) noResultsBox.classList.toggle('hidden', hay !== 0);
				if (grid) grid.classList.toggle('hidden', hay === 0);
			}

			function aplicarFiltros(resetearPagina = true) {
				const term = normalizar(searchInput ? searchInput.value.trim() : '');
				const sortMode = sortSelect ? sortSelect.value : 'default';
				const permitidas = activeCategory.split(',');
				const todas = activeCategory === 'all';
				const soloConStock = !!soloDispo?.checked;

				const res = indice.filter((e) =>
					(!term || e.n.includes(term) || e.m.includes(term)) &&
					(todas || permitidas.includes(e.it.c)) &&
					(!soloConStock || e.it.k === null || e.it.k > 0)
				).map((e) => e.it);

				if (sortMode === 'price-asc') res.sort((a, b) => a.p - b.p);
				else if (sortMode === 'price-desc') res.sort((a, b) => b.p - a.p);
				else if (sortMode === 'name-asc') res.sort((a, b) => a.n.localeCompare(b.n));

				filtrados = res;
				if (resetearPagina) pagina = 1;
				if (pagina > totalPaginas()) pagina = totalPaginas();
				pintar();
			}

			function irAPagina(n: number) {
				const total = totalPaginas();
				pagina = Math.min(Math.max(1, n), total);
				if (gridEsDelServidor) { aplicarFiltros(false); return; }
				pintar();
				// Volver al inicio de la grilla: cambiar de página dejando al usuario
				// en mitad del listado anterior es desorientador.
				grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			[pagArriba, pagAbajo].forEach((cont) => {
				cont?.addEventListener('click', (ev) => {
					const btn = (ev.target as HTMLElement)?.closest('.btn-pag') as HTMLButtonElement | null;
					if (!btn || btn.disabled) return;
					irAPagina(Number(btn.dataset.pagina));
				});
			});

			porPaginaSel?.addEventListener('change', () => {
				porPagina = Number(porPaginaSel.value) || 48;
				pagina = 1;
				if (gridEsDelServidor) aplicarFiltros(); else pintar();
			});

			soloDispo?.addEventListener('change', () => aplicarFiltros());

			// --- Sidebar: en mobile se despliega con el botón "Filtros" ---
			btnFiltros?.addEventListener('click', () => {
				const oculto = sidebar?.classList.contains('hidden');
				sidebar?.classList.toggle('hidden', !oculto);
				btnFiltros.setAttribute('aria-expanded', String(!!oculto));
			});

			buscarCategoria?.addEventListener('input', () => {
				const t = normalizar(buscarCategoria.value.trim());
				let visibles = 0;
				listaCategorias?.querySelectorAll('.cat-item').forEach((el) => {
					const item = el as HTMLElement;
					// "Todos los productos" no se filtra: es la salida para volver atrás.
					const esTodos = item.dataset.category === 'all';
					const coincide = esTodos || !t || normalizar(item.dataset.nombre || '').includes(t);
					item.classList.toggle('hidden', !coincide);
					if (coincide && !esTodos) visibles++;
				});
				sinCategorias?.classList.toggle('hidden', visibles !== 0 || !t);
			});

			function marcarActiva(valor: string) {
				listaCategorias?.querySelectorAll('.cat-item').forEach((el) => {
					const suya = el.getAttribute('data-category') === valor;
					el.classList.toggle('activa', suya);
					el.classList.toggle('bg-[#F2F7F3]', suya);
					el.classList.toggle('text-[#2D5A27]', suya);
					el.classList.toggle('font-bold', suya);
					el.classList.toggle('font-semibold', !suya);
					el.classList.toggle('text-slate-700', !suya);
				});
			}

			function activarCategoria(valor: string, parentId: string | null, etiqueta: string, cerrarEnMobile = true) {
				activeCategory = valor;
				marcarActiva(valor);

				// Subcategorías, sólo si el padre tiene hijas con productos.
				const hijas = parentId
					? allCategories.filter((c: any) => {
						const pid = typeof c.parent_id === 'string' ? c.parent_id : c.parent_id?.$id;
						return pid === parentId && c.productCount > 0;
					})
					: [];

				if (hijas.length > 0 && subRow && subContainer) {
					subContainer.innerHTML =
						'<button class="sub-item w-full text-left px-3 py-1.5 rounded-lg text-xs font-bold bg-[#F2F7F3] text-[#2D5A27] cursor-pointer" data-category="' + esc(valor) + '">Todas las de ' + esc(etiqueta) + '</button>' +
						hijas.map((c: any) =>
							'<button class="sub-item w-full text-left px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-[#2D5A27] cursor-pointer flex items-center justify-between gap-2" data-category="' + esc(c.$id) + '">' +
							'<span class="truncate">' + esc(c.nombre) + '</span>' +
							'<span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded-full font-extrabold shrink-0">' + c.productCount + '</span></button>'
						).join('');
					subRow.classList.remove('hidden');
				} else {
					subRow?.classList.add('hidden');
				}

				aplicarFiltros();

				// En mobile el sidebar tapa la grilla: se cierra al elegir, para que
				// se vea el resultado de lo que se acaba de pedir. No al limpiar:
				// ahí el usuario sigue filtrando y cerrarle el panel lo obliga a
				// volver a abrirlo.
				if (cerrarEnMobile && window.matchMedia('(max-width: 1023px)').matches) {
					sidebar?.classList.add('hidden');
					btnFiltros?.setAttribute('aria-expanded', 'false');
				}
			}

			listaCategorias?.addEventListener('click', (ev) => {
				const item = (ev.target as HTMLElement)?.closest('.cat-item') as HTMLElement | null;
				if (!item) return;
				activarCategoria(
					item.getAttribute('data-category') || 'all',
					item.getAttribute('data-parent-id'),
					item.dataset.nombre || ''
				);
			});

			subContainer?.addEventListener('click', (ev) => {
				const btn = (ev.target as HTMLElement)?.closest('.sub-item') as HTMLElement | null;
				if (!btn) return;
				subContainer.querySelectorAll('.sub-item').forEach((sb) => {
					sb.classList.remove('bg-[#F2F7F3]', 'text-[#2D5A27]', 'font-bold');
					sb.classList.add('text-slate-600', 'font-semibold');
				});
				btn.classList.remove('text-slate-600', 'font-semibold');
				btn.classList.add('bg-[#F2F7F3]', 'text-[#2D5A27]', 'font-bold');
				activeCategory = btn.getAttribute('data-category') || 'all';
				aplicarFiltros();
			});

			// --- Carrito: un solo listener delegado para toda la grilla ---
			grid?.addEventListener('click', (ev) => {
				const btn = (ev.target as HTMLElement)?.closest('.btn-add') as HTMLButtonElement | null;
				if (!btn || btn.disabled) return;
				ev.preventDefault();
				ev.stopPropagation();

				addCartItem({
					id: btn.dataset.id || '',
					nombre: btn.dataset.nombre || '',
					precio: Number(btn.dataset.precio) || 0,
					imagen: btn.dataset.imagen || '',
					sku: btn.dataset.sku || btn.dataset.id || ''
				}, 1);

				document.dispatchEvent(new CustomEvent('cart:open'));

				btn.innerHTML = SVG_OK;
				btn.classList.add('bg-[#2D5A27]', 'text-white', 'border-[#2D5A27]', 'scale-105');
				window.setTimeout(() => {
					btn.innerHTML = SVG_MAS;
					btn.classList.remove('bg-[#2D5A27]', 'text-white', 'border-[#2D5A27]', 'scale-105');
				}, 2000);
			});

			searchInput?.addEventListener('input', () => aplicarFiltros());
			sortSelect?.addEventListener('change', () => aplicarFiltros());

			const limpiarTodo = () => {
				if (searchInput) searchInput.value = '';
				if (sortSelect) sortSelect.value = 'default';
				if (soloDispo) soloDispo.checked = false;
				if (buscarCategoria) {
					buscarCategoria.value = '';
					buscarCategoria.dispatchEvent(new Event('input'));
				}
				subRow?.classList.add('hidden');
				activarCategoria('all', null, '', false);
			};

			// Dos entradas al mismo reset: el del sidebar y el de la caja de
			// "no se encontraron productos".
			btnReset?.addEventListener('click', limpiarTodo);
			btnLimpiar?.addEventListener('click', limpiarTodo);

			pintarPaginacion();
			actualizarContadores();
		});
	</script>
</Layout>
