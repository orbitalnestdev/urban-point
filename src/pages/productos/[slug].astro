---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AddToCartBtn from '../../components/shop/AddToCartBtn';
import { precioDeVentaCentavos, precioListaCentavos } from '../../lib/pricing';
import { getCachedCatalog, getOptimizedImageUrl } from '../../lib/server/catalogCache';
import { grupoDeProducto, etiquetaDeVariante } from '../../lib/variantes';
import { getVistaCatalogo, variantesDelGrupo } from '../../lib/server/catalogView';
import { sanitizeRichHtml } from '../../lib/sanitizeHtml';

const { slug } = Astro.params;

let product: any = null;
let category: any = null;
let relatedProducts: any[] = [];
let galleryImages: string[] = [];
let hermanas: any[] = [];
let nombreGrupo = '';
let barcode = '';

try {
	// Todo sale del catálogo ya cacheado en memoria: producto, categoría y
	// relacionados. Antes esta página consultaba Appwrite en cada visita —el
	// producto por slug, después categoría y relacionados, y a veces una cuarta
	// de "recientes"— sin caché de ningún tipo. Contra un backend de ~550 ms de
	// RTT eso daba 2,0 a 4,5 s de TTFB, y no mejoraba al repetir.
	//
	// El caché público ya trae los documentos completos y filtrados con el mismo
	// criterio que usaba esta página (activo y con precio cargado), así que
	// además de ahorrar los viajes elimina una inconsistencia: hasta ahora la
	// vitrina y la ficha podían discrepar sobre qué producto está publicado.
	const cache = await getCachedCatalog();
	const catalogo: any[] = cache.products || [];
	// Índices calculados una vez por refresco del caché, no por visita.
	const vista = getVistaCatalogo(cache);

	product = (slug ? vista.porSlug.get(slug) : null) || null;

	if (!product) {
		// 404 real en vez del redirect a /productos: el soft-404 confundía a
		// los buscadores y no le decía nada al usuario.
		return Astro.rewrite('/404');
	}

	// Galería: portada primero, después el resto sin repetir.
	if (product.portada_url) {
		galleryImages.push(product.portada_url);
	}
	if (product.galeria_urls) {
		try {
			const parsed = typeof product.galeria_urls === 'string' ? JSON.parse(product.galeria_urls) : product.galeria_urls;
			if (Array.isArray(parsed)) {
				parsed.forEach(url => {
					if (url && !galleryImages.includes(url)) {
						galleryImages.push(url);
					}
				});
			}
		} catch (e) {}
	}

	// Código de barras, guardado dentro de envio_config.
	if (product.envio_config) {
		try {
			const parsedEnv = typeof product.envio_config === 'string' ? JSON.parse(product.envio_config) : product.envio_config;
			if (parsedEnv && parsedEnv.codigo_barras) {
				barcode = parsedEnv.codigo_barras;
			}
		} catch (e) {}
	}

	// Las demás variantes del mismo grupo. La vitrina muestra una sola tarjeta
	// por grupo, así que la ficha es donde el comprador ve el resto: sin esto,
	// las otras 132 entregas del Titanic quedarían inalcanzables.
	//
	// La clave sale de variantesDelGrupo, que usa el MISMO criterio que la
	// vitrina. Acá se comparaba con grupoDeProducto(p).toLowerCase(), sin
	// normalizar tildes ni espacios: con un nombre acentuado de forma
	// inconsistente la tarjeta anunciaba tres variantes y la ficha mostraba
	// dos, dejando la tercera inalcanzable — justo lo que este bloque existe
	// para evitar.
	hermanas = variantesDelGrupo(vista, product)
		.map((p: any) => ({
			$id: p.$id,
			slug: p.slug,
			nombre: p.nombre,
			etiqueta: etiquetaDeVariante(p),
			stock: p.stock,
			precio: precioDeVentaCentavos(p) / 100,
			esActual: p.$id === product.$id
		}));
	nombreGrupo = grupoDeProducto(product);

	const catId = product.categoria_id
		? (typeof product.categoria_id === 'string' ? product.categoria_id : product.categoria_id.$id)
		: null;

	category = catId ? (cache.categories || []).find((c: any) => c.$id === catId) || null : null;

	// Relacionados de la MISMA categoría: la sección promete "te puede
	// interesar", no cuatro productos al azar.
	relatedProducts = catId
		? (vista.porCategoria.get(catId) || [])
				.filter((p: any) => p.$id !== product.$id)
				.slice(0, 4)
		: [];

	// Fallback: si la categoría no tiene suficientes, se completa con recientes.
	// El catálogo ya viene ordenado por $createdAt descendente.
	if (relatedProducts.length < 4) {
		const yaUsados = new Set([product.$id, ...relatedProducts.map((p: any) => p.$id)]);
		for (const p of catalogo) {
			if (relatedProducts.length >= 4) break;
			if (!yaUsados.has(p.$id)) {
				relatedProducts.push(p);
				yaUsados.add(p.$id);
			}
		}
	}

} catch (error) {
	console.error('Error cargando producto:', error);
	return Astro.redirect('/productos');
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });
const precioMinorista = precioDeVentaCentavos(product) / 100;
const listaCentavos = precioListaCentavos(product);
const precioLista = listaCentavos === null ? null : listaCentavos / 100;
const cuotaMonto = Math.round(precioMinorista / 3);

// Sin stock: se deshabilita la compra y se muestra el badge. Sólo cuando el
// stock viene como número (productos sin el campo no se bloquean por error).
const sinStock = typeof product.stock === 'number' && product.stock <= 0;

// La descripción viene del admin como HTML rico y se inyecta con set:html:
// se sanea para cortar scripts/handlers embebidos (XSS almacenado).
const descripcionSegura = product.descripcion ? sanitizeRichHtml(product.descripcion) : '';
---

<Layout title={`${product.nombre} | UrbanPoint`}>
	<!-- Header Navbar -->
	<Header activePage="catalogo" />

	<main class="py-10 bg-slate-50 min-h-screen">
		<div class="max-w-7xl mx-auto px-6">
			
			<!-- Breadcrumbs -->
			<nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-8 overflow-x-auto pb-1">
				<a href="/" class="hover:text-[#2D5A27] transition-colors">Inicio</a>
				<svg class="w-3.5 h-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
				<a href="/productos" class="hover:text-[#2D5A27] transition-colors">Catálogo</a>
				{category && (
					<>
						<svg class="w-3.5 h-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
						<span class="text-[#2D5A27]">{category.nombre}</span>
					</>
				)}
				<svg class="w-3.5 h-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
				<span class="text-slate-900 line-clamp-1">{product.nombre}</span>
			</nav>

			<!-- Main Product Card Container -->
			<div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 md:p-10 mb-12">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">
					
					<!-- Left: Interactive Gallery -->
					<div class="space-y-4">
						<!-- Main Image Display -->
						<div class="aspect-square rounded-2xl bg-slate-50 border border-slate-100 overflow-hidden relative flex items-center justify-center p-4 group">
							{galleryImages.length > 0 ? (
								<img
									id="main-product-img"
									src={getOptimizedImageUrl(galleryImages[0], 800, 800, 85)}
									alt={product.nombre}
									class="w-full h-full object-contain mix-blend-multiply transition-all duration-300 group-hover:scale-105"
								/>
							) : (
								<div class="text-slate-300 flex items-center justify-center">
									<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
								</div>
							)}
							
							<!-- Stacked Green Pill Badge -->
							<div class="absolute top-4 left-4 flex flex-col items-start gap-1.5 z-10">
								<span class="px-3.5 py-1 bg-[#2D5A27] text-white text-xs font-black uppercase tracking-wider rounded-full shadow-md">
									3 sin interés
								</span>
								{sinStock && (
									<span class="px-3.5 py-1 bg-slate-700 text-white text-xs font-black uppercase tracking-wider rounded-full shadow-md">
										Sin stock
									</span>
								)}
							</div>
						</div>

						<!-- Thumbnails Carousel -->
						{galleryImages.length > 1 && (
							<div class="flex items-center gap-3 overflow-x-auto pb-2 pt-1 scrollbar-none">
								{galleryImages.map((imgUrl, idx) => (
									<button 
										class={`thumb-btn shrink-0 w-20 h-20 rounded-xl border-2 p-1 bg-slate-50 overflow-hidden transition-all ${idx === 0 ? 'border-[#2D5A27] ring-2 ring-[#D4E5D6]' : 'border-slate-200 hover:border-[#2D5A27]/50'}`}
										data-img={getOptimizedImageUrl(imgUrl, 800, 800, 85)}
									>
										<img src={getOptimizedImageUrl(imgUrl, 160, 160, 75)} alt={`Vista ${idx + 1}`} class="w-full h-full object-contain mix-blend-multiply" />
									</button>
								))}
							</div>
						)}
					</div>

					<!-- Right: Product Purchase Info -->
					<div class="flex flex-col justify-between h-full space-y-6">
						<div>
							<!-- Brand & SKU / Barcode badges -->
							<div class="flex flex-wrap items-center justify-between gap-2 mb-3">
								<span class="px-3 py-1 rounded-full bg-[#F2F7F3] text-[#2D5A27] font-extrabold text-xs uppercase tracking-wider border border-[#D4E5D6]">
									{product.marca || 'UrbanPoint'}
								</span>
								<div class="flex items-center gap-3 text-xs text-slate-400 font-medium">
									<span>SKU: <strong class="text-slate-700">{product.sku}</strong></span>
									{barcode && <span>GTIN: <strong class="text-slate-700">{barcode}</strong></span>}
								</div>
							</div>

							<!-- Product Title -->
							<h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 leading-tight mb-1">
								{hermanas.length > 1 ? nombreGrupo : product.nombre}
							</h1>
							{hermanas.length > 1 && (
								<p class="text-sm font-bold text-[#2D5A27] mb-4">
									{etiquetaDeVariante(product)}
								</p>
							)}
							{hermanas.length <= 1 && <div class="mb-4"></div>}

							{hermanas.length > 1 && (
								<div class="mb-5">
									<div class="flex items-baseline justify-between mb-2">
										<span class="text-xs font-extrabold uppercase tracking-wider text-slate-500">
											Elegí tu opción
										</span>
										<span class="text-xs font-bold text-slate-400">
											{hermanas.length} disponibles
										</span>
									</div>
									<div class="flex flex-wrap gap-2 max-h-44 overflow-y-auto pr-1">
										{hermanas.map((v) => (
											<a
												href={`/productos/${v.slug}`}
												aria-current={v.esActual ? 'page' : undefined}
												title={v.nombre}
												class={`px-3 py-1.5 rounded-xl text-xs font-bold border transition-all max-w-full truncate ${
													v.esActual
														? 'bg-[#2D5A27] text-white border-[#2D5A27] shadow-sm cursor-default'
														: (typeof v.stock === 'number' && v.stock <= 0)
															? 'bg-slate-50 text-slate-300 border-slate-200 line-through'
															: 'bg-white text-slate-700 border-slate-200 hover:border-[#2D5A27] hover:text-[#2D5A27]'
												}`}
											>
												{v.etiqueta}
											</a>
										))}
									</div>
								</div>
							)}

							<!-- Price & Payment Benefits Box -->
							<div class="p-5 bg-slate-50 rounded-2xl border border-slate-200/80 mb-5 space-y-3">
								<div class="flex items-baseline gap-3">
									<span class="text-4xl font-black text-slate-900 tracking-tight">
										{formateador.format(precioMinorista)}
									</span>
									{precioLista !== null && (
										<span class="text-base text-slate-400 line-through font-medium">
											{formateador.format(precioLista)}
										</span>
									)}
								</div>

								<div class="space-y-1.5 pt-2 border-t border-slate-200/60">
									<p class="text-xs font-medium text-slate-600 flex items-center gap-1.5">
										<span class="text-[#2D5A27] font-bold flex items-center gap-1.5">
											<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
											3 cuotas sin interés
										</span>
										<span>de {formateador.format(cuotaMonto)}</span>
									</p>
								</div>
							</div>

							<!-- Add to Cart CTA (Positioned immediately below price box) -->
							<div class="mb-6">
								<AddToCartBtn
									client:load
									item={{
										id: product.$id,
										nombre: product.nombre,
										precio: precioMinorista,
										imagen: getOptimizedImageUrl(galleryImages[0] || '', 200, 200, 75),
										sku: product.sku || product.$id
									}}
									variant="primary"
									disabled={sinStock}
								/>
							</div>

							<!-- Retail Trust Badges Grid -->
							<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
								<div class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-center gap-3 shadow-xs">
									<div class="w-9 h-9 rounded-xl bg-[#F2F7F3] text-[#2D5A27] flex items-center justify-center shrink-0">
										<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
									</div>
									<div>
										<h4 class="text-xs font-bold text-slate-900">Retiro GRATIS</h4>
										<p class="text-[10px] text-slate-500 font-medium">En tu barrio</p>
									</div>
								</div>

								<div class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-center gap-3 shadow-xs">
									<div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
										<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
									</div>
									<div>
										<h4 class="text-xs font-bold text-slate-900">3 Cuotas</h4>
										<p class="text-[10px] text-slate-500 font-medium">Sin interés</p>
									</div>
								</div>

								<div class="p-3.5 rounded-2xl bg-white border border-slate-200 flex items-center gap-3 shadow-xs">
									<div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
										<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
									</div>
									<div>
										<h4 class="text-xs font-bold text-slate-900">Garantía Oficial</h4>
										<p class="text-[10px] text-slate-500 font-medium">Compra protegida</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Specifications & Description Section -->
			{product.descripcion && (
				<div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 md:p-10 mb-12">
					<h2 class="text-2xl font-extrabold text-slate-900 mb-6 flex items-center gap-3">
						<span class="w-2.5 h-7 bg-[#2D5A27] rounded-full"></span>
						Descripción
					</h2>
					<div class="product-description-content text-slate-700 leading-relaxed text-sm md:text-base">
						<Fragment set:html={descripcionSegura} />
					</div>
				</div>
			)}

			<!-- Related Products Section -->
			{relatedProducts.length > 0 && (
				<div class="mt-16">
					<h2 class="text-2xl font-extrabold text-slate-900 mb-6">
						También te puede interesar
					</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
						{relatedProducts.map((rel) => {
							const relPrecio = precioDeVentaCentavos(rel) / 100;
							const relListaCentavos = precioListaCentavos(rel);
							const relPrecioLista = relListaCentavos === null ? null : relListaCentavos / 100;
							
							return (
								<div class="prod-item group bg-white rounded-3xl border border-slate-200/70 p-5 shadow-sm hover:shadow-2xl hover:border-[#2D5A27]/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
									<div>
										<a href={`/productos/${rel.slug}`} class="block aspect-square rounded-2xl bg-slate-50 mb-4 overflow-hidden relative cursor-pointer group-hover:opacity-95 p-3 flex items-center justify-center">
											{rel.portada_url ? (
												<img src={getOptimizedImageUrl(rel.portada_url, 400, 400, 80)} alt={rel.nombre} loading="lazy" decoding="async" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" />
											) : (
												<div class="w-full h-full flex items-center justify-center text-slate-300">
													<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg>
												</div>
											)}
											<!-- Stacked Green Pill Badge -->
											<div class="absolute top-3 left-3 flex flex-col items-start gap-1 z-10 pointer-events-none">
												<span class="px-3 py-1 bg-[#2D5A27] text-white text-[10px] font-extrabold uppercase tracking-wider rounded-full shadow-md text-center leading-tight">
													3 sin interés
												</span>
											</div>
										</a>
										<span class="text-[11px] font-extrabold text-[#2D5A27] uppercase tracking-wider block mb-1">{rel.marca || 'UrbanPoint'}</span>
										<a href={`/productos/${rel.slug}`} class="font-bold text-slate-900 text-sm line-clamp-2 hover:text-[#2D5A27] transition-colors leading-snug mb-3">{rel.nombre}</a>
										
										<div class="flex items-baseline gap-2 mb-1">
											<span class="text-xl font-black text-slate-900 leading-none">
												{formateador.format(relPrecio)}
											</span>
											{relPrecioLista !== null && (
												<span class="text-xs text-slate-400 line-through font-medium">
													{formateador.format(relPrecioLista)}
												</span>
											)}
										</div>
									</div>
									<div class="pt-3 border-t border-slate-100 mt-2">
										<AddToCartBtn client:load item={{ id: rel.$id, nombre: rel.nombre, precio: relPrecio, imagen: getOptimizedImageUrl(rel.portada_url || '', 200, 200, 75), sku: rel.sku || rel.$id }} variant="primary" disabled={typeof rel.stock === 'number' && rel.stock <= 0} />
									</div>
								</div>
							);
						})}
					</div>
				</div>
			)}
		</div>
	</main>

	<!-- Thumbnail Gallery Selector Script -->
	<script>
		const mainImg = document.getElementById('main-product-img') as HTMLImageElement;
		const thumbBtns = document.querySelectorAll('.thumb-btn');

		thumbBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const newSrc = btn.getAttribute('data-img');
				if (mainImg && newSrc) {
					mainImg.src = newSrc;
					thumbBtns.forEach(b => b.classList.remove('border-[#2D5A27]', 'ring-2', 'ring-[#D4E5D6]'));
					btn.classList.add('border-[#2D5A27]', 'ring-2', 'ring-[#D4E5D6]');
				}
			});
		});
	</script>

	<!-- Custom Table Styling for set:html description -->
	<style is:global>
		.product-description-content table {
			width: 100%;
			border-collapse: collapse;
			margin-top: 1rem;
			margin-bottom: 1rem;
			background-color: #ffffff;
			border-radius: 0.75rem;
			overflow: hidden;
			border: 1px solid #e2e8f0;
		}
		.product-description-content th,
		.product-description-content td {
			padding: 0.75rem 1rem;
			border-bottom: 1px solid #f1f5f9;
			text-align: left;
			font-size: 0.875rem;
		}
		.product-description-content tr:nth-child(even) {
			background-color: #f8fafc;
		}
		.product-description-content tr:hover {
			background-color: #f1f5f9;
		}
		.product-description-content td:first-child {
			font-weight: 600;
			color: #334155;
			width: 35%;
		}
	</style>
	<Footer />
</Layout>
