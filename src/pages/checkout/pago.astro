---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import { getSiteSettings } from '../../lib/server/settings';
import { parseActiveNodeCookie } from '../../lib/nodeSession';
import { toSafeJson } from '../../lib/safeJson';

const settings = await getSiteSettings();
const mpEnabled = settings.mp_enabled;
const transferenciaEnabled = settings.transferencia_enabled;
const activeNodeSession = parseActiveNodeCookie(Astro.request.headers.get('cookie'));

// Config de envío en CENTAVOS, la misma que usa createCheckout server-side:
// el total que se muestra tiene que ser el que se cobra.
const envioConfig = {
	shippingCostCentavos: settings.shipping_cost_centavos || 0,
	freeShippingThresholdCentavos: settings.free_shipping_threshold_centavos || 0
};
---

<Layout title="Pago y Confirmación | UrbanPoint Checkout">
  <main class="bg-slate-50 min-h-screen pb-12">
    <!-- Simple Checkout Header -->
    <header class="bg-white border-b border-slate-200 py-4 px-6 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <Logo height={32} />
            <div class="hidden sm:flex items-center gap-4 text-sm font-bold text-slate-400">
                <a href="/checkout/retiro" class="flex items-center gap-1 hover:text-[#2D5A27]"><span class="w-5 h-5 rounded-full bg-[#2D5A27] text-white flex items-center justify-center text-xs">1</span> Retiro</a>
                <span class="h-px w-8 bg-slate-200"></span>
                <span class="flex items-center gap-1 text-[#2D5A27]"><span class="w-5 h-5 rounded-full bg-[#2D5A27] text-white flex items-center justify-center text-xs">2</span> Pago</span>
            </div>
            <a href="/checkout/retiro" class="text-sm font-bold text-slate-500 hover:text-[#2D5A27]">Volver</a>
        </div>
    </header>

    <div class="max-w-3xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10">
      <div class="mb-6 text-center">
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">Último paso</h1>
        <p class="text-slate-500 mt-2 text-lg">Revisá tu pedido y elegí cómo querés pagar.</p>
      </div>

      <div class="bg-white rounded-[2rem] p-6 sm:p-10 border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.04)] space-y-10 relative overflow-hidden">
        
        <!-- Decorative Background -->
        <div class="absolute right-0 top-0 w-64 h-64 bg-slate-50 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>

        <!-- Summary Section -->
        <div class="relative z-10">
            <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
                <div class="p-2 bg-slate-50 text-slate-700 rounded-xl border border-slate-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                </div>
                Tu pedido
            </h2>
            <div class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm mb-6">
                <div id="checkout-summary-items" class="space-y-4 mb-6">
                    <!-- Injected via JS -->
                </div>
                <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                    <span class="font-bold text-slate-500 uppercase tracking-wider text-sm">Total a pagar</span>
                    <span id="checkout-total-price" class="text-3xl font-black text-slate-900 tracking-tight">$ 0</span>
                </div>
            </div>
        </div>

        <!-- Selected Point Section -->
        <div class="relative z-10">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
                    <div class="p-2 bg-emerald-50 text-[#2D5A27] rounded-xl border border-emerald-100">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    Punto de Retiro Elegido
                </h2>
                {activeNodeSession ? (
                    <span class="text-xs font-extrabold text-[#2D5A27] bg-[#F2F7F3] px-3 py-1.5 rounded-lg border border-[#D4E5D6] flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Punto Asignado
                    </span>
                ) : (
                    <a href="/checkout/retiro" class="text-sm font-bold text-[#2D5A27] hover:text-[#1e3d1a] hover:underline bg-[#F2F7F3] px-3 py-1.5 rounded-lg transition-colors">
                        Cambiar punto
                    </a>
                )}
            </div>
            <div id="selected-point-details" class="p-5 bg-white border-2 border-[#F2F7F3] rounded-2xl flex items-start gap-4 shadow-sm hover:border-[#D4E5D6] transition-colors">
                <!-- Injected via JS -->
                <p class="text-sm font-semibold text-slate-600 flex items-center gap-2">
                    <svg class="animate-spin h-4 w-4 text-[#2D5A27]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    Cargando información del punto...
                </p>
            </div>
        </div>

        <!-- Payment Method Section -->
        <div class="relative z-10">
            <h2 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
                <div class="p-2 bg-blue-50 text-blue-600 rounded-xl border border-blue-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                </div>
                Método de Pago
            </h2>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {mpEnabled && (
                    <label class={`relative flex flex-col p-5 border-2 ${mpEnabled ? 'border-[#2D5A27] bg-[#F2F7F3]' : 'border-slate-100 bg-white'} rounded-2xl cursor-pointer hover:shadow-md transition-all`}>
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-extrabold text-slate-900 text-lg">Mercado Pago</span>
                            <input type="radio" name="payment_method" value="mercadopago" class="w-5 h-5 text-[#2D5A27] focus:ring-[#2D5A27] border-slate-300" checked={mpEnabled} />
                        </div>
                        <span class="text-sm text-slate-600 leading-relaxed">Tarjetas de crédito, débito y dinero en cuenta. Acreditación instantánea.</span>
                    </label>
                )}
                {transferenciaEnabled && (
                    <label class={`relative flex flex-col p-5 border-2 ${!mpEnabled && transferenciaEnabled ? 'border-[#2D5A27] bg-[#F2F7F3]' : 'border-slate-100 bg-white'} rounded-2xl cursor-pointer hover:shadow-md transition-all`}>
                        <div class="flex items-center justify-between mb-3">
                            <span class="font-extrabold text-slate-900 text-lg">A Convenir / Transferencia</span>
                            <input type="radio" name="payment_method" value="a_convenir" class="w-5 h-5 text-[#2D5A27] focus:ring-[#2D5A27] border-slate-300" checked={!mpEnabled && transferenciaEnabled} />
                        </div>
                        <span class="text-sm text-slate-600 leading-relaxed">Pagá en efectivo o mediante transferencia directamente al retirar tu pedido.</span>
                    </label>
                )}
            </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-6 mt-6 relative z-10 border-t border-slate-100">
            <!-- Banner de error inline: reemplaza los alert(), que se pierden
                 apenas se cierran y no dejan rastro de qué falló. -->
            <div id="checkout-error-banner" class="hidden mb-4 bg-red-50 border-2 border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm font-semibold" role="alert"></div>
            <button
                id="btn-confirm-purchase" 
                class="w-full bg-[#2D5A27] hover:bg-[#23471F] text-white font-black py-5 px-6 rounded-2xl shadow-[0_8px_25px_rgba(45,90,39,0.3)] transition-all hover:-translate-y-1 active:translate-y-0 flex items-center justify-center gap-3 text-lg cursor-pointer"
            >
                Confirmar y Pagar
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <div class="flex items-center justify-center gap-2 mt-4 text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <p class="text-xs font-bold uppercase tracking-wider">Compra 100% segura y protegida</p>
            </div>
        </div>

      </div>
    </div>
  </main>

  <script type="application/json" id="envio-config-json" set:html={toSafeJson(envioConfig)} />

  <script>
    import { cartItems, checkoutData } from '../../store/cart';
    import { actions } from 'astro:actions';

    const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });

    // Escape para interpolar datos (carrito, dirección, punto de retiro)
    // dentro de innerHTML sin riesgo de XSS.
    const esc = (s: unknown): string =>
        String(s ?? '').replace(/[&<>"']/g, (c) =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
        );

    document.addEventListener('DOMContentLoaded', async () => {
        const itemsContainer = document.getElementById('checkout-summary-items');
        const totalEl = document.getElementById('checkout-total-price');
        const pointDetailsEl = document.getElementById('selected-point-details');
        const confirmBtn = document.getElementById('btn-confirm-purchase') as HTMLButtonElement;
        const errorBanner = document.getElementById('checkout-error-banner');

        const mostrarError = (msg: string) => {
            if (errorBanner) {
                errorBanner.textContent = msg;
                errorBanner.classList.remove('hidden');
                errorBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        };

        // Config de envío en centavos, inyectada server-side desde settings.
        let envioConfig = { shippingCostCentavos: 0, freeShippingThresholdCentavos: 0 };
        try {
            envioConfig = JSON.parse(document.getElementById('envio-config-json')?.textContent || '{}');
        } catch (e) {}

        // 1. Load Cart
        const cart = cartItems.get();
        const items = Object.values(cart);
        
        if (items.length === 0) {
            window.location.href = '/carrito';
            return;
        }

        let totalSum = 0;
        let itemsHtml = '';
        items.forEach(item => {
            const subtotal = item.precio * item.cantidad;
            totalSum += subtotal;
            itemsHtml += `
                <div class="flex items-start gap-4 py-3 border-b border-slate-50 last:border-0">
                    <div class="bg-slate-100 text-slate-600 font-bold px-2.5 py-1 rounded-lg text-xs shrink-0 mt-0.5">
                        ${item.cantidad}x
                    </div>
                    <div class="flex-1 min-w-0 pr-4">
                        <span class="text-slate-800 font-semibold leading-snug block break-words">${esc(item.nombre)}</span>
                    </div>
                    <div class="shrink-0 text-right">
                        <span class="font-black text-slate-900 block">${formateador.format(subtotal)}</span>
                        ${item.cantidad > 1 ? `<span class="text-[10px] text-slate-400 font-medium uppercase tracking-wider">${formateador.format(item.precio)} c/u</span>` : ''}
                    </div>
                </div>
            `;
        });
        
        if (itemsContainer) itemsContainer.innerHTML = itemsHtml;
        if (totalEl) totalEl.textContent = formateador.format(totalSum);

        // 2. Load Selected Delivery / Point
        const currentCheckout = checkoutData.get() || {};
        const isEnvio = currentCheckout.fulfillment === 'envio';

        if (isEnvio) {
            // El total mostrado tiene que ser el que se cobra. createCheckout
            // ahora IGNORA cualquier costoEnvio del cliente y lo calcula desde
            // settings (en CENTAVOS, gratis si el subtotal alcanza el umbral):
            // acá se replica exactamente ese cálculo para mostrar lo mismo.
            const subtotalCentavos = Math.round(totalSum * 100);
            const umbral = Number(envioConfig.freeShippingThresholdCentavos) || 0;
            const envioCentavos = umbral > 0 && subtotalCentavos >= umbral
                ? 0
                : (Number(envioConfig.shippingCostCentavos) || 0);
            const envioCosto = envioCentavos / 100;
            totalSum += envioCosto;

            if (pointDetailsEl) {
                pointDetailsEl.innerHTML = `
                    <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-blue-600 shrink-0 border border-blue-100 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    </div>
                    <div>
                        <p class="font-extrabold text-slate-900">Envío a Domicilio</p>
                        <p class="text-xs text-slate-600 mt-0.5">${esc(currentCheckout.direccionEnvio || 'Dirección no especificada')}</p>
                        <p class="text-xs font-semibold text-blue-600 mt-1">Costo de envío: ${envioCentavos === 0 ? 'GRATIS' : formateador.format(envioCosto)}</p>
                    </div>
                `;
            }
        } else {
            if (!currentCheckout.pickupPointId) {
                try {
                    const savedNodeStr = localStorage.getItem('up_active_node');
                    if (savedNodeStr) {
                        const savedNode = JSON.parse(savedNodeStr);
                        if (savedNode && savedNode.id) {
                            currentCheckout.pickupPointId = savedNode.id;
                            checkoutData.set({ ...currentCheckout, pickupPointId: savedNode.id });
                        }
                    }
                } catch (e) {}
            }

            if (!currentCheckout.pickupPointId) {
                window.location.href = '/checkout/retiro';
                return;
            }

            try {
                // Se consulta al backend propio, que devuelve solo campos públicos.
                // La colección pickup_points no se expone al SDK del navegador
                // porque contiene CBU, condición fiscal y profile_id.
                const res = await fetch(`/api/pickup-points?id=${encodeURIComponent(currentCheckout.pickupPointId)}`);
                if (!res.ok) throw new Error('Punto de retiro no disponible');
                const point = await res.json();

                if (pointDetailsEl) {
                    pointDetailsEl.innerHTML = `
                        <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#2D5A27] shrink-0 border border-[#D4E5D6] shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        </div>
                        <div>
                            <p class="font-extrabold text-slate-900">${esc(point.nombre_comercial)}</p>
                            <p class="text-xs text-slate-600 mt-0.5">${esc(point.direccion)}, ${esc(point.localidad)}</p>
                            <p class="text-xs font-semibold text-[#2D5A27] mt-1">Retiro GRATIS</p>
                        </div>
                    `;
                }
            } catch (e) {
                console.error(e);
                if (pointDetailsEl) pointDetailsEl.innerHTML = `<p class="text-red-500 font-bold text-sm">Error al cargar el punto de retiro.</p>`;
            }
        }

        if (totalEl) totalEl.textContent = formateador.format(totalSum);

        // 3. Radio Buttons logic
        const radios = document.querySelectorAll('input[name="payment_method"]');
        radios.forEach(radio => {
            radio.addEventListener('change', (e) => {
                // Remove active classes from all
                radios.forEach(r => {
                    const label = r.closest('label');
                    if (label) {
                        label.classList.remove('border-[#2D5A27]', 'bg-[#F2F7F3]');
                        label.classList.add('border-slate-200', 'bg-white');
                    }
                });
                // Add active class to checked
                const checkedLabel = (e.target as HTMLElement).closest('label');
                if (checkedLabel) {
                    checkedLabel.classList.remove('border-slate-200', 'bg-white');
                    checkedLabel.classList.add('border-[#2D5A27]', 'bg-[#F2F7F3]');
                }

                // Update store
                checkoutData.set({ ...currentCheckout, paymentMethod: (e.target as HTMLInputElement).value });
            });
        });

        // Initialize state based on store or available radio buttons
        const savedMethod = currentCheckout.paymentMethod;
        const availableRadios = document.querySelectorAll('input[name="payment_method"]') as NodeListOf<HTMLInputElement>;
        let targetRadio: HTMLInputElement | null = null;

        if (savedMethod) {
            targetRadio = document.querySelector(`input[name="payment_method"][value="${savedMethod}"]`) as HTMLInputElement;
        }
        if (!targetRadio && availableRadios.length > 0) {
            targetRadio = availableRadios[0];
        }

        if (targetRadio) {
            targetRadio.checked = true;
            targetRadio.dispatchEvent(new Event('change'));
        }

        // 4. Handle Submit
        if (confirmBtn) {
            // Se guarda el label original para restaurarlo tal cual si falla
            // (antes quedaba "Finalizar Compra", un texto que nunca existió).
            const labelOriginal = confirmBtn.innerHTML;

            confirmBtn.addEventListener('click', async () => {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = 'Procesando...';
                if (errorBanner) errorBanner.classList.add('hidden');

                const restaurarBoton = () => {
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = labelOriginal;
                };

                try {
                    const finalCheckout = checkoutData.get();
                    const payload = items.map(i => ({ productId: i.id, cantidad: i.cantidad }));

                    // Ya no se manda costoEnvio: el backend lo ignora y lo
                    // calcula siempre server-side desde settings.
                    const { data, error } = await actions.createCheckout({
                        items: payload,
                        fulfillment: (finalCheckout.fulfillment as 'retiro' | 'envio') || 'retiro',
                        pickupPointId: finalCheckout.pickupPointId,
                        direccionEnvio: finalCheckout.direccionEnvio,
                        paymentMethod: finalCheckout.paymentMethod
                    });

                    if (error || !data?.success || !data?.init_point) {
                        mostrarError(error?.message || data?.error || 'No pudimos procesar tu compra. Probá de nuevo en unos minutos.');
                        restaurarBoton();
                        return;
                    }

                    window.location.href = data.init_point;
                } catch (e) {
                    mostrarError('Error de conexión. Revisá tu internet e intentá de nuevo.');
                    restaurarBoton();
                }
            });
        }
    });
  </script>
</Layout>
