---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pago y Confirmación | UrbanPoint Checkout">
  <main class="bg-slate-50 min-h-screen pb-12">
    <!-- Simple Checkout Header -->
    <header class="bg-white border-b border-slate-200 py-4 px-6 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <a href="/" class="text-2xl font-black tracking-tighter text-slate-900 flex items-center gap-1">
                <div class="w-8 h-8 rounded-lg bg-[#2D5A27] text-white flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                </div>
                Urban<span class="text-[#2D5A27]">Point</span>
            </a>
            <div class="hidden sm:flex items-center gap-4 text-sm font-bold text-slate-400">
                <a href="/checkout/retiro" class="flex items-center gap-1 hover:text-[#2D5A27]"><span class="w-5 h-5 rounded-full bg-[#2D5A27] text-white flex items-center justify-center text-xs">1</span> Retiro</a>
                <span class="h-px w-8 bg-slate-200"></span>
                <span class="flex items-center gap-1 text-[#2D5A27]"><span class="w-5 h-5 rounded-full bg-[#2D5A27] text-white flex items-center justify-center text-xs">2</span> Pago</span>
            </div>
            <a href="/checkout/retiro" class="text-sm font-bold text-slate-500 hover:text-[#2D5A27]">Volver</a>
        </div>
    </header>

    <div class="max-w-3xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10">
      <div class="mb-6 text-center">
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Último paso</h1>
        <p class="text-slate-500 mt-1">Revisá tu pedido y elegí cómo querés pagar.</p>
      </div>

      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-8">
        
        <!-- Summary Section -->
        <div>
            <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[#2D5A27]"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                Tu pedido
            </h2>
            <div id="checkout-summary-items" class="space-y-3 mb-4">
                <!-- Injected via JS -->
            </div>
            <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-between">
                <span class="font-bold text-slate-600">Total a pagar</span>
                <span id="checkout-total-price" class="text-2xl font-black text-slate-900">$ 0</span>
            </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Selected Point Section -->
        <div>
            <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[#2D5A27]"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                Punto de Retiro Elegido
            </h2>
            <div id="selected-point-details" class="p-4 bg-[#F2F7F3] border border-[#D4E5D6] rounded-xl flex items-start gap-3">
                <!-- Injected via JS -->
                <p class="text-sm font-semibold text-slate-600">Cargando...</p>
            </div>
            <div class="mt-2 text-right">
                 <a href="/checkout/retiro" class="text-xs font-bold text-[#2D5A27] hover:underline">Cambiar punto de retiro</a>
            </div>
        </div>

        <hr class="border-slate-100" />

        <!-- Payment Method Section -->
        <div>
            <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[#2D5A27]"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                Método de Pago
            </h2>
            
            <div class="grid grid-cols-1 gap-3">
                <label class="relative flex items-center gap-4 p-4 border-2 border-[#2D5A27] bg-[#F2F7F3] rounded-xl cursor-pointer">
                    <input type="radio" name="payment_method" value="mercadopago" class="w-4 h-4 text-[#2D5A27] focus:ring-[#2D5A27]" checked />
                    <div>
                        <span class="block font-bold text-slate-900">Mercado Pago</span>
                        <span class="block text-xs text-slate-500 mt-0.5">Tarjetas de crédito, débito y dinero en cuenta.</span>
                    </div>
                </label>
                <label class="relative flex items-center gap-4 p-4 border-2 border-slate-200 hover:border-slate-300 bg-white rounded-xl cursor-pointer transition-colors">
                    <input type="radio" name="payment_method" value="a_convenir" class="w-4 h-4 text-[#2D5A27] focus:ring-[#2D5A27]" />
                    <div>
                        <span class="block font-bold text-slate-900">A Convenir</span>
                        <span class="block text-xs text-slate-500 mt-0.5">Efectivo o transferencia al retirar tu pedido.</span>
                    </div>
                </label>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
            <button 
                id="btn-confirm-purchase" 
                class="w-full bg-[#2D5A27] hover:bg-[#23471F] text-white font-extrabold py-4 px-6 rounded-xl shadow-lg shadow-[#2D5A27]/20 transition-all flex items-center justify-center gap-2 text-base cursor-pointer"
            >
                Finalizar Compra
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <p class="text-center text-[11px] text-slate-400 font-semibold mt-3">Tus datos están protegidos. Compra 100% segura.</p>
        </div>

      </div>
    </div>
  </main>

  <script>
    import { cartItems, checkoutData, referralCode } from '../../store/cart';
    import { actions } from 'astro:actions';
    import { Client, Databases } from 'appwrite';

    const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });

    document.addEventListener('DOMContentLoaded', async () => {
        const itemsContainer = document.getElementById('checkout-summary-items');
        const totalEl = document.getElementById('checkout-total-price');
        const pointDetailsEl = document.getElementById('selected-point-details');
        const confirmBtn = document.getElementById('btn-confirm-purchase') as HTMLButtonElement;
        
        // 1. Load Cart
        const cart = cartItems.get();
        const items = Object.values(cart);
        
        if (items.length === 0) {
            window.location.href = '/carrito';
            return;
        }

        let totalSum = 0;
        let itemsHtml = '';
        items.forEach(item => {
            const subtotal = item.precio * item.cantidad;
            totalSum += subtotal;
            itemsHtml += `
                <div class="flex items-center justify-between text-sm">
                    <span class="text-slate-700 font-medium">${item.cantidad}x ${item.nombre}</span>
                    <span class="font-bold text-slate-900">${formateador.format(subtotal)}</span>
                </div>
            `;
        });
        
        if (itemsContainer) itemsContainer.innerHTML = itemsHtml;
        if (totalEl) totalEl.textContent = formateador.format(totalSum);

        // 2. Load Selected Point
        const currentCheckout = checkoutData.get();
        if (!currentCheckout || !currentCheckout.pickupPointId) {
            window.location.href = '/checkout/retiro';
            return;
        }

        // Fetch point details from Appwrite (client-side read-only)
        try {
            const client = new Client()
                .setEndpoint('https://aw.orbitalnest.net/v1')
                .setProject('6a6a5321001439f06817');
            const databases = new Databases(client);

            const point = await databases.getDocument('urbanpoint', 'pickup_points', currentCheckout.pickupPointId);
            
            if (pointDetailsEl) {
                pointDetailsEl.innerHTML = `
                    <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-[#2D5A27] shrink-0 border border-[#D4E5D6] shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div>
                        <p class="font-extrabold text-slate-900">${point.nombre_comercial}</p>
                        <p class="text-xs text-slate-600 mt-0.5">${point.direccion}, ${point.localidad}</p>
                        <p class="text-xs font-semibold text-[#2D5A27] mt-1">Retiro GRATIS</p>
                    </div>
                `;
            }
        } catch (e) {
            console.error(e);
            if (pointDetailsEl) pointDetailsEl.innerHTML = `<p class="text-red-500 font-bold text-sm">Error al cargar el punto de retiro.</p>`;
        }

        // 3. Radio Buttons logic
        const radios = document.querySelectorAll('input[name="payment_method"]');
        radios.forEach(radio => {
            radio.addEventListener('change', (e) => {
                // Remove active classes from all
                radios.forEach(r => {
                    const label = r.closest('label');
                    if (label) {
                        label.classList.remove('border-[#2D5A27]', 'bg-[#F2F7F3]');
                        label.classList.add('border-slate-200', 'bg-white');
                    }
                });
                // Add active class to checked
                const checkedLabel = (e.target as HTMLElement).closest('label');
                if (checkedLabel) {
                    checkedLabel.classList.remove('border-slate-200', 'bg-white');
                    checkedLabel.classList.add('border-[#2D5A27]', 'bg-[#F2F7F3]');
                }

                // Update store
                checkoutData.set({ ...currentCheckout, paymentMethod: (e.target as HTMLInputElement).value });
            });
        });

        // Initialize state based on store
        const savedMethod = currentCheckout.paymentMethod || 'mercadopago';
        const targetRadio = document.querySelector(`input[name="payment_method"][value="${savedMethod}"]`) as HTMLInputElement;
        if (targetRadio) {
            targetRadio.checked = true;
            targetRadio.dispatchEvent(new Event('change'));
        }

        // 4. Handle Submit
        if (confirmBtn) {
            confirmBtn.addEventListener('click', async () => {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = 'Procesando...';

                try {
                    const finalCheckout = checkoutData.get();
                    const payload = items.map(i => ({ productId: i.id, cantidad: i.cantidad }));
                    const refCode = referralCode.get().code;

                    const { data, error } = await actions.createCheckout({
                        items: payload,
                        pickupPointId: finalCheckout.pickupPointId,
                        referralCode: refCode,
                        paymentMethod: finalCheckout.paymentMethod
                    });

                    if (error || !data?.success) {
                        alert(error?.message || data?.error || 'Error procesando checkout');
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = 'Finalizar Compra';
                        return;
                    }

                    if (data.init_point === '/checkout/success') {
                        window.location.href = data.init_point;
                    } else {
                        window.location.href = data.init_point!;
                    }
                } catch (e) {
                    alert('Error de conexión');
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = 'Finalizar Compra';
                }
            });
        }
    });
  </script>
</Layout>
