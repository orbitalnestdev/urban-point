---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
---

<Layout title="Envío a Domicilio | UrbanPoint Checkout">
  <main class="bg-slate-50 min-h-screen pb-12">
    <!-- Header -->
    <header class="bg-white border-b border-slate-200 py-4 px-6 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <Logo height={32} />
        <div class="hidden sm:flex items-center gap-4 text-sm font-bold text-slate-400">
          <span class="flex items-center gap-1 text-[#2D5A27]"><span class="w-5 h-5 rounded-full bg-[#2D5A27] text-white flex items-center justify-center text-xs">1</span> Envío</span>
          <span class="h-px w-8 bg-slate-200"></span>
          <span class="flex items-center gap-1"><span class="w-5 h-5 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center text-xs">2</span> Pago</span>
        </div>
        <a href="/carrito" class="text-sm font-bold text-slate-500 hover:text-[#2D5A27]">Volver al carrito</a>
      </div>
    </header>

    <div class="max-w-3xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-6 sm:mt-10">
      <div class="mb-6 text-center">
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">Envío a domicilio</h1>
        <p class="text-slate-500 mt-2 text-lg">Ingresá los datos del domicilio donde querés recibir tu compra.</p>
      </div>

      <div class="bg-white rounded-[2rem] p-6 sm:p-10 border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.04)] space-y-6 relative overflow-hidden">
        
        <form id="form-envio-domicilio" class="space-y-4">
          <div>
            <label for="input-calle" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
              Calle y Altura *
            </label>
            <input 
              type="text" 
              id="input-calle" 
              required 
              placeholder="Ej: Av. Corrientes 1234, 4° B" 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:ring-2 focus:ring-[#2D5A27] focus:outline-none"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="input-localidad" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Localidad / Barrio *
              </label>
              <input 
                type="text" 
                id="input-localidad" 
                required 
                placeholder="Ej: Palermo" 
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:ring-2 focus:ring-[#2D5A27] focus:outline-none"
              />
            </div>
            <div>
              <label for="input-provincia" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Provincia *
              </label>
              <input 
                type="text" 
                id="input-provincia" 
                required 
                value="CABA" 
                placeholder="Ej: CABA" 
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:ring-2 focus:ring-[#2D5A27] focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="input-codigo-postal" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
              Código Postal
            </label>
            <input 
              type="text" 
              id="input-codigo-postal" 
              placeholder="Ej: C1414" 
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 focus:ring-2 focus:ring-[#2D5A27] focus:outline-none"
            />
          </div>

          <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 flex items-center justify-between text-sm">
            <span class="font-bold text-slate-700">Costo de envío estimado:</span>
            <span class="font-black text-slate-900">$ 1.500 (150000 centavos)</span>
          </div>

          <button 
            type="submit" 
            class="w-full bg-[#2D5A27] hover:bg-[#23471F] text-white font-black py-4 px-6 rounded-2xl shadow-md transition-all hover:-translate-y-0.5 active:translate-y-0 text-center cursor-pointer mt-6"
          >
            Continuar al Pago
          </button>
        </form>

      </div>
    </div>
  </main>

  <script>
    import { checkoutData } from '../../store/cart';

    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('form-envio-domicilio') as HTMLFormElement;
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const calle = (document.getElementById('input-calle') as HTMLInputElement).value;
        const localidad = (document.getElementById('input-localidad') as HTMLInputElement).value;
        const provincia = (document.getElementById('input-provincia') as HTMLInputElement).value;
        const cp = (document.getElementById('input-codigo-postal') as HTMLInputElement).value;

        const fullDireccion = `${calle}, ${localidad}, ${provincia} ${cp ? `(CP ${cp})` : ''}`.trim();

        const currentData = checkoutData.get();
        checkoutData.set({
          ...currentData,
          fulfillment: 'envio',
          direccionEnvio: fullDireccion,
          costoEnvio: 150000, // 1500 ARS en centavos
          pickupPointId: undefined
        });

        window.location.href = '/checkout/pago';
      });
    });
  </script>
</Layout>
