---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Logo from '../../components/Logo.astro';
import { getCachedCatalog } from '../../lib/server/catalogCache';

import { parseActiveNodeCookie } from '../../lib/nodeSession';
import { toSafeJson } from '../../lib/safeJson';

let pickupPoints: any[] = [];
let barrios: string[] = [];
let activeNodeSession: any = null;
// Distingue "no hay puntos" de "no pudimos cargarlos".
let catalogoDegradado = false;

try {
  activeNodeSession = parseActiveNodeCookie(Astro.request.headers.get('cookie'));

  // Se lee del caché compartido de catálogo (ya trae los puntos activos con
  // lat/lng/slug/telefono) en vez de paginar pickup_points en cada request.
  const cache = await getCachedCatalog();
  catalogoDegradado = Boolean(cache.degradado);

  pickupPoints = (cache.pickupPoints || []).map((p: any) => ({
    id: p.$id,
    nombre: p.nombre_comercial,
    direccion: p.direccion,
    localidad: p.localidad,
    provincia: p.provincia || 'CABA',
    lat: p.lat,
    lng: p.lng,
    horarios: p.horarios,
    telefono: p.telefono || ''
  }));

  barrios = Array.from(new Set(pickupPoints.map(p => p.localidad))).filter(Boolean).sort();
} catch (e) {
  console.error('Error cargando puntos de retiro para /checkout/retiro:', e);
  catalogoDegradado = true;
}

const POPULAR_BARRIOS = ['Todos', 'Belgrano', 'Palermo', 'Recoleta', 'Caballito', 'Nuñez', 'Villa Crespo', 'Colegiales', 'Villa Urquiza'];
---

<Layout title="Elegí tu Punto de Retiro | UrbanPoint Checkout">
  <!-- Performance Preconnects for Map Tiles & Assets -->
  <link rel="preconnect" href="https://unpkg.com" crossorigin />
  <link rel="preconnect" href="https://mt0.google.com" crossorigin />
  
  <!-- Leaflet CSS -->
  <link 
    rel="stylesheet" 
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
    crossorigin="" 
  />

  <main class="bg-slate-50 min-h-screen pb-12">
    <!-- Simple Checkout Header -->
    <header class="bg-white border-b border-slate-200 py-4 px-6 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <Logo height={32} />
            <div class="hidden sm:flex items-center gap-4 text-sm font-bold text-slate-400">
                <span class="flex items-center gap-1 text-[#2D5A27]"><span class="w-5 h-5 rounded-full bg-[#2D5A27] text-white flex items-center justify-center text-xs">1</span> Retiro</span>
                <span class="h-px w-8 bg-slate-200"></span>
                <span class="flex items-center gap-1"><span class="w-5 h-5 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center text-xs">2</span> Pago</span>
            </div>
            <a href="/carrito" class="text-sm font-bold text-slate-500 hover:text-[#2D5A27]">Volver al carrito</a>
        </div>
    </header>    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-6 sm:mt-8">
      {activeNodeSession ? (
        <div class="max-w-2xl mx-auto my-8 sm:my-12 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xl text-center space-y-6">
          <div class="w-16 h-16 rounded-2xl bg-[#E2EFE4] text-[#2D5A27] flex items-center justify-center mx-auto shadow-xs border border-[#D4E5D6]">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>

          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#2D5A27] text-white rounded-full text-xs font-black uppercase tracking-wider shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Punto de Retiro Asignado
            </span>
            <h1 class="text-3xl font-black text-slate-900 mt-4 tracking-tight">{activeNodeSession.nombre}</h1>
            <p class="text-sm font-bold text-slate-600 mt-1.5 flex items-center justify-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[#2D5A27]"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {activeNodeSession.direccion}, {activeNodeSession.localidad || 'CABA'}
            </p>
            {activeNodeSession.horarios && (
              <p class="text-xs text-slate-500 font-medium mt-1">Horarios: {activeNodeSession.horarios}</p>
            )}
          </div>

          <div class="bg-[#F2F7F3] border border-[#D4E5D6] rounded-2xl p-4 text-xs font-bold text-[#2D5A27] leading-relaxed text-left flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 mt-0.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Iniciaste tu compra a través de la tienda oficial asignada a este Punto de Retiro. Tu pedido será entregado sin cargo exclusivamente en este local.</span>
          </div>

          <button 
            id="btn-confirm-locked-node" 
            data-node-id={activeNodeSession.id}
            class="w-full py-4 bg-[#2D5A27] hover:bg-[#23471F] text-white font-black text-base rounded-2xl shadow-lg shadow-[#2D5A27]/20 transition-all flex items-center justify-center gap-2 cursor-pointer hover:scale-[1.01]"
          >
            <span>Confirmar Punto y Continuar al Pago</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
      ) : (
        <Fragment>
          <div class="mb-6">
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Elegí dónde retirar tu compra</h1>
            <p class="text-slate-500 mt-1">Seleccioná el punto de retiro (Canillita) más cercano. El envío es 100% GRATIS.</p>
          </div>

          <!-- Main 2-Column Container -->
          <div class="puntos-container">
            <!-- Left Sidebar: Controls & Store List -->
            <div class="puntos-sidebar">
              <div class="space-y-3 mb-4 shrink-0">
                <!-- Barrio Dropdown -->
                <div>
                  <label for="barrio-select" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                    Filtrar por Barrio / Localidad
                  </label>
                  <div class="relative">
                    <select 
                      id="barrio-select"
                      class="w-full appearance-none px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-[#2D5A27] focus:outline-none cursor-pointer transition-colors pr-9"
                    >
                      <option value="todos">Todos los barrios</option>
                      {barrios.map(barr => (
                        <option value={barr}>{barr}</option>
                      ))}
                    </select>
                    <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-[#2D5A27]">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </div>
                  </div>
                </div>

                <!-- Quick Barrio Chips -->
                <div id="quick-barrio-chips" class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar">
                  {POPULAR_BARRIOS.map(b => (
                    <button 
                      type="button"
                      data-barrio={b === 'Todos' ? 'todos' : b}
                      class={`barrio-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer border ${
                        b === 'Todos' 
                          ? 'bg-[#2D5A27] text-white border-[#2D5A27]' 
                          : 'bg-white text-slate-600 border-slate-200 hover:bg-[#E2EFE4] hover:text-[#2D5A27]'
                      }`}
                    >
                      {b}
                    </button>
                  ))}
                </div>

                <!-- Address Search Input -->
                <div>
                  <div class="relative">
                    <input 
                      type="text" 
                      id="address-search-input"
                      placeholder="Ej: Palermo, Calle 123..." 
                      class="w-full pl-4 pr-11 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 placeholder-slate-400 focus:ring-2 focus:ring-[#2D5A27] focus:outline-none focus:bg-white shadow-xs transition-all"
                    />
                    <button 
                      id="btn-address-search" 
                      class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-slate-500 hover:text-[#2D5A27] transition-colors"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Cards List Container (Scrollable) -->
              <div id="points-list-container" class="flex-1 overflow-y-auto pr-1 space-y-3.5 custom-scrollbar pb-4">
                {catalogoDegradado && pickupPoints.length === 0 ? (
                  <div class="p-4 bg-amber-50 border-2 border-amber-200 rounded-2xl">
                    <h3 class="text-base font-bold text-slate-900 leading-snug mb-1">
                      No pudimos cargar los puntos de retiro
                    </h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                      Estamos teniendo un problema técnico. Probá recargar la página en unos minutos.
                    </p>
                  </div>
                ) : (
                  <!-- Dynamically populated via Client JS -->
                  <Fragment />
                )}
              </div>
            </div>

            <!-- Right Panel: Google Maps Container -->
            <div class="puntos-map-wrapper relative shadow-sm">
              <div id="map"></div>
            </div>
          </div>
        </Fragment>
      )} </div>
  </main>

  <style>
    .puntos-container {
      display: flex;
      flex-direction: column-reverse;
      gap: 1.5rem;
      width: 100%;
      align-items: flex-start;
    }

    @media (min-width: 1024px) {
      .puntos-container {
        flex-direction: row;
      }
    }

    .puntos-sidebar {
      width: 100%;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      height: 680px;
      background: #ffffff;
      padding: 1.25rem;
      border-radius: 1.5rem;
      border: 1px solid #e5e7eb;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    @media (min-width: 1024px) {
      .puntos-sidebar {
        width: 420px;
        min-width: 420px;
        max-width: 420px;
      }
    }

    .puntos-map-wrapper {
      width: 100%;
      flex: 1;
      height: 680px;
      min-height: 500px;
      background: #ffffff;
      border-radius: 1.5rem;
      border: 1px solid #e5e7eb;
      overflow: hidden;
      position: relative;
    }

    #map {
      width: 100% !important;
      height: 100% !important;
      min-height: 500px !important;
      z-index: 10;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #2D5A27;
      border-radius: 9999px;
    }
  </style>

  <script type="application/json" id="pickup-points-json" set:html={toSafeJson(pickupPoints)} />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <script>
    import { checkoutData } from '../../store/cart';

    document.addEventListener('DOMContentLoaded', () => {
      const btnConfirmLocked = document.getElementById('btn-confirm-locked-node');
      if (btnConfirmLocked) {
        const nodeId = btnConfirmLocked.getAttribute('data-node-id');
        if (nodeId) {
          const currentData = checkoutData.get();
          checkoutData.set({ ...currentData, pickupPointId: nodeId });
        }
        btnConfirmLocked.addEventListener('click', () => {
          const nodeId = btnConfirmLocked.getAttribute('data-node-id');
          if (nodeId) {
            const currentData = checkoutData.get();
            checkoutData.set({ ...currentData, pickupPointId: nodeId });
          }
          window.location.href = '/checkout/pago';
        });
        return;
      }

      const jsonEl = document.getElementById('pickup-points-json');
      if (!jsonEl) return;

      const rawPoints = JSON.parse(jsonEl.textContent || '[]');

      // Sin puntos no hay nada que renderizar: se corta acá para no pisar el
      // banner de error/estado vacío que ya dejó el servidor en la lista.
      if (rawPoints.length === 0) return;

      const barrioSelect = document.getElementById('barrio-select') as HTMLSelectElement;
      const searchInput = document.getElementById('address-search-input') as HTMLInputElement;
      const listContainer = document.getElementById('points-list-container');
      const mapEl = document.getElementById('map');
      const barrioChips = document.querySelectorAll('.barrio-chip');

      if (!mapEl || typeof L === 'undefined') return;

      // Escape para interpolar datos de los puntos (los carga cada canillita)
      // dentro de innerHTML sin riesgo de XSS.
      const esc = (s: unknown): string =>
        String(s ?? '').replace(/[&<>"']/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
        );

      const map = L.map('map', { zoomControl: true }).setView([-34.5878, -58.4116], 12);

      L.tileLayer('https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
        maxZoom: 20,
        subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
        attribution: 'Google'
      }).addTo(map);

      setTimeout(() => map.invalidateSize(), 300);

      function createCustomIcon(isSelected = false) {
        const bg = isSelected ? '#1E3E1B' : '#2D5A27';
        const scale = isSelected ? 'scale(1.25)' : 'scale(1.0)';
        return L.divIcon({
          className: 'custom-leaflet-marker',
          html: `<div style="transform: ${scale}; transition: transform 0.2s;" class="flex items-center justify-center">
            <div style="background-color: ${bg}; border: 2px solid white; box-shadow: 0 3px 8px rgba(0,0,0,0.3);" class="w-8 h-8 rounded-full flex items-center justify-center text-white cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            </div>
          </div>`,
          iconSize: [32, 32],
          iconAnchor: [16, 16],
          popupAnchor: [0, -16]
        });
      }

      let markersMap = new Map();
      let activeMarkerId: string | null = null;
      let markersGroup = L.featureGroup().addTo(map);

      function updateChipStyles(activeBarrioValue: string) {
        barrioChips.forEach(chip => {
          const val = chip.getAttribute('data-barrio');
          const isMatch = (val === activeBarrioValue) || (val === 'todos' && (activeBarrioValue === 'todos' || !activeBarrioValue));
          if (isMatch) {
            chip.className = 'barrio-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer border bg-[#2D5A27] text-white border-[#2D5A27]';
          } else {
            chip.className = 'barrio-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer border bg-white text-slate-600 border-slate-200 hover:bg-[#E2EFE4] hover:text-[#2D5A27]';
          }
        });
      }

      function renderPoints(filteredPoints: any[]) {
        if (!listContainer) return;
        listContainer.innerHTML = '';
        markersGroup.clearLayers();
        markersMap.clear();

        const bounds: any[] = [];

        filteredPoints.forEach(point => {
          if (point.lat && point.lng) {
            const marker = L.marker([point.lat, point.lng], {
              icon: createCustomIcon(point.id === activeMarkerId)
            });

            marker.on('click', () => selectPoint(point.id, false));
            markersGroup.addLayer(marker);
            markersMap.set(point.id, marker);
            bounds.push([point.lat, point.lng]);
          }

          const isSelected = point.id === activeMarkerId;
          const card = document.createElement('div');
          card.id = `card-point-${point.id}`;
          card.className = `p-4 rounded-xl border-2 transition-all cursor-pointer relative flex flex-col justify-between ${
            isSelected ? 'bg-[#F2F7F3] border-[#2D5A27] shadow-sm' : 'bg-white border-slate-100 hover:border-slate-300'
          }`;

          card.innerHTML = `
            <div class="space-y-2 text-left">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-bold text-slate-900 text-sm leading-snug">${esc(point.nombre)}</h3>
                <span class="px-2 py-0.5 bg-[#E2EFE4] text-[#2D5A27] text-[10px] font-extrabold rounded-full shrink-0">
                  ${esc(point.localidad)}
                </span>
              </div>
              <div class="flex items-start gap-2 text-xs text-slate-600 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[#2D5A27] shrink-0 mt-0.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>${esc(point.direccion)}, ${esc(point.localidad)}</span>
              </div>
              <div class="flex items-start gap-2 text-xs text-slate-500 font-medium pb-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[#2D5A27] shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>${esc(point.horarios || 'Lunes a Sábado - 9 a 20hs')}</span>
              </div>
            </div>
            ${isSelected ? `
              <button class="w-full mt-3 bg-[#2D5A27] text-white font-bold py-2.5 rounded-lg text-sm hover:bg-[#23471F] transition-colors" data-confirm-id="${esc(point.id)}">
                Retirar en este punto
              </button>
            ` : ''}
          `;

          card.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).tagName !== 'BUTTON') {
               selectPoint(point.id, true);
            }
          });

          const confirmBtn = card.querySelector('button');
          if (confirmBtn) {
            confirmBtn.addEventListener('click', () => {
              const currentData = checkoutData.get();
              checkoutData.set({ ...currentData, pickupPointId: point.id });
              window.location.href = '/checkout/pago';
            });
          }

          listContainer.appendChild(card);
        });

        if (bounds.length > 0) {
          map.fitBounds(bounds, { padding: [50, 50], maxZoom: 15 });
        }
      }

      function selectPoint(pointId: string, panMap = true) {
        activeMarkerId = pointId;
        renderPoints(getFilteredPoints());

        const activeCard = document.getElementById(`card-point-${pointId}`);
        if (activeCard) {
          activeCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        const marker = markersMap.get(pointId);
        if (marker && panMap) {
          map.flyTo(marker.getLatLng(), 15, { duration: 0.8 });
        }
      }

      function getFilteredPoints() {
        const selectedBarrio = barrioSelect ? barrioSelect.value : 'todos';
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

        return rawPoints.filter((p: any) => {
          const matchBarrio = selectedBarrio === 'todos' || (p.localidad && p.localidad.toLowerCase() === selectedBarrio.toLowerCase());
          const matchQuery = !query || 
            (p.nombre && p.nombre.toLowerCase().includes(query)) ||
            (p.direccion && p.direccion.toLowerCase().includes(query)) ||
            (p.localidad && p.localidad.toLowerCase().includes(query));

          return matchBarrio && matchQuery;
        });
      }

      function filterAndRender() {
        const selectedBarrio = barrioSelect ? barrioSelect.value : 'todos';
        updateChipStyles(selectedBarrio);
        renderPoints(getFilteredPoints());
      }

      if (barrioSelect) {
        barrioSelect.addEventListener('change', filterAndRender);
      }

      barrioChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const targetBarrio = chip.getAttribute('data-barrio');
          if (barrioSelect && targetBarrio) {
            barrioSelect.value = targetBarrio;
          }
          filterAndRender();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', filterAndRender);
      }

      // Automatically select active node from localStorage or checkout state
      let initialActiveId: string | null = null;
      try {
        const savedNodeStr = localStorage.getItem('up_active_node');
        if (savedNodeStr) {
          const savedNode = JSON.parse(savedNodeStr);
          if (savedNode && savedNode.id) initialActiveId = savedNode.id;
        }
      } catch (e) {}

      const savedData = checkoutData.get();
      if (savedData && savedData.pickupPointId) {
        initialActiveId = savedData.pickupPointId;
      }

      if (initialActiveId) {
        activeMarkerId = initialActiveId;
      }

      renderPoints(rawPoints);

      if (activeMarkerId) {
        selectPoint(activeMarkerId, true);
      }
    });
  </script>
</Layout>
