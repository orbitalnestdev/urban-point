---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSiteSettings, saveSiteSetting, getClavesConfiguradas } from '../../../lib/server/settings';
import { CheckCircle, AlertTriangle, Store, Phone, MessageSquare, Newspaper, Truck, CreditCard, Bell, Search } from 'lucide-react';

export const prerender = false;

let settings = await getSiteSettings();
let successMessage = '';
let errorMessage = '';

const mpStatusParam = Astro.url.searchParams.get('mp');
const mpErrorParam = Astro.url.searchParams.get('mp_error');
const settingsMap = settings as unknown as Record<string, any>;
const isMpConnected = settingsMap.mp_status === 'conectado';

if (Astro.request.method === 'POST') {
	try {
		const formData = await Astro.request.formData();
		
		for (const [key, value] of formData.entries()) {
			if (key && !key.startsWith('__')) {
				await saveSiteSetting(key, value.toString());
			}
		}

		// Re-fetch updated settings
		settings = await getSiteSettings();
		successMessage = 'Configuración guardada correctamente. Todos los cambios impactaron en la tienda.';
	} catch (e: any) {
		console.error("Error saving settings:", e);
		errorMessage = 'Ocurrió un error al guardar la configuración: ' + e.message;
	}
}

// Qué se está viendo realmente: valores guardados o defaults del código.
const clavesConfiguradas = await getClavesConfiguradas();
const sinConfigurar = clavesConfiguradas.size === 0;
---

<AdminLayout title="Configuración de Tienda">
	<main class="p-8 max-w-[1600px] mx-auto space-y-6">
		
		<form method="POST">
			<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
				<div>
					<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
						<span>Administración</span> &gt; <span class="text-slate-900">Configuración</span>
					</div>
					<h1 class="text-2xl font-black text-slate-900 tracking-tight">
						Configuración General de la Tienda
					</h1>
					<p class="text-xs text-slate-500 font-medium mt-0.5">Los cambios guardados impactan en vivo en el sitio web sin necesidad de redeploy.</p>
				</div>
				<div class="flex items-center gap-3">
					<button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition-colors shadow-md flex items-center gap-2 cursor-pointer">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
						Guardar Todos los Cambios
					</button>
				</div>
			</header>

			{successMessage && (
				<div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-2xl text-xs font-bold mb-6 flex items-center gap-2">
					<CheckCircle className="w-4 h-4 text-emerald-600 shrink-0" />
					<span>{successMessage}</span>
				</div>
			)}
			
			{errorMessage && (
				<div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-2xl text-xs font-bold mb-6 flex items-center gap-2">
					<AlertTriangle className="w-4 h-4 text-rose-600 shrink-0" />
					<span>{errorMessage}</span>
				</div>
			)}

			{sinConfigurar && !successMessage && (
				<div class="bg-amber-50 border border-amber-200 text-amber-900 px-4 py-3 rounded-2xl text-xs mb-6 flex items-start gap-2">
					<AlertTriangle className="w-4 h-4 text-amber-600 shrink-0 mt-0.5" />
					<span>
						<strong class="block font-bold mb-0.5">Todavía no hay ninguna configuración guardada.</strong>
						Los valores de abajo son los que trae el código por defecto, no configuración real de la tienda:
						el sitio está publicando ese número de WhatsApp y ese mail de contacto.
						Revisá cada campo y presioná <strong>Guardar Todos los Cambios</strong> para que queden persistidos.
					</span>
				</div>
			)}

			<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
				
				{/* Menú de Secciones */}
				<div class="lg:col-span-1 space-y-1">
					<div class="bg-white border border-slate-200 rounded-2xl p-3 shadow-sm sticky top-24 space-y-1">
						{[
							{ id: 'sec-tienda', label: 'Tienda & Identidad', icon: Store },
							{ id: 'sec-contacto', label: 'Contacto & Redes', icon: Phone },
							{ id: 'sec-whatsapp', label: 'Botón Flotante WhatsApp', icon: MessageSquare },
							{ id: 'sec-canillitas', label: 'Red de Canillitas & Comisiones', icon: Newspaper },
							{ id: 'sec-envios', label: 'Envíos & Retiro en Punto', icon: Truck },
							{ id: 'sec-pagos', label: 'Pagos & Mercado Pago', icon: CreditCard },
							{ id: 'sec-notificaciones', label: 'Notificaciones & Emails', icon: Bell },
							{ id: 'sec-seo', label: 'SEO & Legales', icon: Search }
						].map(item => {
							const IconComponent = item.icon;
							return (
								<a 
									href={`#${item.id}`} 
									class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition-colors"
								>
									<IconComponent className="w-4 h-4 text-slate-500 shrink-0" />
									{item.label}
								</a>
							);
						})}
					</div>
				</div>

				{/* Formularios por Sección */}
				<div class="lg:col-span-3 space-y-6">
					
					{/* 1. Tienda */}
					<div id="sec-tienda" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-3">1. Tienda & Identidad</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
							<div>
								<label class="block font-bold text-slate-900 mb-1">Nombre de la Tienda</label>
								<input type="text" name="site_name" value={settings.site_name} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Moneda Principal</label>
								<input type="text" name="currency" value={settings.currency} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div class="md:col-span-2">
								<label class="block font-bold text-slate-900 mb-1">Descripción de la Marca</label>
								<textarea name="site_description" rows="2" class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600">{settings.site_description}</textarea>
							</div>
						</div>
					</div>

					{/* 2. Contacto */}
					<div id="sec-contacto" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-3">2. Contacto & Redes Sociales</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
							<div>
								<label class="block font-bold text-slate-900 mb-1">Email de Atención al Cliente</label>
								<input type="email" name="contact_email" value={settings.contact_email} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Teléfono Principal</label>
								<input type="text" name="contact_phone" value={settings.contact_phone} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Link de Instagram</label>
								<input type="text" name="social_instagram" value={settings.social_instagram} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Link de Facebook</label>
								<input type="text" name="social_facebook" value={settings.social_facebook} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
						</div>
					</div>

					{/* 3. WhatsApp Flotante */}
					<div id="sec-whatsapp" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-3">3. Configuración Botón Flotante de WhatsApp</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
							<div>
								<label class="block font-bold text-slate-900 mb-1">Número de WhatsApp (con código de país)</label>
								<input type="text" name="whatsapp_number" value={settings.whatsapp_number} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Posición en Pantalla</label>
								<select name="whatsapp_position" class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600 bg-slate-50">
									<option value="right" selected={settings.whatsapp_position === 'right'}>Abajo a la Derecha</option>
									<option value="left" selected={settings.whatsapp_position === 'left'}>Abajo a la Izquierda</option>
								</select>
							</div>
							<div class="md:col-span-2">
								<label class="block font-bold text-slate-900 mb-1">Mensaje Pre-cargado de Inicio</label>
								<input type="text" name="whatsapp_message" value={settings.whatsapp_message} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Horario Inicio Atención</label>
								<input type="time" name="whatsapp_schedule_start" value={settings.whatsapp_schedule_start} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Horario Fin Atención</label>
								<input type="time" name="whatsapp_schedule_end" value={settings.whatsapp_schedule_end} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div class="md:col-span-2 flex items-center gap-2 pt-2">
								<input type="checkbox" name="whatsapp_enabled" value="true" checked={settings.whatsapp_enabled} id="chk-wa-enabled" class="w-4 h-4 text-emerald-600 rounded" />
								<label for="chk-wa-enabled" class="font-bold text-slate-900 cursor-pointer">Activar Botón Flotante en la Tienda Pública</label>
							</div>
						</div>
					</div>

					{/* 4. Red de Canillitas */}
					<div id="sec-canillitas" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-3">4. Red de Canillitas & Comisiones Globales</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
							<div>
								<label class="block font-bold text-slate-900 mb-1">Porcentaje de Comisión Global por Defecto (%)</label>
								<input type="number" step="0.1" name="default_commission_pct" value={settings.default_commission_pct} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Ventana de Atribución del Referido (Días)</label>
								<input type="number" name="attribution_days" value={settings.attribution_days} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
						</div>
					</div>

					{/* 5. Envíos y Retiro */}
					<div id="sec-envios" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-3">5. Envíos a Domicilio & Retiro en Punto</h3>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
							<div>
								<label class="block font-bold text-slate-900 mb-1">Costo de Envío a Domicilio ($ ARS)</label>
								<input type="number" name="shipping_cost_centavos" value={settings.shipping_cost_centavos / 100} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Monto Mínimo para Envío Gratis ($ ARS)</label>
								<input type="number" name="free_shipping_threshold_centavos" value={settings.free_shipping_threshold_centavos / 100} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
						</div>
					</div>

					{/* 6. Pagos & Mercado Pago (OAuth) */}
					<div id="sec-pagos" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-6">
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-3">6. Pagos & Integración Mercado Pago OAuth</h3>

						{mpStatusParam === 'conectado' && (
							<div class="bg-emerald-50 border border-emerald-200 text-emerald-800 p-4 rounded-xl text-xs font-bold flex items-center gap-2">
								<CheckCircle className="w-5 h-5 text-emerald-600 shrink-0" />
								<span>¡La cuenta de Mercado Pago de la tienda se vinculó exitosamente mediante OAuth!</span>
							</div>
						)}

						{mpErrorParam && (
							<div class="bg-rose-50 border border-rose-200 text-rose-700 p-4 rounded-xl text-xs font-bold flex items-center gap-2">
								<AlertTriangle className="w-5 h-5 text-rose-600 shrink-0" />
								<span>Error al conectar con Mercado Pago: {mpErrorParam === 'cancelado' ? 'Autorización cancelada por el usuario.' : mpErrorParam}</span>
							</div>
						)}

						<div class="bg-gradient-to-br from-sky-900 to-indigo-950 text-white rounded-2xl p-6 border border-sky-800 flex flex-col md:flex-row md:items-center justify-between gap-6">
							<div class="space-y-2 max-w-xl">
								<div class="flex items-center gap-2 text-sky-300 font-bold text-xs uppercase tracking-widest">
									<CreditCard className="w-4 h-4 text-sky-300" />
									Flujo OAuth Oficial Mercado Pago Argentina
								</div>
								<h4 class="text-xl font-black">Cuenta Principal de Recaudación</h4>
								<p class="text-sky-100 text-xs leading-relaxed">
									Conectá la cuenta oficial de Mercado Pago de la tienda otorgando permisos sin necesidad de ingresar ni exponer Access Tokens o secretos manualmente.
								</p>
							</div>

							<div class="shrink-0 flex flex-col items-start md:items-end gap-3 bg-white/10 p-4 rounded-xl border border-white/10 backdrop-blur-md">
								{isMpConnected ? (
									<>
										<div class="flex items-center gap-2 text-emerald-400 font-extrabold text-xs">
											<span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
											Cuenta OAuth Conectada
										</div>
										<div class="text-xs text-sky-200 font-mono">
											Collector ID: <span class="text-white font-bold">{settingsMap.mp_user_id || 'Activo'}</span>
										</div>
										{settingsMap.mp_connected_at && (
											<div class="text-[11px] text-sky-300">
												Conectado: {new Date(settingsMap.mp_connected_at).toLocaleDateString('es-AR')}
											</div>
										)}
										<button
											type="button"
											id="btn-admin-desconectar-mp"
											class="mt-2 text-xs font-bold text-rose-300 hover:text-rose-100 underline cursor-pointer transition-colors"
										>
											Desconectar cuenta Mercado Pago
										</button>
									</>
								) : (
									<>
										<div class="flex items-center gap-2 text-amber-300 font-bold text-xs">
											<span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
											Sin cuenta OAuth vinculada
										</div>
										<a
											href="/api/auth/mercadopago/connect"
											class="px-5 py-2.5 bg-[#009EE3] hover:bg-[#0089C7] text-white font-black text-xs rounded-xl shadow-lg transition-all flex items-center gap-2 text-center"
										>
											Conectar Mercado Pago con OAuth
										</a>
									</>
								)}
							</div>
						</div>

						<div class="pt-4 border-t border-slate-100 space-y-3 text-xs">
							<h5 class="font-bold text-slate-900 uppercase tracking-wider text-[11px] text-slate-500">Métodos de Pago Visibles en el Checkout</h5>
							<div class="flex items-center gap-3">
								<input type="checkbox" name="mp_enabled" value="true" checked={settings.mp_enabled} id="chk-mp-enabled" class="w-4 h-4 text-emerald-600 rounded cursor-pointer" />
								<label for="chk-mp-enabled" class="font-bold text-slate-800 cursor-pointer">Habilitar cobro por Mercado Pago</label>
							</div>
							<div class="flex items-center gap-3">
								<input type="checkbox" name="transferencia_enabled" value="true" checked={settings.transferencia_enabled} id="chk-transf-enabled" class="w-4 h-4 text-emerald-600 rounded cursor-pointer" />
								<label for="chk-transf-enabled" class="font-bold text-slate-800 cursor-pointer">Habilitar cobro por Transferencia / A Convenir en el Retiro</label>
							</div>
						</div>
					</div>

					{/* 7. SEO */}
					<div id="sec-seo" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-3">7. SEO & Configuración de Buscadores</h3>
						<div class="grid grid-cols-1 gap-4 text-xs">
							<div>
								<label class="block font-bold text-slate-900 mb-1">Título SEO Principal</label>
								<input type="text" name="seo_title" value={settings.seo_title} class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600" />
							</div>
							<div>
								<label class="block font-bold text-slate-900 mb-1">Meta Descripción</label>
								<textarea name="seo_meta_description" rows="2" class="w-full px-3 py-2 border border-slate-200 rounded-xl font-medium outline-none focus:border-emerald-600">{settings.seo_meta_description}</textarea>
							</div>
						</div>
					</div>

				</div>
			</div>
		</form>

	</main>

	<script>
		import { actions } from 'astro:actions';

		document.getElementById('btn-admin-desconectar-mp')?.addEventListener('click', async (e) => {
			const btn = e.currentTarget as HTMLButtonElement;
			if (!confirm('¿Confirmás que querés desvincular la cuenta de Mercado Pago de la tienda?')) return;

			btn.disabled = true;
			btn.innerText = 'Desconectando...';

			try {
				const { data, error } = await actions.disconnectMercadoPago({});
				if (error || !data?.success) {
					alert(error?.message || 'Error al desvincular cuenta.');
					btn.disabled = false;
					btn.innerText = 'Desconectar cuenta Mercado Pago';
				} else {
					alert('Cuenta de Mercado Pago desvinculada exitosamente.');
					window.location.href = '/admin/configuracion#sec-pagos';
				}
			} catch (err) {
				alert('Error de conexión');
				btn.disabled = false;
				btn.innerText = 'Desconectar cuenta Mercado Pago';
			}
		});
	</script>
</AdminLayout>
