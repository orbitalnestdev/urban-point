---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import NewProductModal from '../../../components/admin/NewProductModal.tsx';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import { FileEdit, AlertTriangle, Image as ImageIcon, CheckCircle, Package, PauseCircle, DollarSign, ExternalLink, Check } from 'lucide-react';

export const prerender = false;

const searchQuery = Astro.url.searchParams.get('q') || '';
const estadoFilter = Astro.url.searchParams.get('estado') || '';
const categoriaFilter = Astro.url.searchParams.get('categoria') || '';
const minPrice = Astro.url.searchParams.get('precioMin') || '';
const maxPrice = Astro.url.searchParams.get('precioMax') || '';
const soloBorradores = Astro.url.searchParams.get('borradores') === 'true';

const { databases } = createAdminClient();
let products = [];
let categories = [];

async function fetchAllDocs(collectionId: string) {
	let allDocs: any[] = [];
	let offset = 0;
	while (true) {
		const res = await databases.listDocuments('urbanpoint', collectionId, [
			Query.limit(100),
			Query.offset(offset)
		]);
		allDocs = allDocs.concat(res.documents);
		if (res.documents.length < 100) break;
		offset += 100;
	}
	return allDocs;
}

try {
	[products, categories] = await Promise.all([
		fetchAllDocs('products'),
		fetchAllDocs('categories')
	]);

	const categoryMap: Record<string, any> = {};
	categories.forEach(c => { categoryMap[c.$id] = c; });
	products = products.map(p => ({
		...p,
		categoryObj: typeof p.categoria_id === 'string' ? categoryMap[p.categoria_id] : p.categoria_id
	}));
} catch (e) {
	console.error("Error loading products page:", e);
}

const numBorradores = products.filter(p => p.estado === 'borrador').length;
const numSinStock = products.filter(p => p.stock === 0 && p.estado !== 'borrador').length;
const numSinFoto = products.filter(p => !p.portada_url).length;
const total = products.length;
const activos = products.filter(p => p.estado === 'activo').length;
const pausados = products.filter(p => p.estado === 'pausado').length;

const valorTotalCentavos = products.filter(p => p.estado === 'activo').reduce((acc, p) => acc + ((p.precio || 0) * (p.stock || 0)), 0);
const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

let filteredProducts = [...products];

if (searchQuery.trim()) {
	const q = searchQuery.toLowerCase();
	filteredProducts = filteredProducts.filter(p => 
		p.nombre?.toLowerCase().includes(q) ||
		p.sku?.toLowerCase().includes(q) ||
		p.descripcion?.toLowerCase().includes(q)
	);
}

if (estadoFilter && estadoFilter !== 'todos') {
	filteredProducts = filteredProducts.filter(p => p.estado === estadoFilter);
}

if (categoriaFilter && categoriaFilter !== 'todos') {
	filteredProducts = filteredProducts.filter(p => p.categoria_id?.$id === categoriaFilter || p.categoria_id === categoriaFilter);
}

if (minPrice) {
	const min = parseFloat(minPrice) * 100;
	filteredProducts = filteredProducts.filter(p => (p.precio || 0) >= min);
}

if (maxPrice) {
	const max = parseFloat(maxPrice) * 100;
	filteredProducts = filteredProducts.filter(p => (p.precio || 0) <= max);
}

if (soloBorradores) {
	filteredProducts = filteredProducts.filter(p => p.estado === 'borrador');
}

// 30 days window in ms for derived "Nuevo" flag
const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
const now = Date.now();

// Paginación optimizada (30 productos por página)
const ITEMS_PER_PAGE = 30;
const pageParam = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;

const totalFiltered = filteredProducts.length;
const totalPages = Math.max(1, Math.ceil(totalFiltered / ITEMS_PER_PAGE));
const validPage = Math.min(currentPage, totalPages);

const startIndex = (validPage - 1) * ITEMS_PER_PAGE;
const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalFiltered);

const paginatedProducts = filteredProducts.slice(startIndex, endIndex);

function getPageUrl(targetPage: number) {
	const params = new URLSearchParams(Astro.url.searchParams);
	params.set('page', targetPage.toString());
	return `/admin/catalogo?${params.toString()}`;
}

const filteredPages = Array.from({ length: totalPages }, (_, i) => i + 1)
	.filter(p => p === 1 || p === totalPages || Math.abs(p - validPage) <= 2);

const paginationItems = filteredPages.map((p, index) => ({
	page: p,
	showEllipsisBefore: index > 0 && p - filteredPages[index - 1] > 1
}));
---

<AdminLayout title="Catálogo de Productos">
	<main class="p-8 max-w-[1600px] mx-auto space-y-6">
		
		{/* Top Header */}
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
					<span>Administración</span> &gt; <span class="text-slate-900 font-medium">Catálogo</span>
				</div>
				<h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-3">
					Gestión de Productos
					<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
						{total} en catálogo
					</span>
				</h1>
			</div>
			
			<div class="flex items-center gap-3">
				<button id="btn-export-csv" class="px-3.5 py-2 bg-white border border-slate-200 text-slate-700 text-xs font-bold rounded-xl hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					Exportar CSV
				</button>

				<button id="btn-nuevo-producto" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition-colors shadow-md flex items-center gap-2 cursor-pointer">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
					Nuevo producto
				</button>
			</div>
		</header>

		{/* Top Metric Cards - Solo se muestran las alertas si son > 0 */}
		{(numBorradores > 0 || numSinStock > 0 || numSinFoto > 0) ? (
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				{numBorradores > 0 && (
					<div class="bg-amber-50/70 border border-amber-200 p-4 rounded-2xl relative cursor-pointer hover:shadow-md transition-all" onclick="window.location.href='/admin/catalogo?borradores=true'">
						<p class="absolute top-4 right-4 text-3xl font-black text-amber-700">{numBorradores}</p>
						<div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center mb-2 font-bold"><FileEdit className="w-4 h-4" /></div>
						<h3 class="font-extrabold text-slate-900 text-sm">Borradores sin publicar</h3>
						<p class="text-xs text-slate-500 mt-0.5">Completar ficha y activar &rarr;</p>
					</div>
				)}

				{numSinStock > 0 && (
					<div class="bg-rose-50/70 border border-rose-200 p-4 rounded-2xl relative cursor-pointer hover:shadow-md transition-all" onclick="window.location.href='/admin/catalogo?estado=activo'">
						<p class="absolute top-4 right-4 text-3xl font-black text-rose-700">{numSinStock}</p>
						<div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center mb-2 font-bold"><AlertTriangle className="w-4 h-4" /></div>
						<h3 class="font-extrabold text-slate-900 text-sm">Publicados sin stock</h3>
						<p class="text-xs text-slate-500 mt-0.5">Ingresar reposición &rarr;</p>
					</div>
				)}

				{numSinFoto > 0 && (
					<div class="bg-slate-50/70 border border-slate-200 p-4 rounded-2xl relative cursor-pointer hover:shadow-md transition-all">
						<p class="absolute top-4 right-4 text-3xl font-black text-slate-900">{numSinFoto}</p>
						<div class="w-8 h-8 rounded-xl bg-slate-200 text-slate-600 flex items-center justify-center mb-2 font-bold"><ImageIcon className="w-4 h-4" /></div>
						<h3 class="font-extrabold text-slate-900 text-sm">Sin imagen principal</h3>
						<p class="text-xs text-slate-500 mt-0.5">Subir portada &rarr;</p>
					</div>
				)}
			</div>
		) : (
			<div class="bg-emerald-50 border border-emerald-200 p-4 rounded-2xl text-emerald-800 text-xs font-bold flex items-center gap-2">
				<CheckCircle className="w-4 h-4 text-emerald-600 shrink-0" />
				<span>Catálogo en orden: Todos los productos publicados tienen stock e imagen asignada.</span>
			</div>
		)}

		{/* Resumen General Horizontal Vivos */}
		<div class="bg-white border border-slate-200 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4 shadow-sm">
			<div class="flex items-center gap-3 px-2">
				<div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold"><Package className="w-4 h-4" /></div>
				<div>
					<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Productos</p>
					<p class="text-xl font-black text-slate-900">{total}</p>
				</div>
			</div>

			<div class="flex items-center gap-3 px-2 border-l border-slate-100 pl-4">
				<div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold"><CheckCircle className="w-4 h-4" /></div>
				<div>
					<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Publicados</p>
					<p class="text-xl font-black text-emerald-600">{activos}</p>
				</div>
			</div>

			<div class="flex items-center gap-3 px-2 border-l border-slate-100 pl-4">
				<div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold"><PauseCircle className="w-4 h-4" /></div>
				<div>
					<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Pausados</p>
					<p class="text-xl font-black text-amber-600">{pausados}</p>
				</div>
			</div>

			<div class="flex items-center gap-3 px-2 border-l border-slate-100 pl-4">
				<div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-500 flex items-center justify-center font-bold"><FileEdit className="w-4 h-4" /></div>
				<div>
					<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Borradores</p>
					<p class="text-xl font-black text-slate-700">{numBorradores}</p>
				</div>
			</div>

			<div class="flex items-center gap-3 px-2 border-l border-slate-100 pl-4 flex-1">
				<div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold"><DollarSign className="w-4 h-4" /></div>
				<div>
					<p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Valor del Catálogo Activo</p>
					<p class="text-lg font-black text-slate-900">{formateador.format(valorTotalCentavos / 100)}</p>
				</div>
			</div>
		</div>

		{/* Barra de Búsqueda y Filtros */}
		<div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-4">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				
				{/* Pestañas de Estado */}
				<div class="flex items-center gap-1 overflow-x-auto pb-1">
					{[
						{ id: 'todos', label: 'Todos', count: total },
						{ id: 'activo', label: 'Publicados', count: activos },
						{ id: 'pausado', label: 'Pausados', count: pausados },
						{ id: 'borrador', label: 'Borradores', count: numBorradores }
					].map(tab => (
						<a 
							href={`/admin/catalogo?estado=${tab.id}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
							class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-1.5 ${
								estadoFilter === tab.id 
									? 'bg-slate-900 text-white shadow-sm' 
									: 'bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200'
							}`}
						>
							{tab.label}
							<span class={`px-1.5 py-0.2 rounded-full text-[10px] ${estadoFilter === tab.id ? 'bg-slate-700 text-white' : 'bg-slate-200 text-slate-700'}`}>
								{tab.count}
							</span>
						</a>
					))}
				</div>

				{/* Buscador */}
				<form method="GET" action="/admin/catalogo" class="flex items-center gap-2 w-full md:w-80">
					<input type="hidden" name="estado" value={estadoFilter} />
					<div class="relative w-full">
						<input 
							type="text" 
							name="q" 
							value={searchQuery} 
							placeholder="Buscar por nombre o SKU..." 
							class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:border-emerald-600 focus:bg-white transition-colors"
						/>
						<svg class="w-4 h-4 absolute left-3 top-2.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
					</div>
				</form>
			</div>

			{/* Barra Flotante de Acciones en Lote */}
			<div id="bulk-actions-bar" class="hidden bg-slate-900 text-white p-3 rounded-xl flex items-center justify-between gap-4 shadow-lg animate-in fade-in duration-150">
				<div class="flex items-center gap-2 text-xs font-bold">
					<span id="bulk-count" class="bg-emerald-600 text-white px-2 py-0.5 rounded-md font-mono">0</span>
					<span>productos seleccionados</span>
				</div>
				<div class="flex items-center gap-2 flex-wrap">
					{/* Cambiar Categoría en Lote */}
					<select id="bulk-categoria-select" class="bg-slate-800 border border-slate-700 text-white text-xs font-bold px-3 py-1.5 rounded-lg outline-none cursor-pointer">
						<option value="">-- Cambiar Categoría --</option>
						{categories.map(c => (
							<option value={c.$id}>{c.nombre}</option>
						))}
					</select>

					{/* Cambiar Estado en Lote */}
					<button id="btn-bulk-activar" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer">
						Publicar
					</button>
					<button id="btn-bulk-pausar" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer">
						Pausar
					</button>
					<button id="btn-bulk-eliminar" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer">
						Eliminar
					</button>
				</div>
			</div>

			{/* Tabla de Productos con Selector de 3 Estados */}
			<div class="overflow-x-auto rounded-xl border border-slate-200">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
							<th class="p-3.5 w-10 text-center">
								<input type="checkbox" id="select-all-products" class="rounded border-slate-300 cursor-pointer" />
							</th>
							<th class="p-3.5">Producto</th>
							<th class="p-3.5 text-center">Categoría</th>
							<th class="p-3.5 text-right">Precio ARS</th>
							<th class="p-3.5 text-center">Stock</th>
							<th class="p-3.5 text-center">Estado (3 Valores)</th>
							<th class="p-3.5 text-center">Editar</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-xs">
						{paginatedProducts.map((product) => {
							const createdAtMs = new Date(product.$createdAt).getTime();
							const isNuevoCalculated = !(now - createdAtMs > THIRTY_DAYS_MS);
							const showNuevoBadge = product.es_nuevo_manual !== undefined && product.es_nuevo_manual !== null 
								? product.es_nuevo_manual 
								: isNuevoCalculated;

							return (
								<tr 
									class="hover:bg-slate-50/80 group cursor-pointer transition-colors tr-product"
									data-id={product.$id}
									data-nombre={product.nombre}
									data-sku={product.sku || 'SKU N/A'}
									data-portada={product.portada_url || ''}
									data-estado={product.estado}
									data-precio={product.precio}
									data-stock={product.stock}
									data-categoria={product.categoria_id?.$id || product.categoria_id || ''}
									data-destacado={product.destacado ? 'true' : 'false'}
									data-nuevo={showNuevoBadge ? 'true' : 'false'}
								>
									<td class="p-3.5 text-center" onclick="event.stopPropagation()">
										<input type="checkbox" class="chk-product rounded border-slate-300 cursor-pointer" data-id={product.$id} />
									</td>

									<td class="p-3.5">
										<div class="flex items-center gap-3">
											<div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 overflow-hidden shrink-0">
												<img src={product.portada_url || ''} alt={product.nombre} class="w-full h-full object-cover" onerror="this.src='data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23cbd5e1%22%20stroke-width%3D%221%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%223%22%20width%3D%2218%22%20height%3D%2218%22%20rx%3D%222%22%20ry%3D%222%22%3E%3C%2Frect%3E%3Ccircle%20cx%3D%228.5%22%20cy%3D%228.5%22%20r%3D%221.5%22%3E%3C%2Fcircle%3E%3Cpolyline%20points%3D%2221%2015%2016%2010%205%2021%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E'; this.className='w-full h-full object-center p-2 opacity-40';" />
											</div>
											<div class="min-w-0 flex-1">
												<div class="flex items-center gap-2">
													<span class="font-bold text-slate-900 group-hover:text-emerald-600 transition-colors truncate max-w-[280px] block" title={product.nombre}>
														{product.nombre}
													</span>
													{showNuevoBadge && (
														<span class="px-1.5 py-0.2 rounded text-[9px] font-extrabold bg-blue-100 text-blue-800 border border-blue-200">
															NUEVO
														</span>
													)}
												</div>
												<p class="text-[10px] text-slate-400 font-mono mt-0.5">{product.sku || 'SKU N/A'}</p>
											</div>
										</div>
									</td>

									<td class="p-3.5 text-center text-xs font-bold text-slate-600">
										{product.categoryObj?.nombre || 'Sin categoría'}
									</td>

									<td class="p-3.5 text-right font-black text-slate-900 text-sm">
										<div>{formateador.format((product.precio || 0) / 100)}</div>
										{(product.precio_distribuidor > 0 || product.precio_canillita > 0) && (
											<div class="flex items-center justify-end gap-1.5 mt-1 text-[10px] font-medium text-slate-500">
												{product.precio_distribuidor > 0 && (
													<span title="Precio Distribuidor" class="px-1.5 py-0.5 bg-purple-50 text-purple-700 rounded border border-purple-200">
														Dist: {formateador.format(product.precio_distribuidor / 100)}
													</span>
												)}
												{product.precio_canillita > 0 && (
													<span title="Precio Canillita" class="px-1.5 py-0.5 bg-emerald-50 text-emerald-700 rounded border border-emerald-200">
														Can: {formateador.format(product.precio_canillita / 100)}
													</span>
												)}
											</div>
										)}
									</td>

									<td class="p-3.5 text-center font-bold text-slate-700">
										{product.stock === 0 ? (
											<span class="text-rose-600 bg-rose-50 px-2 py-0.5 rounded-full text-[10px] font-extrabold border border-rose-200">
												0 unidades
											</span>
										) : (
											<span>{product.stock} unidades</span>
										)}
									</td>

									{/* Selector de 3 Estados Unificado */}
									<td class="p-3.5 text-center" onclick="event.stopPropagation()">
										<select 
											data-id={product.$id} 
											class="select-state-table px-2.5 py-1 rounded-full text-[10px] font-bold border outline-none cursor-pointer transition-colors"
											value={product.estado}
										>
											<option value="activo" selected={product.estado === 'activo'}>Publicado</option>
											<option value="pausado" selected={product.estado === 'pausado'}>Pausado</option>
											<option value="borrador" selected={product.estado === 'borrador'}>Borrador</option>
										</select>
									</td>

									<td class="p-3.5 text-center" onclick="event.stopPropagation()">
										<button class="btn-open-drawer px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[10px] rounded-lg transition-colors">
											Editar
										</button>
									</td>
								</tr>
							);
						})}

						{filteredProducts.length === 0 && (
							<tr>
								<td colspan="7" class="p-8 text-center text-slate-500 font-medium">
									No se encontraron productos en el catálogo.
								</td>
							</tr>
						)}
					</tbody>
				</table>
			</div>

			{/* Componente de Paginación Optimizado - 30 por página */}
			{totalPages > 1 && (
				<div class="px-4 py-3 bg-slate-50 border-t border-slate-200 rounded-b-xl flex flex-col sm:flex-row items-center justify-between gap-4">
					<div class="text-xs text-slate-500 font-medium">
						Mostrando <span class="font-bold text-slate-900">{totalFiltered > 0 ? startIndex + 1 : 0}</span> a <span class="font-bold text-slate-900">{endIndex}</span> de <span class="font-bold text-slate-900">{totalFiltered}</span> productos
					</div>

					<div class="flex items-center gap-1.5 overflow-x-auto">
						{/* Botón Anterior */}
						<a 
							href={validPage > 1 ? getPageUrl(validPage - 1) : '#'} 
							class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1 ${
								validPage > 1 
									? 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 shadow-xs' 
									: 'bg-slate-100 text-slate-400 cursor-not-allowed pointer-events-none'
							}`}
						>
							&larr; Anterior
						</a>

						{/* Números de página */}
						{paginationItems.map((item) => (
							<Fragment key={item.page}>
								{item.showEllipsisBefore && (
									<span class="px-1.5 py-1 text-slate-400 text-xs font-bold">...</span>
								)}
								<a 
									href={getPageUrl(item.page)} 
									class={`w-8 h-8 rounded-xl text-xs font-bold flex items-center justify-center transition-all ${
										item.page === validPage 
											? 'bg-slate-900 text-white shadow-sm' 
											: 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'
									}`}
								>
									{item.page}
								</a>
							</Fragment>
						))}

						{/* Botón Siguiente */}
						<a 
							href={validPage < totalPages ? getPageUrl(validPage + 1) : '#'} 
							class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-1 ${
								validPage < totalPages 
									? 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 shadow-xs' 
									: 'bg-slate-100 text-slate-400 cursor-not-allowed pointer-events-none'
							}`}
						>
							Siguiente &rarr;
						</a>
					</div>
				</div>
			)}
		</div>

		{/* Quick Edit Drawer Ampliado y Mejorado */}
		<div id="quick-edit-backdrop" class="fixed inset-0 z-40 bg-slate-900/40 backdrop-blur-xs hidden transition-opacity opacity-0"></div>
		
		<div id="quick-edit-panel" class="fixed top-0 right-0 bottom-0 w-full max-w-lg bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col border-l border-slate-200">
			
			{/* Drawer Header */}
			<div class="p-6 border-b border-slate-100 flex items-start justify-between bg-slate-50/50 shrink-0">
				<div class="flex gap-4 items-center min-w-0 pr-4">
					<div class="w-14 h-14 rounded-2xl border border-slate-200 overflow-hidden bg-white shrink-0">
						<img id="qe-img" src="" class="w-full h-full object-cover" onerror="this.src='data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23cbd5e1%22%20stroke-width%3D%221%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%223%22%20width%3D%2218%22%20height%3D%2218%22%20rx%3D%222%22%20ry%3D%222%22%3E%3C%2Frect%3E%3Ccircle%20cx%3D%228.5%22%20cy%3D%228.5%22%20r%3D%221.5%22%3E%3C%2Fcircle%3E%3Cpolyline%20points%3D%2221%2015%2016%2010%205%2021%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E';" />
					</div>
					<div class="min-w-0">
						<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-200 text-[10px] font-bold text-slate-600 mb-1">
							Edición Rápida
						</span>
						<h3 id="qe-nombre" class="text-lg font-black text-slate-900 leading-tight truncate" title="Producto">Producto</h3>
						<p id="qe-sku" class="text-[10px] font-mono text-slate-400 mt-0.5">SKU</p>
					</div>
				</div>
				<button id="qe-close" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-200 rounded-full transition-colors cursor-pointer shrink-0">
					✕
				</button>
			</div>

			{/* Sub-Header con Enlace Secundario al Editor Completo */}
			<div class="px-6 py-3 border-b border-slate-100 flex items-center justify-between shrink-0 bg-white">
				<a href="#" id="qe-link-full" class="text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1.5 transition-colors">
					<ExternalLink className="w-3.5 h-3.5" /> Abrir editor completo
				</a>
				<span class="text-[10px] font-bold text-emerald-600 opacity-0 transition-opacity flex items-center gap-1" id="qe-saved-indicator">
					<Check className="w-3 h-3" /> Guardado
				</span>
			</div>

			{/* Formulario en 2 Columnas */}
			<div class="p-6 overflow-y-auto flex-1 space-y-6">
				
				{/* 1. Selector de Estado (3 Estados Unificados) */}
				<div>
					<label class="block text-xs font-bold text-slate-900 mb-2">Estado del producto</label>
					<div class="grid grid-cols-3 gap-2 p-1 bg-slate-100 rounded-xl border border-slate-200">
						<label class="text-center cursor-pointer">
							<input type="radio" name="qe-estado" value="activo" class="peer sr-only" />
							<div class="px-2 py-2 rounded-lg text-xs font-bold text-slate-500 peer-checked:bg-emerald-600 peer-checked:text-white transition-all">
								Publicado
							</div>
						</label>
						<label class="text-center cursor-pointer">
							<input type="radio" name="qe-estado" value="pausado" class="peer sr-only" />
							<div class="px-2 py-2 rounded-lg text-xs font-bold text-slate-500 peer-checked:bg-amber-500 peer-checked:text-white transition-all">
								Pausado
							</div>
						</label>
						<label class="text-center cursor-pointer">
							<input type="radio" name="qe-estado" value="borrador" class="peer sr-only" />
							<div class="px-2 py-2 rounded-lg text-xs font-bold text-slate-500 peer-checked:bg-slate-700 peer-checked:text-white transition-all">
								Borrador
							</div>
						</label>
					</div>
				</div>

				{/* 2. Selector de Categoría (Agregado al Editor Rápido) */}
				<div>
					<label class="block text-xs font-bold text-slate-900 mb-1">Categoría del producto</label>
					<select id="qe-categoria" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs font-bold text-slate-900 bg-slate-50 focus:bg-white focus:border-emerald-600 outline-none">
						<option value="">-- Sin Categoría --</option>
						{categories.map(c => (
							<option value={c.$id}>{c.nombre}</option>
						))}
					</select>
				</div>

				{/* 3. Inputs de Precio y Stock (2 Columnas con Formato) */}
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-bold text-slate-900 mb-1">Precio base (ARS)</label>
						<input 
							type="text" 
							id="qe-precio" 
							placeholder="$ 0,00"
							class="w-full px-3 py-2.5 border border-slate-200 rounded-xl font-bold text-slate-900 text-xs focus:border-emerald-600 outline-none" 
						/>
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-900 mb-1">Stock disponible</label>
						<div class="relative">
							<input 
								type="number" 
								id="qe-stock" 
								min="0"
								class="w-full pl-3 pr-16 py-2.5 border border-slate-200 rounded-xl font-bold text-slate-900 text-xs focus:border-emerald-600 outline-none" 
							/>
							<span class="absolute right-3 top-2.5 text-[10px] font-bold text-slate-400">unidades</span>
						</div>
					</div>
				</div>

				{/* 4. Toggles Destacado y Nuevo */}
				<div class="space-y-3 border-t border-b border-slate-100 py-4">
					<div class="flex items-center justify-between">
						<div>
							<p class="text-xs font-bold text-slate-900">Destacado en Portada</p>
							<p class="text-[10px] text-slate-400">Aparece en el carrusel principal.</p>
						</div>
						<input type="checkbox" id="qe-destacado" class="w-4 h-4 text-emerald-600 rounded border-slate-300 cursor-pointer" />
					</div>
					<div class="flex items-center justify-between">
						<div>
							<p class="text-xs font-bold text-slate-900">Distintivo "Nuevo"</p>
							<p class="text-[10px] text-slate-400">Derivado automático (&lt;30 días) u override manual.</p>
						</div>
						<input type="checkbox" id="qe-nuevo" class="w-4 h-4 text-emerald-600 rounded border-slate-300 cursor-pointer" />
					</div>
				</div>

				{/* 5. Foto Principal Thumbnail */}
				<div>
					<label class="block text-xs font-bold text-slate-900 mb-2">Foto principal</label>
					<div class="flex items-center gap-4">
						<div class="w-14 h-14 rounded-xl border border-slate-200 overflow-hidden shrink-0 bg-slate-50">
							<img id="qe-img-thumb" src="" class="w-full h-full object-cover" onerror="this.src='data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2240%22%20height%3D%2240%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23cbd5e1%22%20stroke-width%3D%221%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%223%22%20y%3D%223%22%20width%3D%2218%22%20height%3D%2218%22%20rx%3D%222%22%20ry%3D%222%22%3E%3C%2Frect%3E%3Ccircle%20cx%3D%228.5%22%20cy%3D%228.5%22%20r%3D%221.5%22%3E%3C%2Fcircle%3E%3Cpolyline%20points%3D%2221%2015%2016%2010%205%2021%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E';" />
						</div>
						<a href="#" id="qe-link-gallery" class="text-xs font-bold text-emerald-600 hover:underline">
							Cambiar imagen en editor completo &rarr;
						</a>
					</div>
				</div>
			</div>

			{/* Drawer Footer */}
			<div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between shrink-0">
				<button id="qe-cancel" class="text-xs font-bold text-slate-500 hover:text-slate-800 transition-colors px-4 py-2 cursor-pointer">
					Cancelar
				</button>
				<button id="qe-save" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition-colors shadow-md cursor-pointer">
					Guardar Cambios
				</button>
			</div>
		</div>

	</main>
</AdminLayout>

<script>
	import { exportProductsCsv } from '../../../lib/exports';
	import { actions } from 'astro:actions';

	const backdrop = document.getElementById('quick-edit-backdrop');
	const panel = document.getElementById('quick-edit-panel');
	const btnCloseQe = document.getElementById('qe-close');
	const btnCancelQe = document.getElementById('qe-cancel');
	const btnSaveQe = document.getElementById('qe-save') as HTMLButtonElement;
	
	let currentProductId = '';
	let isDirty = false;
	let initialValues: any = {};

	const markDirty = () => {
		isDirty = true;
	};

	// Attach dirty check listeners
	['qe-precio', 'qe-stock', 'qe-categoria', 'qe-destacado', 'qe-nuevo'].forEach(id => {
		const el = document.getElementById(id);
		el?.addEventListener('change', markDirty);
		el?.addEventListener('input', markDirty);
	});
	document.querySelectorAll('input[name="qe-estado"]').forEach(r => {
		r.addEventListener('change', markDirty);
	});

	const openPanel = (data: any) => {
		currentProductId = data.id;
		isDirty = false;

		const nombreEl = document.getElementById('qe-nombre');
		if (nombreEl) {
			nombreEl.innerText = data.nombre;
			nombreEl.title = data.nombre;
		}
		const skuEl = document.getElementById('qe-sku');
		if (skuEl) skuEl.innerText = data.sku;

		const imgEl = document.getElementById('qe-img') as HTMLImageElement;
		if (imgEl) imgEl.src = data.portada || '';
		const imgThumbEl = document.getElementById('qe-img-thumb') as HTMLImageElement;
		if (imgThumbEl) imgThumbEl.src = data.portada || '';

		const valPriceCents = parseInt(data.precio || '0', 10);
		const valPriceStr = (valPriceCents / 100).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		const precioEl = document.getElementById('qe-precio') as HTMLInputElement;
		if (precioEl) precioEl.value = valPriceStr;

		const stockEl = document.getElementById('qe-stock') as HTMLInputElement;
		if (stockEl) stockEl.value = data.stock.toString();

		const catEl = document.getElementById('qe-categoria') as HTMLSelectElement;
		if (catEl) catEl.value = data.categoria || '';

		const destacadoEl = document.getElementById('qe-destacado') as HTMLInputElement;
		if (destacadoEl) destacadoEl.checked = data.destacado === 'true';

		const nuevoEl = document.getElementById('qe-nuevo') as HTMLInputElement;
		if (nuevoEl) nuevoEl.checked = data.nuevo === 'true';

		const stateRadio = document.querySelector(`input[name="qe-estado"][value="${data.estado}"]`) as HTMLInputElement;
		if (stateRadio) stateRadio.checked = true;

		const fullLink = document.getElementById('qe-link-full') as HTMLAnchorElement;
		if (fullLink) fullLink.href = `/admin/catalogo/${data.id}`;
		const galLink = document.getElementById('qe-link-gallery') as HTMLAnchorElement;
		if (galLink) galLink.href = `/admin/catalogo/${data.id}#identidad`;

		// Scroll Lock
		document.body.classList.add('overflow-hidden');

		backdrop?.classList.remove('hidden');
		setTimeout(() => backdrop?.classList.remove('opacity-0'), 10);
		panel?.classList.remove('translate-x-full');

		// Auto Focus
		setTimeout(() => precioEl?.focus(), 150);
	};

	const safeClosePanel = () => {
		if (isDirty) {
			const confirmed = confirm('Tenés cambios sin guardar. ¿Deseás cerrar de todos modos?');
			if (!confirmed) return;
		}
		forceClosePanel();
	};

	const forceClosePanel = () => {
		document.body.classList.remove('overflow-hidden');
		panel?.classList.add('translate-x-full');
		backdrop?.classList.add('opacity-0');
		setTimeout(() => backdrop?.classList.add('hidden'), 300);
		isDirty = false;
	};

	document.querySelectorAll('.tr-product').forEach(tr => {
		tr.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('button, input, select, a')) return;
			const data = (e.currentTarget as HTMLElement).dataset;
			openPanel(data);
		});
	});

	// Criterio: tap en la tarjeta -> edición rápida (el drawer de arriba);
	// botón "Editar" -> editor completo. Los dos abrían el mismo drawer, así
	// que al editor completo sólo se llegaba desde adentro del panel.
	document.querySelectorAll('.btn-open-drawer').forEach(btn => {
		btn.addEventListener('click', (e) => {
			e.stopPropagation();
			const tr = (e.currentTarget as HTMLElement).closest('.tr-product') as HTMLElement;
			const id = tr?.dataset.id;
			if (id) window.location.href = `/admin/catalogo/${id}`;
		});
	});

	btnCloseQe?.addEventListener('click', safeClosePanel);
	btnCancelQe?.addEventListener('click', safeClosePanel);
	backdrop?.addEventListener('click', safeClosePanel);

	// Escape key shortcut
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !panel?.classList.contains('translate-x-full')) {
			safeClosePanel();
		}
	});

	// Quick Save Action
	btnSaveQe?.addEventListener('click', async () => {
		if (!currentProductId) return;

		const precioRaw = (document.getElementById('qe-precio') as HTMLInputElement).value
			.replace(/\./g, '')
			.replace(',', '.');
		const precioVal = parseFloat(precioRaw);
		if (isNaN(precioVal) || precioVal <= 0) {
			alert('El precio debe ser mayor a cero.');
			return;
		}
		const precioCents = Math.round(precioVal * 100);

		const stockVal = parseInt((document.getElementById('qe-stock') as HTMLInputElement).value, 10);
		if (isNaN(stockVal) || stockVal < 0) {
			alert('El stock no puede ser negativo.');
			return;
		}

		const estado = (document.querySelector('input[name="qe-estado"]:checked') as HTMLInputElement)?.value || 'borrador';
		const categoria_id = (document.getElementById('qe-categoria') as HTMLSelectElement)?.value || null;
		const destacado = (document.getElementById('qe-destacado') as HTMLInputElement)?.checked || false;
		const nuevoManual = (document.getElementById('qe-nuevo') as HTMLInputElement)?.checked || false;

		const originalText = btnSaveQe.innerText;
		btnSaveQe.disabled = true;
		btnSaveQe.innerText = 'Guardando...';

		// No se envía descripcion: el panel rápido no la edita, y mandarla
		// vacía la borraba en cada guardado.
		const nombreEditado = document.getElementById('qe-nombre')?.innerText?.trim();

		const { data, error } = await actions.updateProduct({
			id: currentProductId,
			...(nombreEditado ? { nombre: nombreEditado } : {}),
			precio: precioCents,
			stock: stockVal,
			estado: estado as any,
			categoria_id,
			destacado,
			es_nuevo_manual: nuevoManual
		});

		if (error || !data?.success) {
			alert('Error al guardar: ' + (error?.message || data?.error));
			btnSaveQe.disabled = false;
			btnSaveQe.innerText = originalText;
			return;
		}

		isDirty = false;
		window.location.reload();
	});

	// Table 3-State Dropdown Event Listener
	document.querySelectorAll('.select-state-table').forEach(select => {
		select.addEventListener('change', async (e) => {
			const target = e.currentTarget as HTMLSelectElement;
			const id = target.dataset.id;
			const newEstado = target.value;

			if (!id) return;
			target.disabled = true;

			// Sólo el estado: mandar nombre/precio/stock acá sobrescribía el
			// producto con valores inventados.
			const { data, error } = await actions.updateProduct({
				id,
				estado: newEstado as any
			});

			if (error || !data?.success) {
				alert('Error al cambiar el estado: ' + (error?.message || data?.error));
				window.location.reload();
				return;
			}
			window.location.reload();
		});
	});

	// Bulk Selection Logic
	const selectAllChk = document.getElementById('select-all-products') as HTMLInputElement;
	const bulkBar = document.getElementById('bulk-actions-bar');
	const bulkCount = document.getElementById('bulk-count');

	const updateBulkBar = () => {
		const selectedChks = document.querySelectorAll('.chk-product:checked');
		const count = selectedChks.length;
		if (count > 0) {
			if (bulkCount) bulkCount.innerText = count.toString();
			bulkBar?.classList.remove('hidden');
		} else {
			bulkBar?.classList.add('hidden');
		}
	};

	selectAllChk?.addEventListener('change', (e) => {
		const isChecked = (e.currentTarget as HTMLInputElement).checked;
		document.querySelectorAll('.chk-product').forEach(chk => {
			(chk as HTMLInputElement).checked = isChecked;
		});
		updateBulkBar();
	});

	document.querySelectorAll('.chk-product').forEach(chk => {
		chk.addEventListener('change', updateBulkBar);
	});

	const getSelectedIds = (): string[] => {
		const ids: string[] = [];
		document.querySelectorAll('.chk-product:checked').forEach(chk => {
			const id = (chk as HTMLElement).dataset.id;
			if (id) ids.push(id);
		});
		return ids;
	};

	// Bulk Actions Handlers
	document.getElementById('btn-bulk-activar')?.addEventListener('click', async () => {
		const ids = getSelectedIds();
		if (ids.length === 0) return;
		await actions.bulkUpdateProducts({ ids, accion: 'activar' });
		window.location.reload();
	});

	document.getElementById('btn-bulk-pausar')?.addEventListener('click', async () => {
		const ids = getSelectedIds();
		if (ids.length === 0) return;
		await actions.bulkUpdateProducts({ ids, accion: 'pausar' });
		window.location.reload();
	});

	document.getElementById('btn-bulk-eliminar')?.addEventListener('click', async () => {
		const ids = getSelectedIds();
		if (ids.length === 0) return;
		if (!confirm(`¿Estás seguro de eliminar ${ids.length} productos seleccionados?`)) return;
		await actions.bulkUpdateProducts({ ids, accion: 'eliminar' });
		window.location.reload();
	});

	document.getElementById('bulk-categoria-select')?.addEventListener('change', async (e) => {
		const target = e.currentTarget as HTMLSelectElement;
		const catId = target.value;
		const ids = getSelectedIds();
		if (!catId || ids.length === 0) return;
		await actions.bulkUpdateProducts({ ids, categoria_id: catId });
		window.location.reload();
	});

	// Single Export CSV Action
	document.getElementById('btn-export-csv')?.addEventListener('click', async () => {
		const res = await fetch('/api/products-raw.json');
		if (!res.ok) {
			alert('No se pudo exportar el catálogo. Intentá de nuevo.');
			return;
		}
		exportProductsCsv(await res.json());
	});

	// New Product Action
	document.getElementById('btn-nuevo-producto')?.addEventListener('click', async () => {
		const { data, error } = await actions.createProduct({
			nombre: 'Nuevo Producto ' + Math.floor(100 + Math.random()*900),
			tipo: 'simple'
		});
		if (error || !data?.success) {
			alert('Error al crear producto: ' + (error?.message || data?.error));
			return;
		}
		window.location.href = `/admin/catalogo?estado=borrador`;
	});
</script>
