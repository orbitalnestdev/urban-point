									<label class="block text-sm font-bold text-slate-900 mb-1">Peso del bulto</label>
									<div class="relative">
										<input type="number" step="0.01" id="input-peso-kg" placeholder="0.00" class="w-full pl-4 pr-12 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900" />
