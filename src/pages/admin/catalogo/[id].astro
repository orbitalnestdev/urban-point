				{/* Pestaña 4: Variantes / Personalización */}
				<div id="tab-variantes" class="tab-panel space-y-6 hidden">
					{tipoParam === 'variantes' && (
						<div class="bg-white border border-blue-200 rounded-2xl p-8 shadow-sm">
