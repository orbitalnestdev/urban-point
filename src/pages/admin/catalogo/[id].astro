									<label class="block text-sm font-bold text-slate-900 mb-1">Código de barras (EAN)</label>
									<input type="text" id="input-codigo-barras" placeholder="7790000000000" class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-mono text-slate-900" />
								</div>
							</div>

							<div>
								<label class="block text-sm font-bold text-slate-900 mb-2">Dimensiones del bulto</label>
								<div class="flex items-center gap-3">
									<div class="relative flex-1">
										<input type="number" id="input-dim-largo" placeholder="Largo" class="w-full px-3 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900 text-sm" />
