									</div>
									<span class="text-slate-400 font-bold">×</span>
									<div class="relative flex-1">
										<input type="number" id="input-dim-alto" placeholder="Alto" class="w-full px-3 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900 text-sm" />
									</div>
									<select id="input-dim-unit" class="px-3 py-2 border border-slate-200 rounded-xl bg-white text-slate-700 font-bold text-sm">
										<option value="cm">cm</option>
										<option value="mm">mm</option>
										<option value="m">m</option>
									</select>
								</div>
							</div>
						</div>
					</div>
				</div>

				{/* Pestaña 6: SEO */}
				<div id="tab-seo" class="tab-panel space-y-6 hidden">
					<div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm space-y-8">
						<div>
							<div class="mb-6 border-b border-slate-100 pb-4">
								<h2 class="text-lg font-bold text-slate-900">Buscadores y posicionamiento</h2>
								<p class="text-sm text-slate-500">Sobrescribí estos campos solo si querés afinar cómo aparece en Google.</p>
							</div>
							
							<div class="space-y-6">
								<div>
									<div class="flex items-center justify-between mb-1">
										<label class="block text-sm font-bold text-slate-900">Título SEO</label>
									</div>
									<input type="text" id="input-seo-titulo" placeholder={product.nombre} class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900" />
									<p class="text-[11px] text-slate-400 mt-1 font-medium">Hasta 60 caracteres. Si lo dejás vacío usamos el nombre del producto.</p>
								</div>

								<div>
									<div class="flex items-center justify-between mb-1">
										<label class="block text-sm font-bold text-slate-900">Meta Descripción</label>
									</div>
									<textarea id="input-seo-descripcion" rows="3" placeholder="Resumen que aparece debajo del título en los resultados" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900 resize-none"></textarea>
									<p class="text-[11px] text-slate-400 mt-1 font-medium">Hasta 160 caracteres. Si lo dejás vacío usamos la descripción del producto.</p>
								</div>

								<div class="flex items-center justify-between pt-4 border-t border-slate-100">
									<div>
										<p class="text-sm font-bold text-slate-900">Indexar en buscadores</p>
										<p class="text-[11px] text-slate-400 font-medium">Permitir que aparezca en Google y otros buscadores.</p>
									</div>
									<div class="flex items-center gap-2">
										<label class="relative inline-flex items-center cursor-pointer">
											<input type="checkbox" id="input-seo-indexar" class="sr-only peer" checked>
											<div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
										</label>
										<span class="text-xs font-bold text-emerald-700" id="label-seo-indexar">Sí - visible</span>
									</div>
								</div>
								
								<div>
									<label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1 mt-4">Slug URL</label>
									<input type="text" readonly value={product.slug} class="w-full px-4 py-2 border border-slate-200 rounded-xl bg-slate-50 font-mono text-xs text-slate-600" />
								</div>
							</div>
						</div>
						
						<div class="pt-8 border-t border-slate-100">
							<div class="mb-6 border-b border-slate-100 pb-4">
								<h2 class="text-lg font-bold text-slate-900">Orden manual</h2>
								<p class="text-sm text-slate-500">Configurá la prioridad de aparición de este producto.</p>
							</div>
							
							<div class="w-1/3 min-w-[150px]">
								<label class="block text-sm font-bold text-slate-900 mb-1">Posición de orden</label>
								<input type="number" id="input-seo-orden" placeholder="0" class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900" />
								<p class="text-[11px] text-slate-400 mt-1 font-medium">Números más bajos aparecen primero.</p>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>
		<div id="product-meta-data" data-product={JSON.stringify(product)} data-categories={JSON.stringify(categories)} data-settings={JSON.stringify(siteSettings)} data-combo={JSON.stringify(comboItems)}></div>
	</main>

	<script>
		import { actions } from 'astro:actions';

		// 1. Tab Switching Logic (Event Delegation - Guaranteed to work on child elements like div, svg, span!)
		document.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest('.tab-btn');
			if (!btn) return;
			e.preventDefault();

			const targetTab = btn.getAttribute('data-tab');
			if (!targetTab) return;

			const tabPanels = document.querySelectorAll('.tab-panel');
			const tabBtns = document.querySelectorAll('.tab-btn');

			tabPanels.forEach(panel => {
				if (panel.id === targetTab) {
					panel.classList.remove('hidden');
				} else {
					panel.classList.add('hidden');
				}
			});

			tabBtns.forEach(b => {
				b.classList.remove('bg-orange-50', 'border-orange-200', 'text-orange-900', 'shadow-xs');
				b.classList.add('border-transparent', 'text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
			});

			btn.classList.remove('border-transparent', 'text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
			btn.classList.add('bg-orange-50', 'border-orange-200', 'text-orange-900', 'shadow-xs');
		});

		// Dynamic Variant & Product Data Setup
		let initialProduct: any = {};
		try {
			const metaEl = document.getElementById('product-meta-data');
			initialProduct = JSON.parse(metaEl?.dataset.product || '{}');
		} catch(e) {}

		// Precio ya guardado por nivel (lo que hoy cobra el checkout), en pesos.
		// Sirve de fallback cuando no hay costo cargado: productos importados por
		// CSV traen estos campos pero costo en 0, y sin esto la pestaña mostraba
		// "Precio Calculado: $0" como si el producto no tuviera precio, cuando en
		// realidad sí lo tiene — solo que no se está calculando desde costo.
		const preciosGuardados: Record<string, number> = {
			distribuidor: Number(initialProduct.precio_distribuidor || 0) / 100,
			canillita: Number(initialProduct.precio_canillita || 0) / 100,
			publico: Number(initialProduct.precio || 0) / 100
		};

		// Load Envio Config
		let envioConfig: any = {};
		try {
			if (initialProduct.envio_config) {
				envioConfig = typeof initialProduct.envio_config === 'string' ? JSON.parse(initialProduct.envio_config) : initialProduct.envio_config;
			}
		} catch (e) {}
		
		const setVal = (id: string, val: any) => {
			const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
			if (el && val !== undefined && val !== null) el.value = val;
		};

		setVal('input-unidad-venta', envioConfig.unidad_venta);
		setVal('input-compra-minima', envioConfig.compra_minima);
		setVal('input-compra-maxima', envioConfig.compra_maxima);
		setVal('input-tamano-pack', envioConfig.tamano_pack);
		setVal('input-tamano-bulto', envioConfig.tamano_bulto);
		setVal('input-peso-kg', envioConfig.peso_kg);
		setVal('input-codigo-barras', envioConfig.codigo_barras);
		
		if (envioConfig.dimensiones) {
			setVal('input-dim-largo', envioConfig.dimensiones.largo);
			setVal('input-dim-ancho', envioConfig.dimensiones.ancho);
			setVal('input-dim-alto', envioConfig.dimensiones.alto);
			setVal('input-dim-unit', envioConfig.dimensiones.unit);
		}

		// Load SEO Config
		let seoConfig: any = {};
		try {
			if (initialProduct.seo_config) {
				seoConfig = typeof initialProduct.seo_config === 'string' ? JSON.parse(initialProduct.seo_config) : initialProduct.seo_config;
			}
		} catch (e) {}
		
		setVal('input-seo-titulo', seoConfig.titulo);
		setVal('input-seo-descripcion', seoConfig.descripcion);
		setVal('input-seo-orden', seoConfig.orden);
		
		const indexarCheckbox = document.getElementById('input-seo-indexar') as HTMLInputElement;
		const indexarLabel = document.getElementById('label-seo-indexar') as HTMLSpanElement;
		if (indexarCheckbox && seoConfig.indexar === false) {
			indexarCheckbox.checked = false;
			if (indexarLabel) {
				indexarLabel.innerText = 'No - oculto';
				indexarLabel.className = 'text-xs font-bold text-slate-500';
			}
		}
		
		indexarCheckbox?.addEventListener('change', (e) => {
			if (indexarLabel) {
				if ((e.target as HTMLInputElement).checked) {
					indexarLabel.innerText = 'Sí - visible';
					indexarLabel.className = 'text-xs font-bold text-emerald-700';
				} else {
					indexarLabel.innerText = 'No - oculto';
					indexarLabel.className = 'text-xs font-bold text-slate-500';
				}
			}
		});


		// --- Integrantes del combo ---------------------------------------
		// Se editan acá y viajan como JSON en combo_items al guardar. El nombre
		// se resuelve en el servidor: si un integrante ya no está en la tanda
		// que se trajo, se muestra su id en vez de ocultarlo.
		let comboItems: Array<{ product_id: string; cantidad: number; nombre: string }> = [];
		try {
			comboItems = JSON.parse(
				document.getElementById('product-meta-data')?.dataset.combo || '[]'
			);
		} catch (e) {
			comboItems = [];
		}

		const listaCombo = document.getElementById('combo-lista');

		const pintarCombo = () => {
			if (!listaCombo) return;
			listaCombo.innerHTML = '';

			if (comboItems.length === 0) {
				const vacio = document.createElement('p');
				vacio.className = 'text-xs text-slate-400 font-medium py-2';
				vacio.textContent = 'Todavía no agregaste productos a este combo.';
				listaCombo.appendChild(vacio);
				return;
			}

			comboItems.forEach((it, i) => {
				const fila = document.createElement('div');
				fila.className = 'flex items-center justify-between gap-3 px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl';

				const nombre = document.createElement('span');
				nombre.className = 'text-xs font-bold text-slate-800 truncate';
				nombre.textContent = it.nombre;

				const controles = document.createElement('div');
				controles.className = 'flex items-center gap-1.5 shrink-0';

				const menos = document.createElement('button');
				menos.type = 'button';
				menos.className = 'w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold text-xs cursor-pointer';
				menos.textContent = '−';
				menos.addEventListener('click', () => {
					comboItems[i].cantidad = Math.max(1, comboItems[i].cantidad - 1);
					pintarCombo();
				});

				const cant = document.createElement('span');
				cant.className = 'w-6 text-center text-xs font-extrabold text-slate-900 tabular-nums';
				cant.textContent = String(it.cantidad);

				const mas = document.createElement('button');
				mas.type = 'button';
				mas.className = 'w-6 h-6 rounded-lg bg-white border border-slate-200 text-slate-600 font-bold text-xs cursor-pointer';
				mas.textContent = '+';
				mas.addEventListener('click', () => {
					comboItems[i].cantidad += 1;
					pintarCombo();
				});

				const quitar = document.createElement('button');
				quitar.type = 'button';
				quitar.className = 'ml-1 text-slate-300 hover:text-rose-600 transition-colors cursor-pointer';
				quitar.title = 'Quitar del combo';
				quitar.textContent = '✕';
				quitar.addEventListener('click', () => {
					comboItems.splice(i, 1);
					pintarCombo();
				});

				controles.append(menos, cant, mas, quitar);
				fila.append(nombre, controles);
				listaCombo.appendChild(fila);
			});
		};

		pintarCombo();

		document.getElementById('combo-agregar')?.addEventListener('click', () => {
			const sel = document.getElementById('combo-select') as HTMLSelectElement | null;
			const id = sel?.value;
			if (!id) return;

			const yaEsta = comboItems.find((x) => x.product_id === id);
			if (yaEsta) {
				yaEsta.cantidad += 1;
			} else {
				comboItems.push({
					product_id: id,
					cantidad: 1,
					nombre: sel?.options[sel.selectedIndex]?.text || id
				});
			}
			if (sel) sel.value = '';
			pintarCombo();
		});

		// Multilevel Pricing Live Calculations
		const categoriesMap = new Map();
		try {
			const catResData = JSON.parse(document.getElementById('product-meta-data')?.dataset.categories || '[]');
			catResData.forEach((c: any) => categoriesMap.set(c.$id, c));
		} catch (e) {}

		let globalSettings = {
			default_markup_distribuidor: 6.25,
			default_markup_canillita: 12.5,
			default_markup_publico: 25.0,
			round_to: 0,
			round_mode: 'nearest'
		};
		try {
			const parsedSettings = JSON.parse(document.getElementById('product-meta-data')?.dataset.settings || '{}');
			if (parsedSettings) {
				globalSettings = {
					default_markup_distribuidor: Number(parsedSettings.default_markup_distribuidor ?? 6.25),
					default_markup_canillita: Number(parsedSettings.default_markup_canillita ?? 12.5),
					default_markup_publico: Number(parsedSettings.default_markup_publico ?? 25.0),
					round_to: Number(parsedSettings.round_to ?? 0),
					round_mode: parsedSettings.round_mode || 'nearest'
				};
			}
		} catch (e) {}

		const applyRounding = (exactPesos: number) => {
			if (!globalSettings.round_to || globalSettings.round_to <= 0) return exactPesos;
			const step = globalSettings.round_to;
			const ratio = exactPesos / step;
			let factor = Math.round(ratio);
			if (globalSettings.round_mode === 'up') factor = Math.ceil(ratio);
			if (globalSettings.round_mode === 'down') factor = Math.floor(ratio);
			return factor * step;
		};

		const updateLevelUI = (level: 'distribuidor' | 'canillita' | 'publico') => {
			const modeSelect = document.getElementById(`select-mode-${level}`) as HTMLSelectElement;
			const containerPercent = document.getElementById(`container-percent-${level}`);
			const containerFixed = document.getElementById(`container-fixed-${level}`);
			const badgeMode = document.getElementById(`badge-mode-${level}`);

			if (!modeSelect) return;
			const mode = modeSelect.value;

			if (mode === 'fixed') {
				containerPercent?.classList.add('hidden');
				containerFixed?.classList.remove('hidden');
				if (badgeMode) badgeMode.innerText = 'PRECIO FIJO MANUAL';
			} else if (mode === 'percent') {
				containerPercent?.classList.remove('hidden');
				containerFixed?.classList.add('hidden');
				if (badgeMode) badgeMode.innerText = 'OVERRIDE PORCENTAJE';
			} else {
				containerPercent?.classList.remove('hidden');
				containerFixed?.classList.add('hidden');
				if (badgeMode) badgeMode.innerText = 'HEREDADO (CATEGORÍA / GLOBAL)';
			}
		};

		['distribuidor', 'canillita', 'publico'].forEach((level: any) => {
			const sel = document.getElementById(`select-mode-${level}`);
			sel?.addEventListener('change', () => {
				updateLevelUI(level);
				calcMultilevelPrices();
			});
			document.getElementById(`input-percent-${level}`)?.addEventListener('input', calcMultilevelPrices);
			document.getElementById(`input-fixed-${level}`)?.addEventListener('input', calcMultilevelPrices);
			updateLevelUI(level);
		});

		document.getElementById('input-costo')?.addEventListener('input', calcMultilevelPrices);
		document.getElementById('input-categoria')?.addEventListener('change', calcMultilevelPrices);

		function calcMultilevelPrices() {
			const costArs = parseFloat((document.getElementById('input-costo') as HTMLInputElement)?.value || '0');
			const selectedCatId = (document.getElementById('input-categoria') as HTMLSelectElement)?.value;
			const categoryDoc = selectedCatId ? categoriesMap.get(selectedCatId) : null;

			// Cost badge status
			const badgeCosto = document.getElementById('badge-costo-status');
			if (badgeCosto) {
				if (costArs <= 0) {
					badgeCosto.className = 'px-3 py-1 bg-amber-100 text-amber-800 border border-amber-200 text-xs font-bold rounded-full flex items-center gap-1';
					badgeCosto.innerHTML = '⚠️ Sin costo cargado';
					badgeCosto.classList.remove('hidden');
				} else {
					badgeCosto.className = 'px-3 py-1 bg-emerald-100 text-emerald-800 border border-emerald-200 text-xs font-bold rounded-full flex items-center gap-1';
					badgeCosto.innerHTML = '✓ Costo Asignado';
					badgeCosto.classList.remove('hidden');
				}
			}

			const prices: Record<string, { exactPesos: number; roundedPesos: number; markupPct: number; gainPesos: number }> = {};

			['distribuidor', 'canillita', 'publico'].forEach((level) => {
				const mode = (document.getElementById(`select-mode-${level}`) as HTMLSelectElement)?.value || 'inherit';
				let exactPesos = 0;
				let roundedPesos = 0;
				let markupPct = 0;
				let esValorGuardado = false;

				if (mode === 'fixed') {
					const fixedVal = parseFloat((document.getElementById(`input-fixed-${level}`) as HTMLInputElement)?.value || '0');
					exactPesos = fixedVal;
					roundedPesos = applyRounding(exactPesos);
					markupPct = costArs > 0 ? ((roundedPesos - costArs) / costArs) * 100 : 0;
				} else if (costArs > 0) {
					if (mode === 'percent') {
						const inputPct = parseFloat((document.getElementById(`input-percent-${level}`) as HTMLInputElement)?.value || '');
						if (Number.isFinite(inputPct)) {
							markupPct = inputPct;
						}
					}

					if (markupPct === 0 && mode === 'inherit') {
						const catKey = `markup_${level}`;
						if (categoryDoc && categoryDoc[catKey] !== undefined && categoryDoc[catKey] !== null) {
							markupPct = parseFloat(categoryDoc[catKey]);
						} else {
							markupPct = (globalSettings as any)[`default_markup_${level}`] || 0;
						}
					}

					exactPesos = costArs * (1 + markupPct / 100);
					roundedPesos = applyRounding(exactPesos);
				} else {
					// Sin costo no hay nada para calcular. Antes esto quedaba en $0,
					// como si el producto no tuviera precio — se muestra el que ya
					// está guardado (el que de verdad se cobra) en su lugar.
					roundedPesos = preciosGuardados[level] || 0;
					exactPesos = roundedPesos;
					esValorGuardado = roundedPesos > 0;
				}

				const gainPesos = costArs > 0 ? (roundedPesos - costArs) : 0;
				const realMarginPct = roundedPesos > 0 && costArs > 0 ? ((roundedPesos - costArs) / roundedPesos) * 100 : 0;
				prices[level] = { exactPesos, roundedPesos, markupPct, gainPesos };

				// Update UI Labels
				const lblPrice = document.getElementById(`lbl-price-${level}`);
				const lblMarkup = document.getElementById(`lbl-markup-${level}`);
				const lblMargin = document.getElementById(`lbl-margin-${level}`);
				const lblGain = document.getElementById(`lbl-gain-${level}`);
				const lblSource = document.getElementById(`lbl-price-source-${level}`);

				if (lblPrice) lblPrice.innerText = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(roundedPesos);
				if (lblMarkup) lblMarkup.innerText = esValorGuardado ? '—' : `${markupPct.toFixed(1)}%`;
				if (lblMargin) lblMargin.innerText = esValorGuardado ? '—' : `${realMarginPct.toFixed(1)}%`;
				if (lblGain) lblGain.innerText = esValorGuardado ? '—' : new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(gainPesos);
				lblSource?.classList.toggle('hidden', !esValorGuardado);
			});

			// Hierarchy Validation Alerts
			const alertBox = document.getElementById('pricing-hierarchy-alert');
			if (alertBox) {
				const pDist = prices['distribuidor']?.roundedPesos || 0;
				const pCani = prices['canillita']?.roundedPesos || 0;
				const pPub = prices['publico']?.roundedPesos || 0;

				let alertHtml = '';
				if (costArs <= 0) {
					alertHtml = `<div class="bg-amber-50 text-amber-800 border-amber-200 border p-3 rounded-xl">⚠️ <strong>Atención:</strong> El producto no tiene costo asignado. Se recomienda ingresar el costo real para automatizar los precios de venta derivados.</div>`;
				} else if (pDist > pCani || pCani > pPub) {
					alertHtml = `<div class="bg-amber-50 text-amber-800 border-amber-200 border p-3 rounded-xl">⚠️ <strong>Inconsistencia en Escala de Precios:</strong> Se detectó que un nivel inferior es mayor que un nivel superior (Valores: Distribuidor $${pDist} | Canillita $${pCani} | Público $${pPub}). Verificar la jerarquía de markups.</div>`;
				} else if (pDist < costArs || pCani < costArs || pPub < costArs) {
					alertHtml = `<div class="bg-rose-50 text-rose-800 border-rose-200 border p-3 rounded-xl">🚫 <strong>Precio Bajo Costo:</strong> Uno o más niveles de precio están por debajo del costo de compra ($${costArs}).</div>`;
				}

				if (alertHtml) {
					alertBox.innerHTML = alertHtml;
					alertBox.classList.remove('hidden');
				} else {
					alertBox.innerHTML = '';
					alertBox.classList.add('hidden');
				}
			}
		}

		calcMultilevelPrices();

		document.getElementById('btn-guardar-producto')?.addEventListener('click', async (e) => {
			const btn = e.currentTarget as HTMLButtonElement;
			const productId = btn.dataset.productId;
			if (!productId) return;

			const nombre = (document.getElementById('input-nombre') as HTMLInputElement)?.value;
			const marca = (document.getElementById('input-marca') as HTMLInputElement)?.value;
			const grupo = (document.getElementById('input-grupo') as HTMLInputElement)?.value?.trim() || '';
			const descripcion = (document.getElementById('input-descripcion') as HTMLTextAreaElement)?.value;
			
			const costoArs = parseFloat((document.getElementById('input-costo') as HTMLInputElement)?.value || '0');
			const precioPromocionalArs = parseFloat((document.getElementById('input-precio-promocional') as HTMLInputElement)?.value || '0');

			const distMode = (document.getElementById('select-mode-distribuidor') as HTMLSelectElement)?.value;
			const distPercent = parseFloat((document.getElementById('input-percent-distribuidor') as HTMLInputElement)?.value || '');
			const distFixedArs = parseFloat((document.getElementById('input-fixed-distribuidor') as HTMLInputElement)?.value || '');

			const caniMode = (document.getElementById('select-mode-canillita') as HTMLSelectElement)?.value;
			const caniPercent = parseFloat((document.getElementById('input-percent-canillita') as HTMLInputElement)?.value || '');
			const caniFixedArs = parseFloat((document.getElementById('input-fixed-canillita') as HTMLInputElement)?.value || '');

			const pubMode = (document.getElementById('select-mode-publico') as HTMLSelectElement)?.value;
			const pubPercent = parseFloat((document.getElementById('input-percent-publico') as HTMLInputElement)?.value || '');
			const pubFixedArs = parseFloat((document.getElementById('input-fixed-publico') as HTMLInputElement)?.value || '');

			const stock = parseInt((document.getElementById('input-stock') as HTMLInputElement)?.value || '0', 10);
			const stockMaximo = parseInt((document.getElementById('input-stock-maximo') as HTMLInputElement)?.value || '0', 10);
			const nivelReorden = parseInt((document.getElementById('input-nivel-reorden') as HTMLInputElement)?.value || '0', 10);
			const tiempoReposicion = parseInt((document.getElementById('input-tiempo-reposicion') as HTMLInputElement)?.value || '0', 10);
			
			const estado = (document.getElementById('input-estado') as HTMLSelectElement)?.value as any;
			const categoriaId = (document.getElementById('input-categoria') as HTMLSelectElement)?.value;

			const envioConfig = {
				unidad_venta: (document.getElementById('input-unidad-venta') as HTMLSelectElement)?.value || 'unidad',
				compra_minima: (document.getElementById('input-compra-minima') as HTMLInputElement)?.value || '',
				compra_maxima: (document.getElementById('input-compra-maxima') as HTMLInputElement)?.value || '',
				tamano_pack: (document.getElementById('input-tamano-pack') as HTMLInputElement)?.value || '',
				tamano_bulto: (document.getElementById('input-tamano-bulto') as HTMLInputElement)?.value || '',
				peso_kg: (document.getElementById('input-peso-kg') as HTMLInputElement)?.value || '',
				codigo_barras: (document.getElementById('input-codigo-barras') as HTMLInputElement)?.value || '',
				dimensiones: {
					largo: (document.getElementById('input-dim-largo') as HTMLInputElement)?.value || '',
					ancho: (document.getElementById('input-dim-ancho') as HTMLInputElement)?.value || '',
					alto: (document.getElementById('input-dim-alto') as HTMLInputElement)?.value || '',
					unit: (document.getElementById('input-dim-unit') as HTMLSelectElement)?.value || 'cm'
				}
			};

			const seoConfig = {
				titulo: (document.getElementById('input-seo-titulo') as HTMLInputElement)?.value || '',
				descripcion: (document.getElementById('input-seo-descripcion') as HTMLTextAreaElement)?.value || '',
				indexar: (document.getElementById('input-seo-indexar') as HTMLInputElement)?.checked,
				orden: parseInt((document.getElementById('input-seo-orden') as HTMLInputElement)?.value || '0', 10)
			};

			const variantRows = document.querySelectorAll('.variant-row');
			const updatedVariants: any[] = [];
			variantRows.forEach(row => {
				const opcion = (row.querySelector('.var-opcion') as HTMLInputElement)?.value || '';
				const sku = (row.querySelector('.var-sku') as HTMLInputElement)?.value || '';
				const vStock = parseInt((row.querySelector('.var-stock') as HTMLInputElement)?.value || '0', 10);
				updatedVariants.push({ opcion, sku, stock: vStock });
			});

			if (!nombre) {
				alert('El nombre es obligatorio.');
				return;
			}

			btn.disabled = true;
			btn.innerText = 'Guardando...';

			let finalStock = Math.max(0, stock);
			if (updatedVariants.length > 0) {
				const sumStock = updatedVariants.reduce((acc, curr) => acc + (curr.stock || 0), 0);
				if (sumStock > 0) finalStock = sumStock;
			}

			try {
				const { data, error } = await actions.updateProduct({
					id: productId,
					nombre,
					marca,
					grupo,
					combo_items: JSON.stringify(comboItems.map(({ product_id, cantidad }) => ({ product_id, cantidad }))),
					descripcion,
					cost: Math.round(costoArs * 100),
					costo: Math.round(costoArs * 100),

					distribuidor_mode: distMode as any,
					distribuidor_percent: Number.isFinite(distPercent) ? distPercent : null,
					distribuidor_fixed_price: Number.isFinite(distFixedArs) ? Math.round(distFixedArs * 100) : null,

					canillita_mode: caniMode as any,
					canillita_percent: Number.isFinite(caniPercent) ? caniPercent : null,
					canillita_fixed_price: Number.isFinite(caniFixedArs) ? Math.round(caniFixedArs * 100) : null,

					publico_mode: pubMode as any,
					publico_percent: Number.isFinite(pubPercent) ? pubPercent : null,
					publico_fixed_price: Number.isFinite(pubFixedArs) ? Math.round(pubFixedArs * 100) : null,

					precio_promocional: precioPromocionalArs > 0 ? Math.round(precioPromocionalArs * 100) : 0,

					stock: finalStock,
					stock_maximo: stockMaximo,
					nivel_reorden: nivelReorden,
					tiempo_reposicion: tiempoReposicion,
					envio_config: JSON.stringify(envioConfig),
					seo_config: JSON.stringify(seoConfig),
					portada_url: (currentPortadaUrl && currentPortadaUrl.trim()) ? currentPortadaUrl.trim() : undefined,

					galeria_urls: JSON.stringify(currentGaleriaUrls),
					estado,
					categoria_id: categoriaId
				});

				if (error || !data?.success) {
					alert('Error al guardar el producto: ' + (error?.message || data?.error));
					btn.disabled = false;
					btn.innerText = 'Guardar Cambios';
					return;
				}

				alert('¡Producto guardado exitosamente con sus precios multinivel!');
				window.location.reload();
			} catch (err: any) {
				alert('Error al guardar: ' + err.message);
				btn.disabled = false;
				btn.innerText = 'Guardar Cambios';
			}
		});

		let currentPortadaUrl = initialProduct.portada_url || '';
		let currentGaleriaUrls: string[] = initialProduct.galeria_urls ? (typeof initialProduct.galeria_urls === 'string' ? JSON.parse(initialProduct.galeria_urls) : initialProduct.galeria_urls) : [];

		const filePortada = document.getElementById('input-file-portada') as HTMLInputElement;
		const fileGaleria = document.getElementById('input-file-galeria') as HTMLInputElement;
		const btnUploadPortada = document.getElementById('btn-upload-portada');
		const btnUploadGaleria = document.getElementById('btn-upload-galeria');
		const imgPortadaPreview = document.getElementById('img-portada-preview') as HTMLImageElement;
		const portadaPlaceholder = document.getElementById('portada-placeholder');

		if (btnUploadPortada && filePortada) {
			btnUploadPortada.addEventListener('click', () => filePortada.click());
			filePortada.addEventListener('change', async () => {
				if (filePortada.files && filePortada.files[0]) {
					const formData = new FormData();
					formData.append('file', filePortada.files[0]);
					try {
						const res = await fetch('/api/upload-image', { method: 'POST', body: formData });
						const json = await res.json();
						if (json.success && json.url) {
							currentPortadaUrl = json.url;
							if (imgPortadaPreview) {
								imgPortadaPreview.src = json.url;
								imgPortadaPreview.classList.remove('hidden');
							}
							if (portadaPlaceholder) portadaPlaceholder.classList.add('hidden');
						} else {
							alert('Error subiendo imagen: ' + (json.error || 'Intente nuevamente'));
						}
					} catch(e) {
						alert('Error de conexión al subir imagen');
					}
				}
			});
		}

		if (btnUploadGaleria && fileGaleria) {
			btnUploadGaleria.addEventListener('click', () => fileGaleria.click());
			fileGaleria.addEventListener('change', async () => {
				if (fileGaleria.files && fileGaleria.files[0]) {
					const formData = new FormData();
					formData.append('file', fileGaleria.files[0]);
					try {
						const res = await fetch('/api/upload-image', { method: 'POST', body: formData });
						const json = await res.json();
						if (json.success && json.url) {
							currentGaleriaUrls.push(json.url);
							renderGallery();
						} else {
							alert('Error subiendo foto de galería');
						}
					} catch(e) {
						alert('Error al subir foto');
					}
				}
			});
		}

		function renderGallery() {
			const list = document.getElementById('gallery-list');
			if (!list) return;
			let html = '';
			currentGaleriaUrls.forEach((url, idx) => {
				html += `
					<div class="aspect-square rounded-2xl border border-slate-200 overflow-hidden relative group bg-slate-50 p-1 flex items-center justify-center gallery-item" data-url="${url}">
						<img src="${url}" class="w-full h-full object-contain" />
						<button 
							type="button" 
							data-idx="${idx}"
							class="btn-delete-galeria absolute top-2 right-2 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold shadow-md opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer"
						>
							×
						</button>
					</div>
				`;
			});
			html += `
				<div 
					id="btn-upload-galeria" 
					class="aspect-square rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-center p-2 hover:bg-slate-50 hover:border-indigo-400 transition-colors cursor-pointer group"
				>
					<span class="text-2xl text-slate-300 group-hover:text-indigo-500 font-bold">+</span>
					<span class="text-[10px] font-bold text-slate-500">Agregar foto</span>
				</div>
			`;
			list.innerHTML = html;
			
			const newBtn = document.getElementById('btn-upload-galeria');
			if (newBtn && fileGaleria) newBtn.addEventListener('click', () => fileGaleria.click());

			list.querySelectorAll('.btn-delete-galeria').forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
					currentGaleriaUrls.splice(idx, 1);
					renderGallery();
				});
			});
		}

		document.querySelectorAll('.btn-delete-galeria').forEach((btn, idx) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				currentGaleriaUrls.splice(idx, 1);
				renderGallery();
			});
		});
	</script>
</AdminLayout>
