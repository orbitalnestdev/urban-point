				{/* Pestaña 6: SEO */}
				<div id="tab-seo" class="tab-panel space-y-6 hidden">
					<div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm space-y-8">
						<div>
							<div class="mb-6 border-b border-slate-100 pb-4">
								<h2 class="text-lg font-bold text-slate-900">Buscadores y posicionamiento</h2>
								<p class="text-sm text-slate-500">Sobrescribí estos campos solo si querés afinar cómo aparece en Google.</p>
							</div>
							
							<div class="space-y-6">
								<div>
									<div class="flex items-center justify-between mb-1">
										<label class="block text-sm font-bold text-slate-900">Título SEO</label>
									</div>
									<input type="text" id="input-seo-titulo" placeholder={product.nombre} class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900" />
									<p class="text-[11px] text-slate-400 mt-1 font-medium">Hasta 60 caracteres. Si lo dejás vacío usamos el nombre del producto.</p>
								</div>

								<div>
									<div class="flex items-center justify-between mb-1">
										<label class="block text-sm font-bold text-slate-900">Meta Descripción</label>
									</div>
									<textarea id="input-seo-descripcion" rows="3" placeholder="Resumen que aparece debajo del título en los resultados" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900 resize-none"></textarea>
									<p class="text-[11px] text-slate-400 mt-1 font-medium">Hasta 160 caracteres. Si lo dejás vacío usamos la descripción del producto.</p>
								</div>

								<div class="flex items-center justify-between pt-4 border-t border-slate-100">
									<div>
										<p class="text-sm font-bold text-slate-900">Indexar en buscadores</p>
										<p class="text-[11px] text-slate-400 font-medium">Permitir que aparezca en Google y otros buscadores.</p>
									</div>
									<div class="flex items-center gap-2">
										<label class="relative inline-flex items-center cursor-pointer">
											<input type="checkbox" id="input-seo-indexar" class="sr-only peer" checked>
											<div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
										</label>
										<span class="text-xs font-bold text-emerald-700" id="label-seo-indexar">Sí - visible</span>
									</div>
								</div>
								
								<div>
									<label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1 mt-4">Slug URL</label>
									<input type="text" readonly value={product.slug} class="w-full px-4 py-2 border border-slate-200 rounded-xl bg-slate-50 font-mono text-xs text-slate-600" />
								</div>
							</div>
						</div>
						
						<div class="pt-8 border-t border-slate-100">
							<div class="mb-6 border-b border-slate-100 pb-4">
								<h2 class="text-lg font-bold text-slate-900">Orden manual</h2>
								<p class="text-sm text-slate-500">Configurá la prioridad de aparición de este producto.</p>
							</div>
							
							<div class="w-1/3 min-w-[150px]">
								<label class="block text-sm font-bold text-slate-900 mb-1">Posición de orden</label>
								<input type="number" id="input-seo-orden" placeholder="0" class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900" />
								<p class="text-[11px] text-slate-400 mt-1 font-medium">Números más bajos aparecen primero.</p>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>
		<div id="product-meta-data" data-product={JSON.stringify(product)}></div>
	</main>

	<script>
		import { actions } from 'astro:actions';

		// 1. Tab Switching Logic (Event Delegation - Guaranteed to work on child elements like div, svg, span!)
		document.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest('.tab-btn');
			if (!btn) return;
			e.preventDefault();

			const targetTab = btn.getAttribute('data-tab');
			if (!targetTab) return;

			const tabPanels = document.querySelectorAll('.tab-panel');
			const tabBtns = document.querySelectorAll('.tab-btn');

			tabPanels.forEach(panel => {
				if (panel.id === targetTab) {
					panel.classList.remove('hidden');
				} else {
					panel.classList.add('hidden');
				}
			});

			tabBtns.forEach(b => {
				b.classList.remove('bg-orange-50', 'border-orange-200', 'text-orange-900', 'shadow-xs');
				b.classList.add('border-transparent', 'text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
			});

			btn.classList.remove('border-transparent', 'text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
			btn.classList.add('bg-orange-50', 'border-orange-200', 'text-orange-900', 'shadow-xs');
		});

		// Dynamic Variant & Product Data Setup
		let initialProduct: any = {};
		try {
			const metaEl = document.getElementById('product-meta-data');
			initialProduct = JSON.parse(metaEl?.dataset.product || '{}');
		} catch(e) {}
		
		// Load Envio Config
		let envioConfig: any = {};
		try {
			if (initialProduct.envio_config) {
				envioConfig = typeof initialProduct.envio_config === 'string' ? JSON.parse(initialProduct.envio_config) : initialProduct.envio_config;
			}
		} catch (e) {}
		
		const setVal = (id: string, val: any) => {
			const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
			if (el && val !== undefined && val !== null) el.value = val;
		};

		setVal('input-unidad-venta', envioConfig.unidad_venta);
		setVal('input-compra-minima', envioConfig.compra_minima);
		setVal('input-compra-maxima', envioConfig.compra_maxima);
		setVal('input-tamano-pack', envioConfig.tamano_pack);
		setVal('input-tamano-bulto', envioConfig.tamano_bulto);
		setVal('input-peso-kg', envioConfig.peso_kg);
		setVal('input-codigo-barras', envioConfig.codigo_barras);
		
		if (envioConfig.dimensiones) {
			setVal('input-dim-largo', envioConfig.dimensiones.largo);
			setVal('input-dim-ancho', envioConfig.dimensiones.ancho);
			setVal('input-dim-alto', envioConfig.dimensiones.alto);
			setVal('input-dim-unit', envioConfig.dimensiones.unit);
		}

		// Load SEO Config
		let seoConfig: any = {};
		try {
			if (initialProduct.seo_config) {
				seoConfig = typeof initialProduct.seo_config === 'string' ? JSON.parse(initialProduct.seo_config) : initialProduct.seo_config;
			}
		} catch (e) {}
		
		setVal('input-seo-titulo', seoConfig.titulo);
		setVal('input-seo-descripcion', seoConfig.descripcion);
		setVal('input-seo-orden', seoConfig.orden);
		
		const indexarCheckbox = document.getElementById('input-seo-indexar') as HTMLInputElement;
		const indexarLabel = document.getElementById('label-seo-indexar') as HTMLSpanElement;
		if (indexarCheckbox && seoConfig.indexar === false) {
			indexarCheckbox.checked = false;
			if (indexarLabel) {
				indexarLabel.innerText = 'No - oculto';
				indexarLabel.className = 'text-xs font-bold text-slate-500';
			}
		}
		
		indexarCheckbox?.addEventListener('change', (e) => {
			if (indexarLabel) {
				if ((e.target as HTMLInputElement).checked) {
					indexarLabel.innerText = 'Sí - visible';
					indexarLabel.className = 'text-xs font-bold text-emerald-700';
				} else {
					indexarLabel.innerText = 'No - oculto';
					indexarLabel.className = 'text-xs font-bold text-slate-500';
				}
			}
		});

		let currentVariants: any[] = [];
		try {
			if (initialProduct.variantes) {
				currentVariants = typeof initialProduct.variantes === 'string' ? JSON.parse(initialProduct.variantes) : initialProduct.variantes;
			}
		} catch (e) {
			currentVariants = [];
		}

		if (!Array.isArray(currentVariants) || currentVariants.length === 0) {
			currentVariants = [
				{ opcion: 'S / Estándar', sku: `${initialProduct.sku || 'SKU'}-S`, stock: 10, precio: (initialProduct.precio || 0) / 100 },
				{ opcion: 'M / Estándar', sku: `${initialProduct.sku || 'SKU'}-M`, stock: 15, precio: (initialProduct.precio || 0) / 100 },
				{ opcion: 'L / Estándar', sku: `${initialProduct.sku || 'SKU'}-L`, stock: 8, precio: (initialProduct.precio || 0) / 100 }
			];
		}

		const renderVariants = () => {
			const container = document.getElementById('lista-variantes');
			if (!container) return;

			container.innerHTML = '';
			currentVariants.forEach((v, index) => {
				const row = document.createElement('div');
				row.className = 'p-4 border border-slate-200 rounded-xl bg-slate-50 grid grid-cols-1 sm:grid-cols-4 gap-4 items-center variant-row';
				row.innerHTML = `
					<div>
						<label class="block text-xs font-bold text-slate-500 mb-1">Talle / Opción</label>
						<input type="text" value="${v.opcion || ''}" class="var-opcion w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-800" />
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-500 mb-1">SKU Variante</label>
						<input type="text" value="${v.sku || ''}" class="var-sku w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm font-mono text-slate-600" />
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-500 mb-1">Stock Indiv.</label>
						<input type="number" value="${v.stock || 0}" class="var-stock w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-800" />
					</div>
					<div class="flex items-end justify-end pb-1 h-full">
						<button type="button" class="btn-remove-variant text-rose-500 hover:text-rose-700 hover:bg-rose-50 p-1.5 rounded transition-colors" data-index="${index}">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
						</button>
					</div>
				`;
				container.appendChild(row);
			});

			document.querySelectorAll('.btn-remove-variant').forEach(btn => {
				btn.addEventListener('click', (e) => {
					const index = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
					currentVariants.splice(index, 1);
					renderVariants();
				});
			});
		};

		renderVariants();

		document.getElementById('btn-agregar-variante')?.addEventListener('click', () => {
			currentVariants.push({
				opcion: 'Nueva Opción',
				sku: `${initialProduct.sku || 'SKU'}-VAR-${currentVariants.length + 1}`,
				stock: 10,
				precio: (initialProduct.precio || 0) / 100
			});
			renderVariants();
		});

		const calcMargin = () => {
			const precio = parseFloat((document.getElementById('input-precio-ars') as HTMLInputElement)?.value || '0');
			const costo = parseFloat((document.getElementById('input-costo') as HTMLInputElement)?.value || '0');
			const labelMargen = document.getElementById('label-margen');
			const labelGanancia = document.getElementById('label-ganancia');

			const ganancia = precio - costo;
			if (labelGanancia) {
				labelGanancia.innerText = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(Math.max(0, ganancia));
			}

			if (labelMargen) {
				if (costo > 0 && precio > 0) {
					const margin = ((precio - costo) / costo) * 100;
					labelMargen.innerText = margin.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
				} else {
					labelMargen.innerText = '0,0 %';
				}
			}
		};

		document.getElementById('input-precio-ars')?.addEventListener('input', calcMargin);
		document.getElementById('input-costo')?.addEventListener('input', calcMargin);
		calcMargin();

		document.getElementById('btn-guardar-producto')?.addEventListener('click', async (e) => {
			const btn = e.currentTarget as HTMLButtonElement;
			const productId = btn.dataset.productId;
			if (!productId) return;

			const nombre = (document.getElementById('input-nombre') as HTMLInputElement)?.value;
			const marca = (document.getElementById('input-marca') as HTMLInputElement)?.value;
			const descripcion = (document.getElementById('input-descripcion') as HTMLTextAreaElement)?.value;
			const precioArs = parseFloat((document.getElementById('input-precio-ars') as HTMLInputElement)?.value || '0');
			const precioPromocionalArs = parseFloat((document.getElementById('input-precio-promocional') as HTMLInputElement)?.value || '0');
			const precioDistribuidorArs = parseFloat((document.getElementById('input-precio-distribuidor') as HTMLInputElement)?.value || '0');
			const precioCanillitaArs = parseFloat((document.getElementById('input-precio-canillita') as HTMLInputElement)?.value || '0');
			const costoArs = parseFloat((document.getElementById('input-costo') as HTMLInputElement)?.value || '0');
			
			const stock = parseInt((document.getElementById('input-stock') as HTMLInputElement)?.value || '0', 10);
			const stockMaximo = parseInt((document.getElementById('input-stock-maximo') as HTMLInputElement)?.value || '0', 10);
			const nivelReorden = parseInt((document.getElementById('input-nivel-reorden') as HTMLInputElement)?.value || '0', 10);
			const tiempoReposicion = parseInt((document.getElementById('input-tiempo-reposicion') as HTMLInputElement)?.value || '0', 10);
			
			const estado = (document.getElementById('input-estado') as HTMLSelectElement)?.value as any;
			const categoriaId = (document.getElementById('input-categoria') as HTMLSelectElement)?.value;

			const envioConfig = {
				unidad_venta: (document.getElementById('input-unidad-venta') as HTMLSelectElement)?.value || 'unidad',
				compra_minima: (document.getElementById('input-compra-minima') as HTMLInputElement)?.value || '',
				compra_maxima: (document.getElementById('input-compra-maxima') as HTMLInputElement)?.value || '',
				tamano_pack: (document.getElementById('input-tamano-pack') as HTMLInputElement)?.value || '',
				tamano_bulto: (document.getElementById('input-tamano-bulto') as HTMLInputElement)?.value || '',
				peso_kg: (document.getElementById('input-peso-kg') as HTMLInputElement)?.value || '',
				codigo_barras: (document.getElementById('input-codigo-barras') as HTMLInputElement)?.value || '',
				dimensiones: {
					largo: (document.getElementById('input-dim-largo') as HTMLInputElement)?.value || '',
					ancho: (document.getElementById('input-dim-ancho') as HTMLInputElement)?.value || '',
					alto: (document.getElementById('input-dim-alto') as HTMLInputElement)?.value || '',
					unit: (document.getElementById('input-dim-unit') as HTMLSelectElement)?.value || 'cm'
				}
			};

			const seoConfig = {
				titulo: (document.getElementById('input-seo-titulo') as HTMLInputElement)?.value || '',
				descripcion: (document.getElementById('input-seo-descripcion') as HTMLTextAreaElement)?.value || '',
				indexar: (document.getElementById('input-seo-indexar') as HTMLInputElement)?.checked,
				orden: parseInt((document.getElementById('input-seo-orden') as HTMLInputElement)?.value || '0', 10)
			};

			const variantRows = document.querySelectorAll('.variant-row');
			const updatedVariants: any[] = [];
			variantRows.forEach(row => {
				const opcion = (row.querySelector('.var-opcion') as HTMLInputElement)?.value || '';
				const sku = (row.querySelector('.var-sku') as HTMLInputElement)?.value || '';
				const vStock = parseInt((row.querySelector('.var-stock') as HTMLInputElement)?.value || '0', 10);
				updatedVariants.push({ opcion, sku, stock: vStock, precio: precioArs });
			});

			if (!nombre) {
				alert('El nombre es obligatorio.');
				return;
			}

			btn.disabled = true;
			btn.innerText = 'Guardando...';

			let finalStock = Math.max(0, stock);
			if (updatedVariants.length > 0) {
				const sumStock = updatedVariants.reduce((acc, curr) => acc + (curr.stock || 0), 0);
				if (sumStock > 0) finalStock = sumStock;
			}

			try {
				const { data, error } = await actions.updateProduct({
					id: productId,
					nombre,
					marca,
					descripcion,
					precio: Math.round(precioArs * 100),
					precio_promocional: (precioPromocionalArs > 0 && precioPromocionalArs < precioArs) ? Math.round(precioPromocionalArs * 100) : 0,

					precio_distribuidor: Math.round(precioDistribuidorArs * 100),
					precio_canillita: Math.round(precioCanillitaArs * 100),
					costo: Math.round(costoArs * 100),
					stock: finalStock,
					stock_maximo: stockMaximo,
					nivel_reorden: nivelReorden,
					tiempo_reposicion: tiempoReposicion,
					envio_config: JSON.stringify(envioConfig),
					seo_config: JSON.stringify(seoConfig),
					portada_url: (currentPortadaUrl && currentPortadaUrl.trim()) ? currentPortadaUrl.trim() : undefined,

					galeria_urls: JSON.stringify(currentGaleriaUrls),
					estado,
					categoria_id: categoriaId
				});

				if (error || !data?.success) {
					alert('Error al guardar el producto: ' + (error?.message || data?.error));
					btn.disabled = false;
					btn.innerText = 'Guardar Cambios';
					return;
				}

				alert('¡Producto guardado exitosamente!');
				window.location.reload();
			} catch (err: any) {
				alert('Error al guardar: ' + err.message);
				btn.disabled = false;
				btn.innerText = 'Guardar Cambios';
			}
		});

		let currentPortadaUrl = initialProduct.portada_url || '';
		let currentGaleriaUrls: string[] = initialProduct.galeria_urls ? (typeof initialProduct.galeria_urls === 'string' ? JSON.parse(initialProduct.galeria_urls) : initialProduct.galeria_urls) : [];

		const filePortada = document.getElementById('input-file-portada') as HTMLInputElement;
		const fileGaleria = document.getElementById('input-file-galeria') as HTMLInputElement;
		const btnUploadPortada = document.getElementById('btn-upload-portada');
		const btnUploadGaleria = document.getElementById('btn-upload-galeria');
		const imgPortadaPreview = document.getElementById('img-portada-preview') as HTMLImageElement;
		const portadaPlaceholder = document.getElementById('portada-placeholder');

		if (btnUploadPortada && filePortada) {
			btnUploadPortada.addEventListener('click', () => filePortada.click());
			filePortada.addEventListener('change', async () => {
				if (filePortada.files && filePortada.files[0]) {
					const formData = new FormData();
					formData.append('file', filePortada.files[0]);
					try {
						const res = await fetch('/api/upload-image', { method: 'POST', body: formData });
						const json = await res.json();
						if (json.success && json.url) {
							currentPortadaUrl = json.url;
							if (imgPortadaPreview) {
								imgPortadaPreview.src = json.url;
								imgPortadaPreview.classList.remove('hidden');
							}
							if (portadaPlaceholder) portadaPlaceholder.classList.add('hidden');
						} else {
							alert('Error subiendo imagen: ' + (json.error || 'Intente nuevamente'));
						}
					} catch(e) {
						alert('Error de conexión al subir imagen');
					}
				}
			});
		}

		if (btnUploadGaleria && fileGaleria) {
			btnUploadGaleria.addEventListener('click', () => fileGaleria.click());
			fileGaleria.addEventListener('change', async () => {
				if (fileGaleria.files && fileGaleria.files[0]) {
					const formData = new FormData();
					formData.append('file', fileGaleria.files[0]);
					try {
						const res = await fetch('/api/upload-image', { method: 'POST', body: formData });
						const json = await res.json();
						if (json.success && json.url) {
							currentGaleriaUrls.push(json.url);
							renderGallery();
						} else {
							alert('Error subiendo foto de galería');
						}
					} catch(e) {
						alert('Error al subir foto');
					}
				}
			});
		}

		function renderGallery() {
			const list = document.getElementById('gallery-list');
			if (!list) return;
			let html = '';
			currentGaleriaUrls.forEach((url, idx) => {
				html += `
					<div class="aspect-square rounded-2xl border border-slate-200 overflow-hidden relative group bg-slate-50 p-1 flex items-center justify-center gallery-item" data-url="${url}">
						<img src="${url}" class="w-full h-full object-contain" />
						<button 
							type="button" 
							data-idx="${idx}"
							class="btn-delete-galeria absolute top-2 right-2 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold shadow-md opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer"
						>
							×
						</button>
					</div>
				`;
			});
			html += `
				<div 
					id="btn-upload-galeria" 
					class="aspect-square rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-center p-2 hover:bg-slate-50 hover:border-indigo-400 transition-colors cursor-pointer group"
				>
					<span class="text-2xl text-slate-300 group-hover:text-indigo-500 font-bold">+</span>
					<span class="text-[10px] font-bold text-slate-500">Agregar foto</span>
				</div>
			`;
			list.innerHTML = html;
			
			const newBtn = document.getElementById('btn-upload-galeria');
			if (newBtn && fileGaleria) newBtn.addEventListener('click', () => fileGaleria.click());

			list.querySelectorAll('.btn-delete-galeria').forEach(btn => {
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
					currentGaleriaUrls.splice(idx, 1);
					renderGallery();
				});
			});
		}

		document.querySelectorAll('.btn-delete-galeria').forEach((btn, idx) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				currentGaleriaUrls.splice(idx, 1);
				renderGallery();
			});
		});
	</script>
</AdminLayout>
