										<input type="number" id="input-dim-alto" placeholder="Alto" class="w-full px-3 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900 text-sm" />
									</div>
									<select id="input-dim-unit" class="px-3 py-2 border border-slate-200 rounded-xl bg-white text-slate-700 font-bold text-sm">
										<option value="cm">cm</option>
