---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import { grupoDeProducto, claveDeGrupo } from '../../../lib/variantes';
import { getAdminCachedCatalog } from '../../../lib/server/catalogCache';

export const prerender = false;

const { id } = Astro.params;
const { databases } = createAdminClient();

let product = null;
let categories: any[] = [];
let allProducts: any[] = [];
import { buildCategoryTree } from '../../../lib/server/categoryUtils';

import { getSiteSettings } from '../../../lib/server/settings';

let siteSettings: any = {};

// Las cuatro consultas no dependen entre sí: en serie eran cuatro round-trips
// encadenados. Sólo el getDocument del producto define si la página existe.
// El catálogo sale del caché de admin, que ya tiene TODOS los productos. Antes
// se pedía una tanda de 100 sueltos: alcanzaba para el selector de combos pero
// no para encontrar las variantes hermanas, que pueden estar en cualquier parte
// de un catálogo de miles.
const [settingsRes, productRes, catRes, allProdRes] = await Promise.allSettled([
	getSiteSettings(),
	databases.getDocument('urbanpoint', 'products', id as string),
	databases.listDocuments('urbanpoint', 'categories', [Query.limit(100)]),
	getAdminCachedCatalog()
]);

// Producto inexistente (o id inválido): volver al listado como antes.
if (productRes.status === 'rejected') {
	console.error(productRes.reason);
	return Astro.redirect('/admin/catalogo');
}
product = productRes.value;

if (settingsRes.status === 'fulfilled') siteSettings = settingsRes.value;
if (catRes.status === 'fulfilled') categories = catRes.value.documents;
if (allProdRes.status === 'fulfilled') {
	allProducts = (allProdRes.value.products || []).filter((p: any) => p.$id !== id);
}

// Grupo que la tienda deduciría del nombre si no hay override cargado. Se usa
// como placeholder para que se vea el efecto antes de escribir nada.
const grupoDeducido = grupoDeProducto(product);

// Las otras variantes del mismo grupo, con el MISMO criterio que la vitrina.
// El panel no las mostraba: cargabas "un producto con variantes" y te quedaban
// tres fichas que desde el admin no se veían relacionadas.
const claveActual = claveDeGrupo(product);
const hermanas = allProducts
	.filter((p: any) => claveDeGrupo(p) === claveActual)
	.sort((a: any, b: any) => (a.nombre || '').localeCompare(b.nombre || '', 'es'));

// El tipo sale del documento, no de `?tipo=` en la URL: así sobrevive a volver
// desde el listado, que enlaza sin parámetros.
const tipoProducto: string = product.tipo || 'simple';

// Integrantes del combo, con el nombre resuelto para poder mostrarlos. Si el
// producto integrante no está entre los que se trajeron, se muestra el id:
// mejor eso que ocultar que el combo lo incluye.
let comboItems: Array<{ product_id: string; cantidad: number; nombre: string }> = [];
if (tipoProducto === 'combo' && product.combo_items) {
	try {
		const crudos = typeof product.combo_items === 'string'
			? JSON.parse(product.combo_items)
			: product.combo_items;
		if (Array.isArray(crudos)) {
			const porId = new Map<string, any>(allProducts.map((p: any) => [p.$id, p]));
			comboItems = crudos
				.filter((it: any) => it && it.product_id)
				.map((it: any) => ({
					product_id: String(it.product_id),
					cantidad: Number(it.cantidad) || 1,
					nombre: porId.get(String(it.product_id))?.nombre || String(it.product_id)
				}));
		}
	} catch (e) {
		console.warn('combo_items no es JSON válido en el producto', id);
	}
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

let galeriaUrls: string[] = [];
if (product.galeria_urls) {
	try {
		galeriaUrls = typeof product.galeria_urls === 'string' ? JSON.parse(product.galeria_urls) : product.galeria_urls;
	} catch (e) {}
}
---

<AdminLayout title={`Editar ${product.nombre}`}>
	<main class="p-8 max-w-7xl mx-auto">
		<!-- Top Header -->
		<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200/80">
			<div class="flex items-start gap-4 min-w-0 flex-1">
				<a href="/admin/catalogo" class="w-10 h-10 rounded-xl border border-slate-200 bg-white shadow-xs flex items-center justify-center text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-all shrink-0 mt-1">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
				</a>
				<div class="min-w-0 flex-1">
					<div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
						<span>EDITAR PRODUCTO #{product.sku || product.$id.substring(0, 6)}</span>
						{tipoProducto === 'variantes' && (
							<span class="px-2 py-0.5 bg-indigo-100 text-indigo-800 text-[10px] rounded-full font-extrabold">CON VARIANTES</span>
						)}
						{tipoProducto === 'combo' && (
							<span class="px-2 py-0.5 bg-amber-100 text-amber-800 text-[10px] rounded-full font-extrabold">COMBO</span>
						)}
						{product.grupo && (
							<span class="px-2 py-0.5 bg-blue-100 text-blue-800 text-[10px] rounded-full font-extrabold normal-case tracking-normal">{product.grupo}</span>
						)}
					</div>
					<h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight line-clamp-2" title={product.nombre}>
						{product.nombre}
					</h1>
				</div>
			</div>
			
			<div class="flex items-center gap-3 shrink-0 whitespace-nowrap self-end sm:self-center">
				<a href="/admin/catalogo" class="px-4 py-2.5 border border-slate-200 bg-white text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition-all text-xs sm:text-sm">
					Descartar
				</a>
				<button 
					id="btn-guardar-producto" 
					data-product-id={product.$id} 
					class="px-6 py-2.5 bg-[#2D5A27] hover:bg-[#23471F] text-white font-extrabold rounded-xl transition-all shadow-md shadow-[#2D5A27]/20 text-xs sm:text-sm flex items-center gap-2 whitespace-nowrap cursor-pointer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
					Guardar Cambios
				</button>
			</div>
		</header>

		<div class="flex flex-col md:flex-row gap-8">
			
			{/* Sidebar Izquierdo (Tabs) */}
			<div class="w-full md:w-64 flex-shrink-0">
				<nav class="sticky top-8 space-y-1.5" id="tab-nav-buttons">
					<button type="button" data-tab="tab-identidad" class="tab-btn w-full text-left flex flex-col px-4 py-3 rounded-xl bg-orange-50 border border-orange-200 text-orange-900 font-bold transition-all cursor-pointer">
						<div class="flex items-center gap-2 mb-0.5">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-orange-600"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
							Identidad
						</div>
						<span class="text-xs text-orange-700/80 ml-6 font-normal">Nombre &bull; fotos &bull; categoría</span>
					</button>

					<button type="button" data-tab="tab-precio" class="tab-btn w-full text-left flex flex-col px-4 py-3 rounded-xl border border-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all font-bold cursor-pointer">
						<div class="flex items-center gap-2 mb-0.5">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
							Precio
						</div>
						<span class="text-xs text-slate-400 ml-6 font-normal">Base &bull; costo &bull; oferta</span>
					</button>

					<button type="button" data-tab="tab-stock" class="tab-btn w-full text-left flex flex-col px-4 py-3 rounded-xl border border-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all font-bold cursor-pointer">
						<div class="flex items-center gap-2 mb-0.5">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
							Stock
						</div>
						<span class="text-xs text-slate-400 ml-6 font-normal">Cantidad &bull; reposición</span>
					</button>

					<button type="button" data-tab="tab-envio" class="tab-btn w-full text-left flex flex-col px-4 py-3 rounded-xl border border-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all font-bold cursor-pointer">
						<div class="flex items-center gap-2 mb-0.5">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
							Envío
						</div>
						<span class="text-xs text-slate-400 ml-6 font-normal">Pack &bull; bulto &bull; mínimo</span>
					</button>

					<button type="button" data-tab="tab-seo" class="tab-btn w-full text-left flex flex-col px-4 py-3 rounded-xl border border-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all font-bold cursor-pointer">
						<div class="flex items-center gap-2 mb-0.5">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
							SEO
						</div>
						<span class="text-xs text-slate-400 ml-6 font-normal">Buscadores &bull; URL</span>
					</button>
				</nav>
			</div>

			{/* Contenido Principal en Pestañas Separadas */}
			<div class="flex-1">
				
				{/* Pestaña 1: Identidad */}
				<div id="tab-identidad" class="tab-panel space-y-6">
					<div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
						<div class="mb-6 border-b border-slate-100 pb-4 flex justify-between items-center">
							<div>
								<h2 class="text-lg font-bold text-slate-900">Información básica</h2>
								<p class="text-sm text-slate-500">Nombre claro, descripción, estado de publicación y categoría.</p>
							</div>
							<div>
								<label class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Estado</label>
								<select id="input-estado" class="px-3 py-1.5 border border-slate-200 rounded-lg text-sm font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
									<option value="activo" selected={product.estado === 'activo'}>Activo</option>
									<option value="borrador" selected={product.estado === 'borrador'}>Borrador</option>
									<option value="inactivo" selected={product.estado === 'inactivo'}>Inactivo</option>
								</select>
							</div>
						</div>

						<div class="space-y-6">
							<div>
								<label class="block text-sm font-bold text-slate-900 mb-1">Nombre del Producto <span class="text-rose-500">*</span></label>
								<input type="text" id="input-nombre" value={product.nombre} class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" />
							</div>

							<div>
								<label class="block text-sm font-bold text-slate-900 mb-1">Grupo de variantes</label>
								<input
									type="text"
									id="input-grupo"
									placeholder={grupoDeducido}
									value={product.grupo || ''}
									class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900"
								/>
								<p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
									Junta este producto con sus variantes bajo una sola tarjeta en la tienda.
									Los productos que compartan el mismo grupo se muestran juntos, y cada uno
									conserva su stock y su precio.
									{product.grupo
										? ' Vaciá el campo para volver a deducirlo del nombre.'
										: ` Si lo dejás vacío se deduce del nombre: “${grupoDeducido}”.`}
								</p>
							</div>

							{hermanas.length > 0 && (
								<div class="border border-indigo-200 bg-indigo-50/40 rounded-2xl p-5">
									<div class="flex items-baseline justify-between gap-3 mb-3">
										<h3 class="text-sm font-extrabold text-slate-900">
											Otras variantes de “{grupoDeducido}”
										</h3>
										<span class="text-[11px] font-bold text-indigo-700 shrink-0">
											{hermanas.length + 1} en total
										</span>
									</div>

									<div class="space-y-1.5">
										{hermanas.map((h: any) => (
											<a
												href={`/admin/catalogo/${h.$id}`}
												class="flex items-center justify-between gap-3 px-3 py-2 bg-white border border-slate-200 rounded-xl hover:border-indigo-400 transition-colors group"
											>
												<span class="text-xs font-bold text-slate-800 truncate group-hover:text-indigo-700">
													{h.nombre}
												</span>
												<span class="flex items-center gap-3 shrink-0 text-[11px] font-bold">
													<span class="font-mono text-slate-400">{h.sku || '—'}</span>
													<span class={(h.stock || 0) > 0 ? 'text-slate-600' : 'text-rose-600'}>
														stock {h.stock ?? 0}
													</span>
													<span class="text-slate-900">{formateador.format((h.precio || 0) / 100)}</span>
												</span>
											</a>
										))}
									</div>

									<p class="text-[11px] text-slate-500 mt-3 leading-relaxed">
										En la tienda se muestran como una sola tarjeta con un selector.
										Cada una conserva su stock, su SKU y su precio.
									</p>
								</div>
							)}

						{tipoProducto === 'combo' && (
							<div>
								<label class="block text-sm font-bold text-slate-900 mb-1">Productos que integran el combo</label>
								<div id="combo-lista" class="space-y-2 mb-3"></div>
								<div class="flex items-center gap-2">
									<select id="combo-select" class="flex-1 px-3 py-2 border border-slate-200 rounded-xl text-xs font-bold text-slate-900 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
										<option value="">-- Elegí un producto --</option>
										{allProducts.map((p: any) => (
											<option value={p.$id}>{p.nombre}</option>
										))}
									</select>
									<button type="button" id="combo-agregar" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition-colors cursor-pointer shrink-0">
										Agregar
									</button>
								</div>
								<p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
									El combo se vende como un producto más, con su propio precio y su propio
									stock. Esta lista es lo que ve el comprador en la ficha.
								</p>
							</div>
						)}

							<div>
								<label class="block text-sm font-bold text-slate-900 mb-1">Descripción</label>
								<textarea id="input-descripcion" rows="4" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none">{product.descripcion || ''}</textarea>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
								<div>
									<label class="block text-sm font-bold text-slate-900 mb-1">Marca / Fabricante</label>
									<input 
										type="text" 
										id="input-marca" 
										placeholder="Ej: Attain, Vitta, Kanji" 
										value={product.marca || ''} 
										class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-slate-900 h-[46px]" 
									/>
								</div>
								<div>
									<label class="block text-sm font-bold text-slate-900 mb-1">Categoría</label>
									<select id="input-categoria" class="w-full px-4 py-2.5 border border-slate-200 rounded-xl text-slate-900 font-medium bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 h-[46px] cursor-pointer">
										<option value="">-- Sin Categoría --</option>
										{buildCategoryTree(categories).map((c) => (
											<option 
												value={c.$id} 
												selected={product.categoria_id?.$id === c.$id || product.categoria_id === c.$id}
											>
												{c.isSub ? `\u00A0\u00A0\u00A0\u00A0↳ ${c.nombre}` : `📁 ${c.nombre}`}
											</option>
										))}
									</select>

								</div>
								<div>
									<label class="block text-sm font-bold text-slate-900 mb-1">SKU (Código único)</label>
									<input type="text" id="input-sku" readonly value={product.sku || 'N/A'} class="w-full px-4 py-2 border border-slate-200 rounded-xl bg-slate-50 font-mono text-slate-500 h-[46px]" />
								</div>
							</div>
						</div>

						<div class="mt-8 pt-8 border-t border-slate-100">
							<div class="flex items-center justify-between mb-4">
								<div>
									<h3 class="text-sm font-bold text-slate-900">Fotos del Producto</h3>
									<p class="text-xs text-slate-500">Subí imágenes de alta calidad a Appwrite Storage.</p>
								</div>
							</div>

							<!-- Hidden Inputs for File Uploads -->
							<input type="file" id="input-file-portada" accept="image/*" class="hidden" />
							<input type="file" id="input-file-galeria" accept="image/*" class="hidden" />

							<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4" id="gallery-container">
								
								<!-- Portada Box -->
								<div 
									id="btn-upload-portada"
									class="col-span-1 sm:col-span-2 aspect-[4/3] rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-center p-6 hover:bg-slate-50 hover:border-indigo-400 transition-colors cursor-pointer group relative overflow-hidden"
								>
									<img 
										id="img-portada-preview" 
										src={product.portada_url || ''} 
										class={`absolute inset-0 w-full h-full object-contain p-2 bg-slate-50 ${product.portada_url ? '' : 'hidden'}`} 
									/>
									<div id="portada-placeholder" class={`flex flex-col items-center ${product.portada_url ? 'hidden' : ''}`}>
										<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400 group-hover:text-indigo-500 mb-2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
										<span class="text-sm font-bold text-slate-600 group-hover:text-indigo-600">Subir foto de portada</span>
										<span class="text-xs text-slate-400 mt-1">Haz clic para elegir archivo</span>
									</div>
								</div>

								<!-- Gallery Thumbnails List -->
								<div id="gallery-list" class="col-span-1 sm:col-span-2 grid grid-cols-2 gap-4">
									{galeriaUrls.map((url: string) => (
										<div class="aspect-square rounded-2xl border border-slate-200 overflow-hidden relative group bg-slate-50 p-1 flex items-center justify-center gallery-item" data-url={url}>
											<img src={url} class="w-full h-full object-contain" />
											<button 
												type="button" 
												class="btn-delete-galeria absolute top-2 right-2 w-7 h-7 bg-red-500 text-white rounded-full flex items-center justify-center text-xs font-bold shadow-md opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer"
											>
												×
											</button>
										</div>
									))}
									<div 
										id="btn-upload-galeria" 
										class="aspect-square rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-center p-2 hover:bg-slate-50 hover:border-indigo-400 transition-colors cursor-pointer group"
									>
										<span class="text-2xl text-slate-300 group-hover:text-indigo-500 font-bold">+</span>
										<span class="text-[10px] font-bold text-slate-500">Agregar foto</span>
									</div>
								</div>

							</div>
						</div>
					</div>
				</div>

				{/* Pestaña 2: Precio Multinivel */}
				<div id="tab-precio" class="tab-panel space-y-6 hidden">

					{/* 1. Costo Base Obligatorio */}
					<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
						<div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
							<div>
								<h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
