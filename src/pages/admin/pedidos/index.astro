---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import { ShoppingCart, Clock, PackageCheck, CheckCircle2, Store, Truck } from 'lucide-react';
import Pagination from '../../../components/admin/Pagination.astro';
import { ETIQUETAS, normalizarEstadoPedido, type EstadoPedido } from '../../../lib/orderStates';

export const prerender = false;

const searchQuery = Astro.url.searchParams.get('q') || '';
const estadoFilter = Astro.url.searchParams.get('estado') || 'todos';

const { databases } = createAdminClient();
let orders = [];
let allOrders = [];
let currentPage = 1;
let pageSize = 25;
let totalFiltered = 0;
let totalPages = 1;
let pagedOrders = [];

try {
	const [resOrders, resProfiles, resPoints] = await Promise.all([
		// Con 200 pedidos los contadores de pestañas y el badge de "totales"
		// mentían apenas la tienda pasaba ese volumen. Se suben a 1000 pero
		// pidiendo sólo los campos que la tabla usa, para no inflar el payload.
		databases.listDocuments('urbanpoint', 'orders', [
			Query.select([
				'numero', 'estado', 'fulfillment', 'total', 'customer_id',
				'pickup_point_id', 'canillita_id', 'comision_total_centavos',
				'pickup_code_hash', '$createdAt'
			]),
			Query.orderDesc('$createdAt'),
			Query.limit(1000)
		]),
		databases.listDocuments('urbanpoint', 'profiles', [
			Query.limit(200)
		]).catch(() => ({ documents: [] })),
		databases.listDocuments('urbanpoint', 'pickup_points', [
			Query.limit(200)
		]).catch(() => ({ documents: [] }))
	]);


	const rawOrders = resOrders.documents;

	const profileMap: Record<string, any> = {};
	(resProfiles.documents || []).forEach((p: any) => { 
		profileMap[p.$id] = p; 
		if (p.user_id) profileMap[p.user_id] = p; 
	});

	const pointMap: Record<string, any> = {};
	(resPoints.documents || []).forEach((p: any) => { 
		pointMap[p.$id] = p; 
	});

	allOrders = rawOrders.map((o) => {
		const custId = typeof o.customer_id === 'string' ? o.customer_id : o.customer_id?.$id;
		const customerProfile = custId ? profileMap[custId] : null;

		const ptId = typeof o.pickup_point_id === 'string' ? o.pickup_point_id : o.pickup_point_id?.$id;
		const pickupPoint = ptId ? pointMap[ptId] : null;

		const canId = o.canillita_id || (pickupPoint ? (typeof pickupPoint.profile_id === 'string' ? pickupPoint.profile_id : pickupPoint.profile_id?.$id) : null);
		const canillitaProfile = canId ? profileMap[canId] : null;

		return {
			...o,
			customerProfile,
			pickupPoint,
			canillitaProfile,
			totalItems: o.items_count || 1,
			comisionCentavos: o.comision_total_centavos || 0
		};
	});

	let filtered = [...allOrders];

	// Los filtros agrupan SOLO estados canónicos (los del enum de orders):
	// los alias muertos (listo, en_transito, enviado, preparado, confirmado,
	// nuevo, etc.) no existen en la base y sólo ensuciaban la lógica.
	if (estadoFilter && estadoFilter !== 'todos') {
		if (estadoFilter === 'despachado') {
			filtered = filtered.filter(o => o.estado === 'despachado' || o.estado === 'en_punto');
		} else if (estadoFilter === 'entregado') {
			filtered = filtered.filter(o => o.estado === 'entregado' || o.estado === 'retirado');
		} else if (estadoFilter === 'cancelado') {
			filtered = filtered.filter(o => o.estado === 'cancelado' || o.estado === 'reembolsado');
		} else {
			filtered = filtered.filter(o => o.estado === estadoFilter);
		}
	}

	if (searchQuery.trim()) {
		const q = searchQuery.toLowerCase();
		filtered = filtered.filter(o => 
			o.numero?.toString().toLowerCase().includes(q) ||
			o.pickup_code_hash?.toLowerCase().includes(q) ||
			o.customerProfile?.nombre?.toLowerCase().includes(q) ||
			o.customerProfile?.email?.toLowerCase().includes(q) ||
			o.pickupPoint?.nombre_comercial?.toLowerCase().includes(q) ||
			o.canillitaProfile?.nombre?.toLowerCase().includes(q)
		);
	}
	orders = filtered;

	currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
	pageSize = 25;
	totalFiltered = filtered.length;
	totalPages = Math.ceil(totalFiltered / pageSize) || 1;
	pagedOrders = filtered.slice((currentPage - 1) * pageSize, currentPage * pageSize);
	orders = pagedOrders;

} catch (e) {
	console.error("Error loading orders page:", e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const counts = {
	todos: allOrders.length,
	pendiente_pago: allOrders.filter(o => o.estado === 'pendiente_pago').length,
	pagado: allOrders.filter(o => o.estado === 'pagado').length,
	preparando: allOrders.filter(o => o.estado === 'preparando').length,
	despachado: allOrders.filter(o => o.estado === 'despachado' || o.estado === 'en_punto').length,
	entregado: allOrders.filter(o => o.estado === 'entregado' || o.estado === 'retirado').length,
	cancelado: allOrders.filter(o => o.estado === 'cancelado' || o.estado === 'reembolsado').length
};

// Etiquetas y colores derivados de la máquina de estados canónica: la versión
// casera de esta página no conocía en_punto, retirado ni reembolsado y esos
// pedidos aparecían con el estado crudo sin color.
const CLASES_ESTADO: Record<EstadoPedido, string> = {
	pendiente_pago: 'bg-amber-50 text-amber-700 border-amber-200',
	pagado: 'bg-blue-50 text-blue-700 border-blue-200',
	preparando: 'bg-indigo-50 text-indigo-700 border-indigo-200',
	despachado: 'bg-purple-50 text-purple-700 border-purple-200',
	en_punto: 'bg-cyan-50 text-cyan-700 border-cyan-200',
	entregado: 'bg-emerald-50 text-emerald-700 border-emerald-200',
	retirado: 'bg-emerald-50 text-emerald-700 border-emerald-200',
	cancelado: 'bg-rose-50 text-rose-700 border-rose-200',
	reembolsado: 'bg-rose-50 text-rose-700 border-rose-200'
};

const getStatusLabel = (estado: string) => {
	const canonico = normalizarEstadoPedido(estado);
	return canonico ? ETIQUETAS[canonico] : estado;
};

const getStatusClass = (estado: string) => {
	const canonico = normalizarEstadoPedido(estado);
	return canonico ? CLASES_ESTADO[canonico] : 'bg-slate-50 text-slate-700 border-slate-200';
};
---

<AdminLayout title="Gestión de Pedidos">
	<main class="p-8 max-w-[1600px] mx-auto space-y-6">
		
		{/* Header Compacto de Página */}
		<header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
					<span>Administración</span> &gt; <span class="text-slate-900">Pedidos</span>
				</div>
				<h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-3">
					Gestión de Pedidos
					<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
						{allOrders.length >= 1000 ? `últimos ${allOrders.length}` : `${allOrders.length} totales`}
					</span>
				</h1>
			</div>
			<div class="flex items-center gap-3">
				<button onclick="window.location.reload()" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 font-bold text-xs rounded-xl hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
					Actualizar
				</button>
			</div>
		</header>

		{/* Cards Métricas Vivas */}
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			<div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Total Pedidos</p>
					<p class="text-2xl font-black text-slate-900">{counts.todos}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold">
					<ShoppingCart className="w-5 h-5" />
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Pendientes de Pago</p>
					<p class="text-2xl font-black text-amber-600">{counts.pendiente_pago}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
					<Clock className="w-5 h-5" />
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">En Preparación / Despacho</p>
					<p class="text-2xl font-black text-indigo-600">{counts.pagado + counts.preparando + counts.despachado}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
					<PackageCheck className="w-5 h-5" />
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Entregados</p>
					<p class="text-2xl font-black text-emerald-600">{counts.entregado}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
					<CheckCircle2 className="w-5 h-5" />
				</div>
			</div>
		</div>

		{/* Pestañas y Buscador */}
		<div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-4">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				{/* Pestañas de Estado */}
				<div class="flex items-center gap-1 overflow-x-auto pb-1 max-w-full">
					{[
						{ id: 'todos', label: 'Todos', count: counts.todos },
						{ id: 'pendiente_pago', label: 'Nuevos', count: counts.pendiente_pago },
						{ id: 'pagado', label: 'A preparar', count: counts.pagado },
						{ id: 'preparando', label: 'En preparación', count: counts.preparando },
						{ id: 'despachado', label: 'Despachados / Listos', count: counts.despachado },
						{ id: 'entregado', label: 'Entregados', count: counts.entregado },
						{ id: 'cancelado', label: 'Cancelados', count: counts.cancelado }
					].map(tab => (
						<a 
							href={`/admin/pedidos?estado=${tab.id}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
							class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-1.5 ${
								estadoFilter === tab.id 
									? 'bg-slate-900 text-white shadow-sm' 
									: 'bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200'
							}`}
						>
							{tab.label}
							<span class={`px-1.5 py-0.2 rounded-full text-[10px] ${estadoFilter === tab.id ? 'bg-slate-700 text-white' : 'bg-slate-200 text-slate-700'}`}>
								{tab.count}
							</span>
						</a>
					))}
				</div>

				{/* Buscador */}
				<form method="GET" action="/admin/pedidos" class="flex items-center gap-2 w-full md:w-80">
					<input type="hidden" name="estado" value={estadoFilter} />
					<div class="relative w-full">
						<input 
							type="text" 
							name="q" 
							value={searchQuery} 
							placeholder="Buscar por #, cliente o punto..." 
							class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:border-emerald-600 focus:bg-white transition-colors"
						/>
						<svg class="w-4 h-4 absolute left-3 top-2.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
					</div>
					{searchQuery && (
						<a href={`/admin/pedidos?estado=${estadoFilter}`} class="px-3 py-2 bg-slate-100 text-slate-600 rounded-xl text-xs font-bold hover:bg-slate-200">
							Limpiar
						</a>
					)}
				</form>
			</div>

			{/* Tabla de Pedidos B2C */}
			<div class="overflow-x-auto rounded-xl border border-slate-200">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
							<th class="p-3.5">Pedido / Fecha</th>
							<th class="p-3.5">Cliente</th>
							<th class="p-3.5">Tipo de Entrega</th>
							<th class="p-3.5">Punto de Retiro / Canillita</th>
							<th class="p-3.5 text-center">Ítems</th>
							<th class="p-3.5 text-right">Total Pedido</th>
							<th class="p-3.5 text-right">Comisión</th>
							<th class="p-3.5 text-center">Estado</th>
							<th class="p-3.5 text-center">Acción</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-xs">
						{orders.map(o => {
							const dateStr = new Date(o.$createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' });
							const isRetiro = o.fulfillment === 'retiro';
							return (
								<tr class="hover:bg-slate-50/80 transition-colors">
									<td class="p-3.5 font-mono">
										<a href={`/admin/pedidos/${o.$id}`} class="font-bold text-emerald-700 hover:underline">
											ORD-{o.numero || o.$id.substring(0, 6)}
										</a>
										<p class="text-[10px] text-slate-400 mt-0.5">{dateStr}</p>
										{isRetiro && o.pickup_code_hash && (
											<span class="inline-block mt-1 px-1.5 py-0.5 bg-amber-50 text-amber-800 border border-amber-300 font-mono font-black text-[10px] rounded tracking-wider" title="Código de Retiro">
												CÓD: {o.pickup_code_hash}
											</span>
										)}
									</td>

									<td class="p-3.5">
										{o.customerProfile ? (
											<div>
												<p class="font-bold text-slate-900">{o.customerProfile.nombre}</p>
												<p class="text-[10px] text-slate-400">{o.customerProfile.email}</p>
											</div>
										) : (
											<div>
												<p class="font-bold text-slate-900">Cliente Registrado</p>
												<p class="text-[10px] text-slate-400">Cliente de Tienda</p>
											</div>
										)}
									</td>

									<td class="p-3.5">
										<span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold border ${
											isRetiro 
												? 'bg-purple-50 text-purple-700 border-purple-200' 
												: 'bg-blue-50 text-blue-700 border-blue-200'
										}`}>
											{isRetiro ? (
												<><Store className="w-3 h-3 text-purple-600 shrink-0" /> Retiro en Punto</>
											) : (
												<><Truck className="w-3 h-3 text-blue-600 shrink-0" /> Envío a Domicilio</>
											)}
										</span>
									</td>

									<td class="p-3.5">
										{o.pickupPoint ? (
											<div>
												<p class="font-bold text-slate-900">{o.pickupPoint.nombre_comercial}</p>
												<p class="text-[10px] text-slate-400">{o.pickupPoint.direccion}, {o.pickupPoint.localidad}</p>
											</div>
										) : o.canillitaProfile ? (
											<div>
												<p class="font-bold text-slate-900">{o.canillitaProfile.nombre}</p>
												<p class="text-[10px] text-slate-400">Canillita Atribuidor</p>
											</div>
										) : (
											<span class="text-slate-400 italic">Directo</span>
										)}
									</td>

									<td class="p-3.5 text-center font-bold text-slate-700">
										{o.totalItems} u.
									</td>

									<td class="p-3.5 text-right font-black text-slate-900 text-sm">
										{formateador.format((o.total || 0) / 100)}
									</td>

									<td class="p-3.5 text-right font-bold text-emerald-600">
										{o.comisionCentavos > 0 ? formateador.format(o.comisionCentavos / 100) : '$0,00'}
									</td>

									<td class="p-3.5 text-center">
										<span class={`px-2.5 py-1 rounded-full text-[10px] font-bold border ${getStatusClass(o.estado)}`}>
											{getStatusLabel(o.estado)}
										</span>
									</td>

									<td class="p-3.5 text-center">
										<a 
											href={`/admin/pedidos/${o.$id}`}
											class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-[11px] rounded-xl transition-colors shadow-sm inline-block"
										>
											Ver Ficha
										</a>
									</td>
								</tr>
							);
						})}

						{orders.length === 0 && (
							<tr>
								<td colspan="9" class="p-8 text-center text-slate-500 font-medium">
									No se encontraron pedidos en la categoría seleccionada.
								</td>
							</tr>
						)}
					</tbody>
				</table>

				<Pagination 
					currentPage={currentPage} 
					totalPages={totalPages} 
					totalItems={totalFiltered} 
					pageSize={pageSize} 
					searchParams={Astro.url.searchParams} 
					baseUrl="/admin/pedidos" 
				/>
			</div>
		</div>

	</main>
</AdminLayout>
