---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const searchQuery = Astro.url.searchParams.get('q') || '';
const estadoFilter = Astro.url.searchParams.get('estado') || '';

const { databases } = createAdminClient();
let orders = [];
let allOrders = [];

try {
	const res = await databases.listDocuments('urbanpoint', 'orders', [
		Query.orderDesc('$createdAt'),
		Query.limit(200)
	]);
	allOrders = res.documents;

	// fetch profiles for all customer_ids
	const customerIds = [...new Set(allOrders.map(o => o.customer_id).filter(Boolean))];
	const profiles = {};
	if (customerIds.length > 0) {
		const profRes = await databases.listDocuments('urbanpoint', 'profiles', [
			Query.equal('$id', customerIds),
			Query.limit(customerIds.length)
		]);
		profRes.documents.forEach(p => {
			profiles[p.$id] = p;
		});
	}

	// fetch order items to count articles
	const orderIds = allOrders.map(o => o.$id);
	const orderItemsCount = {};
	if (orderIds.length > 0) {
		const itemsRes = await databases.listDocuments('urbanpoint', 'order_items', [
			Query.equal('order_id', orderIds),
			Query.limit(orderIds.length * 5)
		]);
		itemsRes.documents.forEach(item => {
			if (!orderItemsCount[item.order_id]) orderItemsCount[item.order_id] = 0;
			orderItemsCount[item.order_id] += item.cantidad || 1;
		});
	}

	allOrders = allOrders.map(o => ({
		...o,
		customerProfile: o.customer_id ? profiles[o.customer_id] : null,
		totalItems: orderItemsCount[o.$id] || 0
	}));

	let filtered = [...allOrders];

	if (estadoFilter && estadoFilter !== 'todos') {
		filtered = filtered.filter(o => o.estado === estadoFilter);
	}

	if (searchQuery.trim()) {
		const q = searchQuery.toLowerCase();
		filtered = filtered.filter(o => 
			o.numero?.toString().toLowerCase().includes(q) ||
			o.customerProfile?.nombre?.toLowerCase().includes(q) ||
			o.customerProfile?.email?.toLowerCase().includes(q)
		);
	}

	orders = filtered;

} catch (e) {
	console.error(e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const getStatusColor = (estado) => {
	switch(estado) {
		case 'pendiente': return 'bg-slate-100 text-slate-700';
		case 'pagado': return 'bg-amber-100 text-amber-700';
		case 'preparando': return 'bg-blue-100 text-blue-700';
		case 'listo': return 'bg-indigo-100 text-indigo-700';
		case 'en_camino': return 'bg-purple-100 text-purple-700';
		case 'entregado': return 'bg-emerald-100 text-emerald-700';
		case 'cancelado': return 'bg-rose-100 text-rose-700';
		default: return 'bg-slate-100 text-slate-700';
	}
};

const getStatusDot = (estado) => {
	switch(estado) {
		case 'pendiente': return 'bg-slate-500';
		case 'pagado': return 'bg-amber-500';
		case 'preparando': return 'bg-blue-500';
		case 'listo': return 'bg-indigo-500';
		case 'en_camino': return 'bg-purple-500';
		case 'entregado': return 'bg-emerald-500';
		case 'cancelado': return 'bg-rose-500';
		default: return 'bg-slate-500';
	}
};

const getStatusLabel = (estado) => {
	switch(estado) {
		case 'pendiente': return 'Pago Pendiente';
		case 'pagado': return 'A Preparar';
		case 'preparando': return 'Preparando';
		case 'listo': return 'Listo para Envío';
		case 'en_camino': return 'En Camino';
		case 'entregado': return 'Entregado';
		case 'cancelado': return 'Cancelado';
		default: return estado;
	}
};
---

