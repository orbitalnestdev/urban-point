---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const currentAdminId = Astro.locals?.user?.id; // Needed to prevent self-demotion
const { databases, users } = createAdminClient();

let admins = [];
let successMessage = '';
let errorMessage = '';

// Handle POST request (Promote or Demote)
if (Astro.request.method === 'POST') {
	try {
		const formData = await Astro.request.formData();
		const action = formData.get('action');

		if (action === 'promote') {
			const email = formData.get('email')?.toString().trim();
			if (!email) throw new Error('El correo es obligatorio.');

			// 1. Find user by email
			const userList = await users.list([Query.equal('email', email)]);
			if (userList.users.length === 0) {
				throw new Error('No se encontró ningún usuario registrado con ese correo.');
			}
			const targetUser = userList.users[0];

			// 2. Find their profile
			const profileList = await databases.listDocuments('urbanpoint', 'profiles', [
				Query.equal('user_id', targetUser.$id)
			]);

			if (profileList.documents.length === 0) {
				throw new Error('El usuario no tiene un perfil asociado.');
			}

			const targetProfile = profileList.documents[0];

			if (targetProfile.role === 'admin') {
				throw new Error('El usuario ya es administrador.');
			}

			// 3. Update role
			await databases.updateDocument('urbanpoint', 'profiles', targetProfile.$id, {
				role: 'admin'
			});

			successMessage = `¡${targetUser.email} ha sido promovido a administrador!`;
		} else if (action === 'demote') {
			const profileId = formData.get('profile_id')?.toString();
			const userId = formData.get('user_id')?.toString();

			if (!profileId || !userId) throw new Error('Faltan datos para revocar el permiso.');
			if (userId === currentAdminId) throw new Error('No puedes revocar tus propios permisos por seguridad.');

			// Update role to null (or 'cliente')
			await databases.updateDocument('urbanpoint', 'profiles', profileId, {
				role: null
			});

			successMessage = 'Se han revocado los permisos de administrador correctamente.';
		}
	} catch (error: any) {
		console.error("Error managing team:", error);
		errorMessage = error.message || 'Ocurrió un error al procesar la solicitud.';
	}
}

// Fetch all admins
try {
	const resProfiles = await databases.listDocuments('urbanpoint', 'profiles', [
		Query.equal('role', 'admin'),
		Query.orderDesc('$createdAt')
	]);

	// For each admin profile, fetch their email from Appwrite Users
	admins = await Promise.all(resProfiles.documents.map(async (profile) => {
		try {
			const user = await users.get(profile.user_id);
			return { ...profile, email: user.email };
		} catch (e) {
			return { ...profile, email: 'Email no disponible' };
		}
	}));
} catch (error) {
	console.error("Error fetching admins:", error);
}

const isSelf = (userId: string) => userId === currentAdminId;
---

<AdminLayout title="Equipo de Trabajo">
	<main class="p-8 max-w-7xl mx-auto">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
			<div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Equipo de Trabajo</h1>
				<p class="text-slate-500 font-medium mt-1">Gestioná los accesos de administración a la plataforma.</p>
			</div>
		</header>

		{successMessage && (
			<div class="bg-emerald-50 border border-emerald-200 text-[#2D5A27] px-4 py-3 rounded-xl text-sm font-semibold mb-6 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
				{successMessage}
			</div>
		)}
		
		{errorMessage && (
			<div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm font-semibold mb-6 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
				{errorMessage}
			</div>
		)}

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			
			{/* Left Column: Admin List */}
			<div class="lg:col-span-2 space-y-6">
				<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
					<div class="p-6 border-b border-slate-100 flex items-center justify-between">
						<div>
							<h2 class="text-lg font-bold text-slate-900">Administradores Activos</h2>
							<p class="text-sm text-slate-500">Usuarios con acceso total al panel.</p>
						</div>
						<div class="px-3 py-1 bg-slate-100 text-slate-600 font-bold text-xs rounded-full">
							{admins.length} {admins.length === 1 ? 'miembro' : 'miembros'}
						</div>
					</div>
					
					<div class="divide-y divide-slate-100">
						{admins.length === 0 ? (
							<div class="p-8 text-center text-slate-500">No hay administradores registrados.</div>
						) : (
							admins.map(admin => (
								<div class="p-6 flex items-center justify-between hover:bg-slate-50 transition-colors">
									<div class="flex items-center gap-4">
										<div class="w-12 h-12 rounded-full bg-indigo-50 text-indigo-600 font-bold flex items-center justify-center shrink-0">
											{admin.nombre ? admin.nombre.substring(0,1).toUpperCase() : 'A'}
										</div>
										<div>
											<p class="font-bold text-slate-900 flex items-center gap-2">
												{admin.nombre || 'Sin nombre'}
												{isSelf(admin.user_id) && (
													<span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[10px] font-black uppercase tracking-wider rounded">Tú</span>
												)}
											</p>
											<p class="text-sm text-slate-500">{admin.email}</p>
										</div>
									</div>
									<div>
										{isSelf(admin.user_id) ? (
											<button disabled class="px-4 py-2 bg-slate-100 text-slate-400 font-bold text-xs rounded-lg cursor-not-allowed">
												Revocar
											</button>
										) : (
											<form method="POST" onsubmit="return confirm('¿Estás seguro de que deseas revocar los permisos de administrador de este usuario?');">
												<input type="hidden" name="action" value="demote" />
												<input type="hidden" name="profile_id" value={admin.$id} />
												<input type="hidden" name="user_id" value={admin.user_id} />
												<button type="submit" class="px-4 py-2 bg-white border border-rose-200 text-rose-600 font-bold text-xs rounded-lg hover:bg-rose-50 transition-colors shadow-sm">
													Revocar
												</button>
											</form>
										)}
									</div>
								</div>
							))
						)}
					</div>
				</div>
			</div>

			{/* Right Column: Add Admin Form */}
			<div class="lg:col-span-1">
				<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sticky top-24">
					<div class="w-10 h-10 bg-slate-900 text-white rounded-xl flex items-center justify-center mb-4 shadow-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
					</div>
					<h2 class="text-lg font-bold text-slate-900 mb-1">Agregar Administrador</h2>
					<p class="text-sm text-slate-500 mb-6">Promové a un cliente registrado para que tenga acceso total.</p>
					
					<form method="POST" class="space-y-4">
						<input type="hidden" name="action" value="promote" />
						
						<div>
							<label class="block text-sm font-bold text-slate-900 mb-1">Correo electrónico</label>
							<input 
								type="email" 
								name="email" 
								required
								placeholder="usuario@ejemplo.com" 
								class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-shadow"
							/>
							<p class="text-[11px] text-slate-400 mt-1">El usuario ya debe tener una cuenta de cliente creada en la plataforma.</p>
						</div>
						
						<button type="submit" class="w-full py-2.5 bg-slate-900 text-white font-bold rounded-xl hover:bg-slate-800 transition-colors shadow-md flex items-center justify-center gap-2 mt-2">
							Otorgar permisos
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
						</button>
					</form>
				</div>
			</div>
		</div>
	</main>
</AdminLayout>
