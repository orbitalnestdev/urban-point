---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;

// Protección de ruta (el middleware ya protege /admin, pero verificamos locals)
const user = Astro.locals?.user;
if (!user || user.role !== 'admin') {
    return Astro.redirect('/login');
}

// Simulamos los miembros del equipo por ahora
const teamMembers = [
    { id: '1', nombre: 'Carlos Admin', email: 'carlos@urbanpoint.com.ar', rol: 'Administrador', estado: 'Activo', ultimoAcceso: 'Hace 2 horas' },
    { id: '2', nombre: 'Laura Soporte', email: 'laura@urbanpoint.com.ar', rol: 'Soporte', estado: 'Activo', ultimoAcceso: 'Ayer' },
    { id: '3', nombre: 'Martín Cajero', email: 'martin@urbanpoint.com.ar', rol: 'Cajero', estado: 'Inactivo', ultimoAcceso: 'Hace 1 semana' }
];

---

<AdminLayout title="Equipo de Trabajo">
    <div class="max-w-6xl mx-auto">
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Equipo de Trabajo</h1>
                <p class="text-slate-500 mt-1">Gestioná los accesos y roles de los miembros de tu tienda.</p>
            </div>
            
            <button onclick="document.getElementById('modal-invitar').classList.remove('hidden')" class="px-5 py-2.5 bg-[#2D5A27] hover:bg-[#23471F] text-white font-bold rounded-xl flex items-center gap-2 transition-colors shadow-sm cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                Invitar Miembro
            </button>
        </div>

        <!-- Tabla de Miembros -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500">
                            <th class="p-4 font-bold">Miembro</th>
                            <th class="p-4 font-bold">Rol</th>
                            <th class="p-4 font-bold">Estado</th>
                            <th class="p-4 font-bold">Último Acceso</th>
                            <th class="p-4 font-bold text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        {teamMembers.map(member => (
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="p-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-[#F2F7F3] text-[#2D5A27] font-bold flex items-center justify-center shrink-0">
                                            {member.nombre.substring(0, 1).toUpperCase()}
                                        </div>
                                        <div>
                                            <p class="font-bold text-slate-900">{member.nombre}</p>
                                            <p class="text-xs text-slate-500">{member.email}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-4">
                                    <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider ${
                                        member.rol === 'Administrador' ? 'bg-purple-100 text-purple-700' :
                                        member.rol === 'Soporte' ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-700'
                                    }`}>
                                        {member.rol}
                                    </span>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class={`w-2 h-2 rounded-full ${member.estado === 'Activo' ? 'bg-emerald-500' : 'bg-slate-300'}`}></span>
                                        <span class="font-medium text-slate-700">{member.estado}</span>
                                    </div>
                                </td>
                                <td class="p-4 text-slate-500 font-medium">
                                    {member.ultimoAcceso}
                                </td>
                                <td class="p-4 text-right">
                                    <button class="text-slate-400 hover:text-[#2D5A27] p-2 transition-colors cursor-pointer" title="Editar">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            {teamMembers.length === 0 && (
                <div class="p-8 text-center text-slate-500">
                    No hay otros miembros en el equipo todavía.
                </div>
            )}
        </div>

    </div>

    <!-- Modal para Invitar -->
    <div id="modal-invitar" class="fixed inset-0 z-50 flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm cursor-pointer" onclick="document.getElementById('modal-invitar').classList.add('hidden')"></div>
        <div class="bg-white rounded-3xl w-full max-w-md p-6 relative z-10 shadow-2xl m-4">
            <h3 class="text-xl font-bold text-slate-900 mb-1">Invitar al equipo</h3>
            <p class="text-sm text-slate-500 mb-6">Enviaremos un correo de invitación con instrucciones para acceder.</p>
            
            <form class="space-y-4" onsubmit="event.preventDefault(); alert('Invitación enviada'); document.getElementById('modal-invitar').classList.add('hidden');">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Correo Electrónico</label>
                    <input type="email" placeholder="ejemplo@correo.com" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none text-sm text-slate-800" required />
                </div>
                
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Rol Asignado</label>
                    <select class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none text-sm font-medium text-slate-800 appearance-none cursor-pointer">
                        <option value="Soporte">Soporte (Solo ver pedidos y mensajes)</option>
                        <option value="Cajero">Cajero (Pedidos y pagos)</option>
                        <option value="Administrador">Administrador (Acceso total)</option>
                    </select>
                </div>

                <div class="pt-4 flex gap-3">
                    <button type="button" onclick="document.getElementById('modal-invitar').classList.add('hidden')" class="flex-1 px-4 py-2.5 border border-slate-200 text-slate-600 font-bold rounded-xl hover:bg-slate-50 transition-colors cursor-pointer">
                        Cancelar
                    </button>
                    <button type="submit" class="flex-1 px-4 py-2.5 bg-[#2D5A27] text-white font-bold rounded-xl hover:bg-[#23471F] transition-colors cursor-pointer">
                        Enviar Invitación
                    </button>
                </div>
            </form>
        </div>
    </div>
</AdminLayout>
