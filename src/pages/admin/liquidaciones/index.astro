---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import Pagination from '../../../components/admin/Pagination.astro';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

const { databases } = createAdminClient();

const tabParam = Astro.url.searchParams.get('tab') || 'pendientes';
const periodoParam = Astro.url.searchParams.get('periodo') || '';

let pendingBalances: any[] = [];
let pastPayouts: any[] = [];
let totalPendienteCentavos = 0;
let totalLiquidadoCentavos = 0;
let currentPage = 1;
let pageSize = 25;
let totalPendingItems = 0;
let totalPendingPages = 1;
let pagedPendingBalances: any[] = [];
let totalPayoutItems = 0;
let totalPayoutPages = 1;
let pagedPastPayouts: any[] = [];

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

try {
  // 1. Fetch pending commission ledger entries
  const ledgerRes = await databases.listDocuments('urbanpoint', 'commission_ledger', [
    Query.equal('estado', 'pendiente'),
    Query.limit(5000)
  ]);

  // Aggregate pending balance by profile
  const balanceMap: Record<string, {
    id: string;
    name: string;
    commercial_name: string;
    email: string;
    phone: string;
    code: string;
    cbu: string;
    alias: string;
    banco: string;
    titular: string;
    balance: number;
    count: number;
  }> = {};

  for (const item of ledgerRes.documents) {
    const profileId = typeof item.profile_id === 'string' ? item.profile_id : item.profile_id?.$id;
    if (!profileId) continue;

    const monto = item.monto_centavos || 0;
    totalPendienteCentavos += monto;

    if (!balanceMap[profileId]) {
      balanceMap[profileId] = {
        id: profileId,
        name: 'Canillita',
        commercial_name: '',
        email: '',
        phone: '',
        code: 'CANI-REF',
        cbu: 'No informado',
        alias: 'No informado',
        banco: 'No especificado',
        titular: 'No especificado',
        balance: 0,
        count: 0
      };
    }
    balanceMap[profileId].balance += monto;
    balanceMap[profileId].count += 1;
  }

  // Fetch profiles, pickup points, and referral codes for display & banking
  const profileIds = Object.keys(balanceMap);
  if (profileIds.length > 0) {
    const [profilesRes, pointsRes, refCodesRes] = await Promise.all([
      databases.listDocuments('urbanpoint', 'profiles', [
        Query.equal('$id', profileIds),
        Query.limit(500)
      ]).catch(() => ({ documents: [] })),
      databases.listDocuments('urbanpoint', 'pickup_points', [
        Query.equal('profile_id', profileIds),
        Query.limit(500)
      ]).catch(() => ({ documents: [] })),
      databases.listDocuments('urbanpoint', 'referral_codes', [
        Query.equal('owner_id', profileIds),
        Query.limit(500)
      ]).catch(() => ({ documents: [] }))
    ]);

    const profileDocMap: Record<string, any> = {};
    (profilesRes.documents || []).forEach((p: any) => { profileDocMap[p.$id] = p; });

    const pointDocMap: Record<string, any> = {};
    (pointsRes.documents || []).forEach((pt: any) => {
      const pId = typeof pt.profile_id === 'string' ? pt.profile_id : pt.profile_id?.$id;
      if (pId) pointDocMap[pId] = pt;
    });

    for (const pId of profileIds) {
      const prof = profileDocMap[pId];
      const pt = pointDocMap[pId];
      if (balanceMap[pId]) {
        balanceMap[pId].name = prof?.nombre || pt?.nombre_comercial || 'Canillita';
        balanceMap[pId].commercial_name = pt?.nombre_comercial || prof?.nombre || '';
        balanceMap[pId].email = prof?.email || pt?.email || '';
        balanceMap[pId].phone = prof?.telefono || pt?.telefono || '';
        balanceMap[pId].cbu = pt?.cbu || pt?.cvu || prof?.cbu || prof?.cvu || 'No informado';
        balanceMap[pId].alias = pt?.alias || prof?.alias || 'No informado';
        balanceMap[pId].banco = pt?.banco || prof?.banco || 'No especificado';
        balanceMap[pId].titular = pt?.titular_cuenta || prof?.titular_cuenta || prof?.nombre || 'No especificado';
      }
    }

    for (const ref of (refCodesRes.documents || [])) {
      const oId = typeof ref.owner_id === 'string' ? ref.owner_id : ref.owner_id?.$id;
      if (oId && balanceMap[oId]) {
        balanceMap[oId].code = ref.code;
      }
    }
  }

  pendingBalances = Object.values(balanceMap);

  // 2. Fetch past payouts history with beneficiary resolution
  const payoutQueries = [Query.orderDesc('$createdAt'), Query.limit(100)];
  if (periodoParam) {
    payoutQueries.unshift(Query.equal('periodo', periodoParam));
  }
  const payoutsRes = await databases.listDocuments('urbanpoint', 'payouts', payoutQueries);

  const payoutProfileIds = Array.from(new Set((payoutsRes.documents || []).map((p: any) => typeof p.profile_id === 'string' ? p.profile_id : p.profile_id?.$id).filter(Boolean)));

  const payoutProfileMap: Record<string, any> = {};
  if (payoutProfileIds.length > 0) {
    const [pRes, ptRes] = await Promise.all([
      databases.listDocuments('urbanpoint', 'profiles', [
        Query.equal('$id', payoutProfileIds),
        Query.limit(500)
      ]).catch(() => ({ documents: [] })),
      databases.listDocuments('urbanpoint', 'pickup_points', [
        Query.equal('profile_id', payoutProfileIds),
        Query.limit(500)
      ]).catch(() => ({ documents: [] }))
    ]);
    (pRes.documents || []).forEach((p: any) => { payoutProfileMap[p.$id] = p; });
    (ptRes.documents || []).forEach((pt: any) => {
      const pId = typeof pt.profile_id === 'string' ? pt.profile_id : pt.profile_id?.$id;
      if (pId) payoutProfileMap[pId + '_pt'] = pt;
    });
  }

  pastPayouts = (payoutsRes.documents || []).map((pay: any) => {
    const profId = typeof pay.profile_id === 'string' ? pay.profile_id : pay.profile_id?.$id;
    const prof = profId ? payoutProfileMap[profId] : null;
    const pt = profId ? payoutProfileMap[profId + '_pt'] : null;
    return {
      ...pay,
      beneficiaryName: pt?.nombre_comercial || prof?.nombre || 'Canillita',
      contactInfo: prof?.email || prof?.telefono || ''
    };
  });

  totalLiquidadoCentavos = pastPayouts.reduce((acc, curr) => acc + (curr.monto_centavos || 0), 0);

  currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
  pageSize = 25;

  totalPendingItems = pendingBalances.length;
  totalPendingPages = Math.ceil(totalPendingItems / pageSize) || 1;
  pagedPendingBalances = pendingBalances.slice((currentPage - 1) * pageSize, currentPage * pageSize);

  totalPayoutItems = pastPayouts.length;
  totalPayoutPages = Math.ceil(totalPayoutItems / pageSize) || 1;
  pagedPastPayouts = pastPayouts.slice((currentPage - 1) * pageSize, currentPage * pageSize);

} catch (e) {
  console.error("Error loading liquidaciones:", e);
}
---

<AdminLayout title="Liquidación de Comisiones">
	<main class="p-6 md:p-8 max-w-7xl mx-auto">
		<!-- Compact Header with Live Statistics -->
		<header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-200">
			<div>
				<h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Liquidación de Comisiones</h1>
				<p class="text-xs text-slate-500 font-medium mt-0.5">
					Pendientes: <strong class="text-emerald-700">{formateador.format(totalPendienteCentavos / 100)}</strong> ({pendingBalances.length} canillitas) | Liquidado histórico: <strong class="text-slate-800">{formateador.format(totalLiquidadoCentavos / 100)}</strong>
				</p>
			</div>

			<div class="flex items-center gap-3">
				<button id="btn-export-csv" class="px-4 py-2 bg-slate-100 text-slate-700 hover:bg-slate-200 font-bold rounded-xl text-xs transition-colors cursor-pointer flex items-center gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					Exportar a CSV
				</button>
			</div>
		</header>

		<!-- Subheader & Tabs -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
			<div class="flex items-center gap-2 bg-slate-100 p-1 rounded-xl text-xs font-bold w-fit">
				<a href="?tab=pendientes" class={`px-4 py-2 rounded-lg transition-colors ${tabParam === 'pendientes' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900'}`}>
					Pendientes de Pago ({pendingBalances.length})
				</a>
				<a href="?tab=historial" class={`px-4 py-2 rounded-lg transition-colors ${tabParam === 'historial' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900'}`}>
					Historial de Liquidaciones ({pastPayouts.length})
				</a>
			</div>
		</div>

		{/* Tab 1: Pendientes de Pago */}
		{tabParam === 'pendientes' && (
			<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs">
				{pendingBalances.length === 0 ? (
					<div class="p-12 text-center text-slate-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-3 text-emerald-500"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
						<p class="text-lg font-bold text-slate-800">¡Todo al día!</p>
						<p class="text-xs text-slate-500 mt-1">No hay saldo a favor pendiente de pago para liquidar en este momento.</p>
					</div>
				) : (
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-xs">
							<thead>
								<tr class="bg-slate-50 border-b border-slate-200 font-bold text-slate-500 uppercase tracking-wider h-[38px]">
									<th class="px-4 py-2">Canillita / Comercio</th>
									<th class="px-4 py-2 text-center">Código REF</th>
									<th class="px-4 py-2 text-center">Contacto</th>
									<th class="px-4 py-2 text-center">Órdenes</th>
									<th class="px-4 py-2 text-right">Saldo Pendiente</th>
									<th class="px-4 py-2 text-right">Acción</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								{pagedPendingBalances.map(p => (
									<tr class="hover:bg-slate-50 transition-colors h-[42px]">
										<td class="px-4 py-2">
											<p class="font-bold text-slate-900">{p.name} {p.commercial_name && p.commercial_name !== p.name ? `(${p.commercial_name})` : ''}</p>
											<p class="text-[11px] text-slate-500 font-mono">CBU: {p.cbu}</p>
										</td>
										<td class="px-4 py-2 text-center">
											<span class="font-mono font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded text-[11px]">{p.code}</span>
										</td>
										<td class="px-4 py-2 text-center text-slate-600">
											{p.phone || p.email || 'Sin contacto'}
										</td>
										<td class="px-4 py-2 text-center font-bold text-slate-800">
											{p.count}
										</td>
										<td class="px-4 py-2 text-right font-black text-emerald-600 text-sm">
											{formateador.format(p.balance / 100)}
										</td>
										<td class="px-4 py-2 text-right">
											<button 
												class="btn-liquidar-modal px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs transition-all shadow-xs cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
												data-profile={p.id}
												data-name={p.name}
												data-comercial={p.commercial_name}
												data-balance={p.balance}
												data-cbu={p.cbu}
												data-alias={p.alias}
												data-banco={p.banco}
												data-titular={p.titular}
												disabled={p.balance <= 0}
											>
												Liquidar
											</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
						<Pagination 
							currentPage={currentPage} 
							totalPages={totalPendingPages} 
							totalItems={totalPendingItems} 
							pageSize={pageSize} 
							searchParams={Astro.url.searchParams} 
							baseUrl="/admin/liquidaciones" 
						/>
					</div>
				)}
			</div>
		)}

		{/* Tab 2: Historial de Liquidaciones */}
		{tabParam === 'historial' && (
			<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs">
				{pastPayouts.length === 0 ? (
					<div class="p-12 text-center text-slate-500 text-sm">
						No hay liquidaciones históricas registradas.
					</div>
				) : (
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-xs">
							<thead>
								<tr class="bg-slate-50 border-b border-slate-200 font-bold text-slate-500 uppercase tracking-wider h-[38px]">
									<th class="px-4 py-2">Fecha</th>
									<th class="px-4 py-2">Beneficiario</th>
									<th class="px-4 py-2">Comprobante #</th>
									<th class="px-4 py-2 text-center">Período</th>
									<th class="px-4 py-2 text-center">Método</th>
									<th class="px-4 py-2 text-right">Monto Liquidado</th>
									<th class="px-4 py-2 text-center">Estado</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								{pagedPastPayouts.map(pay => (
									<tr class="hover:bg-slate-50 transition-colors h-[42px]">
										<td class="px-4 py-2 text-slate-700 font-medium">
											{new Date(pay.$createdAt).toLocaleString('es-AR')}
										</td>
										<td class="px-4 py-2 font-bold text-slate-900">
											{pay.beneficiaryName}
											{pay.contactInfo && <span class="block text-[10px] font-normal text-slate-400">{pay.contactInfo}</span>}
										</td>
										<td class="px-4 py-2 font-mono text-slate-900 font-bold">
											{pay.comprobante || pay.$id.substring(0,10)}
										</td>
										<td class="px-4 py-2 text-center font-bold text-slate-800">
											{pay.periodo || '2026-08'}
										</td>
										<td class="px-4 py-2 text-center text-slate-600 capitalize">
											{pay.metodo_pago || 'Transferencia'}
										</td>
										<td class="px-4 py-2 text-right font-black text-slate-900 text-sm">
											{formateador.format((pay.monto_centavos || 0) / 100)}
										</td>
										<td class="px-4 py-2 text-center">
											<span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 font-bold text-[11px] rounded-full border border-emerald-200">Ejecutado</span>
										</td>
									</tr>
								))}
							</tbody>
						</table>
						<Pagination 
							currentPage={currentPage} 
							totalPages={totalPayoutPages} 
							totalItems={totalPayoutItems} 
							pageSize={pageSize} 
							searchParams={Astro.url.searchParams} 
							baseUrl="/admin/liquidaciones" 
						/>
					</div>
				)}
			</div>
		)}
	</main>

	<!-- Modal de Confirmación e Idempotencia de Payout -->
	<div id="modal-payout" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
		<div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-6">
			<div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200">
				<h3 class="text-lg font-extrabold text-slate-900">Confirmar Liquidación</h3>
				<button id="btn-close-payout" class="text-slate-400 hover:text-slate-600 text-2xl font-bold">&times;</button>
			</div>

			<form id="form-payout" class="space-y-4">
				<input type="hidden" id="payout-profile-id" />
				<input type="hidden" id="payout-balance-val" />
				<input type="hidden" id="payout-idempotency" />

				<div class="bg-slate-50 border border-slate-200 p-4 rounded-2xl space-y-3">
					<div>
						<p class="text-xs text-slate-500 font-medium">Canillita Beneficiario:</p>
						<p id="payout-target-name" class="text-base font-bold text-slate-900"></p>
					</div>

					<div class="pt-2 border-t border-slate-200 text-xs space-y-1">
						<p class="font-bold text-slate-700">Datos Bancarios para Transferencia:</p>
						<p class="text-slate-600"><span class="font-semibold text-slate-800">Titular:</span> <span id="payout-target-titular" class="font-medium text-slate-900"></span></p>
						<p class="text-slate-600"><span class="font-semibold text-slate-800">CBU / CVU:</span> <span id="payout-target-cbu" class="select-all font-mono font-bold text-indigo-700 bg-indigo-50 px-1.5 py-0.5 rounded"></span></p>
						<p class="text-slate-600"><span class="font-semibold text-slate-800">Alias:</span> <span id="payout-target-alias" class="select-all font-mono font-bold text-indigo-700 bg-indigo-50 px-1.5 py-0.5 rounded"></span></p>
						<p class="text-slate-600"><span class="font-semibold text-slate-800">Banco:</span> <span id="payout-target-banco" class="font-medium text-slate-900"></span></p>
					</div>

					<div class="pt-2 border-t border-slate-200">
						<p class="text-xs text-slate-500 font-medium">Monto Total a Liquidar:</p>
						<p id="payout-target-monto" class="text-2xl font-black text-emerald-600"></p>
					</div>
				</div>

				<div>
					<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nº Comprobante / Transacción Banco</label>
					<input type="text" id="payout-comprobante" required placeholder="Ej: TR-98240192" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono outline-none focus:border-emerald-600" />
				</div>

				<div>
					<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Método de Pago</label>
					<select id="payout-metodo" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-emerald-600 cursor-pointer">
						<option value="transferencia">Transferencia Bancaria (CBU)</option>
						<option value="mercadopago">Mercado Pago / CVU</option>
						<option value="efectivo">Efectivo en Mano</option>
					</select>
				</div>

				<div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
					<button type="button" id="btn-cancel-payout" class="px-4 py-2 bg-slate-100 text-slate-700 font-bold rounded-xl text-xs hover:bg-slate-200">Cancelar</button>
					<button type="submit" id="btn-confirm-payout" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md text-xs cursor-pointer">Ejecutar Pago Idempotente</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		import { actions } from 'astro:actions';

		const modal = document.getElementById('modal-payout');
		const formPayout = document.getElementById('form-payout') as HTMLFormElement;
		const targetName = document.getElementById('payout-target-name')!;
		const targetMonto = document.getElementById('payout-target-monto')!;
		const targetTitular = document.getElementById('payout-target-titular')!;
		const targetCbu = document.getElementById('payout-target-cbu')!;
		const targetAlias = document.getElementById('payout-target-alias')!;
		const targetBanco = document.getElementById('payout-target-banco')!;

		const inputProfile = document.getElementById('payout-profile-id') as HTMLInputElement;
		const inputBalance = document.getElementById('payout-balance-val') as HTMLInputElement;
		const inputIdempotency = document.getElementById('payout-idempotency') as HTMLInputElement;
		const inputComprobante = document.getElementById('payout-comprobante') as HTMLInputElement;
		const inputMetodo = document.getElementById('payout-metodo') as HTMLSelectElement;

		const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

		document.querySelectorAll('.btn-liquidar-modal').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const el = e.currentTarget as HTMLElement;
				const profileId = el.dataset.profile || '';
				const name = el.dataset.name || 'Canillita';
				const comercial = el.dataset.comercial || '';
				const balance = parseInt(el.dataset.balance || '0', 10);
				const cbu = el.dataset.cbu || 'No informado';
				const alias = el.dataset.alias || 'No informado';
				const banco = el.dataset.banco || 'No especificado';
				const titular = el.dataset.titular || name;

				if (balance <= 0) {
					alert('No se puede liquidar un saldo en $0.00.');
					return;
				}

				inputProfile.value = profileId;
				inputBalance.value = balance.toString();
				targetName.textContent = comercial && comercial !== name ? `${name} (${comercial})` : name;
				targetMonto.textContent = formateador.format(balance / 100);
				
				if (targetTitular) targetTitular.textContent = titular;
				if (targetCbu) targetCbu.textContent = cbu;
				if (targetAlias) targetAlias.textContent = alias;
				if (targetBanco) targetBanco.textContent = banco;

				// Generate unique idempotency key
				inputIdempotency.value = `IDEMP-${profileId}-${balance}-${Date.now()}`;
				inputComprobante.value = `TR-${Math.floor(100000 + Math.random() * 900000)}`;

				modal?.classList.remove('hidden');
			});
		});

		document.getElementById('btn-close-payout')?.addEventListener('click', () => modal?.classList.add('hidden'));
		document.getElementById('btn-cancel-payout')?.addEventListener('click', () => modal?.classList.add('hidden'));

		formPayout?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const profileId = inputProfile.value;
			const balance = parseInt(inputBalance.value, 10);
			const idempotencyKey = inputIdempotency.value;
			const comprobante = inputComprobante.value;
			const metodo = inputMetodo.value;

			const btnSubmit = document.getElementById('btn-confirm-payout') as HTMLButtonElement;
			btnSubmit.setAttribute('disabled', 'true');
			btnSubmit.textContent = 'Procesando Pago...';

			try {
				const { data, error } = await actions.liquidateCommissions({
					profileId,
					montoCentavos: balance,
					periodo: new Date().toISOString().substring(0, 7),
					metodoPago: metodo,
					comprobante,
					idempotencyKey
				});

				if (error || !data?.success) {
					alert(error?.message || 'Error al ejecutar la liquidación.');
					btnSubmit.removeAttribute('disabled');
					btnSubmit.textContent = 'Ejecutar Pago Idempotente';
				} else {
					alert('¡Liquidación ejecutada con éxito!');
					window.location.reload();
				}
			} catch (err) {
				alert('Error de conexión');
				btnSubmit.removeAttribute('disabled');
				btnSubmit.textContent = 'Ejecutar Pago Idempotente';
			}
		});

		// CSV Exporter
		document.getElementById('btn-export-csv')?.addEventListener('click', () => {
			const rows = [
				['Canillita ID', 'Periodo', 'Monto ARS', 'Comprobante', 'Metodo']
			];
			document.querySelectorAll('tbody tr').forEach(tr => {
				const cols = Array.from(tr.querySelectorAll('td')).map(td => td.innerText.replace(/\n/g, ' ').trim());
				if (cols.length > 0) rows.push(cols);
			});

			const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
			const encodedUri = encodeURI(csvContent);
			const link = document.createElement("a");
			link.setAttribute("href", encodedUri);
			link.setAttribute("download", `liquidaciones_${new Date().toISOString().substring(0,10)}.csv`);
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
		});
	</script>
</AdminLayout>
