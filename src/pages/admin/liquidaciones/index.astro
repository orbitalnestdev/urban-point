			<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
				<div class="flex items-center justify-between text-slate-400 mb-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-500">Fee Logística (Puntos)</span>
					<Building2 className="w-5 h-5 text-sky-600" />
				</div>
				<h3 class="text-2xl font-black text-slate-900">{formateador.format(totalFeeLogisticaCentavos / 100)}</h3>
				<p class="text-[11px] text-slate-500 font-medium mt-1">Comisión por entregas en local</p>
			</div>

			<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
				<div class="flex items-center justify-between text-slate-400 mb-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-500">Comisión Referidos</span>
					<ArrowUpRight className="w-5 h-5 text-purple-600" />
				</div>
				<h3 class="text-2xl font-black text-slate-900">{formateador.format(totalComisionReferidoCentavos / 100)}</h3>
				<p class="text-[11px] text-slate-500 font-medium mt-1">Comisión por ventas referidas</p>
			</div>

			<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs bg-amber-50/40">
				<div class="flex items-center justify-between text-slate-400 mb-2">
					<span class="text-xs font-bold uppercase tracking-wider text-amber-800">Por Confirmar (Pendiente)</span>
					<Clock className="w-5 h-5 text-amber-600" />
				</div>
				<h3 class="text-2xl font-black text-amber-700">{formateador.format(totalPorConfirmarCentavos / 100)}</h3>
				<p class="text-[11px] text-amber-700 font-medium mt-1">A la espera de confirmación de entrega</p>
			</div>

			<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs bg-emerald-50/40">
				<div class="flex items-center justify-between text-slate-400 mb-2">
					<span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Liquidable (Disponible)</span>
					<CheckCircle2 className="w-5 h-5 text-emerald-600" />
				</div>
				<h3 class="text-2xl font-black text-emerald-700">{formateador.format(totalDisponibleCentavos / 100)}</h3>
				<p class="text-[11px] text-emerald-700 font-medium mt-1">{summaryCanillitasList.filter(s => (s as any).disponibleTotalCentavos > 0).length} canillitas con saldo confirmado</p>
			</div>
		</div>

		<!-- Navigation Tabs -->
		<div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden">
			<div class="flex border-b border-slate-200 bg-slate-50/60 p-2 gap-2">
				<a 
					href={`/admin/liquidaciones?tab=resumen${canillitaParam ? `&canillita=${canillitaParam}` : ''}${periodoParam ? `&periodo=${periodoParam}` : ''}`} 
					class={`px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all flex items-center gap-2 ${tabParam === 'resumen' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-200/60'}`}
				>
					<User className="w-4 h-4" />
					Resumen por Canillita ({summaryCanillitasList.length})
				</a>

				<a 
					href={`/admin/liquidaciones?tab=movimientos${canillitaParam ? `&canillita=${canillitaParam}` : ''}${periodoParam ? `&periodo=${periodoParam}` : ''}`} 
					class={`px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all flex items-center gap-2 ${tabParam === 'movimientos' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-200/60'}`}
				>
					<FileText className="w-4 h-4" />
					Detalle de Movimientos / Asientos ({allLedgerDocs.length})
				</a>

				<a 
					href={`/admin/liquidaciones?tab=payouts${canillitaParam ? `&canillita=${canillitaParam}` : ''}${periodoParam ? `&periodo=${periodoParam}` : ''}`} 
					class={`px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all flex items-center gap-2 ${tabParam === 'payouts' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-200/60'}`}
				>
					<CheckCircle2 className="w-4 h-4" />
					Histórico de Liquidaciones / Pagos ({pastPayouts.length})
				</a>
			</div>

			<!-- TAB 1: Resumen por Canillitas -->
			{tabParam === 'resumen' && (
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">
								<th class="p-4">Canillita (Punto de Retiro)</th>
								<th class="p-4">Datos de Transferencia Bancaria</th>
								<th class="p-4 text-right">Fee Logística</th>
								<th class="p-4 text-right">Referidos</th>
								<th class="p-4 text-right">Saldo Pendiente</th>
								<th class="p-4 text-right">Total Liquidado</th>
								<th class="p-4 text-center">Acciones</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100 text-xs">
							{summaryCanillitasList.map(item => (
								<tr class="hover:bg-slate-50/80 transition-colors">
									<td class="p-4">
										<p class="font-extrabold text-slate-900 text-sm">{item.info.nombreComercial}</p>
										<p class="text-slate-500 text-[11px] mt-0.5">
											Titular: <strong>{item.info.titular}</strong> &bull; {item.info.email || 'Sin email'}
										</p>
										<span class="inline-block mt-1 px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">
											REF: {item.info.code}
										</span>
									</td>

									<td class="p-4">
										<p class="font-mono text-xs font-bold text-slate-800 select-all">{item.info.cbu}</p>
										<p class="text-[11px] text-slate-500 mt-0.5">
											Alias: <strong class="text-slate-700">{item.info.alias}</strong> ({item.info.banco})
										</p>
										<p class="text-[10px] text-slate-400">Titular: {item.info.titularCuenta}</p>
									</td>

									<td class="p-4 text-right font-medium text-slate-700">
										{formateador.format(item.feeLogisticaCentavos / 100)}
									</td>

									<td class="p-4 text-right font-medium text-slate-700">
										{formateador.format(item.referidoCentavos / 100)}
									</td>

									<td class="p-4 text-right">
										<span class={`font-black text-sm ${item.pendienteCentavos > 0 ? 'text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200' : 'text-slate-400'}`}>
											{formateador.format(item.pendienteCentavos / 100)}
										</span>
									</td>

									<td class="p-4 text-right font-bold text-slate-800">
										{formateador.format(item.liquidadoCentavos / 100)}
									</td>

									<td class="p-4 text-center space-x-2 whitespace-nowrap">
										<a 
											href={`/admin/liquidaciones?canillita=${item.profileId}${periodoParam ? `&periodo=${periodoParam}` : ''}&tab=movimientos`} 
											class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-lg text-xs transition-colors inline-block"
										>
											Ver Movimientos
										</a>

										{(item as any).disponibleTotalCentavos > 0 && (
											<button
												class="btn-abrir-payout px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-xs transition-colors shadow-xs cursor-pointer"
												data-profile-id={item.profileId}
												data-nombre={item.info.nombreComercial}
												data-titular={item.info.titularCuenta}
												data-banco={item.info.banco}
												data-cbu={item.info.cbu}
												data-alias={item.info.alias}
												data-monto={(item as any).disponibleTotalCentavos}
											>
												Liquidar
											</button>
										)}
									</td>
								</tr>
							))}

							{summaryCanillitasList.length === 0 && (
								<tr>
									<td colspan="7" class="p-12 text-center text-slate-500 font-medium">
										No hay comisiones ni canillitas para los filtros seleccionados.
									</td>
								</tr>
							)}
						</tbody>
					</table>
				</div>
			)}

			<!-- TAB 2: Detalle de Movimientos / Asientos -->
			{tabParam === 'movimientos' && (
				<div>
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse">
							<thead>
								<tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">
									<th class="p-4">Fecha / Hora</th>
									<th class="p-4">Canillita Beneficiario</th>
									<th class="p-4">Pedido Relacionado</th>
									<th class="p-4">Tipo de Comisión</th>
									<th class="p-4">Concepto / Motivo</th>
									<th class="p-4 text-right">Monto Comisión</th>
									<th class="p-4 text-center">Estado</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100 text-xs">
								{pagedLedgerDocs.map((doc: any) => {
									const pId = typeof doc.profile_id === 'string' ? doc.profile_id : doc.profile_id?.$id;
									const cInfo = canillitaOptionsMap[pId];
									const orderId = typeof doc.order_id === 'string' ? doc.order_id : doc.order_id?.$id;
									const fechaStr = doc.$createdAt ? new Date(doc.$createdAt).toLocaleString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';

									return (
										<tr class="hover:bg-slate-50/80 transition-colors">
											<td class="p-4 font-mono text-slate-500 whitespace-nowrap">{fechaStr}</td>

											<td class="p-4">
												<p class="font-bold text-slate-900">{cInfo?.nombreComercial || 'Canillita'}</p>
												<p class="text-[11px] text-slate-400">{cInfo?.titular}</p>
											</td>

											<td class="p-4">
												{orderId ? (
													<a href={`/admin/pedidos/${orderId}`} target="_blank" class="font-mono text-indigo-600 font-bold hover:underline">
														#{orderId.substring(0, 8)}
													</a>
												) : (
													<span class="text-slate-400 italic">S/N</span>
												)}
											</td>

											<td class="p-4">
												{doc.tipo === 'fee_logistica' ? (
													<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200">
														Fee Logística
													</span>
												) : (
													<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">
														Comisión Referido
													</span>
												)}
											</td>

											<td class="p-4 text-slate-700 font-medium">
												{doc.motivo || 'Devengo de comisión'}
											</td>

											<td class="p-4 text-right font-extrabold text-slate-900 text-sm">
												{formateador.format((doc.monto_centavos || 0) / 100)}
											</td>

											<td class="p-4 text-center">
												{doc.estado === 'pendiente' && (
													<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
														Por confirmar
													</span>
												)}
												{doc.estado === 'disponible' && (
													<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-sky-100 text-sky-800 border border-sky-200">
														Liquidable
													</span>
												)}
												{doc.estado === 'liquidado' && (
													<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
														Liquidado
													</span>
												)}
												{doc.estado === 'revertido' && (
													<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
														Revertido
													</span>
												)}
											</td>
										</tr>
									);
								})}

								{pagedLedgerDocs.length === 0 && (
									<tr>
										<td colspan="7" class="p-12 text-center text-slate-500 font-medium">
											No hay asientos registrados para este filtro.
										</td>
									</tr>
								)}
							</tbody>
						</table>
					</div>

					<div class="p-4 border-t border-slate-100">
						<Pagination 
							currentPage={currentPage} 
							totalPages={totalLedgerPages} 
							totalItems={totalLedgerItems} 
							pageSize={pageSize} 
							searchParams={Astro.url.searchParams} 
							baseUrl="/admin/liquidaciones" 
						/>
					</div>
				</div>
			)}

			<!-- TAB 3: Histórico de Liquidaciones / Payouts -->
			{tabParam === 'payouts' && (
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">
								<th class="p-4">Fecha de Pago</th>
								<th class="p-4">Beneficiario (Canillita)</th>
								<th class="p-4">Período Liquidado</th>
								<th class="p-4">Medio & Referencia</th>
								<th class="p-4 text-right">Monto Liquidado</th>
								<th class="p-4 text-center">Estado</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100 text-xs">
							{pastPayouts.map((pay: any) => {
								const fechaStr = pay.$createdAt ? new Date(pay.$createdAt).toLocaleString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';

								return (
									<tr class="hover:bg-slate-50/80 transition-colors">
										<td class="p-4 font-mono text-slate-500">{fechaStr}</td>

										<td class="p-4">
											<p class="font-bold text-slate-900">{pay.beneficiaryName}</p>
											<p class="text-[11px] text-slate-400">CBU: {pay.cbu}</p>
										</td>

										<td class="p-4 font-mono font-bold text-slate-700">
											{pay.periodo || 'Acumulado'}
										</td>

										<td class="p-4">
											<p class="font-bold text-slate-800 uppercase text-[11px]">{pay.medio_pago || 'Transferencia'}</p>
											<p class="font-mono text-slate-500 text-[11px]">Ref: {pay.referencia_pago || pay.idempotency_key || 'S/R'}</p>
										</td>

										<td class="p-4 text-right font-black text-slate-900 text-sm">
											{formateador.format((pay.monto_centavos || 0) / 100)}
										</td>

										<td class="p-4 text-center">
											<span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
												Completado
											</span>
										</td>
									</tr>
								);
							})}

							{pastPayouts.length === 0 && (
								<tr>
									<td colspan="6" class="p-12 text-center text-slate-500 font-medium">
										No se han registrado pagos ni liquidaciones en el período seleccionado.
									</td>
								</tr>
							)}
						</tbody>
					</table>
				</div>
			)}
		</div>
	</main>

	<!-- Modal de Ejecución de Liquidación / Payout -->
	<div id="modal-payout" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
		<div class="bg-white rounded-3xl shadow-2xl max-w-lg w-full p-6 space-y-5">
			<div class="flex items-center justify-between pb-3 border-b border-slate-200">
				<h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
					<CreditCard className="w-5 h-5 text-emerald-600" />
					Confirmar Liquidación de Comisiones
				</h3>
				<button id="btn-close-payout-modal" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
			</div>

			<form id="form-payout" class="space-y-4">
				<input type="hidden" id="payout-profile-id" />

				<div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-2">
					<p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Beneficiario</p>
					<h4 id="payout-canillita-nombre" class="text-base font-black text-slate-900">Nombre Canillita</h4>
					
					<div class="pt-2 border-t border-slate-200 grid grid-cols-2 gap-2 text-xs">
						<div>Titular: <strong id="payout-titular" class="text-slate-800">--</strong></div>
						<div>Banco: <strong id="payout-banco" class="text-slate-800">--</strong></div>
						<div class="col-span-2 font-mono">CBU/CVU: <strong id="payout-cbu" class="text-slate-900 select-all">--</strong></div>
						<div class="col-span-2">Alias: <strong id="payout-alias" class="text-slate-900">--</strong></div>
					</div>
				</div>

				<div class="bg-emerald-50 border border-emerald-200 p-4 rounded-2xl text-center">
					<p class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Monto Total A Liquidar</p>
					<h2 id="payout-monto-text" class="text-3xl font-black text-emerald-700 mt-0.5">$0,00</h2>
					<p class="text-[11px] text-emerald-800/80 font-medium mt-1.5 leading-snug">
						Se liquida <strong>todo el saldo confirmado</strong> (entregas ya realizadas) pendiente de pago,
						de todos los períodos — no solo el mes filtrado en pantalla.
					</p>
				</div>

				<div>
					<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">N° de Comprobante / Referencia Bancaria</label>
					<input 
						type="text" 
						id="payout-referencia" 
						required 
						placeholder="Ej: TRANSF-8947201" 
						class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono outline-none focus:border-emerald-600"
					/>
				</div>

				<div class="flex justify-end gap-3 pt-3 border-t border-slate-200">
					<button type="button" id="btn-cancel-payout" class="px-5 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-xl hover:bg-slate-200 text-sm">Cancelar</button>
					<button type="submit" id="btn-confirm-payout" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md text-sm cursor-pointer">Confirmar Pago & Liquidar</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		import { actions } from 'astro:actions';

		const modalPayout = document.getElementById('modal-payout');
		const btnClosePayout = document.getElementById('btn-close-payout-modal');
		const btnCancelPayout = document.getElementById('btn-cancel-payout');
		const formPayout = document.getElementById('form-payout') as HTMLFormElement;

		const inputProfileId = document.getElementById('payout-profile-id') as HTMLInputElement;
		const txtNombre = document.getElementById('payout-canillita-nombre');
		const txtTitular = document.getElementById('payout-titular');
		const txtBanco = document.getElementById('payout-banco');
		const txtCbu = document.getElementById('payout-cbu');
		const txtAlias = document.getElementById('payout-alias');
		const txtMonto = document.getElementById('payout-monto-text');
		const inputRef = document.getElementById('payout-referencia') as HTMLInputElement;

		const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

		function closeModal() {
			modalPayout?.classList.add('hidden');
		}

		btnClosePayout?.addEventListener('click', closeModal);
		btnCancelPayout?.addEventListener('click', closeModal);

		document.querySelectorAll('.btn-abrir-payout').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLElement;
				const pId = target.dataset.profileId || '';
				const nombre = target.dataset.nombre || '';
				const titular = target.dataset.titular || '';
				const banco = target.dataset.banco || '';
				const cbu = target.dataset.cbu || '';
				const alias = target.dataset.alias || '';
				const montoCentavos = parseInt(target.dataset.monto || '0', 10);

				inputProfileId.value = pId;
				if (txtNombre) txtNombre.textContent = nombre;
				if (txtTitular) txtTitular.textContent = titular;
				if (txtBanco) txtBanco.textContent = banco;
				if (txtCbu) txtCbu.textContent = cbu;
				if (txtAlias) txtAlias.textContent = alias;
				if (txtMonto) txtMonto.textContent = formateador.format(montoCentavos / 100);
				inputRef.value = `TRANSF-${Date.now().toString().substring(6)}`;

				modalPayout?.classList.remove('hidden');
			});
		});

		formPayout?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const profileId = inputProfileId.value;
			const referenciaPago = inputRef.value.trim();

			if (!profileId || !referenciaPago) {
				alert('Por favor ingresá un número de comprobante de transferencia.');
				return;
			}

			const btnConfirm = document.getElementById('btn-confirm-payout') as HTMLButtonElement;
			btnConfirm.disabled = true;
			btnConfirm.textContent = 'Procesando pago...';

			const formData = new FormData();
			formData.append('profileId', profileId);
			formData.append('medioPago', 'transferencia');
			formData.append('referenciaPago', referenciaPago);

			const { data, error } = await actions.createPayout(formData);
			if (error || !data?.success) {
				alert(error?.message || 'Error al procesar la liquidación');
				btnConfirm.disabled = false;
				btnConfirm.textContent = 'Confirmar Pago & Liquidar';
			} else {
				alert('¡Liquidación registrada exitosamente!');
				window.location.reload();
			}
		});
	</script>
</AdminLayout>
