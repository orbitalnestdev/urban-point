---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import Pagination from '../../../components/admin/Pagination.astro';
import { toSafeJson } from '../../../lib/safeJson';
import { 
  DollarSign, 
  Calendar, 
  User, 
  Filter, 
  Search, 
  CreditCard, 
  CheckCircle2, 
  Clock, 
  ArrowUpRight, 
  Building2, 
  FileText,
  RefreshCw
} from 'lucide-react';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

const { databases } = createAdminClient();

// URL Query Parameters
const canillitaParam = Astro.url.searchParams.get('canillita') || '';
const periodoParam = Astro.url.searchParams.get('periodo') || '';
const estadoParam = Astro.url.searchParams.get('estado') || 'todos';
const qParam = Astro.url.searchParams.get('q') || '';
const tabParam = Astro.url.searchParams.get('tab') || 'resumen';

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

let pickupPoints: any[] = [];
let profiles: any[] = [];
let refCodes: any[] = [];
let allLedgerDocs: any[] = [];
let pastPayouts: any[] = [];
let canillitaOptionsMap: Record<string, any> = {};
let canillitaOptions: any[] = [];
// Saldo 'disponible' total por canillita (sin recorte de período): es lo que
// createPayout liquida de verdad.
let disponibleTotalByProfile: Record<string, number> = {};

// Opciones de período generadas dinámicamente (últimos 6 meses): la lista
// estaba hardcodeada abril-agosto 2026 y quedaba vieja con solo dejar pasar
// el tiempo.
const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const hoy = new Date();
const periodOptions: Array<{ value: string; label: string }> = [
  { value: '', label: 'Todos los períodos' }
];
for (let i = 0; i < 6; i++) {
  const d = new Date(hoy.getFullYear(), hoy.getMonth() - i, 1);
  const value = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  periodOptions.push({ value, label: `${MESES[d.getMonth()]} ${d.getFullYear()}${i === 0 ? ' (Actual)' : ''}` });
}

// Rango de fechas del período elegido, en UTC (los $createdAt de Appwrite son
// ISO UTC; el filtro viejo comparaba el substring del mes con el mismo criterio).
let periodoDesdeIso: string | null = null;
let periodoHastaIso: string | null = null;
if (/^\d{4}-\d{2}$/.test(periodoParam)) {
  const [py, pm] = periodoParam.split('-').map(Number);
  periodoDesdeIso = new Date(Date.UTC(py, pm - 1, 1)).toISOString();
  periodoHastaIso = new Date(Date.UTC(py, pm, 1)).toISOString();
}

try {
  // 1. Fetch auxiliary collections
  const [pointsRes, profilesRes, refRes] = await Promise.all([
    databases.listDocuments('urbanpoint', 'pickup_points', [Query.limit(500)]).catch(() => ({ documents: [] })),
    databases.listDocuments('urbanpoint', 'profiles', [Query.equal('role', 'canillita'), Query.limit(500)]).catch(() => ({ documents: [] })),
    databases.listDocuments('urbanpoint', 'referral_codes', [Query.limit(500)]).catch(() => ({ documents: [] }))
  ]);

  pickupPoints = pointsRes.documents || [];
  profiles = profilesRes.documents || [];
  refCodes = refRes.documents || [];

  // Map profile details & bank info
  const profileMap: Record<string, any> = {};
  profiles.forEach(p => { profileMap[p.$id] = p; });

  const pointMap: Record<string, any> = {};
  pickupPoints.forEach(pt => {
    const pId = typeof pt.profile_id === 'string' ? pt.profile_id : pt.profile_id?.$id;
    if (pId) pointMap[pId] = pt;
  });

  const refCodeMap: Record<string, any> = {};
  refCodes.forEach(ref => {
    const ownerId = typeof ref.owner_id === 'string' ? ref.owner_id : ref.owner_id?.$id;
    if (ownerId) refCodeMap[ownerId] = ref.code;
  });

  // Build Canillita Options List for Select Filter
  canillitaOptionsMap = {};
  
  // Add from pickup points
  pickupPoints.forEach(pt => {
    const pId = typeof pt.profile_id === 'string' ? pt.profile_id : pt.profile_id?.$id;
    if (pId) {
      const prof = profileMap[pId];
      canillitaOptionsMap[pId] = {
        profileId: pId,
        nombreComercial: pt.nombre_comercial,
        titular: prof?.nombre || pt.titular_nombre || 'Sin titular',
        email: prof?.email || pt.email || '',
        phone: prof?.telefono || pt.telefono || '',
        cbu: pt.cbu || pt.cvu || prof?.cbu || prof?.cvu || 'No informado',
        alias: pt.alias || prof?.alias || 'No informado',
        banco: pt.banco || prof?.banco || 'No especificado',
        titularCuenta: pt.titular_cuenta || prof?.titular_cuenta || prof?.nombre || 'No especificado',
        code: refCodeMap[pId] || 'S/CODE'
      };
    }
  });

  // Add remaining canillita profiles if not mapped
  profiles.forEach(prof => {
    if (!canillitaOptionsMap[prof.$id]) {
      const pt = pointMap[prof.$id];
      canillitaOptionsMap[prof.$id] = {
        profileId: prof.$id,
        nombreComercial: pt?.nombre_comercial || prof.nombre,
        titular: prof.nombre,
        email: prof.email || '',
        phone: prof.telefono || '',
        cbu: pt?.cbu || prof.cbu || prof.cvu || 'No informado',
        alias: pt?.alias || prof.alias || 'No informado',
        banco: pt?.banco || prof.banco || 'No especificado',
        titularCuenta: pt?.titular_cuenta || prof.titular_cuenta || prof.nombre || 'No especificado',
        code: refCodeMap[prof.$id] || 'S/CODE'
      };
    }
  });

  canillitaOptions = Object.values(canillitaOptionsMap).sort((a: any, b: any) => 
    a.nombreComercial.localeCompare(b.nombreComercial)
  );

  // 2. Fetch Ledger Entries. El período se filtra en la query misma: traer
  // 5000 documentos para después tirar la mayoría en memoria era pagar el
  // costo de red al cuete (y con >5000 asientos el filtro directamente mentía).
  const ledgerQueries = [Query.orderDesc('$createdAt'), Query.limit(5000)];
  if (canillitaParam) {
    ledgerQueries.unshift(Query.equal('profile_id', canillitaParam));
  }
  if (estadoParam !== 'todos') {
    ledgerQueries.unshift(Query.equal('estado', estadoParam));
  }
  if (periodoDesdeIso && periodoHastaIso) {
    ledgerQueries.unshift(Query.greaterThanEqual('$createdAt', periodoDesdeIso));
    ledgerQueries.unshift(Query.lessThan('$createdAt', periodoHastaIso));
  }

  // En paralelo, el saldo disponible REAL por canillita (todos los períodos):
  // createPayout liquida TODO lo disponible, así que el modal tiene que mostrar
  // ese total y no el recorte del período visible.
  const [ledgerRes, disponiblesRes] = await Promise.all([
    databases.listDocuments('urbanpoint', 'commission_ledger', ledgerQueries),
    databases.listDocuments('urbanpoint', 'commission_ledger', [
      Query.equal('estado', 'disponible'),
      Query.select(['profile_id', 'monto_centavos']),
      Query.limit(5000)
    ]).catch(() =>
      // Query.select sobre la relación profile_id puede ser rechazado según la
      // versión del servidor de Appwrite: se reintenta sin select.
      databases.listDocuments('urbanpoint', 'commission_ledger', [
        Query.equal('estado', 'disponible'),
        Query.limit(5000)
      ])
    ).catch(() => ({ documents: [] as any[] }))
  ]);
  allLedgerDocs = ledgerRes.documents || [];

  for (const doc of (disponiblesRes.documents || [])) {
    const pId = typeof doc.profile_id === 'string' ? doc.profile_id : doc.profile_id?.$id;
    if (!pId) continue;
    disponibleTotalByProfile[pId] = (disponibleTotalByProfile[pId] || 0) + (doc.monto_centavos || 0);
  }

  // Búsqueda por texto: esta sí queda en memoria (Appwrite no puede matchear
  // contra los nombres del mapa de canillitas).
  allLedgerDocs = allLedgerDocs.filter(doc => {
    if (qParam.trim()) {
      const q = qParam.toLowerCase();
      const pId = typeof doc.profile_id === 'string' ? doc.profile_id : doc.profile_id?.$id;
      const cInfo = canillitaOptionsMap[pId];
      const matchName = cInfo?.nombreComercial?.toLowerCase().includes(q) || cInfo?.titular?.toLowerCase().includes(q);
      const matchMotivo = doc.motivo?.toLowerCase().includes(q);
      const matchOrder = (typeof doc.order_id === 'string' ? doc.order_id : doc.order_id?.$id)?.toLowerCase().includes(q);
      if (!matchName && !matchMotivo && !matchOrder) return false;
    }
    return true;
  });

  // 3. Fetch past Payouts. Se filtran por $createdAt igual que los ledgers:
  // antes usaban el campo 'periodo' y las dos pestañas mostraban recortes
  // distintos para el mismo mes elegido.
  const payoutQueries = [Query.orderDesc('$createdAt'), Query.limit(500)];
  if (canillitaParam) {
    payoutQueries.unshift(Query.equal('profile_id', canillitaParam));
  }
  if (periodoDesdeIso && periodoHastaIso) {
    payoutQueries.unshift(Query.greaterThanEqual('$createdAt', periodoDesdeIso));
    payoutQueries.unshift(Query.lessThan('$createdAt', periodoHastaIso));
  }
  const payoutsRes = await databases.listDocuments('urbanpoint', 'payouts', payoutQueries);
  pastPayouts = (payoutsRes.documents || []).map((pay: any) => {
    const pId = typeof pay.profile_id === 'string' ? pay.profile_id : pay.profile_id?.$id;
    const cInfo = canillitaOptionsMap[pId];
    return {
      ...pay,
      beneficiaryName: cInfo?.nombreComercial || cInfo?.titular || 'Canillita',
      email: cInfo?.email || '',
      cbu: cInfo?.cbu || 'No informado'
    };
  });

} catch (e) {
  console.error("Error cargando panel de liquidaciones:", e);
}

// Global KPI Metrics calculation based on filtered ledgers.
// 'pendiente' (espera confirmación de entrega) y 'disponible' (liquidable ya)
// se muestran por separado: sumarlos en un solo número escondía cuánto se
// puede pagar hoy realmente.
let totalComisionCentavos = 0;
let totalFeeLogisticaCentavos = 0;
let totalComisionReferidoCentavos = 0;
let totalPorConfirmarCentavos = 0;
let totalDisponibleCentavos = 0;
let totalLiquidadoCentavos = 0;

for (const doc of allLedgerDocs) {
  const monto = doc.monto_centavos || 0;
  totalComisionCentavos += monto;

  if (doc.tipo === 'fee_logistica') {
    totalFeeLogisticaCentavos += monto;
  } else if (doc.tipo === 'comision_referido') {
    totalComisionReferidoCentavos += monto;
  }

  if (doc.estado === 'pendiente') {
    totalPorConfirmarCentavos += monto;
  } else if (doc.estado === 'disponible') {
    totalDisponibleCentavos += monto;
  } else if (doc.estado === 'liquidado') {
    totalLiquidadoCentavos += monto;
  }
}

// Group ledgers by Canillita for Tab 1 (Resumen por Canillita)
const groupedByCanillitaMap: Record<string, {
  profileId: string;
  info: any;
  feeLogisticaCentavos: number;
  referidoCentavos: number;
  pendienteCentavos: number;
  liquidadoCentavos: number;
  totalCentavos: number;
  asientosCount: number;
}> = {};

for (const doc of allLedgerDocs) {
  const pId = typeof doc.profile_id === 'string' ? doc.profile_id : doc.profile_id?.$id;
  if (!pId) continue;

  if (!groupedByCanillitaMap[pId]) {
    groupedByCanillitaMap[pId] = {
      profileId: pId,
      info: canillitaOptionsMap[pId] || {
        profileId: pId,
        nombreComercial: 'Canillita',
        titular: 'Sin Titular',
        email: '',
        phone: '',
        cbu: 'No informado',
        alias: 'No informado',
        banco: 'No especificado',
        titularCuenta: 'No especificado',
        code: 'S/CODE'
      },
      feeLogisticaCentavos: 0,
      referidoCentavos: 0,
      pendienteCentavos: 0,
      liquidadoCentavos: 0,
      totalCentavos: 0,
      asientosCount: 0
    };
  }

  const monto = doc.monto_centavos || 0;
  const group = groupedByCanillitaMap[pId];
  group.totalCentavos += monto;
  group.asientosCount += 1;

  if (doc.tipo === 'fee_logistica') group.feeLogisticaCentavos += monto;
  if (doc.tipo === 'comision_referido') group.referidoCentavos += monto;
  if (doc.estado === 'pendiente' || doc.estado === 'disponible') group.pendienteCentavos += monto;
  if (doc.estado === 'liquidado') group.liquidadoCentavos += monto;
}

// El botón "Liquidar" opera sobre el saldo disponible total del canillita
// (todos los períodos), no sobre el recorte visible.
for (const group of Object.values(groupedByCanillitaMap)) {
  (group as any).disponibleTotalCentavos = disponibleTotalByProfile[group.profileId] || 0;
}

const summaryCanillitasList = Object.values(groupedByCanillitaMap).sort((a, b) => b.pendienteCentavos - a.pendienteCentavos);

// Pagination setup
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
const pageSize = 25;

const totalLedgerItems = allLedgerDocs.length;
const totalLedgerPages = Math.ceil(totalLedgerItems / pageSize) || 1;
const pagedLedgerDocs = allLedgerDocs.slice((currentPage - 1) * pageSize, currentPage * pageSize);

const selectedCanillitaInfo = canillitaParam ? canillitaOptionsMap[canillitaParam] : null;
const selectedCanillitaStats = canillitaParam ? groupedByCanillitaMap[canillitaParam] : null;
---

<AdminLayout title="Gestión y Liquidación de Comisiones">
	<main class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
		
		<!-- Header Principal -->
		<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs">
			<div>
				<h1 class="text-2xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2.5">
					<DollarSign className="w-7 h-7 text-indigo-600" />
					Gestión & Liquidación de Comisiones
				</h1>
				<p class="text-slate-500 text-xs sm:text-sm mt-1">
					Auditoría detallada de comisiones por Canillita, fee de logística, referidos y ejecución de pagos.
				</p>
			</div>
			
			<div class="flex items-center gap-3">
				<a 
					href="/admin/liquidaciones" 
					class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition-colors flex items-center gap-2"
				>
					<RefreshCw className="w-4 h-4" />
					Limpiar Filtros
				</a>
			</div>
		</header>

		<!-- Control Surface / Filtros de Auditoría -->
		<div class="bg-white p-5 rounded-3xl border border-slate-200/80 shadow-xs space-y-4">
			<div class="flex items-center gap-2 border-b border-slate-100 pb-3">
				<Filter className="w-4 h-4 text-indigo-600" />
				<h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Filtros de Auditoría & Período</h2>
			</div>

			<form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
				<input type="hidden" name="tab" value={tabParam} />
				
				<!-- Filtro 1: Seleccionar Canillita / Punto -->
				<div>
					<label for="canillita" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
						<User className="w-3.5 h-3.5 text-slate-400" /> Canillita / Punto
					</label>
					<select 
						name="canillita" 
						id="canillita" 
						onchange="this.form.submit()"
						class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 outline-none focus:border-indigo-600 cursor-pointer"
					>
						<option value="">-- Todos los Canillitas ({canillitaOptions.length}) --</option>
						{canillitaOptions.map(c => (
							<option value={c.profileId} selected={canillitaParam === c.profileId}>
								{c.nombreComercial} ({c.titular})
							</option>
						))}
					</select>
				</div>

				<!-- Filtro 2: Período / Mes -->
				<div>
					<label for="periodo" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
						<Calendar className="w-3.5 h-3.5 text-slate-400" /> Mes / Período
					</label>
					<select 
						name="periodo" 
						id="periodo" 
						onchange="this.form.submit()"
						class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 outline-none focus:border-indigo-600 cursor-pointer"
					>
						{periodOptions.map(p => (
							<option value={p.value} selected={periodoParam === p.value}>{p.label}</option>
						))}
					</select>
				</div>

				<!-- Filtro 3: Estado de Comisión -->
				<div>
					<label for="estado" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
						<Clock className="w-3.5 h-3.5 text-slate-400" /> Estado
					</label>
					<select 
						name="estado" 
						id="estado" 
						onchange="this.form.submit()"
						class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 outline-none focus:border-indigo-600 cursor-pointer"
					>
						<option value="todos" selected={estadoParam === 'todos'}>Todas las comisiones</option>
						<option value="pendiente" selected={estadoParam === 'pendiente'}>Por confirmar (pendiente)</option>
						<option value="disponible" selected={estadoParam === 'disponible'}>Liquidable (disponible)</option>
						<option value="liquidado" selected={estadoParam === 'liquidado'}>Liquidadas / Pagadas</option>
					</select>
				</div>

				<!-- Filtro 4: Búsqueda rápida por texto -->
				<div>
					<label for="q" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
						<Search className="w-3.5 h-3.5 text-slate-400" /> Buscar por Nombre / Orden
					</label>
					<div class="relative">
						<input 
							type="text" 
							name="q" 
							id="q" 
							value={qParam} 
							placeholder="Ej: Adelina, N° Orden..." 
							class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 outline-none focus:border-indigo-600"
						/>
						<Search className="w-4 h-4 text-slate-400 absolute left-3 top-3" />
					</div>
				</div>
			</form>
		</div>

		<!-- Spotlight Card (Si hay un Canillita seleccionado) -->
		{selectedCanillitaInfo && (
			<div class="bg-gradient-to-br from-indigo-900 via-slate-900 to-indigo-950 text-white rounded-3xl p-6 shadow-xl border border-indigo-700/50 space-y-4">
				<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-indigo-800/80 pb-4">
					<div class="flex items-center gap-3.5">
						<div class="w-12 h-12 rounded-2xl bg-indigo-600 text-white font-black flex items-center justify-center text-xl shadow-lg shrink-0">
							{selectedCanillitaInfo.nombreComercial.charAt(0)}
						</div>
						<div>
							<div class="flex items-center gap-2">
								<h2 class="text-xl font-black tracking-tight">{selectedCanillitaInfo.nombreComercial}</h2>
								<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-800/80 text-indigo-200 border border-indigo-700">
									REF: {selectedCanillitaInfo.code}
								</span>
							</div>
							<p class="text-xs text-indigo-200 font-medium mt-0.5">
								Titular: <strong>{selectedCanillitaInfo.titular}</strong> &bull; {selectedCanillitaInfo.email} &bull; {selectedCanillitaInfo.phone}
							</p>
						</div>
					</div>

					{(disponibleTotalByProfile[selectedCanillitaInfo.profileId] || 0) > 0 && (
						<button
							class="btn-abrir-payout px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl shadow-lg transition-all text-xs flex items-center gap-2 cursor-pointer shrink-0 hover:scale-[1.02]"
							data-profile-id={selectedCanillitaInfo.profileId}
							data-nombre={selectedCanillitaInfo.nombreComercial}
							data-titular={selectedCanillitaInfo.titularCuenta}
							data-banco={selectedCanillitaInfo.banco}
							data-cbu={selectedCanillitaInfo.cbu}
							data-alias={selectedCanillitaInfo.alias}
							data-monto={disponibleTotalByProfile[selectedCanillitaInfo.profileId]}
						>
							<CreditCard className="w-4 h-4" />
							Liquidar Saldo Disponible ({formateador.format((disponibleTotalByProfile[selectedCanillitaInfo.profileId] || 0) / 100)})
						</button>
					)}
				</div>

				<!-- Datos Bancarios & Totales del Canillita -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
					<div class="bg-indigo-950/60 p-4 rounded-2xl border border-indigo-800/60">
						<p class="text-[10px] font-bold text-indigo-300 uppercase tracking-wider">CBU / CVU para Transferencia</p>
						<p class="text-sm font-mono font-bold text-white mt-1 select-all">{selectedCanillitaInfo.cbu}</p>
					</div>

					<div class="bg-indigo-950/60 p-4 rounded-2xl border border-indigo-800/60">
						<p class="text-[10px] font-bold text-indigo-300 uppercase tracking-wider">Alias & Banco</p>
						<p class="text-sm font-bold text-white mt-1">{selectedCanillitaInfo.alias} <span class="text-xs text-indigo-300">({selectedCanillitaInfo.banco})</span></p>
					</div>

					<div class="bg-indigo-950/60 p-4 rounded-2xl border border-indigo-800/60">
						<p class="text-[10px] font-bold text-indigo-300 uppercase tracking-wider">Titular de Cuenta</p>
						<p class="text-sm font-bold text-white mt-1">{selectedCanillitaInfo.titularCuenta}</p>
					</div>

					<div class="bg-indigo-950/60 p-4 rounded-2xl border border-indigo-800/60">
						<p class="text-[10px] font-bold text-indigo-300 uppercase tracking-wider">Saldo Pendiente Actual</p>
						<p class="text-lg font-black text-emerald-400 mt-0.5">
							{selectedCanillitaStats ? formateador.format(selectedCanillitaStats.pendienteCentavos / 100) : '$0,00'}
						</p>
					</div>
				</div>
			</div>
		)}

		<!-- KPI Metric Cards (Dinamizadas según los filtros) -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
			<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
				<div class="flex items-center justify-between text-slate-400 mb-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-500">Comisiones Totales</span>
