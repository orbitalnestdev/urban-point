---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { KpiCards } from '../../../components/admin/reportes/KpiCards';
import { CanillitasRanking } from '../../../components/admin/reportes/CanillitasRanking';
import { Download } from 'lucide-react';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

const { data, error } = await Astro.callAction(actions.getAdminReports, {});

if (error) {
  console.error("Error fetching reports:", error);
}

const reportsData = data || {
  totalVendido: 0,
  totalDevengado: 0,
  payoutsPendientes: 0,
  ranking: []
};
---

<AdminLayout title="Reportes y Métricas">
  <main class="p-8 max-w-7xl mx-auto space-y-8">
    <header class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Reportes y Métricas</h1>
        <p class="text-slate-500 font-medium mt-1">Resumen del rendimiento de la plataforma en los últimos 30 días.</p>
      </div>
      <div class="flex items-center gap-4">
        <button class="flex items-center gap-2 text-sm text-slate-700 font-bold bg-white hover:bg-slate-50 transition-colors px-4 py-2.5 rounded-xl border border-slate-200 shadow-sm">
          <Download class="w-4 h-4" />
          Exportar CSV
        </button>
      </div>
    </header>

    <KpiCards data={reportsData} />

    <div class="pt-4">
      <CanillitasRanking ranking={reportsData.ranking} />
    </div>

  </main>
</AdminLayout>
