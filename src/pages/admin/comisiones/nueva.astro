---
export const prerender = false;
// AdminLayout en lugar del Layout público: la página quedaba fuera del panel,
// con un nav propio inconsistente y sin el sidebar de administración.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import RuleForm from '../../../components/admin/RuleForm';
import { createAdminClient } from '../../../lib/server/appwrite';
import { ChevronLeft } from 'lucide-react';
import { Query } from 'node-appwrite';

const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/');
}

const { databases } = createAdminClient();

// Categorías y canillitas no dependen entre sí: en paralelo.
const [categoriasRes, canillitasRes] = await Promise.all([
  databases.listDocuments('urbanpoint', 'categories', [Query.limit(50)]),
  databases.listDocuments('urbanpoint', 'pickup_points', [
    Query.equal('estado', 'activo'),
    Query.limit(50)
  ])
]);

const categorias = categoriasRes.documents.map(c => ({ id: c.$id, name: c.nombre }));
const canillitas = canillitasRes.documents.map(c => ({ id: typeof c.profile_id === 'string' ? c.profile_id : c.profile_id.$id, name: c.nombre_comercial }));
---

<AdminLayout title="Nueva Regla de Comisión">
  <main class="bg-slate-50 py-12">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-8">
        <a href="/admin/comisiones" class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-slate-900 transition-colors mb-3">
          <ChevronLeft className="w-4 h-4" /> Volver a Comisiones
        </a>
        <h1 class="text-3xl font-bold text-slate-900">Crear Regla de Comisión</h1>
        <p class="text-slate-500 mt-1">Configura cuánto se paga por referido y por fee de logística.</p>
      </div>

      <RuleForm client:only="react" canillitas={canillitas} categorias={categorias} />
    </div>
  </main>
</AdminLayout>
