---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();
let ledgers = [];
let pickupPoints = [];

try {
	const res = await databases.listDocuments('urbanpoint', 'commission_ledger', [
		Query.equal('estado', 'pendiente'),
		Query.orderDesc('$createdAt')
	]);
	ledgers = res.documents;
	
	const resPP = await databases.listDocuments('urbanpoint', 'pickup_points');
	pickupPoints = resPP.documents;
} catch (e) {
	console.error(e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const totalPendiente = ledgers.reduce((acc, l) => acc + l.monto_centavos, 0) / 100;

// Agrupar por profile_id
const groupedLedgers = ledgers.reduce((acc, l) => {
	const pid = l.profile_id?.$id;
	if (!pid) return acc;
	if (!acc[pid]) {
		acc[pid] = {
			profile: l.profile_id,
			pickup_point: pickupPoints.find(p => p.profile_id?.$id === pid),
			total_centavos: 0,
			count: 0,
			ledgers: []
		};
	}
	acc[pid].total_centavos += l.monto_centavos;
	acc[pid].count += 1;
	acc[pid].ledgers.push(l);
	return acc;
}, {});

const groups = Object.values(groupedLedgers);
---

<AdminLayout title="Liquidación de Comisiones">
	<main class="p-8">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
			<div>
				<div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
					<span>Finanzas</span> <span class="text-slate-300">/</span> <span class="text-slate-900 font-medium">Comisiones</span>
				</div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Liquidación de Comisiones</h1>
				<p class="text-slate-500 font-medium mt-1">Gestioná los pagos a tu red de Canillitas (Puntos de Retiro).</p>
			</div>
			<div class="flex items-center gap-2">
				<button class="px-6 py-2 bg-slate-900 text-white font-bold rounded-lg hover:bg-slate-800 transition-colors shadow-md">Liquidar Todo ({formateador.format(totalPendiente)})</button>
			</div>
		</header>

		{/* Top Metric Cards */}
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Comisiones Pendientes</h3>
				<p class="text-3xl font-black text-amber-600">{formateador.format(totalPendiente)}</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm opacity-50">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Comisiones Pagadas (Mes)</h3>
				<p class="text-3xl font-black text-emerald-600">--</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Puntos a liquidar</h3>
				<p class="text-3xl font-black text-slate-900">{groups.length}</p>
			</div>
		</div>

		{/* Tabla de Liquidaciones */}
		<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
						<th class="p-4 w-12 text-center"><input type="checkbox" class="rounded border-slate-300" /></th>
						<th class="p-4">Canillita (Punto de Retiro)</th>
						<th class="p-4 text-center">Ventas Pendientes</th>
						<th class="p-4 text-right">Monto a Liquidar</th>
						<th class="p-4 text-center">Acciones</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					
					{groups.map((group: any) => (
						<tr class="hover:bg-slate-50">
							<td class="p-4 text-center"><input type="checkbox" class="rounded border-slate-300" /></td>
							<td class="p-4">
								<p class="font-bold text-slate-900">{group.pickup_point?.nombre_comercial || group.profile.nombre}</p>
								<p class="text-xs text-slate-500">
									{group.pickup_point?.cbu ? `CBU: ${group.pickup_point.cbu}` : 'Sin CBU cargado'}
								</p>
							</td>
							<td class="p-4 text-center font-bold text-slate-900">{group.count}</td>
							<td class="p-4 text-right font-black text-amber-600">{formateador.format(group.total_centavos / 100)}</td>
							<td class="p-4 text-center">
								<button class="px-3 py-1.5 bg-emerald-50 text-emerald-700 font-bold rounded-lg text-xs hover:bg-emerald-100 transition-colors">Marcar Pagado</button>
							</td>
						</tr>
					))}

					{groups.length === 0 && (
						<tr>
							<td colspan="5" class="p-8 text-center text-slate-500">No hay comisiones pendientes de liquidar.</td>
						</tr>
					)}

				</tbody>
			</table>
		</div>
	</main>
</AdminLayout>
