---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();
let ledgers: any[] = [];
let pickupPoints: any[] = [];

try {
	// liquidarComisiones() paga SOLO los asientos 'disponible' (confirmados por
	// entrega). Lo 'pendiente' todavía espera confirmación: se muestra aparte
	// para que el número de "a liquidar" coincida con lo que realmente se paga.
	// Las dos queries no dependen entre sí: se corren en paralelo.
	const [res, resPP] = await Promise.all([
		databases.listDocuments('urbanpoint', 'commission_ledger', [
			Query.equal('estado', ['pendiente', 'disponible']),
			Query.orderDesc('$createdAt'),
			Query.limit(5000)
		]),
		databases.listDocuments('urbanpoint', 'pickup_points', [Query.limit(500)])
	]);
	ledgers = res.documents;
	pickupPoints = resPP.documents;
} catch (e) {
	console.error(e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const disponibles = ledgers.filter(l => l.estado === 'disponible');
const pendientesConfirmacion = ledgers.filter(l => l.estado === 'pendiente');
const totalDisponible = disponibles.reduce((acc, l) => acc + (l.monto_centavos || 0), 0) / 100;
const totalPorConfirmar = pendientesConfirmacion.reduce((acc, l) => acc + (l.monto_centavos || 0), 0) / 100;

// Appwrite puede devolver la relación como objeto expandido o como string plano:
// usar sólo `?.$id` descartaba las filas donde venía como string.
const relId = (rel: any): string | null =>
	typeof rel === 'string' ? rel : rel?.$id || null;

// Agrupar por profile_id, separando lo liquidable de lo que espera confirmación.
const groupedLedgers = ledgers.reduce((acc: Record<string, any>, l: any) => {
	const pid = relId(l.profile_id);
	if (!pid) return acc;
	if (!acc[pid]) {
		acc[pid] = {
			profile: typeof l.profile_id === 'string' ? null : l.profile_id,
			pickup_point: pickupPoints.find(p => relId(p.profile_id) === pid),
			disponible_centavos: 0,
			pendiente_centavos: 0,
			count_disponible: 0,
			count_pendiente: 0
		};
	}
	if (l.estado === 'disponible') {
		acc[pid].disponible_centavos += l.monto_centavos || 0;
		acc[pid].count_disponible += 1;
	} else {
		acc[pid].pendiente_centavos += l.monto_centavos || 0;
		acc[pid].count_pendiente += 1;
	}
	return acc;
}, {});

const groups = Object.values(groupedLedgers);
---

<AdminLayout title="Liquidación de Comisiones">
	<main class="p-8">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
			<div>
				<div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
					<span>Finanzas</span> <span class="text-slate-300">/</span> <span class="text-slate-900 font-medium">Comisiones</span>
				</div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Comisiones de la Red</h1>
				<p class="text-slate-500 font-medium mt-1">Vista de control. Para pagar, usá la pantalla de liquidaciones.</p>
			</div>
			<div class="flex items-center gap-2">
				{/* Esta página es de solo lectura: el pago real se hace en /admin/liquidaciones. */}
				<a href="/admin/liquidaciones" class="px-6 py-2 bg-slate-900 text-white font-bold rounded-lg hover:bg-slate-800 transition-colors shadow-md">
					Ir a Liquidaciones &rarr;
				</a>
			</div>
		</header>

		{/* Top Metric Cards */}
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">A Liquidar (Confirmado)</h3>
				<p class="text-3xl font-black text-emerald-600">{formateador.format(totalDisponible)}</p>
				<p class="text-xs text-slate-400 mt-2">Asientos disponibles: entregas ya confirmadas.</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Por Confirmar</h3>
				<p class="text-3xl font-black text-amber-600">{formateador.format(totalPorConfirmar)}</p>
				<p class="text-xs text-slate-400 mt-2">Devengado, a la espera de la entrega.</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Canillitas con Saldo</h3>
				<p class="text-3xl font-black text-slate-900">{groups.length}</p>
			</div>
		</div>

		{/* Tabla resumen por canillita */}
		<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
						<th class="p-4">Canillita (Punto de Retiro)</th>
						<th class="p-4 text-center">Ventas Confirmadas</th>
						<th class="p-4 text-right">A Liquidar</th>
						<th class="p-4 text-right">Por Confirmar</th>
						<th class="p-4 text-center">Acciones</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">

					{groups.map((group: any) => (
						<tr class="hover:bg-slate-50">
							<td class="p-4">
								<p class="font-bold text-slate-900">{group.pickup_point?.nombre_comercial || group.profile?.nombre || 'Canillita'}</p>
								<p class="text-xs text-slate-500">
									{group.pickup_point?.cbu ? `CBU: ${group.pickup_point.cbu}` : 'Sin CBU cargado'}
								</p>
							</td>
							<td class="p-4 text-center font-bold text-slate-900">{group.count_disponible}</td>
							<td class="p-4 text-right font-black text-emerald-600">{formateador.format(group.disponible_centavos / 100)}</td>
							<td class="p-4 text-right font-bold text-amber-600">{formateador.format(group.pendiente_centavos / 100)}</td>
							<td class="p-4 text-center">
								<a href="/admin/liquidaciones" class="px-3 py-1.5 bg-emerald-50 text-emerald-700 font-bold rounded-lg text-xs hover:bg-emerald-100 transition-colors">Liquidar &rarr;</a>
							</td>
						</tr>
					))}

					{groups.length === 0 && (
						<tr>
							<td colspan="5" class="p-8 text-center text-slate-500">No hay comisiones pendientes de liquidar.</td>
						</tr>
					)}

				</tbody>
			</table>
		</div>
	</main>
</AdminLayout>
