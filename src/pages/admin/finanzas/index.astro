---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();
let ledgers: any[] = [];

try {
	// Sin límite explícito Appwrite devuelve 25 documentos y los totales mienten.
	const res = await databases.listDocuments('urbanpoint', 'commission_ledger', [
		Query.orderDesc('$createdAt'),
		Query.limit(5000)
	]);
	ledgers = res.documents;
} catch (e) {
	console.error(e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

// "Pendiente de pago al canillita" = devengado ('pendiente') + confirmado por
// entrega ('disponible'). Las reversas y lo revertido se excluyen: ya no se
// le deben. El estado final del ledger es 'liquidado' (no existe 'pagada').
const pendientes = ledgers.filter(l =>
	(l.estado === 'pendiente' || l.estado === 'disponible') &&
	l.tipo !== 'reversa' &&
	l.estado !== 'revertido'
);
const pagadas = ledgers.filter(l => l.estado === 'liquidado');
const totalPendientes = pendientes.reduce((acc, l) => acc + (l.monto_centavos || 0), 0) / 100;
const totalPagadas = pagadas.reduce((acc, l) => acc + (l.monto_centavos || 0), 0) / 100;

---

<AdminLayout title="Finanzas">
	<main class="p-8">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
			<div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Finanzas</h1>
				<p class="text-slate-500 font-medium mt-1">Control de ingresos, comisiones, pagos y métricas financieras.</p>
			</div>
			<div class="flex items-center gap-2 flex-wrap">
				{/* El botón "Registrar Egreso" se eliminó: no tenía handler ni pantalla detrás. */}
				<a href="/api/admin/reports?type=comisiones" class="px-3 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-lg hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					Exportar Movimientos
				</a>
			</div>
		</header>

		{/* Top Metric Cards */}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm relative overflow-hidden">
				<div class="absolute right-0 top-0 w-24 h-24 bg-emerald-50 rounded-bl-full -mr-4 -mt-4 opacity-50 z-0"></div>
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2 relative z-10">Ingresos Brutos (Mes)</h3>
				<p class="text-3xl font-black text-emerald-600 relative z-10">--</p>
			</div>
			
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm relative overflow-hidden">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2 relative z-10">Comisiones Pagadas</h3>
				<p class="text-3xl font-black text-slate-900 relative z-10">{formateador.format(totalPagadas)}</p>
				<p class="text-xs text-slate-400 mt-2 relative z-10">A la red de retiro</p>
			</div>
			
			<a href="/admin/finanzas/comisiones" class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm relative overflow-hidden cursor-pointer hover:border-amber-300 transition-colors group block">
				<div class="absolute right-0 top-0 w-24 h-24 bg-amber-50 rounded-bl-full -mr-4 -mt-4 opacity-50 z-0 group-hover:scale-110 transition-transform"></div>
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2 relative z-10">Comisiones Pendientes</h3>
				<p class="text-3xl font-black text-amber-600 relative z-10">{formateador.format(totalPendientes)}</p>
				<p class="text-xs text-slate-500 mt-2 font-bold relative z-10 uppercase tracking-wide flex items-center gap-1">Liquidar Red &rarr;</p>
			</a>
			
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm relative overflow-hidden">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2 relative z-10">Ticket Promedio</h3>
				<p class="text-3xl font-black text-indigo-600 relative z-10">--</p>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			{/* Últimos movimientos */}
			<div class="lg:col-span-2">
				<h2 class="text-xl font-bold text-slate-900 mb-4">Últimos Movimientos (Comisiones)</h2>
				<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
					<table class="w-full text-left border-collapse">
						<tbody class="divide-y divide-slate-100">
							{ledgers.map(ledger => {
								const date = new Date(ledger.$createdAt);
								const formattedDate = date.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
								const amount = ledger.monto_centavos / 100;
								
								return (
									<tr class="hover:bg-slate-50">
										<td class="p-4 w-12">
											{ledger.estado === 'pendiente' || ledger.estado === 'disponible' ? (
												<div class="w-10 h-10 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
												</div>
											) : (
												<div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center">
													<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
												</div>
											)}
										</td>
										<td class="p-4">
											<p class="font-bold text-slate-900">{ledger.motivo}</p>
											<p class="text-xs text-slate-500">Para: {ledger.profile_id?.nombre || 'N/A'}</p>
										</td>
										<td class="p-4 text-right">
											<p class={`font-black ${ledger.estado === 'pendiente' || ledger.estado === 'disponible' ? 'text-amber-600' : 'text-emerald-600'}`}>
												{formateador.format(amount)}
											</p>
											<p class="text-xs text-slate-400">{formattedDate}</p>
										</td>
									</tr>
								)
							})}
							
							{ledgers.length === 0 && (
								<tr>
									<td colspan="3" class="p-8 text-center text-slate-500">No hay movimientos de comisiones registrados.</td>
								</tr>
							)}
						</tbody>
					</table>
				</div>
			</div>

			{/* Breakdown */}
			<div>
				<h2 class="text-xl font-bold text-slate-900 mb-4">Desglose (Mes Actual)</h2>
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<div class="space-y-4">
						<div>
							<div class="flex justify-between text-sm mb-1">
								<span class="text-slate-600 font-medium">Ventas Directas</span>
								<span class="font-bold text-slate-900">--%</span>
							</div>
							<div class="w-full bg-slate-100 rounded-full h-2">
								<div class="bg-indigo-500 h-2 rounded-full" style="width: 0%"></div>
							</div>
						</div>
						<div>
							<div class="flex justify-between text-sm mb-1">
								<span class="text-slate-600 font-medium">Ventas Red de Retiro</span>
								<span class="font-bold text-slate-900">--%</span>
							</div>
							<div class="w-full bg-slate-100 rounded-full h-2">
								<div class="bg-emerald-500 h-2 rounded-full" style="width: 0%"></div>
							</div>
						</div>
					</div>

					<hr class="my-6 border-slate-100" />

					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Medios de Pago</h3>
					<div class="space-y-4">
						<div class="flex items-center justify-between opacity-50">
							<div class="flex items-center gap-3">
								<div class="w-8 h-8 rounded bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-[10px] text-slate-500">MP</div>
								<span class="text-sm font-bold text-slate-900">Mercado Pago</span>
							</div>
							<span class="text-sm font-black text-slate-900">--%</span>
						</div>
						<div class="flex items-center justify-between opacity-50">
							<div class="flex items-center gap-3">
								<div class="w-8 h-8 rounded bg-slate-100 border border-slate-200 flex items-center justify-center font-bold text-[10px] text-slate-500">TR</div>
								<span class="text-sm font-bold text-slate-900">Transferencia</span>
							</div>
							<span class="text-sm font-black text-slate-900">--%</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</AdminLayout>
