---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import { Copy, QrCode } from 'lucide-react';
import Pagination from '../../../components/admin/Pagination.astro';
import { toSafeJson } from '../../../lib/safeJson';

export const prerender = false;

const { databases } = createAdminClient();
let puntos: any[] = [];
let referidos: any[] = [];
let profiles: any[] = [];

async function fetchAllDocs(coll: string, baseQueries: any[] = []) {
	let docs: any[] = [];
	let offset = 0;
	while (true) {
		const res = await databases.listDocuments('urbanpoint', coll, [
			...baseQueries,
			Query.limit(100),
			Query.offset(offset)
		]);
		docs.push(...res.documents);
		if (res.documents.length < 100) break;
		offset += 100;
	}
	return docs;
}

try {
	[puntos, referidos, profiles] = await Promise.all([
		fetchAllDocs('pickup_points', [Query.orderDesc('$createdAt')]),
		fetchAllDocs('referral_codes'),
		fetchAllDocs('profiles')
	]);
} catch (e) {
	console.error(e);
}

const profileMap: Record<string, any> = {};
profiles.forEach(p => { profileMap[p.$id] = p; });

// Índice de códigos de referido por dueño: hacer un .find() adentro del map
// de la tabla era O(puntos × códigos) en cada render.
const refCodeByProfile = new Map<string, any>();
for (const r of referidos) {
	const ownerId = typeof r.owner_id === 'string' ? r.owner_id : r.owner_id?.$id;
	if (ownerId && !refCodeByProfile.has(ownerId)) refCodeByProfile.set(ownerId, r);
}

const searchQuery = Astro.url.searchParams.get('q') || '';
const estadoFilter = Astro.url.searchParams.get('estado') || 'todos';

let allPuntos = puntos.map(p => {
	const profId = typeof p.profile_id === 'string' ? p.profile_id : p.profile_id?.$id;
	return {
		...p,
		profileObj: profId ? profileMap[profId] : (typeof p.profile_id === 'object' ? p.profile_id : null)
	};
});

let filteredPuntos = [...allPuntos];

if (estadoFilter !== 'todos') {
	filteredPuntos = filteredPuntos.filter(p => p.estado === estadoFilter);
}
if (searchQuery.trim()) {
	const q = searchQuery.toLowerCase();
	filteredPuntos = filteredPuntos.filter(p =>
		p.nombre_comercial?.toLowerCase().includes(q) ||
		p.direccion?.toLowerCase().includes(q) ||
		p.slug?.toLowerCase().includes(q) ||
		p.localidad?.toLowerCase().includes(q)
	);
}

const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
const pageSize = 25;
const totalFiltered = filteredPuntos.length;
const totalPages = Math.ceil(totalFiltered / pageSize) || 1;
const pagedPuntos = filteredPuntos.slice((currentPage - 1) * pageSize, currentPage * pageSize);
puntos = pagedPuntos;

const activeCount = allPuntos.filter(p => p.estado === 'activo').length;
const pendingCount = allPuntos.filter(p => p.estado === 'pendiente').length;
const suspendedCount = allPuntos.filter(p => p.estado === 'suspendido').length;
---

<AdminLayout title="Red de Retiro y Canillitas">
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
	
	<main class="p-6 md:p-8 max-w-7xl mx-auto">
		<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
			<div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Red de Retiro & Canillitas</h1>
				<p class="text-slate-500 font-medium mt-1">Gestión integral de puntos de entrega, estado de canillitas y códigos de referido.</p>
			</div>
			<div class="flex items-center gap-3">
				<a href="/admin/canillitas/solicitudes" class="px-4 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-xl hover:bg-slate-200 transition-colors text-sm">
					Ver Solicitudes
				</a>
				<button id="btn-nuevo-punto" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all shadow-md flex items-center gap-2 cursor-pointer text-sm">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
					Nuevo Punto de Retiro
				</button>
			</div>
		</header>

		{/* Top Metric Cards */}
		<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-400 text-xs uppercase tracking-wider mb-1">Puntos Activos</h3>
				<p class="text-3xl font-extrabold text-emerald-600">{activeCount}</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-400 text-xs uppercase tracking-wider mb-1">Pendientes de Activación</h3>
				<p class="text-3xl font-extrabold text-amber-600">{pendingCount}</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-400 text-xs uppercase tracking-wider mb-1">Suspendidos</h3>
				<p class="text-3xl font-extrabold text-rose-600">{suspendedCount}</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-400 text-xs uppercase tracking-wider mb-1">Códigos de Referido</h3>
				<p class="text-3xl font-extrabold text-indigo-600">{referidos.filter(r => r.activo).length}</p>
			</div>
		</div>

		{/* ABM Table for Pickup Points */}
		<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm mb-12">
			<div class="p-6 border-b border-slate-200 flex items-center justify-between">
				<h2 class="text-xl font-bold text-slate-900">Puntos de Retiro Registrados</h2>
				<span class="text-xs text-slate-500 font-medium">Total: {puntos.length} puntos</span>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
							<th class="p-4">Punto / Local</th>
							<th class="p-4">URL del Nodo</th>
							<th class="p-4">Ubicación / Coordenadas</th>
							<th class="p-4 text-center">Código REF</th>
							<th class="p-4 text-center">Horarios</th>
							<th class="p-4 text-center">Estado</th>
							<th class="p-4 text-right">Acciones</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 text-sm">
						{puntos.map(punto => {
							const puntoProfileId = typeof punto.profile_id === 'string' ? punto.profile_id : punto.profile_id?.$id;
							const refCode = puntoProfileId ? refCodeByProfile.get(puntoProfileId) : undefined;

							return (
								<tr class="hover:bg-slate-50 transition-colors">
									<td class="p-4">
										<p class="font-bold text-slate-900">{punto.nombre_comercial}</p>
										<p class="text-xs text-slate-500">{punto.direccion}</p>
										{punto.profileObj && punto.profileObj.email ? (
											<p class="text-[11px] font-semibold text-indigo-700 mt-0.5 flex items-center gap-1">
												<span>🟢 Acceso Canillita:</span> <strong>{punto.profileObj.email}</strong>
											</p>
										) : (
											<p class="text-[11px] font-medium text-slate-400 mt-0.5 flex items-center gap-1">
												<span>⚪ Solo Punto (Sin Usuario)</span>
												&bull; 
												<button 
													type="button" 
													class="btn-editar-punto text-indigo-600 font-bold hover:underline cursor-pointer"
													data-punto={toSafeJson(punto)}
												>
													+ Crear Acceso
												</button>
											</p>
										)}
									</td>
									<td class="p-4">
										{punto.slug ? (
											<div class="flex items-center gap-1.5">
												<a href={`/${punto.slug}`} target="_blank" class="font-mono text-xs text-emerald-700 font-bold hover:underline">
													/{punto.slug}
												</a>
												<button 
													class="btn-copy-node-url p-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded transition-colors text-[10px] font-bold cursor-pointer"
													data-slug={punto.slug}
													title="Copiar URL directa del Nodo"
												>
													<Copy className="w-3 h-3" />
												</button>
											</div>
										) : (
											<span class="text-xs text-slate-400 italic">Sin URL</span>
										)}
									</td>
									<td class="p-4">
										<p class="font-medium text-slate-700">{punto.localidad}, {punto.provincia}</p>
										<p class="text-xs font-mono text-slate-400">Lat: {punto.lat}, Lng: {punto.lng}</p>
									</td>
									<td class="p-4 text-center">
										{refCode ? (
											<div class="flex items-center justify-center gap-1.5">
												<span class={`inline-block font-mono font-bold text-xs px-2.5 py-1 rounded border ${refCode.activo ? 'bg-indigo-50 text-indigo-700 border-indigo-200' : 'bg-slate-100 text-slate-500 border-slate-200 line-through'}`}>
													{refCode.code}
												</span>
												<button 
													class="btn-copy-full-link p-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded transition-colors text-[10px] font-bold cursor-pointer"
													data-code={refCode.code}
													title="Copiar Link Completo de Referido"
												>
													<span class="inline-flex items-center gap-1"><Copy className="w-3 h-3" /> Link</span>
												</button>
											</div>
										) : (
											<span class="text-xs text-slate-400 italic">Sin código</span>
										)}
									</td>
									<td class="p-4 text-center text-xs text-slate-600 font-medium">
										{punto.horarios || 'No especificado'}
									</td>
									<td class="p-4 text-center">
										{punto.estado === 'activo' && (
											<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Activo</span>
										)}
										{punto.estado === 'pendiente' && (
											<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">Pendiente</span>
										)}
										{punto.estado === 'suspendido' && (
											<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200">Suspendido</span>
										)}
										{punto.estado === 'baja' && (
											<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">Baja</span>
										)}
									</td>
									<td class="p-4 text-right space-x-2 whitespace-nowrap">
										{puntoProfileId && (
											<a 
												href={`/api/admin/impersonate?profile_id=${puntoProfileId}`} 
												title="Ingresar a la app impersonando a este Canillita" 
												class="px-2.5 py-1 bg-amber-50 hover:bg-amber-100 text-amber-800 font-bold text-xs rounded-lg transition-colors border border-amber-200 inline-flex items-center gap-1 cursor-pointer"
											>
												👁️ Probar
											</a>
										)}
										{punto.slug && (
											<button 
												class="btn-generar-qr px-2.5 py-1 bg-[#E2EFE4] hover:bg-[#D4E5D6] text-[#2D5A27] font-extrabold text-xs rounded-lg transition-colors cursor-pointer inline-flex items-center gap-1.5"
												data-slug={punto.slug}
												data-nombre={punto.nombre_comercial}
												data-direccion={punto.direccion}
												title="Generar QR y Afiche del Puesto"
											>
												<QrCode className="w-3.5 h-3.5" /> Afiche QR
											</button>
										)}
										<button 
											class="btn-editar-punto text-indigo-600 hover:text-indigo-800 font-bold text-xs cursor-pointer"
											data-punto={toSafeJson(punto)}
										>
											Editar
										</button>
										{refCode && (
											<button 
												class="btn-regenerar-code text-amber-600 hover:text-amber-800 font-bold text-xs cursor-pointer"
												data-profile={puntoProfileId}
											>
												Regenerar REF
											</button>
										)}
										<button 
											class="btn-eliminar-punto text-rose-600 hover:text-rose-800 font-bold text-xs cursor-pointer"
											data-id={punto.$id}
										>
											Eliminar
										</button>
									</td>
								</tr>
							);
						})}

						{puntos.length === 0 && (
							<tr>
								<td colspan="7" class="p-8 text-center text-slate-500">No hay puntos de retiro registrados.</td>
							</tr>
						)}
					</tbody>
				</table>

				<Pagination 
					currentPage={currentPage} 
					totalPages={totalPages} 
					totalItems={totalFiltered} 
					pageSize={pageSize} 
					searchParams={Astro.url.searchParams} 
					baseUrl="/admin/canillitas" 
				/>
			</div>
		</div>
	</main>

	<!-- Modal Afiche / QR del Puesto -->
	<div id="modal-qr-afiche" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4 hidden">
		<div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 text-center border-4 border-[#2D5A27] relative overflow-hidden">
			<button id="btn-close-qr-modal" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>

			<div class="space-y-4">
				<div class="inline-flex items-center gap-2 px-3.5 py-1 bg-[#E2EFE4] text-[#2D5A27] font-extrabold text-xs uppercase tracking-wider rounded-full">
					UrbanPoint POS
				</div>

				<h2 id="qr-modal-nombre" class="text-2xl font-black text-slate-900 leading-tight">Nombre del Puesto</h2>
				<p id="qr-modal-direccion" class="text-xs text-slate-500 font-medium">Dirección del Puesto</p>

				<div class="p-4 bg-slate-50 border-2 border-slate-200 rounded-2xl inline-block shadow-inner my-2">
					<img id="qr-code-img" src="" alt="QR Code" class="w-60 h-60 mx-auto object-contain" />
				</div>

				<div class="space-y-1">
					<p class="text-[11px] font-extrabold text-slate-400 uppercase tracking-widest">Escaneá con tu celular para comprar</p>
					<p id="qr-modal-url" class="font-mono text-sm font-extrabold text-[#2D5A27]">urbanpoint.com.ar/slug</p>
				</div>

				<div class="pt-4 border-t border-slate-100 flex gap-3 justify-center">
					<a id="btn-download-qr-img" download="qr-urbanpoint.png" href="#" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition-colors">
						Descargar QR (PNG)
					</a>
					<button id="btn-print-poster" class="px-4 py-2.5 bg-[#2D5A27] hover:bg-[#23471F] text-white text-xs font-bold rounded-xl transition-colors shadow-md">
						Imprimir Afiche
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal ABM Punto de Retiro con Selector de Mapa -->
	<div id="modal-punto" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
		<div class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full p-6 max-h-[90vh] overflow-y-auto">
			<div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200">
				<h3 id="modal-title" class="text-xl font-bold text-slate-900">Punto de Retiro</h3>
				<button id="btn-close-modal" class="text-slate-400 hover:text-slate-600 text-2xl font-bold">&times;</button>
			</div>

			<form id="form-punto" class="space-y-4">
				<input type="hidden" id="punto-id" />
				
				<!-- Sección 1: Datos Comerciales y Estado -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nombre Comercial del Puesto</label>
						<input type="text" id="punto-nombre" required placeholder="Ej: ADELINA25" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Estado del Punto</label>
						<select id="punto-estado" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600 cursor-pointer">
							<option value="activo">Activo</option>
							<option value="pendiente">Pendiente</option>
							<option value="suspendido">Suspendido</option>
							<option value="baja">Baja</option>
						</select>
					</div>
				</div>

				<!-- Sección 2: Cuenta de Usuario del Canillita (Acceso a Portal /canillita) -->
				<div class="bg-indigo-50/70 border border-indigo-200 rounded-2xl p-4 space-y-3">
					<div class="flex items-center justify-between">
						<h4 class="text-xs font-black text-indigo-900 uppercase tracking-wider flex items-center gap-1.5">
							👤 Cuenta de Usuario Canillita (Portal /canillita)
						</h4>
						<span class="text-[10px] bg-indigo-200 text-indigo-800 font-bold px-2 py-0.5 rounded-full">Rol: Canillita</span>
					</div>
					<p class="text-[11px] text-slate-600 font-medium leading-relaxed">
						Completá Email y Contraseña para que el Canillita pueda ingresar a su portal (<code class="bg-white px-1.5 py-0.5 rounded border border-indigo-200 text-indigo-700">/canillita/login</code>). Válido para puestos nuevos o puestos existentes sin usuario.
					</p>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nombre y Apellido del Titular</label>
							<input type="text" id="punto-titular-nombre" placeholder="Ej: Juan Pérez" class="w-full px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email de Acceso (Usuario)</label>
							<input type="email" id="punto-email" placeholder="canillita@ejemplo.com" class="w-full px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
						</div>
					</div>
					<div>
						<div class="flex items-center justify-between mb-1">
							<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
								Contraseña de Acceso <span id="pwd-help-text" class="text-[10px] text-slate-500 font-normal">(Mín. 8 caracteres)</span>
							</label>
							<div class="flex items-center gap-2">
								<button type="button" id="btn-gen-password" class="text-[11px] bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-2.5 py-1 rounded-lg transition-colors cursor-pointer shadow-xs">
									🎲 Generar Contraseña
								</button>
								<button type="button" id="btn-copy-credentials" class="text-[11px] bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-2.5 py-1 rounded-lg transition-colors cursor-pointer shadow-xs hidden">
									📋 Copiar Acceso
								</button>
							</div>
						</div>
						<input type="text" id="punto-password" placeholder="••••••••" class="w-full px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-mono outline-none focus:border-indigo-600" />
					</div>
				</div>

				<!-- Sección 3: Ubicación y Contacto -->
				<div>
					<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Dirección Completa (Calle y Altura)</label>
					<input type="text" id="punto-direccion" required placeholder="Ej: Jerónimo Salguero 420" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Localidad / Barrio</label>
						<input type="text" id="punto-localidad" required placeholder="Almagro" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Provincia</label>
						<input type="text" id="punto-provincia" required placeholder="CABA" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">URL amigable (Slug de Nodo)</label>
						<input type="text" id="punto-slug" placeholder="adelina25" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono outline-none focus:border-indigo-600" />
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Teléfono / WhatsApp de Contacto</label>
						<input type="text" id="punto-telefono" placeholder="(11) 2478-5603" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Horarios de Atención</label>
						<input type="text" id="punto-horarios" required placeholder="Lunes a Sábado 08 a 20hs" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Comisión Personalizada % (Opcional)</label>
						<input type="number" id="punto-comision" placeholder="10" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600" />
					</div>
				</div>

				<!-- Sección 4: Mapa Interactivo con Geocodificador -->
				<div class="space-y-2 pt-2 border-t border-slate-200">
					<div class="flex items-center justify-between">
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Ubicación Geográfica en Mapa Interactivo</label>
						<span class="text-[11px] text-indigo-700 font-semibold">📍 Arrastrá el marcador o hacé clic en el mapa</span>
					</div>
					
					<!-- Buscador en mapa -->
					<div class="flex items-center gap-2">
						<input type="text" id="map-search-input" placeholder="Buscar dirección en el mapa (ej: Jeronimo Salguero 420, CABA)..." class="flex-1 px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-600" />
						<button type="button" id="btn-search-map" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl text-xs transition-colors cursor-pointer shrink-0">
							🔍 Ubicar en Mapa
						</button>
					</div>

					<div id="modal-map" class="w-full h-60 rounded-2xl border-2 border-slate-200 overflow-hidden relative shadow-inner z-0"></div>
					<div class="grid grid-cols-2 gap-4 text-xs font-mono text-slate-700 bg-slate-50 p-2.5 rounded-xl border border-slate-200">
						<div>Latitud: <span id="span-lat" class="font-bold text-slate-900">-34.6037</span></div>
						<div>Longitud: <span id="span-lng" class="font-bold text-slate-900">-58.3816</span></div>
					</div>
				</div>

				<div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
					<button type="button" id="btn-cancel-modal" class="px-5 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-xl hover:bg-slate-200 text-sm">Cancelar</button>
					<button type="submit" id="btn-save-punto" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md text-sm cursor-pointer">Guardar Canillita y Punto</button>
				</div>
			</form>
		</div>
	</div>

	<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
	<script>
		import { actions } from 'astro:actions';
		import QRCode from 'qrcode';

		const modal = document.getElementById('modal-punto');
		const modalTitle = document.getElementById('modal-title');
		const formPunto = document.getElementById('form-punto') as HTMLFormElement;
		const btnNuevo = document.getElementById('btn-nuevo-punto');
		const btnClose = document.getElementById('btn-close-modal');
		const btnCancel = document.getElementById('btn-cancel-modal');

		const modalQr = document.getElementById('modal-qr-afiche');
		const btnCloseQr = document.getElementById('btn-close-qr-modal');
		const qrNombre = document.getElementById('qr-modal-nombre');
		const qrDireccion = document.getElementById('qr-modal-direccion');
		const qrUrl = document.getElementById('qr-modal-url');
		const qrImg = document.getElementById('qr-code-img') as HTMLImageElement;
		const btnDownloadQr = document.getElementById('btn-download-qr-img') as HTMLAnchorElement;

		const inputId = document.getElementById('punto-id') as HTMLInputElement;
		const inputNombre = document.getElementById('punto-nombre') as HTMLInputElement;
		const inputTitularNombre = document.getElementById('punto-titular-nombre') as HTMLInputElement;
		const inputEmail = document.getElementById('punto-email') as HTMLInputElement;
		const inputPassword = document.getElementById('punto-password') as HTMLInputElement;
		const pwdHelpText = document.getElementById('pwd-help-text');
		const inputSlug = document.getElementById('punto-slug') as HTMLInputElement;
		const inputTelefono = document.getElementById('punto-telefono') as HTMLInputElement;
		const inputEstado = document.getElementById('punto-estado') as HTMLSelectElement;
		const inputDireccion = document.getElementById('punto-direccion') as HTMLInputElement;
		const inputLocalidad = document.getElementById('punto-localidad') as HTMLInputElement;
		const inputProvincia = document.getElementById('punto-provincia') as HTMLInputElement;
		const inputHorarios = document.getElementById('punto-horarios') as HTMLInputElement;
		const inputComision = document.getElementById('punto-comision') as HTMLInputElement;
		const spanLat = document.getElementById('span-lat')!;
		const spanLng = document.getElementById('span-lng')!;

		let currentLat = -34.6037;
		let currentLng = -58.3816;
		let map: any = null;
		let marker: any = null;

		btnCloseQr?.addEventListener('click', () => modalQr?.classList.add('hidden'));

		document.querySelectorAll('.btn-generar-qr').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const target = e.currentTarget as HTMLElement;
				const slug = target.dataset.slug || '';
				const nombre = target.dataset.nombre || '';
				const direccion = target.dataset.direccion || '';
				const fullUrl = `${window.location.origin}/${slug}`;

				if (qrNombre) qrNombre.textContent = nombre;
				if (qrDireccion) qrDireccion.textContent = direccion;
				if (qrUrl) qrUrl.textContent = fullUrl.replace(/^https?:\/\//, '');

				try {
					const dataUrl = await QRCode.toDataURL(fullUrl, {
						width: 400,
						margin: 2,
						color: { dark: '#2D5A27', light: '#FFFFFF' }
					});
					if (qrImg) qrImg.src = dataUrl;
					if (btnDownloadQr) {
						btnDownloadQr.href = dataUrl;
						btnDownloadQr.download = `qr-urbanpoint-${slug}.png`;
					}
					modalQr?.classList.remove('hidden');
				} catch (err) {
					console.error('Error generando QR:', err);
				}
			});
		});

		function initModalMap(lat: number, lng: number) {
			currentLat = lat;
			currentLng = lng;
			spanLat.textContent = lat.toFixed(6);
			spanLng.textContent = lng.toFixed(6);

			if (!map && typeof (window as any).L !== 'undefined') {
				const L = (window as any).L;
				map = L.map('modal-map').setView([lat, lng], 15);
				L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
					maxZoom: 19,
					attribution: '&copy; OpenStreetMap'
				}).addTo(map);

				marker = L.marker([lat, lng], { draggable: true }).addTo(map);

				// Arrastrar el pin actualiza coordenadas
				marker.on('dragend', () => {
					const pos = marker.getLatLng();
					currentLat = pos.lat;
					currentLng = pos.lng;
					spanLat.textContent = pos.lat.toFixed(6);
					spanLng.textContent = pos.lng.toFixed(6);
				});

				// Hacer clic en cualquier lugar del mapa coloca el pin allí
				map.on('click', (e: any) => {
					const pos = e.latlng;
					marker.setLatLng(pos);
					currentLat = pos.lat;
					currentLng = pos.lng;
					spanLat.textContent = pos.lat.toFixed(6);
					spanLng.textContent = pos.lng.toFixed(6);
				});
			} else if (map && marker) {
				map.setView([lat, lng], 15);
				marker.setLatLng([lat, lng]);
			}

			// Asegurar que Leaflet recalcule tamaño para evitar baldosas grises
			setTimeout(() => { if (map) map.invalidateSize(); }, 150);
			setTimeout(() => { if (map) map.invalidateSize(); }, 350);
		}

		// Geocodificador con OpenStreetMap Nominatim
		document.getElementById('btn-search-map')?.addEventListener('click', async () => {
			const searchInput = (document.getElementById('map-search-input') as HTMLInputElement)?.value.trim();
			const address = searchInput || `${inputDireccion.value}, ${inputLocalidad.value}`;
			if (!address) {
				alert('Ingresá una dirección para buscar en el mapa.');
				return;
			}

			try {
				const query = encodeURIComponent(`${address}, Argentina`);
				const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${query}`);
				const data = await res.json();
				if (data && data.length > 0) {
					const newLat = parseFloat(data[0].lat);
					const newLng = parseFloat(data[0].lon);
					initModalMap(newLat, newLng);
				} else {
					alert('No se encontró la dirección en el mapa. Podés hacer clic o arrastrar el marcador manualmente.');
				}
			} catch(err) {
				console.error('Error buscando dirección:', err);
			}
		});

		document.getElementById('btn-gen-password')?.addEventListener('click', () => {
			const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$';
			let pass = 'Urban2026!';
			for (let i = 0; i < 4; i++) {
				pass += chars.charAt(Math.floor(Math.random() * chars.length));
			}
			inputPassword.value = pass;
			const btnCopy = document.getElementById('btn-copy-credentials');
			if (btnCopy) btnCopy.classList.remove('hidden');
		});

		document.getElementById('btn-copy-credentials')?.addEventListener('click', () => {
			const email = inputEmail.value.trim();
			const pass = inputPassword.value.trim();
			if (!email || !pass) {
				alert('Completá email y contraseña antes de copiar.');
				return;
			}
			const text = `Acceso Panel Canillita (UrbanPoint):\nURL: ${window.location.origin}/canillita/login\nUsuario: ${email}\nContraseña: ${pass}`;
			navigator.clipboard.writeText(text).then(() => {
				alert('¡Credenciales copiadas al portapapeles!\n\n' + text);
			});
		});

		function openModal(data: any = null) {
			if (data) {
				modalTitle!.textContent = 'Editar Canillita y Punto de Retiro';
				inputId.value = data.$id;
				inputNombre.value = data.nombre_comercial || '';
				inputTitularNombre.value = data.profileObj?.nombre || '';
				inputEmail.value = data.profileObj?.email || '';
				inputPassword.value = '';
				if (pwdHelpText) pwdHelpText.textContent = '(Opcional: Dejar en blanco para mantener contraseña actual)';
				inputSlug.value = data.slug || '';
				inputTelefono.value = data.telefono || data.profileObj?.telefono || '';
				inputEstado.value = data.estado || 'activo';
				inputDireccion.value = data.direccion || '';
				inputLocalidad.value = data.localidad || 'CABA';
				inputProvincia.value = data.provincia || 'CABA';
				inputHorarios.value = data.horarios || 'Lunes a Viernes 9 a 18hs';
				inputComision.value = data.comision_pct !== undefined ? data.comision_pct : '';
				initModalMap(data.lat || -34.6037, data.lng || -58.3816);
			} else {
				modalTitle!.textContent = 'Nuevo Canillita y Punto de Retiro';
				inputId.value = '';
				inputNombre.value = '';
				inputTitularNombre.value = '';
				inputEmail.value = '';
				inputPassword.value = '';
				if (pwdHelpText) pwdHelpText.textContent = '(Obligatoria al crear: Mínimo 8 caracteres)';
				inputSlug.value = '';
				inputTelefono.value = '';
				inputEstado.value = 'activo';
				inputDireccion.value = '';
				inputLocalidad.value = 'CABA';
				inputProvincia.value = 'CABA';
				inputHorarios.value = 'Lunes a Viernes 9 a 18hs';
				inputComision.value = '';
				initModalMap(-34.6037, -58.3816);
			}
			modal!.classList.remove('hidden');
		}

		function closeModal() {
			modal!.classList.add('hidden');
		}

		btnNuevo?.addEventListener('click', () => openModal());
		btnClose?.addEventListener('click', closeModal);
		btnCancel?.addEventListener('click', closeModal);

		document.querySelectorAll('.btn-editar-punto').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const data = JSON.parse((e.currentTarget as HTMLElement).dataset.punto || '{}');
				openModal(data);
			});
		});

		document.querySelectorAll('.btn-eliminar-punto').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const id = (e.currentTarget as HTMLElement).dataset.id;
				if (!id || !confirm('¿Estás seguro de eliminar este punto de retiro?')) return;
				const { data, error } = await actions.deletePickupPoint({ id });
				if (error || !data?.success) {
					alert(error?.message || 'Error al eliminar');
				} else {
					window.location.reload();
				}
			});
		});

		document.querySelectorAll('.btn-regenerar-code').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const profileId = (e.currentTarget as HTMLElement).dataset.profile;
				if (!profileId || !confirm('¿Regenerar el código de referido para este canillita?')) return;
				const { data, error } = await actions.regenerateReferralCode({ profileId });
				if (error || !data?.success) {
					alert(error?.message || 'Error al regenerar código');
				} else {
					alert(`Nuevo código generado: ${data.code}`);
					window.location.reload();
				}
			});
		});

		formPunto?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const id = inputId.value;
			
			if (!id && inputEmail.value && (!inputPassword.value || inputPassword.value.length < 8)) {
				alert('Al crear un nuevo Canillita, la contraseña de acceso es obligatoria (mínimo 8 caracteres).');
				return;
			}

			const payload = {
				id: id || undefined,
				nombre_comercial: inputNombre.value,
				titular_nombre: inputTitularNombre.value || undefined,
				email: inputEmail.value || undefined,
				password: inputPassword.value || undefined,
				slug: inputSlug.value || undefined,
				direccion: inputDireccion.value,
				localidad: inputLocalidad.value,
				provincia: inputProvincia.value,
				horarios: inputHorarios.value,
				telefono: inputTelefono.value || undefined,
				estado: inputEstado.value as any,
				comision_pct: inputComision.value ? parseInt(inputComision.value, 10) : undefined,
				lat: typeof currentLat === 'number' && !isNaN(currentLat) ? currentLat : -34.6037,
				lng: typeof currentLng === 'number' && !isNaN(currentLng) ? currentLng : -58.3816
			};

			const btnSave = document.getElementById('btn-save-punto') as HTMLButtonElement;
			btnSave.disabled = true;
			btnSave.textContent = 'Guardando...';

			const { data, error } = await actions.savePickupPoint(payload);
			if (error || !data?.success) {
				alert(data?.error || error?.message || 'Error al guardar el punto');
				btnSave.disabled = false;
				btnSave.textContent = 'Guardar Canillita y Punto';
			} else {
				window.location.reload();
			}
		});

		document.querySelectorAll('.btn-copy-node-url').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const slug = (e.currentTarget as HTMLElement).dataset.slug || '';
				const fullUrl = `${window.location.origin}/${slug}`;
				navigator.clipboard.writeText(fullUrl).then(() => {
					alert(`¡URL del Nodo copiada al portapapeles!\n${fullUrl}`);
				});
			});
		});

		document.querySelectorAll('.btn-copy-full-link').forEach(btn => {
			btn.addEventListener('click', (e) => {
				const code = (e.currentTarget as HTMLElement).dataset.code || '';
				const fullUrl = `${window.location.origin}/?ref=${code}`;
				navigator.clipboard.writeText(fullUrl).then(() => {
					alert(`¡Link copiado al portapapeles!\n${fullUrl}`);
				});
			});
		});
	</script>
</AdminLayout>
