---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { Client, Databases } from 'node-appwrite';
import { APPWRITE_API_KEY } from 'astro:env/server';
import { PUBLIC_APPWRITE_ENDPOINT, PUBLIC_APPWRITE_PROJECT_ID } from 'astro:env/client';

const { id } = Astro.params;

const client = new Client()
	.setEndpoint(PUBLIC_APPWRITE_ENDPOINT)
	.setProject(PUBLIC_APPWRITE_PROJECT_ID)
	.setKey(APPWRITE_API_KEY);

const db = new Databases(client);

let app = null;
try {
	app = await db.getDocument('urbanpoint', 'canillita_applications', id as string);
} catch (error) {
	return Astro.redirect('/admin/canillitas/solicitudes?error=not_found');
}

if (!app || app.estado !== 'solicitado') {
	return Astro.redirect('/admin/canillitas/solicitudes');
}
---

<AdminLayout title={`Solicitud: ${app.nombre_comercial}`}>
	<div class="max-w-4xl mx-auto">
		<header class="flex items-center justify-between mb-8 border-b border-slate-200 pb-8">
			<div>
				<div class="flex items-center gap-3 mb-2">
					<h1 class="text-3xl font-extrabold text-slate-900">{app.nombre_comercial}</h1>
					<span class="bg-amber-100 text-amber-700 text-xs font-bold px-2 py-1 rounded border border-amber-200">PENDIENTE</span>
				</div>
				<p class="text-slate-500">Recibida el {new Date(app.$createdAt).toLocaleString()}</p>
			</div>
			
			<div class="flex gap-4">
				<button id="btn-rechazar" class="px-6 py-2.5 bg-white border border-red-200 text-red-600 hover:bg-red-50 hover:border-red-300 font-semibold rounded-xl transition-colors">
					Rechazar
				</button>
				<button id="btn-aprobar" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-600/20 transition-all flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
					Aprobar y Crear Punto
				</button>
			</div>
		</header>

		<div class="grid grid-cols-2 gap-8">
			<div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
				<h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
					Datos del Titular
				</h3>
				<div class="space-y-4">
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">Nombre Completo</p>
						<p class="text-slate-900 font-medium">{app.nombre} {app.apellido}</p>
					</div>
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">DNI</p>
						<p class="text-slate-900 font-medium">{app.dni}</p>
					</div>
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">Email</p>
						<a href={`mailto:${app.email}`} class="text-indigo-600 font-medium hover:underline">{app.email}</a>
					</div>
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">Teléfono</p>
						<p class="text-slate-900 font-medium">{app.telefono}</p>
					</div>
				</div>
			</div>

			<div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
				<h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
					Datos del Local
				</h3>
				<div class="space-y-4">
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">Nombre Comercial</p>
						<p class="text-slate-900 font-medium">{app.nombre_comercial}</p>
					</div>
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">Dirección</p>
						<p class="text-slate-900 font-medium">{app.direccion}</p>
					</div>
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">Coordenadas</p>
						<p class="text-slate-900 font-medium">{app.lat}, {app.lng}</p>
						<a href={`https://www.google.com/maps?q=${app.lat},${app.lng}`} target="_blank" class="text-sm text-indigo-600 hover:underline inline-block mt-1">Ver en Google Maps</a>
					</div>
					<div>
						<p class="text-sm font-medium text-slate-500 mb-1">Horarios</p>
						<p class="text-slate-900 font-medium">{app.horarios}</p>
					</div>
				</div>
			</div>
		</div>
		
		<div class="mt-8 bg-blue-50 border border-blue-100 p-6 rounded-2xl flex items-start gap-4">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500 shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
			<div>
				<h4 class="font-bold text-blue-900 mb-1">¿Qué pasa al aprobar?</h4>
				<p class="text-sm text-blue-800">
					Se creará una cuenta de usuario para este email si no existe, se generará el perfil de <strong>Canillita</strong>, el <strong>Punto de Retiro</strong> en estado pendiente de activación, y su código de referidos.
				</p>
			</div>
		</div>
	</div>
</AdminLayout>

<script>
	import { actions } from 'astro:actions';
	
	const btnAprobar = document.getElementById('btn-aprobar');
	const btnRechazar = document.getElementById('btn-rechazar');
	const appId = window.location.pathname.split('/').pop();

	if (btnAprobar) {
		btnAprobar.addEventListener('click', async () => {
			btnAprobar.setAttribute('disabled', 'true');
			btnAprobar.innerHTML = 'Procesando...';
			
			try {
				const { data, error } = await actions.approveCanillita({ applicationId: appId! });
				if (error || !data?.success) {
					alert(error?.message || data?.error || 'Ocurrió un error al aprobar.');
					btnAprobar.removeAttribute('disabled');
					btnAprobar.innerHTML = 'Aprobar y Crear Punto';
					return;
				}
				
				alert('¡Canillita aprobado y punto de retiro creado exitosamente!');
				window.location.href = '/admin/canillitas/solicitudes';
			} catch (err) {
				alert('Ocurrió un error inesperado.');
				btnAprobar.removeAttribute('disabled');
				btnAprobar.innerHTML = 'Aprobar y Crear Punto';
			}
		});
	}

	if (btnRechazar) {
		btnRechazar.addEventListener('click', async () => {
			const motivo = prompt('Ingresá el motivo de rechazo (será visible para soporte):');
			if (!motivo) return;
			
			btnRechazar.setAttribute('disabled', 'true');
			btnRechazar.innerHTML = 'Rechazando...';
			
			try {
				const { data, error } = await actions.rejectCanillita({ applicationId: appId!, motivo });
				if (error || !data?.success) {
					alert(error?.message || data?.error || 'Ocurrió un error al rechazar.');
					btnRechazar.removeAttribute('disabled');
					btnRechazar.innerHTML = 'Rechazar';
					return;
				}
				
				alert('Solicitud rechazada.');
				window.location.href = '/admin/canillitas/solicitudes';
			} catch (err) {
				alert('Ocurrió un error inesperado.');
				btnRechazar.removeAttribute('disabled');
				btnRechazar.innerHTML = 'Rechazar';
			}
		});
	}
</script>
