---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { Query } from 'node-appwrite';
import { createAdminClient } from '../../../../lib/server/appwrite';

const { databases } = createAdminClient();

const estadoParam = Astro.url.searchParams.get('estado') || 'solicitado';

let applications: any[] = [];
try {
	const queries = [Query.orderDesc('$createdAt')];
	if (estadoParam !== 'todos') {
		queries.unshift(Query.equal('estado', estadoParam));
	}
	const response = await databases.listDocuments('urbanpoint', 'canillita_applications', queries);
	applications = response.documents;
} catch (error) {
	console.error(error);
}
---

<AdminLayout title="Solicitudes de Canillitas">
	<div class="max-w-5xl mx-auto">
		<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<h1 class="text-3xl font-extrabold text-slate-900">Solicitudes de Canillitas</h1>
				<p class="text-slate-500 mt-1">Revisá y aprobá nuevos locales para sumarse a la red.</p>
			</div>
			<div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-xl text-xs font-bold">
				<a href="?estado=solicitado" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoParam === 'solicitado' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900'}`}>Solicitados</a>
				<a href="?estado=aprobado" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoParam === 'aprobado' ? 'bg-white text-emerald-700 shadow-xs' : 'text-slate-600 hover:text-slate-900'}`}>Aprobados</a>
				<a href="?estado=rechazado" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoParam === 'rechazado' ? 'bg-white text-rose-700 shadow-xs' : 'text-slate-600 hover:text-slate-900'}`}>Rechazados</a>
				<a href="?estado=suspendido" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoParam === 'suspendido' ? 'bg-white text-amber-700 shadow-xs' : 'text-slate-600 hover:text-slate-900'}`}>Suspendidos</a>
				<a href="?estado=todos" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoParam === 'todos' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600 hover:text-slate-900'}`}>Todos</a>
			</div>
		</div>

		<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
			{applications.length === 0 ? (
				<div class="p-12 text-center text-slate-500">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-slate-300"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
					<p class="text-lg font-medium text-slate-700">No hay solicitudes en estado "{estadoParam}".</p>
					<p>Las solicitudes aparecerán aquí.</p>
				</div>
			) : (
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500">
							<th class="p-4 font-semibold">Local</th>
							<th class="p-4 font-semibold">Titular</th>
							<th class="p-4 font-semibold">Dirección</th>
							<th class="p-4 font-semibold">Fecha</th>
							<th class="p-4 font-semibold text-right">Acción</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						{applications.map((app: any) => (
							<tr class="hover:bg-slate-50 transition-colors group">
								<td class="p-4">
									<div class="font-bold text-slate-900">{app.nombre_comercial}</div>
								</td>
								<td class="p-4">
									<div class="text-slate-700 font-medium">{app.nombre} {app.apellido}</div>
									<div class="text-xs text-slate-500">{app.email}</div>
								</td>
								<td class="p-4 text-sm text-slate-600">
									{app.direccion}
								</td>
								<td class="p-4 text-sm text-slate-500">
									{new Date(app.$createdAt).toLocaleDateString()}
								</td>
								<td class="p-4 text-right">
									<a href={`/admin/canillitas/solicitudes/${app.$id}`} class="inline-flex items-center gap-1 px-4 py-2 bg-white border border-slate-200 hover:border-indigo-600 hover:text-indigo-600 rounded-lg text-sm font-semibold transition-all shadow-sm">
										Revisar
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
									</a>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			)}
		</div>
	</div>
</AdminLayout>
