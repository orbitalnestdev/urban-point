---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();
let orders = [];
let recentOrders = [];
let products = [];
let clientes = [];

try {
	const resOrders = await databases.listDocuments('urbanpoint', 'orders', [
		Query.orderDesc('$createdAt'),
		Query.limit(100) // limit for metrics
	]);
	orders = resOrders.documents;
	recentOrders = orders.slice(0, 6);
	
	const resProducts = await databases.listDocuments('urbanpoint', 'products');
	products = resProducts.documents;
	
	const resProfiles = await databases.listDocuments('urbanpoint', 'profiles', [
		Query.notEqual('role', 'admin')
	]);
	clientes = resProfiles.documents;
} catch (e) {
	console.error(e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const pendientes = orders.filter(o => o.estado === 'pagado');
const sinSeguimiento = orders.filter(o => o.estado === 'listo');
const pagosPendientes = orders.filter(o => o.estado === 'pendiente');
const totalPagosPendientes = pagosPendientes.reduce((acc, o) => acc + o.total, 0);

const sinStock = products.filter(p => p.stock === 0).length;
const totalVentas = orders.filter(o => o.estado !== 'cancelado').reduce((acc, o) => acc + o.total, 0);
const ticketPromedio = orders.length > 0 ? (totalVentas / orders.length) : 0;

const getStatusColor = (estado) => {
	switch(estado) {
		case 'pendiente': return 'border-slate-200 bg-slate-50 text-slate-700';
		case 'pagado': return 'border-blue-200 bg-blue-50 text-blue-700';
		case 'listo': return 'border-indigo-200 bg-indigo-50 text-indigo-700';
		case 'en_camino': return 'border-purple-200 bg-purple-50 text-purple-700';
		case 'entregado': return 'border-emerald-200 bg-emerald-50 text-emerald-700';
		case 'cancelado': return 'border-rose-200 bg-rose-50 text-rose-700';
		default: return 'border-slate-200 bg-slate-50 text-slate-700';
	}
};

const getStatusDot = (estado) => {
	switch(estado) {
		case 'pendiente': return 'bg-slate-500';
		case 'pagado': return 'bg-blue-500';
		case 'listo': return 'bg-indigo-500';
		case 'en_camino': return 'bg-purple-500';
		case 'entregado': return 'bg-emerald-500';
		case 'cancelado': return 'bg-rose-500';
		default: return 'bg-slate-500';
	}
};
---

<AdminLayout title="Dashboard General">
	<main class="p-8">
		<header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
			<div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
					Buenas tardes, Urban <span class="text-2xl">👋</span>
				</h1>
				<p class="text-slate-500 font-medium mt-1">Esto es lo que necesita tu atención hoy.</p>
			</div>
			<div class="flex items-center bg-white border border-slate-200 rounded-xl p-1 shadow-sm">
				<button class="px-4 py-1.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 transition-colors">7 días</button>
				<button class="px-4 py-1.5 text-sm font-bold text-white bg-slate-900 rounded-lg shadow-md transition-colors">30 días</button>
				<button class="px-4 py-1.5 text-sm font-medium text-slate-600 rounded-lg hover:bg-slate-50 transition-colors">90 días</button>
			</div>
		</header>

		{/* Para hacer hoy */}
		<section class="mb-10">
			<div class="flex items-center gap-3 mb-4">
				<div class="w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center text-yellow-400">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
				</div>
				<h2 class="text-xl font-bold text-slate-900">Para hacer hoy</h2>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
				{/* Card 1 */}
				<a href="/admin/pedidos" class="bg-orange-50/50 border border-orange-200 p-5 rounded-2xl flex flex-col hover:shadow-lg hover:shadow-orange-500/10 transition-all cursor-pointer">
					<div class="w-8 h-8 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
					</div>
					<p class="text-3xl font-black text-orange-600 mb-1">{pendientes.length}</p>
					<p class="font-bold text-slate-900 text-sm">Pedidos sin preparar</p>
					<p class="text-xs text-slate-500 mb-4 line-clamp-1">Nuevos a preparar</p>
					<div class="mt-auto text-orange-600 font-bold text-xs uppercase tracking-wider flex items-center gap-1">Revisar pedidos &rarr;</div>
				</a>

				{/* Card 2 */}
				<a href="/admin/pedidos" class="bg-blue-50/50 border border-blue-200 p-5 rounded-2xl flex flex-col hover:shadow-lg hover:shadow-blue-500/10 transition-all cursor-pointer">
					<div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
					</div>
					<p class="text-3xl font-black text-blue-600 mb-1">{sinSeguimiento.length}</p>
					<p class="font-bold text-slate-900 text-sm">Esperando entrega</p>
					<p class="text-xs text-slate-500 mb-4 line-clamp-1">Listos para envío o retiro</p>
					<div class="mt-auto text-blue-600 font-bold text-xs uppercase tracking-wider flex items-center gap-1">Ver envíos &rarr;</div>
				</a>

				{/* Card 3 */}
				<div class="bg-rose-50/50 border border-rose-200 p-5 rounded-2xl flex flex-col hover:shadow-lg hover:shadow-rose-500/10 transition-all cursor-pointer relative">
					<div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
					</div>
					<p class="text-2xl font-black text-rose-600 mb-1">{formateador.format(totalPagosPendientes)}</p>
					<p class="font-bold text-slate-900 text-sm">Pagos pendientes</p>
					<p class="text-xs text-slate-500 mb-4 line-clamp-1">{pagosPendientes.length} pedidos sin saldar</p>
					<div class="mt-auto text-rose-600 font-bold text-xs uppercase tracking-wider flex items-center gap-1">Ver saldos &rarr;</div>
				</div>



				{/* Card 5 */}
				<div class="bg-emerald-50/50 border border-emerald-200 p-5 rounded-2xl flex flex-col hover:shadow-lg hover:shadow-emerald-500/10 transition-all cursor-pointer">
					<div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
					</div>
					<p class="text-3xl font-black text-emerald-600 mb-1">+12%</p>
					<p class="font-bold text-slate-900 text-sm">Crecimiento</p>
					<p class="text-xs text-slate-500 mb-4 line-clamp-1">Últimos 30 días vs anterior</p>
					<div class="mt-auto text-emerald-600 font-bold text-xs uppercase tracking-wider flex items-center gap-1">Ver análisis &rarr;</div>
				</div>
			</div>
		</section>

		{/* Pulso del negocio */}
		<section class="bg-white border border-slate-200 rounded-3xl p-6 mb-10 shadow-sm">
			<div class="flex items-center justify-between mb-8">
				<div class="flex items-center gap-3">
					<h2 class="text-xl font-bold text-slate-900">Pulso del negocio</h2>
					<span class="text-slate-400 font-medium">Últimos 30 días</span>
				</div>
				<a href="/admin/analisis" class="px-4 py-2 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors flex items-center gap-2">
					Ver análisis completo <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
				</a>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
				<div class="flex flex-col">
					<p class="text-sm font-bold text-slate-500 mb-1">Ventas</p>
					<div class="flex items-baseline gap-2 mb-2">
						<p class="text-2xl font-black text-slate-900">{formateador.format(totalVentas)}</p>
						<span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg> +15,2%</span>
					</div>
					<div class="h-10 w-full mt-auto relative overflow-hidden">
						<svg preserveAspectRatio="none" viewBox="0 0 100 20" class="w-full h-full stroke-emerald-500 fill-none opacity-50" stroke-width="1.5"><path d="M0 20 Q 25 15, 50 10 T 100 5"></path></svg>
					</div>
				</div>
				<div class="flex flex-col">
					<p class="text-sm font-bold text-slate-500 mb-1">Pedidos</p>
					<div class="flex items-baseline gap-2 mb-2">
						<p class="text-2xl font-black text-slate-900">{orders.length}</p>
						<span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg> +8,4%</span>
					</div>
					<div class="h-10 w-full mt-auto relative overflow-hidden">
						<svg preserveAspectRatio="none" viewBox="0 0 100 20" class="w-full h-full stroke-blue-600 fill-none opacity-50" stroke-width="1.5"><path d="M0 15 Q 25 5, 50 15 T 100 5"></path></svg>
					</div>
				</div>
				<div class="flex flex-col">
					<p class="text-sm font-bold text-slate-500 mb-1">Clientes</p>
					<div class="flex items-baseline gap-2 mb-2">
						<p class="text-2xl font-black text-slate-900">{clientes.length}</p>
						<span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg> +21,0%</span>
					</div>
					<div class="h-10 w-full mt-auto relative overflow-hidden">
						{/* No chart here based on design */}
					</div>
				</div>
				<div class="flex flex-col">
					<p class="text-sm font-bold text-slate-500 mb-1">Venta promedio</p>
					<div class="flex items-baseline gap-2 mb-2">
						<p class="text-2xl font-black text-slate-900">{formateador.format(ticketPromedio)}</p>
						<span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg> +5,6%</span>
					</div>
					<div class="h-10 w-full mt-auto relative overflow-hidden">
						<svg preserveAspectRatio="none" viewBox="0 0 100 20" class="w-full h-full stroke-emerald-500 fill-none opacity-50" stroke-width="1.5"><path d="M0 15 Q 25 15, 50 10 T 100 5"></path></svg>
					</div>
				</div>
			</div>
		</section>

		{/* Actividad reciente */}
		<section class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
			<div class="p-6 border-b border-slate-100 flex items-center gap-3">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
				<h2 class="text-xl font-bold text-slate-900">Pedidos recientes</h2>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-100">
				
				{/* Columna Izquierda */}
				<div class="flex flex-col divide-y divide-slate-100">
					{recentOrders.slice(0, 3).map(order => {
						const date = new Date(order.$createdAt);
						const formattedDate = date.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
						return (
							<a href={`/admin/pedidos/${order.$id}`} class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors cursor-pointer block">
								<div class="flex items-center gap-4">
									<div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center">
										{order.customer_id?.nombre?.substring(0, 1).toUpperCase() || 'C'}
									</div>
									<div>
										<p class="font-bold text-slate-900">{order.customer_id?.nombre || 'Cliente'}</p>
										<p class="text-xs text-slate-500">#{order.numero} &bull; {formattedDate}</p>
									</div>
								</div>
								<div class="text-right">
									<p class="font-black text-slate-900">{formateador.format(order.total)}</p>
									<span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold border ${getStatusColor(order.estado)}`}>
										<span class={`w-1.5 h-1.5 rounded-full ${getStatusDot(order.estado)}`}></span> {order.estado}
									</span>
								</div>
							</a>
						);
					})}
				</div>

				{/* Columna Derecha */}
				<div class="flex flex-col divide-y divide-slate-100">
					{recentOrders.slice(3, 6).map(order => {
						const date = new Date(order.$createdAt);
						const formattedDate = date.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
						return (
							<a href={`/admin/pedidos/${order.$id}`} class="p-4 flex items-center justify-between hover:bg-slate-50 transition-colors cursor-pointer block">
								<div class="flex items-center gap-4">
									<div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center">
										{order.customer_id?.nombre?.substring(0, 1).toUpperCase() || 'C'}
									</div>
									<div>
										<p class="font-bold text-slate-900">{order.customer_id?.nombre || 'Cliente'}</p>
										<p class="text-xs text-slate-500">#{order.numero} &bull; {formattedDate}</p>
									</div>
								</div>
								<div class="text-right">
									<p class="font-black text-slate-900">{formateador.format(order.total)}</p>
									<span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold border ${getStatusColor(order.estado)}`}>
										<span class={`w-1.5 h-1.5 rounded-full ${getStatusDot(order.estado)}`}></span> {order.estado}
									</span>
								</div>
							</a>
						);
					})}
					{recentOrders.length < 4 && recentOrders.length > 0 && (
						<div class="p-8 text-center text-slate-400 text-sm">Fin de pedidos recientes</div>
					)}
					{recentOrders.length === 0 && (
						<div class="p-8 text-center text-slate-400 text-sm h-full flex items-center justify-center">Aún no hay pedidos registrados</div>
					)}
				</div>

			</div>
			
			<div class="bg-slate-50 p-3 text-center border-t border-slate-100">
				<a href="/admin/pedidos" class="text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors">Ver todos los pedidos &rarr;</a>
			</div>
		</section>
	</main>
</AdminLayout>
