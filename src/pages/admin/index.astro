---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../lib/server/appwrite';
import { getAdminCachedCatalog } from '../../lib/server/catalogCache';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();

let orders: any[] = [];
let products: any[] = [];
let applications: any[] = [];
let pendingLedgers: any[] = [];

try {
	const [resOrders, adminCache, resApps, resLedger] = await Promise.all([
		databases.listDocuments('urbanpoint', 'orders', [
			Query.orderDesc('$createdAt'),
			Query.limit(200)
		]),
		getAdminCachedCatalog(),
		// Sin Query.limit, Appwrite devuelve 25 documentos por defecto y los
		// KPIs (solicitudes, comisiones pendientes) quedan subestimados.
		databases.listDocuments('urbanpoint', 'canillita_applications', [
			Query.equal('estado', 'solicitado'),
			Query.limit(1000)
		]),
		databases.listDocuments('urbanpoint', 'commission_ledger', [
			Query.equal('estado', 'pendiente'),
			Query.limit(5000)
		])
	]);

	orders = resOrders.documents;
	products = adminCache.products || [];
	applications = resApps.documents;
	pendingLedgers = resLedger.documents;
} catch (e) {
	console.error("Dashboard error:", e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const now = new Date();
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1).getTime();
const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

// Sales calculations
const salesTodayCentavos = orders
	.filter(o => o.estado !== 'cancelado' && new Date(o.$createdAt).getTime() >= startOfToday)
	.reduce((acc, o) => acc + (o.total || 0), 0);

const salesMonthCentavos = orders
	.filter(o => o.estado !== 'cancelado' && new Date(o.$createdAt).getTime() >= startOfMonth)
	.reduce((acc, o) => acc + (o.total || 0), 0);

// Actionable metrics
const nuevosSinConfirmar = orders.filter(o => o.estado === 'pendiente_pago' || o.estado === 'pendiente').length;
// 'listo' y 'preparado' no existen en el enum de orders: estas dos métricas
// daban siempre 0. Los estados reales son 'en_punto' y 'preparando'.
const esperandoRetiro = (o: any) => o.estado === 'en_punto' || o.estado === 'preparando';
const listosParaRetiro = orders.filter(esperandoRetiro).length;
const sinRetirarStale = orders.filter(o => esperandoRetiro(o) && (now.getTime() - new Date(o.$createdAt).getTime()) > SEVEN_DAYS_MS).length;

const sinStockCount = products.filter(p => p.stock === 0).length;
const stockCriticoCount = products.filter(p => p.stock > 0 && p.stock <= 5).length;
const totalPendingCommissionsCentavos = pendingLedgers.reduce((acc, l) => acc + (l.monto_centavos || 0), 0);

const recentOrders = orders.slice(0, 8);
---

<AdminLayout title="Dashboard General">
	<main class="p-8 max-w-[1600px] mx-auto space-y-6">
		
		{/* Top Header */}
		<header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
					<span>Administración</span> &gt; <span class="text-slate-900">Dashboard</span>
				</div>
				<h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
					Estado General de la Tienda
				</h1>
				<p class="text-xs text-slate-500 font-medium mt-0.5">Métricas operativas en tiempo real basadas en datos de producción.</p>
			</div>

			<div class="flex items-center gap-2">
				<a href="/admin/pedidos" class="px-4 py-2 bg-slate-900 text-white font-bold text-xs rounded-xl hover:bg-slate-800 transition-colors shadow-sm">
					Ver Todos los Pedidos
				</a>
			</div>
		</header>

		{/* 1. Ventas del Día y del Mes */}
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Ventas de Hoy</p>
					<p class="text-2xl font-black text-emerald-600">{formateador.format(salesTodayCentavos / 100)}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Ventas del Mes</p>
					<p class="text-2xl font-black text-slate-900">{formateador.format(salesMonthCentavos / 100)}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Solicitudes Canillita</p>
					<p class="text-2xl font-black text-purple-600">{applications.length}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Comisiones Pendientes</p>
					<p class="text-2xl font-black text-amber-600">{formateador.format(totalPendingCommissionsCentavos / 100)}</p>
				</div>
				<div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
				</div>
			</div>
		</div>

		{/* 2. Pedidos que Requieren Acción */}
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
			<a href="/admin/pedidos?estado=pendiente_pago" class="bg-amber-50/60 border border-amber-200 p-5 rounded-2xl shadow-sm hover:shadow-md transition-all flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-amber-800 uppercase tracking-wider mb-1">Nuevos Sin Confirmar</p>
					<p class="text-3xl font-black text-amber-700">{nuevosSinConfirmar}</p>
					<p class="text-[10px] text-amber-600 font-bold mt-1">Revisar pagos &rarr;</p>
				</div>
				<div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-2xl flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
				</div>
			</a>

			{/* La card cuenta en_punto+preparando: linkear al filtro de despachado mostraba otra cosa. */}
			<a href="/admin/pedidos" class="bg-blue-50/60 border border-blue-200 p-5 rounded-2xl shadow-sm hover:shadow-md transition-all flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-blue-800 uppercase tracking-wider mb-1">Listos Para Retiro</p>
					<p class="text-3xl font-black text-blue-700">{listosParaRetiro}</p>
					<p class="text-[10px] text-blue-600 font-bold mt-1">Esperando retiro &rarr;</p>
				</div>
				<div class="w-12 h-12 bg-blue-100 text-blue-700 rounded-2xl flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
				</div>
			</a>

			<div class="bg-rose-50/60 border border-rose-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<p class="text-xs font-bold text-rose-800 uppercase tracking-wider mb-1">Stock Sin Stock / Crítico</p>
					<p class="text-3xl font-black text-rose-700">{sinStockCount + stockCriticoCount}</p>
					<p class="text-[10px] text-rose-600 font-bold mt-1">{sinStockCount} sin stock, {stockCriticoCount} crítico</p>
				</div>
				<div class="w-12 h-12 bg-rose-100 text-rose-700 rounded-2xl flex items-center justify-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
				</div>
			</div>
		</div>

		{/* 3. Últimos Pedidos Registrados */}
		<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
			<div class="flex items-center justify-between border-b border-slate-100 pb-3">
				<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Últimos Pedidos Registrados</h3>
				<a href="/admin/pedidos" class="text-xs font-bold text-emerald-600 hover:underline">Ver todos &rarr;</a>
			</div>

			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse text-xs">
					<thead>
						<tr class="bg-slate-50 text-[10px] font-bold text-slate-500 uppercase tracking-wider">
							<th class="p-3">Pedido #</th>
							<th class="p-3">Fecha</th>
							<th class="p-3">Tipo Entrega</th>
							<th class="p-3 text-right">Total</th>
							<th class="p-3 text-center">Estado</th>
							<th class="p-3 text-center">Acción</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						{recentOrders.map(o => (
							<tr class="hover:bg-slate-50">
								<td class="p-3 font-mono font-bold text-emerald-700">ORD-{o.numero || o.$id.substring(0,6)}</td>
								<td class="p-3 text-slate-500">{new Date(o.$createdAt).toLocaleDateString('es-AR')}</td>
								<td class="p-3 font-bold text-slate-700">{o.fulfillment === 'retiro' ? 'Retiro en Punto' : 'Envío a Domicilio'}</td>
								<td class="p-3 text-right font-black text-slate-900">{formateador.format((o.total || 0) / 100)}</td>
								<td class="p-3 text-center">
									<span class="px-2 py-0.5 rounded-full text-[10px] font-bold border bg-slate-100 text-slate-700">
										{o.estado}
									</span>
								</td>
								<td class="p-3 text-center">
									<a href={`/admin/pedidos/${o.$id}`} class="text-xs font-bold text-emerald-600 hover:underline">Ficha &rarr;</a>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

	</main>
</AdminLayout>
