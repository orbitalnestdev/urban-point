									<div class="flex items-center justify-between text-sm mb-2 last:mb-0">
										<div class="flex items-center gap-2">
											<span class="font-bold text-slate-700">Remera Básica Algodón</span>
											<span class="text-slate-400 text-xs">M - Negro</span>
										</div>
										<span class="font-black text-rose-600">-1</span>
									</div>
									<div class="flex items-center justify-between text-sm mb-2 last:mb-0">
