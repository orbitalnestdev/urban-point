							Configurar alertas
						</button>
					</div>

					<div class="space-y-4">
						{/* Mocked Item 1 */}
						<div class="p-4 border border-slate-100 hover:border-slate-200 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors bg-white">
							<div class="flex items-center gap-4 flex-1">
								<div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center shrink-0 overflow-hidden border border-slate-200">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
								</div>
								<div>
									<h3 class="font-extrabold text-slate-900 text-sm">Remera Básica Algodón</h3>
									<div class="flex items-center gap-2 text-[11px] font-bold mt-1">
										<span class="text-slate-500 font-mono">SKU-77489</span>
										<span class="text-slate-300">&bull;</span>
										<span class="text-emerald-600 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded">Publicado</span>
