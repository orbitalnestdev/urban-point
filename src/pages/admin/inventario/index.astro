										<span class="text-slate-300">&bull;</span>
										<span class="text-slate-500 bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded">Pausado</span>
									</div>
								</div>
							</div>

							<div class="flex-1 text-center hidden md:block">
								<span class="text-xs text-slate-500 font-bold bg-slate-50 px-3 py-1 rounded-lg border border-slate-100">
									Último: <span class="text-slate-700">Hace 3 meses</span>
								</span>
							</div>

							<div class="flex items-center gap-6 justify-end flex-1">
