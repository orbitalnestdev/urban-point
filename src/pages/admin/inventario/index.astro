									Último: <span class="text-slate-700">Hace 1 mes</span>
								</span>
							</div>

							<div class="flex items-center gap-6 justify-end flex-1">
								<div class="text-right">
									<p class="text-sm font-black text-rose-600">Stock actual 0</p>
									<p class="text-[10px] font-bold text-slate-400 uppercase">Recomendado 20</p>
								</div>
								<div class="flex items-center gap-2">
									<button class="px-4 py-2 border border-emerald-600 text-emerald-600 hover:bg-emerald-50 font-bold text-xs rounded-lg transition-colors flex items-center gap-1 shadow-sm whitespace-nowrap">
										+ Reponer
									</button>
									<button class="px-3 py-2 text-slate-400 hover:text-slate-700 font-bold text-xs rounded-lg transition-colors flex items-center gap-1 bg-slate-50 border border-slate-200 shadow-sm">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
										Posponer
									</button>
								</div>
							</div>
						</div>

						{/* Mocked Item 2 */}
						<div class="p-4 border border-slate-100 hover:border-slate-200 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors bg-white opacity-60">
							<div class="flex items-center gap-4 flex-1">
								<div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center shrink-0 overflow-hidden border border-slate-200">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
								</div>
								<div>
									<h3 class="font-extrabold text-slate-900 text-sm">Pantalón Denim Oversize</h3>
									<div class="flex items-center gap-2 text-[11px] font-bold mt-1">
