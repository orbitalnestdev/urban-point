---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();
let products = [];
let categories = [];
const activeTab = Astro.url.searchParams.get('tab') || 'reposicion';

try {
	const res = await databases.listDocuments('urbanpoint', 'products', [Query.limit(200)]);
	products = res.documents;
	
	const catRes = await databases.listDocuments('urbanpoint', 'categories');
	categories = catRes.documents;
} catch (e) {
	console.error(e);
}

const sinStockProducts = products.filter(p => p.stock === 0);
const sinStockCount = 881; // Mock from screenshot
const enStockCount = 98;
const unidadesTotales = 47100;
const valorInventario = 321700000;

const formateadorMoneda = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 1 });
const formateadorNumero = new Intl.NumberFormat('es-AR', { notation: "compact", compactDisplay: "short" });

---

<AdminLayout title="Inventario | Reposición y Movimientos">
	<main class="p-8 max-w-[1400px] mx-auto pb-24">
		{/* Top Header */}
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
			<div>
				<div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
					<span class="text-slate-900 font-medium">Inventario</span>
				</div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Inventario</h1>
			</div>
			
			<div class="flex items-center gap-3">
				<button class="px-4 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-bold rounded-lg hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon></svg>
					Exportar stock
				</button>
				<button class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-lg transition-colors shadow-md flex items-center gap-2">
					Registrar movimiento
				</button>
			</div>
		</header>

		{/* Tabs */}
		<div class="flex space-x-6 border-b border-slate-200 mb-6 overflow-x-auto hide-scrollbar">
			<a href="/admin/inventario?tab=todos" class={`pb-2 text-sm font-bold whitespace-nowrap flex items-center gap-2 ${activeTab === 'todos' ? 'border-b-2 border-slate-900 text-slate-900' : 'border-b-2 border-transparent text-slate-500 hover:text-slate-700'}`}>Todos</a>
			<a href="/admin/inventario?tab=movimientos" class={`pb-2 text-sm font-bold whitespace-nowrap flex items-center gap-2 ${activeTab === 'movimientos' ? 'border-b-2 border-slate-900 text-slate-900' : 'border-b-2 border-transparent text-slate-500 hover:text-slate-700'}`}>Movimientos</a>
			<a href="/admin/inventario?tab=reposicion" class={`pb-2 text-sm font-bold whitespace-nowrap flex items-center gap-2 ${activeTab === 'reposicion' ? 'border-b-2 border-slate-900 text-slate-900' : 'border-b-2 border-transparent text-slate-500 hover:text-slate-700'}`}>
				Reposición
				<span class="bg-rose-100 text-rose-700 text-[10px] px-2 py-0.5 rounded-full font-bold">881</span>
			</a>
		</div>

		{activeTab === 'reposicion' && (
			<>
				{/* Red Alert Banner */}
