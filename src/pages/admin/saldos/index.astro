---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import { Wallet } from 'lucide-react';
import { saldosPorCliente, creditosDisponibles } from '../../../lib/server/creditos';
import { formatearCentavos } from '../../../lib/pricing';

const { databases } = createAdminClient();

const searchQuery = (Astro.url.searchParams.get('q') || '').trim();

// Mientras la colección no exista, la página avisa qué correr en vez de
// romperse (ver src/lib/server/creditos.ts).
const hayLedger = await creditosDisponibles();
const saldos = hayLedger ? await saldosPorCliente() : new Map<string, number>();

async function fetchAllDocs(coll: string, baseQueries: any[] = []) {
	let docs: any[] = [];
	let offset = 0;
	while (true) {
		const res = await databases.listDocuments('urbanpoint', coll, [
			...baseQueries,
			Query.limit(100),
			Query.offset(offset)
		]);
		docs.push(...res.documents);
		if (res.documents.length < 100) break;
		offset += 100;
	}
	return docs;
}

let perfiles: any[] = [];
try {
	perfiles = await fetchAllDocs('profiles');
} catch (e) {
	console.error('No se pudieron cargar los clientes:', e);
}

// Quien compra: cliente y distribuidor. El saldo del canillita es otra cosa
// (comisiones) y vive en /admin/liquidaciones.
const compradores = perfiles.filter((p: any) => p.role === 'cliente' || p.role === 'distribuidor');

const normalizar = (t: string) => (t || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
const termino = normalizar(searchQuery);

const filas = compradores
	.map((p: any) => ({ perfil: p, saldo: saldos.get(p.$id) || 0 }))
	.filter((f) => !termino || normalizar(f.perfil.nombre).includes(termino) || normalizar(f.perfil.email).includes(termino))
	// Primero los que tienen saldo: es lo que se viene a mirar acá.
	.sort((a, b) => b.saldo - a.saldo || (a.perfil.nombre || '').localeCompare(b.perfil.nombre || '', 'es'));

const totalEnCirculacion = [...saldos.values()].reduce((a, b) => a + b, 0);
const conSaldo = filas.filter((f) => f.saldo > 0).length;
---

<AdminLayout title="Saldo a Favor | UrbanPoint">
	<div class="space-y-6 max-w-6xl mx-auto pb-12">
		<!-- Header -->
		<div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs flex items-center justify-between gap-4 flex-wrap">
			<div class="flex items-center gap-3.5">
				<div class="w-11 h-11 rounded-2xl bg-emerald-50 text-[#2D5A27] border border-emerald-100 flex items-center justify-center shrink-0">
					<Wallet className="w-5 h-5" />
				</div>
				<div>
					<h1 class="text-xl font-black text-slate-900 tracking-tight">Saldo a Favor</h1>
					<p class="text-xs text-slate-500 font-medium">Crédito de los clientes para descontar de su próxima compra.</p>
				</div>
			</div>
		</div>

		{!hayLedger && (
			<div class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
				<p class="font-bold text-amber-900 text-sm">Falta crear la colección de saldos.</p>
				<p class="text-xs text-amber-800 mt-1 font-mono">
					APPWRITE_API_KEY=... npx tsx scripts/setup_credit_ledger.ts --apply
				</p>
			</div>
		)}

		<!-- KPIs -->
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
				<p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Saldo total en circulación</p>
				<h3 class="text-2xl font-black text-slate-900 mt-1">{formatearCentavos(totalEnCirculacion)}</h3>
			</div>
			<div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
				<p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Clientes con saldo</p>
				<h3 class="text-2xl font-black text-slate-900 mt-1">{conSaldo}</h3>
			</div>
		</div>

		<!-- Listado -->
		<div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden">
			<div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3 flex-wrap bg-slate-50/50">
				<h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">Clientes</h2>
				<form method="GET" class="flex items-center gap-2">
					<input
						type="text"
						name="q"
						value={searchQuery}
						placeholder="Buscar por nombre o email..."
						class="px-3 py-1.5 border border-slate-200 rounded-lg text-xs font-medium outline-none focus:border-indigo-500 w-64"
					/>
					<button type="submit" class="px-3 py-1.5 bg-slate-900 text-white text-xs font-bold rounded-lg hover:bg-slate-800">Buscar</button>
				</form>
			</div>

			{filas.length === 0 ? (
				<p class="p-10 text-center text-sm text-slate-500">No hay clientes que coincidan.</p>
			) : (
				<div class="divide-y divide-slate-100">
					{filas.map(({ perfil, saldo }) => (
						<div class="p-4 flex items-center justify-between gap-4 hover:bg-slate-50/80 transition-colors">
							<div class="min-w-0">
								<p class="font-bold text-slate-900 text-sm truncate">{perfil.nombre || '(sin nombre)'}</p>
								<p class="text-xs text-slate-400 truncate">{perfil.email}</p>
							</div>
							<div class="flex items-center gap-3 shrink-0">
								<span class={`font-black text-sm ${saldo > 0 ? 'text-[#2D5A27]' : 'text-slate-300'}`}>
									{formatearCentavos(saldo)}
								</span>
								<button
									class="btn-mover-saldo px-3 py-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold rounded-lg text-xs transition-colors cursor-pointer"
									data-profile-id={perfil.$id}
									data-nombre={perfil.nombre || perfil.email}
								>
									Acreditar / Ajustar
								</button>
							</div>
						</div>
					))}
				</div>
			)}
		</div>
	</div>

	<!-- Modal -->
	<div id="modal-saldo" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
		<div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-6">
			<div class="flex items-center justify-between mb-5 pb-4 border-b border-slate-200">
				<h3 class="text-lg font-bold text-slate-900">Mover saldo</h3>
				<button id="btn-close-saldo" class="text-slate-400 hover:text-slate-600 text-2xl font-bold cursor-pointer">&times;</button>
			</div>

			<form id="form-saldo" class="space-y-4">
				<input type="hidden" id="saldo-profile-id" />

				<p class="text-sm text-slate-600">
					Cliente: <strong id="saldo-nombre" class="text-slate-900"></strong>
				</p>

				<div>
					<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Monto en pesos</label>
					<input
						type="number"
						id="saldo-monto"
						step="0.01"
						required
						placeholder="Ej: 1500"
						class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600"
					/>
					<p class="text-[11px] text-slate-500 mt-1">
						Positivo acredita saldo. Negativo lo descuenta (para corregir una carga mal hecha).
					</p>
				</div>

				<div>
					<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Motivo</label>
					<input
						type="text"
						id="saldo-motivo"
						required
						maxlength="500"
						placeholder="Ej: Devolución del pedido 123456"
						class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-600"
					/>
					<p class="text-[11px] text-slate-500 mt-1">Queda registrado en el historial del cliente.</p>
				</div>

				<div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
					<button type="button" id="btn-cancel-saldo" class="px-5 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-xl hover:bg-slate-200 text-sm cursor-pointer">Cancelar</button>
					<button type="submit" id="btn-save-saldo" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md text-sm cursor-pointer">Guardar</button>
				</div>
			</form>
		</div>
	</div>

	<script>
		import { actions } from 'astro:actions';

		const modal = document.getElementById('modal-saldo');
		const form = document.getElementById('form-saldo') as HTMLFormElement;
		const inputProfileId = document.getElementById('saldo-profile-id') as HTMLInputElement;
		const inputMonto = document.getElementById('saldo-monto') as HTMLInputElement;
		const inputMotivo = document.getElementById('saldo-motivo') as HTMLInputElement;
		const nombreEl = document.getElementById('saldo-nombre');

		function abrir(profileId: string, nombre: string) {
			inputProfileId.value = profileId;
			inputMonto.value = '';
			inputMotivo.value = '';
			if (nombreEl) nombreEl.textContent = nombre;
			modal?.classList.remove('hidden');
		}

		function cerrar() {
			modal?.classList.add('hidden');
		}

		document.querySelectorAll('.btn-mover-saldo').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				const el = e.currentTarget as HTMLElement;
				abrir(el.dataset.profileId || '', el.dataset.nombre || '');
			});
		});

		document.getElementById('btn-close-saldo')?.addEventListener('click', cerrar);
		document.getElementById('btn-cancel-saldo')?.addEventListener('click', cerrar);

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();

			// El ledger trabaja en centavos enteros; acá se carga en pesos.
			const pesos = Number(inputMonto.value);
			if (!Number.isFinite(pesos) || pesos === 0) {
				alert('Ingresá un monto distinto de cero.');
				return;
			}

			const btn = document.getElementById('btn-save-saldo') as HTMLButtonElement;
			btn.disabled = true;
			btn.textContent = 'Guardando...';

			const { data, error } = await actions.moverSaldoCliente({
				profileId: inputProfileId.value,
				montoCentavos: Math.round(pesos * 100),
				motivo: inputMotivo.value
			});

			if (error || !data?.success) {
				alert(data?.error || error?.message || 'No se pudo mover el saldo.');
				btn.disabled = false;
				btn.textContent = 'Guardar';
				return;
			}

			window.location.reload();
		});
	</script>
</AdminLayout>
