---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();
let clientes = [];

try {
	// Fetch profiles that are not admins
	const res = await databases.listDocuments('urbanpoint', 'profiles', [
		Query.notEqual('role', 'admin'),
		Query.orderDesc('$createdAt')
	]);
	
	// Para cada cliente podríamos traer sus órdenes para calcular el total gastado,
	// por ahora solo traemos los perfiles
	clientes = res.documents;
} catch (e) {
	console.error(e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });
---

<AdminLayout title="Clientes">
	<main class="p-8">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
			<div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Clientes</h1>
				<p class="text-slate-500 font-medium mt-1">Conocé a tus compradores, su historial y datos de contacto.</p>
			</div>
			<div class="flex items-center gap-2">
				<button class="px-4 py-2 bg-white border border-slate-200 text-slate-700 font-bold rounded-lg hover:bg-slate-50 transition-colors shadow-sm flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					Exportar CSV
				</button>
			</div>
		</header>

		{/* Top Metric Cards */}
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Total Clientes</h3>
				<p class="text-3xl font-black text-slate-900">{clientes.length}</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm opacity-50">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Clientes Recurrentes</h3>
				<p class="text-3xl font-black text-indigo-600">--%</p>
			</div>
			<div class="bg-white border border-slate-200 p-6 rounded-2xl shadow-sm opacity-50">
				<h3 class="font-bold text-slate-500 text-xs uppercase tracking-wider mb-2">Gasto Promedio por Cliente</h3>
				<p class="text-3xl font-black text-emerald-600">--</p>
			</div>
		</div>

		{/* Filtros */}
		<div class="flex flex-wrap gap-2 mb-6">
			<div class="relative flex-1 min-w-[250px]">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
				<input type="text" placeholder="Buscar por nombre o email" class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
			</div>
		</div>

		{/* Tabla de Clientes */}
		<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
						<th class="p-4">Cliente</th>
						<th class="p-4">Email</th>
						<th class="p-4">Teléfono</th>
						<th class="p-4 text-center">Registro</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					
					{clientes.map(cliente => {
						const date = new Date(cliente.$createdAt);
						const formattedDate = date.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
						
						return (
							<tr class="hover:bg-slate-50">
								<td class="p-4">
									<div class="flex items-center gap-3">
										<div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center">
											{cliente.nombre?.substring(0, 2).toUpperCase() || 'U'}
										</div>
										<div>
											<p class="font-bold text-slate-900">{cliente.nombre || 'Sin nombre'}</p>
											<span class="text-[10px] font-bold text-slate-500 uppercase bg-slate-100 px-1.5 py-0.5 rounded">{cliente.role}</span>
										</div>
									</div>
								</td>
								<td class="p-4 text-slate-600">{cliente.email || 'N/A'}</td>
								<td class="p-4 text-slate-600">{cliente.telefono || 'N/A'}</td>
								<td class="p-4 text-center text-sm text-slate-500">{formattedDate}</td>
							</tr>
						);
					})}

					{clientes.length === 0 && (
						<tr>
							<td colspan="4" class="p-8 text-center text-slate-500">No hay clientes registrados aún.</td>
						</tr>
					)}

				</tbody>
			</table>
		</div>
	</main>
</AdminLayout>
