---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';
import { Users, RefreshCw, CreditCard } from 'lucide-react';
import Pagination from '../../../components/admin/Pagination.astro';

export const prerender = false;

const roleFilter = Astro.url.searchParams.get('role') || 'todos';
const searchQuery = Astro.url.searchParams.get('q') || '';

const { databases } = createAdminClient();
let clientes = [];
let allProfiles = [];
let totalGastadoGeneralCentavos = 0;
let clientesRecurrentesCount = 0;

async function fetchAllDocs(coll: string, baseQueries: any[] = []) {
	let docs: any[] = [];
	let offset = 0;
	while (true) {
		const res = await databases.listDocuments('urbanpoint', coll, [
			...baseQueries,
			Query.limit(100),
			Query.offset(offset)
		]);
		docs.push(...res.documents);
		if (res.documents.length < 100) break;
		offset += 100;
	}
	return docs;
}

/**
 * Trae los pedidos sólo con los campos que esta página usa (Query.select) y
 * en tandas grandes por cursor. Antes se bajaba la colección ENTERA con todos
 * sus campos, paginando de a 100 en serie: era la causa principal de la
 * lentitud del directorio.
 */
async function fetchOrdersLight() {
	const BATCH = 5000;
	const MAX_BATCHES = 4; // tope de seguridad: 20.000 pedidos alcanzan y sobran
	let docs: any[] = [];
	let cursor: string | null = null;
	// Query.select sobre relaciones (customer_id) puede ser rechazado por el
	// servidor de Appwrite según versión: si falla, se reintenta sin select.
	let usarSelect = true;
	for (let i = 0; i < MAX_BATCHES; i++) {
		const queries = [
			Query.orderDesc('$createdAt'),
			Query.limit(BATCH)
		];
		if (usarSelect) queries.unshift(Query.select(['customer_id', 'total', 'estado', '$createdAt']));
		if (cursor) queries.push(Query.cursorAfter(cursor));
		let res;
		try {
			res = await databases.listDocuments('urbanpoint', 'orders', queries);
		} catch (e) {
			if (!usarSelect) throw e;
			usarSelect = false;
			i--; // reintentar esta misma tanda sin select
			continue;
		}
		docs.push(...res.documents);
		if (res.documents.length < BATCH) break;
		cursor = res.documents[res.documents.length - 1].$id;
	}
	return docs;
}

let currentPage = 1;
let pageSize = 25;
let totalFiltered = 0;
let totalPages = 1;

try {
	const [rawProfiles, rawOrders] = await Promise.all([
		fetchAllDocs('profiles', [Query.notEqual('role', 'admin'), Query.orderDesc('$createdAt')]),
		fetchOrdersLight()
	]);

	const ordersByCustomer: Record<string, any[]> = {};
	for (const o of rawOrders) {
		// La relación puede venir como string plano o como documento expandido.
		const cId = typeof o.customer_id === 'string' ? o.customer_id : o.customer_id?.$id;
		if (cId) {
			if (!ordersByCustomer[cId]) ordersByCustomer[cId] = [];
			ordersByCustomer[cId].push(o);
		}
	}

	allProfiles = rawProfiles.map((p) => {
		const customerOrders = ordersByCustomer[p.$id] || [];
		const totalOrdersCount = customerOrders.length;
		const totalSpentCentavos = customerOrders
			.filter(o => o.estado !== 'cancelado')
			.reduce((acc, curr) => acc + (curr.total || 0), 0);
		
		const lastOrderDate = customerOrders.length > 0 ? customerOrders[0].$createdAt : null;

		return {
			...p,
			totalOrdersCount,
			totalSpentCentavos,
			lastOrderDate
		};
	});

	const clientesOnly = allProfiles.filter(p => p.role === 'cliente');
	totalGastadoGeneralCentavos = clientesOnly.reduce((acc, c) => acc + c.totalSpentCentavos, 0);
	clientesRecurrentesCount = clientesOnly.filter(c => c.totalOrdersCount > 1).length;

	let filtered = [...allProfiles];
	if (roleFilter !== 'todos') {
		filtered = filtered.filter(p => p.role === roleFilter);
	}
	if (searchQuery.trim()) {
		const q = searchQuery.toLowerCase();
		filtered = filtered.filter(p => 
			p.nombre?.toLowerCase().includes(q) ||
			p.email?.toLowerCase().includes(q) ||
			p.telefono?.toLowerCase().includes(q)
		);
	}

	totalFiltered = filtered.length;
	currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
	totalPages = Math.ceil(totalFiltered / pageSize) || 1;
	clientes = filtered.slice((currentPage - 1) * pageSize, currentPage * pageSize);

} catch (e) {
	console.error("Error loading clientes:", e);
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const totalClientesCount = allProfiles.filter(p => p.role === 'cliente').length;
const porcentajeRecurrentes = totalClientesCount > 0 ? Math.round((clientesRecurrentesCount / totalClientesCount) * 100) : 0;
const gastoPromedioCentavos = totalClientesCount > 0 ? Math.round(totalGastadoGeneralCentavos / totalClientesCount) : 0;
---

<AdminLayout title="Clientes">
	<main class="p-8 max-w-[1600px] mx-auto space-y-6">
		
		{/* Header Compacto */}
		<header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
					<span>Administración</span> &gt; <span class="text-slate-900">Clientes</span>
				</div>
				<h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-3">
					Directorio de Clientes
					<span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
						{allProfiles.length} usuarios
					</span>
				</h1>
			</div>
		</header>

		{/* Cards de Métricas Real e Integradas */}
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<h3 class="font-bold text-slate-400 text-xs uppercase tracking-wider mb-1">Total Clientes Compradores</h3>
					<p class="text-3xl font-black text-slate-900">{totalClientesCount}</p>
				</div>
				<div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl">
					<Users className="w-5 h-5" />
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<h3 class="font-bold text-slate-400 text-xs uppercase tracking-wider mb-1">Clientes Recurrentes</h3>
					<p class="text-3xl font-black text-indigo-600">{porcentajeRecurrentes}%</p>
					<p class="text-[10px] text-slate-400 mt-0.5">{clientesRecurrentesCount} de {totalClientesCount} realizaron &gt;1 compra</p>
				</div>
				<div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xl">
					<RefreshCw className="w-5 h-5" />
				</div>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm flex items-center justify-between">
				<div>
					<h3 class="font-bold text-slate-400 text-xs uppercase tracking-wider mb-1">Gasto Promedio por Cliente</h3>
					<p class="text-2xl font-black text-slate-900">{formateador.format(gastoPromedioCentavos / 100)}</p>
				</div>
				<div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-xl">
					<CreditCard className="w-5 h-5" />
				</div>
			</div>
		</div>

		{/* Filtros y Buscador */}
		<div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div class="flex items-center gap-2">
				{[
					{ id: 'todos', label: 'Todos los Usuarios' },
					{ id: 'cliente', label: 'Clientes Compradores' },
					{ id: 'canillita', label: 'Canillita Afiliados' },
					{ id: 'distribuidor', label: 'Distribuidores' }
				].map(tab => (
					<a
						href={`/admin/clientes?role=${tab.id}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
						class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${
							roleFilter === tab.id
								? 'bg-slate-900 text-white shadow-sm'
								: 'bg-slate-50 text-slate-600 hover:bg-slate-100 border border-slate-200'
						}`}
					>
						{tab.label}
					</a>
				))}
			</div>

			<form method="GET" action="/admin/clientes" class="flex items-center gap-2 w-full md:w-80">
				<input type="hidden" name="role" value={roleFilter} />
				<div class="relative w-full">
					<input 
						type="text" 
						name="q" 
						value={searchQuery} 
						placeholder="Buscar por nombre, email o teléfono..." 
						class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium outline-none focus:border-emerald-600 focus:bg-white transition-colors"
					/>
					<svg class="w-4 h-4 absolute left-3 top-2.5 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
				</div>
				{searchQuery && (
					<a href={`/admin/clientes?role=${roleFilter}`} class="px-3 py-2 bg-slate-100 text-slate-600 rounded-xl text-xs font-bold hover:bg-slate-200">
						Limpiar
					</a>
				)}
			</form>
		</div>

		{/* Tabla de Clientes */}
		<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
						<th class="p-4">Cliente / Usuario</th>
						<th class="p-4">Contacto</th>
						<th class="p-4 text-center">Tipo Rol</th>
						<th class="p-4 text-center">Compras Totales</th>
						<th class="p-4 text-right">Total Gastado</th>
						<th class="p-4 text-center">Fecha Registro</th>
						<th class="p-4 text-center">Acción</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100 text-xs">
					{clientes.map(c => {
						const dateStr = new Date(c.$createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
						return (
							<tr class="hover:bg-slate-50/80 transition-colors cursor-pointer" onclick={`window.location.href='/admin/clientes/${c.$id}'`}>
								<td class="p-4">
									<div class="flex items-center gap-3">
										<div class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs flex items-center justify-center shrink-0">
											{c.nombre?.substring(0, 2).toUpperCase() || 'U'}
										</div>
										<div>
											<p class="font-bold text-slate-900">{c.nombre || 'Sin Nombre'}</p>
											<p class="text-[10px] text-slate-400 font-mono">ID: {c.$id.substring(0, 10)}...</p>
										</div>
									</div>
								</td>
								<td class="p-4">
									<p class="font-medium text-slate-800">{c.email || 'Sin Email'}</p>
									<p class="text-[10px] text-slate-400">{c.telefono || 'Sin Teléfono'}</p>
								</td>
								<td class="p-4 text-center">
									<span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${
										c.role === 'distribuidor'
											? 'bg-purple-100 text-purple-900 border-purple-300'
											: c.role === 'canillita' 
												? 'bg-amber-50 text-amber-800 border-amber-200' 
												: 'bg-emerald-50 text-emerald-700 border-emerald-200'
									}`}>
										{c.role === 'distribuidor' ? 'DISTRIBUIDOR' : (c.role === 'canillita' ? 'CANILLITA' : 'CLIENTE')}
									</span>
								</td>
								<td class="p-4 text-center font-bold text-slate-700">
									{c.totalOrdersCount} pedidos
								</td>
								<td class="p-4 text-right font-black text-slate-900">
									{formateador.format((c.totalSpentCentavos || 0) / 100)}
								</td>
								<td class="p-4 text-center text-slate-500">
									{dateStr}
								</td>
								<td class="p-4 text-center" onclick="event.stopPropagation()">
									<a href={`/admin/clientes/${c.$id}`} class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-[11px] rounded-xl transition-colors inline-block">
										Ver Ficha
									</a>
								</td>
							</tr>
						);
					})}

					{clientes.length === 0 && (
						<tr>
							<td colspan="7" class="p-8 text-center text-slate-500 font-medium">
								No se encontraron clientes registrados.
							</td>
						</tr>
					)}
				</tbody>
			</table>

				<Pagination 
					currentPage={currentPage} 
					totalPages={totalPages} 
					totalItems={totalFiltered} 
					pageSize={pageSize} 
					searchParams={Astro.url.searchParams} 
					baseUrl="/admin/clientes" 
				/>
			</div>

	</main>
</AdminLayout>
