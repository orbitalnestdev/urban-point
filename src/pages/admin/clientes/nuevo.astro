---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query, ID } from 'node-appwrite';

export const prerender = false;

// Este formulario no tenía `name` en ningún input ni handler: "Guardar
// cliente" no guardaba nada, silenciosamente. Se conectan acá sólo los
// campos que tienen dónde vivir en `profiles` hoy (nombre, apellido, email,
// teléfono) — el resto del formulario (condición IVA, descuentos, precios
// por categoría, campos personalizados) no tiene ningún atributo en la base
// todavía, así que sigue sin `name` y queda deshabilitado: es mejor no
// enviarlo a que se envíe y se pierda en silencio.
let errorMessage = '';

if (Astro.request.method === 'POST') {
	try {
		const formData = await Astro.request.formData();
		const nombre = formData.get('nombre')?.toString().trim();
		const apellido = formData.get('apellido')?.toString().trim();
		const email = formData.get('email')?.toString().trim();
		const telefono = formData.get('telefono')?.toString().trim();

		if (!nombre || !email) {
			throw new Error('Nombre y email son obligatorios.');
		}

		const { databases, users } = createAdminClient();
		const nombreCompleto = apellido ? `${nombre} ${apellido}` : nombre;

		const existingProfile = await databases.listDocuments('urbanpoint', 'profiles', [
			Query.equal('email', email),
			Query.limit(1)
		]);
		if (existingProfile.documents.length > 0) {
			throw new Error(`Ya existe una cuenta con el email ${email}.`);
		}

		let userId: string;
		const existingUsers = await users.list([Query.equal('email', email)]);
		if (existingUsers.users.length > 0) {
			userId = existingUsers.users[0].$id;
		} else {
			const tempPassword = Math.random().toString(36).slice(-8) + 'A1!';
			const newAuthUser = await users.create(ID.unique(), email, undefined, tempPassword, nombreCompleto);
			userId = newAuthUser.$id;
		}

		// role: 'cliente' fijo, nunca lo que mande el formulario — es el mismo
		// patrón ya corregido en /admin/equipo, acá desde el principio.
		const nuevoPerfil = await databases.createDocument('urbanpoint', 'profiles', ID.unique(), {
			user_id: userId,
			nombre: nombreCompleto,
			email,
			telefono: telefono || '',
			role: 'cliente'
		});

		return Astro.redirect(`/admin/clientes/${nuevoPerfil.$id}?creado=1`);
	} catch (e: any) {
		errorMessage = e.message || 'No se pudo crear el cliente.';
	}
}
---

<AdminLayout title="Agregar Cliente">
	<main class="p-8 max-w-[1200px] mx-auto pb-24">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6">
			<div>
				<div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
					<a href="/admin/clientes" class="hover:text-slate-700">Clientes</a> <span class="text-slate-300">/</span> <span class="text-slate-900 font-medium">Agregar nuevo cliente</span>
				</div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Agregar nuevo cliente</h1>
			</div>
		</header>

		{errorMessage && (
			<div class="mb-6 bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-sm font-semibold">
				{errorMessage}
			</div>
		)}

		<form method="POST" id="form-nuevo-cliente" class="grid grid-cols-1 lg:grid-cols-3 gap-8">

			<div class="lg:col-span-2 space-y-8">
				{/* Información básica */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-6">Información básica</h3>

					<div class="grid grid-cols-2 gap-4 mb-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Nombre <span class="text-rose-500">*</span></label>
							<input type="text" name="nombre" required placeholder="Ej. Juan" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Apellido</label>
							<input type="text" name="apellido" placeholder="Ej. Pérez" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
					</div>

					<div class="mb-4">
						<label class="block text-xs font-bold text-slate-700 mb-1.5">Correo electrónico <span class="text-rose-500">*</span></label>
						<input type="email" name="email" required placeholder="juan.perez@empresa.com" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
					</div>

					<div class="grid grid-cols-2 gap-4 mb-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Teléfono</label>
							<input type="text" name="telefono" placeholder="+54 9 11 1234-5678" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Empresa</label>
							<input type="text" disabled placeholder="Próximamente" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 text-slate-400 cursor-not-allowed" />
						</div>
					</div>

					<div>
						<label class="block text-xs font-bold text-slate-700 mb-1.5 flex items-center justify-between">
							Notas internas
							<span class="text-[10px] text-slate-400 font-normal">El cliente no verá esto</span>
						</label>
						<textarea rows="3" disabled placeholder="Próximamente" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 text-slate-400 cursor-not-allowed"></textarea>
					</div>
				</div>

				{/* Fiscal / Comercial */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm opacity-60">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-6">Fiscal / Comercial <span class="normal-case font-medium">(próximamente)</span></h3>

					<div class="grid grid-cols-2 gap-4 mb-6">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Condición IVA</label>
							<select disabled class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 bg-slate-50 cursor-not-allowed appearance-none pr-8">
								<option value="">Seleccionar...</option>
								<option value="ri">Responsable Inscripto</option>
								<option value="mt">Monotributo</option>
								<option value="ex">Exento</option>
								<option value="cf">Consumidor Final</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Identificación fiscal (CUIT/DNI)</label>
							<input type="text" disabled placeholder="Sin guiones" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 cursor-not-allowed" />
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Desc. por defecto</label>
							<div class="relative">
								<input type="number" disabled placeholder="0" class="w-full pl-4 pr-8 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 cursor-not-allowed" />
								<span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">%</span>
							</div>
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Ajuste de precio</label>
							<div class="relative">
								<select disabled class="w-full pl-4 pr-8 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 bg-slate-50 cursor-not-allowed appearance-none">
									<option value="none">Sin ajuste</option>
									<option value="1">+1%</option>
									<option value="2">+2%</option>
								</select>
							</div>
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Percepción IIBB</label>
							<div class="relative">
								<input type="number" disabled placeholder="0.00" class="w-full pl-4 pr-8 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 cursor-not-allowed" />
								<span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">%</span>
							</div>
						</div>
					</div>
				</div>

			</div>

			<div class="space-y-6">
				{/* Clasificación comercial */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm opacity-60">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Clasificación comercial <span class="normal-case font-medium">(próximamente)</span></h3>

					<div class="mb-4">
						<label class="block text-xs font-bold text-slate-700 mb-1.5">Relación comercial</label>
						<select disabled class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 bg-slate-50 cursor-not-allowed appearance-none pr-8">
							<option value="b2b">Mayorista (B2B)</option>
							<option value="b2c">Minorista (B2C)</option>
							<option value="distribuidor">Distribuidor</option>
						</select>
					</div>

					<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-100 rounded-xl cursor-not-allowed mb-3">
						<input type="checkbox" disabled class="mt-0.5 rounded border-slate-300 text-indigo-600" />
						<div>
							<span class="block text-sm font-bold text-slate-900">Atención prioritaria</span>
							<span class="block text-[10px] text-slate-500">Destaca a este cliente en la vista de pedidos</span>
						</div>
					</label>

					<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-100 rounded-xl cursor-not-allowed">
						<input type="checkbox" disabled class="mt-0.5 rounded border-slate-300 text-rose-600" />
						<div>
							<span class="block text-sm font-bold text-slate-900">Excluir de marketing</span>
							<span class="block text-[10px] text-slate-500">No enviar promociones</span>
						</div>
					</label>
				</div>

				{/* Precios por categoría */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm opacity-60">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Precios por categoría <span class="normal-case font-medium">(próximamente)</span></h3>
					<p class="text-[11px] text-slate-500 font-medium mb-4">Define listas de precios o márgenes específicos para este cliente en ciertas categorías.</p>
					<button type="button" disabled class="w-full py-2 bg-slate-50 border border-dashed border-slate-300 text-slate-400 font-bold text-xs rounded-xl cursor-not-allowed flex items-center justify-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
						Agregar regla de categoría
					</button>
				</div>

				{/* Campos personalizados */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm opacity-60">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Campos pers. <span class="normal-case font-medium">(próximamente)</span></h3>
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-700 mb-1.5">Matrícula profesional</label>
						<input type="text" disabled placeholder="Ej. MP-12345" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 cursor-not-allowed" />
					</div>
				</div>

				{/* Acceso al portal */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Acceso al portal</h3>
					<p class="text-xs text-slate-500 leading-relaxed">Se crea con una contraseña provisoria (mismo mecanismo que invitar al equipo). El envío de invitación por email queda para más adelante.</p>
				</div>
			</div>
		</form>
	</main>

	{/* Bottom Fixed Bar */}
	<div class="fixed bottom-0 left-0 lg:left-64 right-0 bg-white border-t border-slate-200 p-4 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-40">
		<div class="max-w-[1200px] mx-auto flex items-center justify-between">
			<a href="/admin/clientes" class="px-6 py-2 border border-slate-200 text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition-colors shadow-sm">
				Descartar
			</a>
			<button type="submit" form="form-nuevo-cliente" class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-colors flex items-center gap-2">
				Guardar cliente
			</button>
		</div>
	</div>
</AdminLayout>
