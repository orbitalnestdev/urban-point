---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Agregar Cliente">
	<main class="p-8 max-w-[1200px] mx-auto pb-24">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6">
			<div>
				<div class="flex items-center gap-2 text-sm text-slate-500 mb-1">
					<a href="/admin/clientes" class="hover:text-slate-700">Clientes</a> <span class="text-slate-300">/</span> <span class="text-slate-900 font-medium">Agregar nuevo cliente</span>
				</div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Agregar nuevo cliente</h1>
			</div>
		</header>

		<form class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			
			<div class="lg:col-span-2 space-y-8">
				{/* Información básica */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-6">Información básica</h3>
					
					<div class="grid grid-cols-2 gap-4 mb-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Nombre <span class="text-rose-500">*</span></label>
							<input type="text" placeholder="Ej. Juan" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Apellido</label>
							<input type="text" placeholder="Ej. Pérez" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
					</div>

					<div class="mb-4">
						<label class="block text-xs font-bold text-slate-700 mb-1.5">Correo electrónico</label>
						<input type="email" placeholder="juan.perez@empresa.com" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
					</div>

					<div class="grid grid-cols-2 gap-4 mb-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Teléfono</label>
							<input type="text" placeholder="+54 9 11 1234-5678" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Empresa</label>
							<input type="text" placeholder="Razón social" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
					</div>

					<div>
						<label class="block text-xs font-bold text-slate-700 mb-1.5 flex items-center justify-between">
							Notas internas
							<span class="text-[10px] text-slate-400 font-normal">El cliente no verá esto</span>
						</label>
						<textarea rows="3" placeholder="Ej. Cliente de la sucursal Norte, prefiere entregas por la mañana..." class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"></textarea>
					</div>
				</div>

				{/* Fiscal / Comercial */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-6">Fiscal / Comercial</h3>
					
					<div class="grid grid-cols-2 gap-4 mb-6">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Condición IVA</label>
							<select class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 bg-white focus:outline-none focus:border-indigo-500 appearance-none pr-8 relative bg-no-repeat bg-[right_10px_center] bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2216%22%20height%3D%2216%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2364748b%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E')]">
								<option value="">Seleccionar...</option>
								<option value="ri">Responsable Inscripto</option>
								<option value="mt">Monotributo</option>
								<option value="ex">Exento</option>
								<option value="cf">Consumidor Final</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Identificación fiscal (CUIT/DNI)</label>
							<input type="text" placeholder="Sin guiones" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Desc. por defecto</label>
							<div class="relative">
								<input type="number" placeholder="0" class="w-full pl-4 pr-8 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
								<span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">%</span>
							</div>
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Ajuste de precio</label>
							<div class="relative">
								<select class="w-full pl-4 pr-8 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 bg-white focus:outline-none focus:border-indigo-500 appearance-none bg-no-repeat bg-[right_10px_center] bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2216%22%20height%3D%2216%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2364748b%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E')]">
									<option value="none">Sin ajuste</option>
									<option value="1">+1%</option>
									<option value="2">+2%</option>
								</select>
							</div>
						</div>
						<div>
							<label class="block text-xs font-bold text-slate-700 mb-1.5">Percepción IIBB</label>
							<div class="relative">
								<input type="number" placeholder="0.00" class="w-full pl-4 pr-8 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
								<span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">%</span>
							</div>
						</div>
					</div>
				</div>

			</div>
			
			<div class="space-y-6">
				{/* Clasificación comercial */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Clasificación comercial</h3>
					
					<div class="mb-4">
						<label class="block text-xs font-bold text-slate-700 mb-1.5">Relación comercial</label>
						<select class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 bg-white focus:outline-none focus:border-indigo-500 appearance-none pr-8 relative bg-no-repeat bg-[right_10px_center] bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2216%22%20height%3D%2216%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2364748b%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E')]">
							<option value="b2b">Mayorista (B2B)</option>
							<option value="b2c">Minorista (B2C)</option>
							<option value="distribuidor">Distribuidor</option>
						</select>
					</div>

					<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-100 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors mb-3">
						<input type="checkbox" class="mt-0.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" />
						<div>
							<span class="block text-sm font-bold text-slate-900">Atención prioritaria</span>
							<span class="block text-[10px] text-slate-500">Destaca a este cliente en la vista de pedidos</span>
						</div>
					</label>

					<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-100 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
						<input type="checkbox" class="mt-0.5 rounded border-slate-300 text-rose-600 focus:ring-rose-600" />
						<div>
							<span class="block text-sm font-bold text-slate-900">Excluir de marketing</span>
							<span class="block text-[10px] text-slate-500">No enviar carritos abandonados ni promos</span>
						</div>
					</label>
				</div>

				{/* Precios por categoría */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Precios por categoría</h3>
					<p class="text-[11px] text-slate-500 font-medium mb-4">Define listas de precios o márgenes específicos para este cliente en ciertas categorías.</p>
					<button type="button" class="w-full py-2 bg-slate-50 border border-dashed border-slate-300 text-slate-600 hover:bg-slate-100 font-bold text-xs rounded-xl transition-colors flex items-center justify-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
						Agregar regla de categoría
					</button>
				</div>

				{/* Campos personalizados */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<div class="flex items-center justify-between mb-4">
						<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Campos pers.</h3>
						<span class="text-[10px] text-slate-400">Gestionar</span>
					</div>
					<div>
						<label class="block text-xs font-bold text-slate-700 mb-1.5">Matrícula profesional</label>
						<input type="text" placeholder="Ej. MP-12345" class="w-full px-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500" />
					</div>
				</div>

				{/* Acceso al portal */}
				<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Acceso al portal</h3>
					
					<label class="flex items-start gap-3">
						<input type="checkbox" checked class="mt-0.5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" />
						<div>
							<span class="block text-sm font-bold text-slate-900">Enviar invitación por email</span>
							<span class="block text-xs text-slate-500 mt-1">El cliente recibirá un link para crear su contraseña y ver el catálogo B2B.</span>
						</div>
					</label>
				</div>
			</div>
		</form>
	</main>

	{/* Bottom Fixed Bar */}
	<div class="fixed bottom-0 left-0 lg:left-64 right-0 bg-white border-t border-slate-200 p-4 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-40">
		<div class="max-w-[1200px] mx-auto flex items-center justify-between">
			<a href="/admin/clientes" class="px-6 py-2 border border-slate-200 text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition-colors shadow-sm">
				Descartar
			</a>
			<button class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition-colors flex items-center gap-2">
				Guardar cliente
			</button>
		</div>
	</div>
</AdminLayout>
