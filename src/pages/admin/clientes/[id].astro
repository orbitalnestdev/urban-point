---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { id } = Astro.params;
const { databases } = createAdminClient();

let profile = null;
let orders = [];
let totalSpentCentavos = 0;
let preferredPoint = null;
let referringCanillita = null;

try {
	profile = await databases.getDocument('urbanpoint', 'profiles', id as string);

	const ordersRes = await databases.listDocuments('urbanpoint', 'orders', [
		Query.equal('customer_id', id as string),
		Query.orderDesc('$createdAt'),
		Query.limit(100)
	]);
	orders = ordersRes.documents;

	totalSpentCentavos = orders
		.filter(o => o.estado !== 'cancelado')
		.reduce((acc, curr) => acc + (curr.total || 0), 0);

	// Determine preferred pickup point if any
	const ptCountMap: Record<string, number> = {};
	let lastRefCodeId = null;

	for (const o of orders) {
		if (o.pickup_point_id) {
			const ptId = typeof o.pickup_point_id === 'string' ? o.pickup_point_id : o.pickup_point_id?.$id;
			if (ptId) {
				ptCountMap[ptId] = (ptCountMap[ptId] || 0) + 1;
			}
		}
		if (o.referral_code_id && !lastRefCodeId) {
			lastRefCodeId = typeof o.referral_code_id === 'string' ? o.referral_code_id : o.referral_code_id?.$id;
		}
	}

	const topPtId = Object.keys(ptCountMap).sort((a, b) => ptCountMap[b] - ptCountMap[a])[0];
	if (topPtId) {
		try {
			preferredPoint = await databases.getDocument('urbanpoint', 'pickup_points', topPtId);
		} catch (e) {}
	}

	if (lastRefCodeId) {
		try {
			const refDoc = await databases.getDocument('urbanpoint', 'referral_codes', lastRefCodeId);
			const ownerId = typeof refDoc.owner_id === 'string' ? refDoc.owner_id : refDoc.owner_id?.$id;
			if (ownerId) {
				referringCanillita = await databases.getDocument('urbanpoint', 'profiles', ownerId);
			}
		} catch (e) {}
	}
} catch (e) {
	console.error("Error loading customer profile:", e);
	return Astro.redirect('/admin/clientes');
}

const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

const getStatusClass = (estado: string) => {
	switch(estado) {
		case 'pendiente_pago': return 'bg-amber-50 text-amber-700 border-amber-200';
		case 'pagado': return 'bg-blue-50 text-blue-700 border-blue-200';
		case 'preparando': return 'bg-indigo-50 text-indigo-700 border-indigo-200';
		case 'entregado': return 'bg-emerald-50 text-emerald-700 border-emerald-200';
		case 'cancelado': return 'bg-rose-50 text-rose-700 border-rose-200';
		default: return 'bg-slate-50 text-slate-700 border-slate-200';
	}
};
---

<AdminLayout title={`Ficha de Cliente - ${profile.nombre}`}>
	<main class="p-8 max-w-[1400px] mx-auto space-y-6">
		
		{/* Header & Breadcrumb */}
		<header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
					<a href="/admin/clientes" class="hover:text-slate-700">Clientes</a> 
					<span class="text-slate-300">&gt;</span> 
					<span class="text-slate-900">{profile.nombre}</span>
				</div>
				<h1 class="text-3xl font-black text-slate-900 tracking-tight flex items-center gap-3">
					{profile.nombre}
					<span class={`px-2.5 py-0.5 rounded-full text-xs font-bold border uppercase ${
						profile.role === 'canillita' 
							? 'bg-purple-50 text-purple-700 border-purple-200' 
							: 'bg-emerald-50 text-emerald-700 border-emerald-200'
					}`}>
						{profile.role === 'canillita' ? 'Canillita Afiliado' : 'Cliente B2C'}
					</span>
				</h1>
			</div>
			<div class="flex items-center gap-3">
				<a href="/admin/clientes" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-colors">
					Volver a Clientes
				</a>
			</div>
		</header>

		{/* Cards Resumen Métricas */}
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
				<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Total Compras</p>
				<p class="text-3xl font-black text-slate-900">{orders.length}</p>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
				<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Total Acumulado Gastado</p>
				<p class="text-3xl font-black text-emerald-600">{formateador.format(totalSpentCentavos / 100)}</p>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
				<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Canillita Atribuidor</p>
				<p class="text-sm font-bold text-slate-900 mt-1">
					{referringCanillita ? referringCanillita.nombre : 'Directo (Sin referido)'}
				</p>
			</div>

			<div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm">
				<p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Punto de Retiro Habitual</p>
				<p class="text-sm font-bold text-slate-900 mt-1">
					{preferredPoint ? preferredPoint.nombre_comercial : 'Sin preferencia'}
				</p>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			{/* Información Personal */}
			<div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
				<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-3">Datos de Contacto</h3>
				<div>
					<span class="block text-[11px] font-bold text-slate-400">Email</span>
					<span class="text-sm font-bold text-slate-900">{profile.email || 'Sin Registrar'}</span>
				</div>
				<div>
					<span class="block text-[11px] font-bold text-slate-400">Teléfono</span>
					<span class="text-sm font-bold text-slate-900">{profile.telefono || 'Sin Registrar'}</span>
				</div>
				<div>
					<span class="block text-[11px] font-bold text-slate-400">Fecha de Registro</span>
					<span class="text-sm font-bold text-slate-900">
						{new Date(profile.$createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' })}
					</span>
				</div>
				<div class="pt-3 border-t border-slate-100 space-y-2">
					<label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider">Asignar Rol de Usuario</label>
					<select id="select-user-role" data-profile-id={profile.$id} class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 outline-none focus:border-indigo-600 cursor-pointer">
						<option value="cliente" selected={profile.role === 'cliente'}>Cliente B2C</option>
						<option value="canillita" selected={profile.role === 'canillita'}>Canillita Afiliado</option>
						<option value="distribuidor" selected={profile.role === 'distribuidor'}>Distribuidor (Precio Mayorista)</option>
						<option value="admin" selected={profile.role === 'admin'}>Administrador</option>
					</select>
					<p class="text-[10px] text-slate-400">El rol distribuidor se asigna directamente desde el panel sin flujo de alta público.</p>
				</div>
			</div>

			{/* Historial de Pedidos */}
			<div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
				<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-3">Historial de Pedidos Realizados</h3>
				
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="bg-slate-50 text-[10px] font-bold text-slate-500 uppercase tracking-wider">
								<th class="p-3">Pedido</th>
								<th class="p-3">Fecha</th>
								<th class="p-3 text-right">Total</th>
								<th class="p-3 text-center">Estado</th>
								<th class="p-3 text-center">Ver</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100 text-xs">
							{orders.map(o => (
								<tr class="hover:bg-slate-50">
									<td class="p-3 font-mono font-bold text-emerald-700">
										ORD-{o.numero || o.$id.substring(0,6)}
									</td>
									<td class="p-3 text-slate-500">
										{new Date(o.$createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: '2-digit' })}
									</td>
									<td class="p-3 text-right font-black text-slate-900">
										{formateador.format((o.total || 0) / 100)}
									</td>
									<td class="p-3 text-center">
										<span class={`px-2 py-0.5 rounded-full text-[10px] font-bold border ${getStatusClass(o.estado)}`}>
											{o.estado}
										</span>
									</td>
									<td class="p-3 text-center">
										<a href={`/admin/pedidos/${o.$id}`} class="text-xs font-bold text-emerald-600 hover:underline">
											Detalle &rarr;
										</a>
									</td>
								</tr>
							))}

							{orders.length === 0 && (
								<tr>
									<td colspan="5" class="p-6 text-center text-slate-500 font-medium">
										Este cliente aún no ha realizado ningún pedido.
									</td>
								</tr>
							)}
						</tbody>
					</table>
				</div>
			</div>
		</div>

	</main>

	<script>
		import { actions } from 'astro:actions';

		const selectRole = document.getElementById('select-user-role') as HTMLSelectElement;
		selectRole?.addEventListener('change', async () => {
			const profileId = selectRole.dataset.profileId;
			const role = selectRole.value as any;

			if (!profileId) return;

			if (confirm(`¿Estás seguro de cambiar el rol de este usuario a "${role}"?`)) {
				selectRole.disabled = true;
				const { data, error } = await actions.updateProfileRole({ profileId, role });
				selectRole.disabled = false;
				if (error || !data?.success) {
					alert(error?.message || 'Error al cambiar el rol del usuario');
				} else {
					alert(`Rol actualizado con éxito a "${role}".`);
					window.location.reload();
				}
			}
		});
	</script>
</AdminLayout>
