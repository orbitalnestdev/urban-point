---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createAdminClient } from '../../../lib/server/appwrite';
import { Query } from 'node-appwrite';

export const prerender = false;

const { databases } = createAdminClient();
let promotions = [];
try {
	const res = await databases.listDocuments('urbanpoint', 'promotions');
	promotions = res.documents;
} catch (e) {
	// Colección promociones por defecto si no existe aún
}
---

<AdminLayout title="Promociones">
	<main class="p-8 max-w-7xl mx-auto space-y-6">
		<header class="flex flex-col md:flex-row md:items-start justify-between gap-4">
			<div>
				<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
					<span>Descuentos</span> <span class="text-slate-300">/</span> <span class="text-slate-900 font-medium">Promociones</span>
				</div>
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Promociones</h1>
				<p class="text-slate-500 font-medium text-sm mt-1">Crea y gestiona ofertas por tiempo limitado para tus clientes.</p>
			</div>

			<a 
				href="/admin/promociones/nueva" 
				class="px-5 py-2.5 bg-orange-600 hover:bg-orange-700 text-white font-extrabold text-sm rounded-xl shadow-md transition-colors flex items-center gap-2"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
				Nueva promoción
			</a>
		</header>

		{/* Lista de Promociones */}
		<div class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="bg-slate-50 border-b border-slate-200 text-xs font-extrabold text-slate-500 uppercase tracking-wider">
						<th class="p-4">Promoción</th>
						<th class="p-4 text-center">Tipo</th>
						<th class="p-4 text-center">Descuento</th>
						<th class="p-4 text-center">Vigencia</th>
						<th class="p-4 text-center">Estado</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					{promotions.map((promo) => (
						<tr class="hover:bg-slate-50">
							<td class="p-4 font-extrabold text-slate-900">{promo.nombre}</td>
							<td class="p-4 text-center font-bold text-slate-600 capitalize">{promo.tipo}</td>
							<td class="p-4 text-center font-black text-slate-900">{promo.valor}%</td>
							<td class="p-4 text-center text-xs text-slate-500 font-bold">{promo.desde} al {promo.hasta}</td>
							<td class="p-4 text-center">
								<span class="px-2.5 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-700 capitalize">{promo.estado}</span>
							</td>
						</tr>
					))}

					{promotions.length === 0 && (
						<tr>
							<td colspan="5" class="p-12 text-center text-slate-400 font-bold">
								No hay promociones activas. ¡Hacé clic en "Nueva promoción" para crear tu primera oferta!
							</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</main>
</AdminLayout>
