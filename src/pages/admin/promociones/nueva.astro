---
import AdminLayout from '../../../layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Nueva Promoción">
	<main class="p-8 max-w-7xl mx-auto space-y-6">
		{/* Header & Breadcrumb */}
		<div>
			<div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
				<a href="/admin/promociones" class="hover:text-slate-700">Promociones</a> 
				<span class="text-slate-300">/</span> 
				<span class="text-slate-900 font-medium">Nueva</span>
			</div>
			<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Nueva promoción</h1>
			<p class="text-slate-500 font-medium text-sm mt-1">Crea una promoción por tiempo limitado</p>
		</div>

		<form id="form-nueva-promo" class="space-y-6">
			{/* Seccion 1: Promoción */}
			<div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm space-y-6">
				<div class="flex items-center gap-2 text-base font-extrabold text-slate-900 border-b border-slate-100 pb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-orange-600"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
					Promoción
				</div>

				<div>
					<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Nombre *</label>
					<input 
						type="text" 
						id="input-nombre" 
						required 
						placeholder="Ej. Black Friday" 
						class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
					/>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Tipo de descuento</label>
						<select id="input-tipo" class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-slate-900">
							<option value="porcentaje">Porcentaje (%)</option>
							<option value="monto_fijo">Monto fijo ($)</option>
						</select>
					</div>
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Descuento (%)</label>
						<input 
							type="number" 
							step="0.01" 
							id="input-valor" 
							defaultValue="15.00" 
							class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
						/>
					</div>
				</div>
			</div>

			{/* Seccion 2: Vigencia */}
			<div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm space-y-6">
				<div class="flex items-center gap-2 text-base font-extrabold text-slate-900 border-b border-slate-100 pb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-orange-600"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
					Vigencia
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Desde *</label>
						<div class="relative">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
							<input 
								type="datetime-local" 
								id="input-desde" 
								required 
								class="w-full pl-12 pr-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
							/>
						</div>
					</div>
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Hasta *</label>
						<div class="relative">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
							<input 
								type="datetime-local" 
								id="input-hasta" 
								required 
								class="w-full pl-12 pr-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
							/>
						</div>
					</div>
				</div>
			</div>

			{/* Seccion 3: Límites y combinación */}
			<div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm space-y-6">
				<div class="flex items-center gap-2 text-base font-extrabold text-slate-900 border-b border-slate-100 pb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-orange-600"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
					Límites y combinación
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Usos máximos (vacío = ilimitado)</label>
						<input 
							type="text" 
							id="input-usos-max" 
							placeholder="Ilimitado" 
							class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
						/>
					</div>
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Usos por cliente (vacío = ilimitado)</label>
						<input 
							type="text" 
							id="input-usos-cliente" 
							placeholder="Ilimitado" 
							class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
						/>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Combinación con el descuento del cliente</label>
						<select id="input-combinacion" class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-slate-900">
							<option value="suma">Se suma (compound) — promo + descuento del cliente</option>
							<option value="no_acumulable">No acumulable</option>
							<option value="reemplaza">Reemplaza el descuento del cliente</option>
						</select>
					</div>
					<div>
						<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Estado</label>
						<select id="input-estado-promo" class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-slate-900">
							<option value="borrador">Borrador</option>
							<option value="activo">Activo</option>
							<option value="inactivo">Inactivo</option>
						</select>
					</div>
				</div>
			</div>

			{/* Seccion 4: Alcance */}
			<div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm space-y-6">
				<div class="flex items-center gap-2 text-base font-extrabold text-slate-900 border-b border-slate-100 pb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-indigo-600"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
					Alcance y Condiciones
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					
					{/* Alcance de Productos */}
					<div class="space-y-4">
						<h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Aplica a productos</h4>
						<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
							<input type="radio" name="alcance_productos" value="todos" checked class="mt-0.5" />
							<div>
								<span class="block text-sm font-bold text-slate-900">Todos los productos</span>
								<span class="block text-[10px] text-slate-500 mt-0.5">La promoción aplica a todo el catálogo</span>
							</div>
						</label>
						<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors opacity-60">
							<input type="radio" name="alcance_productos" value="categorias" disabled class="mt-0.5" />
							<div>
								<span class="block text-sm font-bold text-slate-900">Categorías específicas</span>
								<span class="block text-[10px] text-slate-500 mt-0.5">Próximamente</span>
							</div>
						</label>
						<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors opacity-60">
							<input type="radio" name="alcance_productos" value="especificos" disabled class="mt-0.5" />
							<div>
								<span class="block text-sm font-bold text-slate-900">Productos específicos</span>
								<span class="block text-[10px] text-slate-500 mt-0.5">Próximamente</span>
							</div>
						</label>
					</div>

					{/* Alcance de Clientes */}
					<div class="space-y-4">
						<h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Aplica a clientes</h4>
						<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
							<input type="radio" name="alcance_clientes" value="todos" checked class="mt-0.5" />
							<div>
								<span class="block text-sm font-bold text-slate-900">Todos los clientes</span>
								<span class="block text-[10px] text-slate-500 mt-0.5">B2B, B2C, y visitantes sin registro</span>
							</div>
						</label>
						<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
							<input type="radio" name="alcance_clientes" value="b2b" class="mt-0.5" />
							<div>
								<span class="block text-sm font-bold text-slate-900">Solo Mayoristas (B2B)</span>
								<span class="block text-[10px] text-slate-500 mt-0.5">Exclusivo para clientes con cuenta B2B aprobada</span>
							</div>
						</label>
						<label class="flex items-start gap-3 p-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-colors">
							<input type="radio" name="alcance_clientes" value="b2c" class="mt-0.5" />
							<div>
								<span class="block text-sm font-bold text-slate-900">Solo Minoristas (B2C)</span>
								<span class="block text-[10px] text-slate-500 mt-0.5">Solo para el consumidor final</span>
							</div>
						</label>
					</div>

				</div>

				<div class="border-t border-slate-100 pt-6 mt-6">
					<h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-4">Requisitos de compra (Opcional)</h4>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Monto mínimo del carrito</label>
							<div class="relative">
								<span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold">$</span>
								<input 
									type="number" 
									placeholder="0.00" 
									class="w-full pl-8 pr-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
								/>
							</div>
						</div>
						<div>
							<label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Cantidad mínima de artículos</label>
							<input 
								type="number" 
								placeholder="0" 
								class="w-full px-4 py-3 border border-slate-200 rounded-xl font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white" 
							/>
						</div>
					</div>
				</div>
			</div>

			{/* Botones de acción */}
			<div class="flex items-center gap-3">
				<button 
					type="submit" 
					id="btn-submit-promo" 
					class="px-8 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-lg transition-colors"
				>
					Crear promoción
				</button>
				<a 
					href="/admin/promociones" 
					class="px-6 py-3 border border-slate-200 text-slate-700 hover:bg-slate-50 font-bold text-sm rounded-xl transition-colors"
				>
					Cancelar
				</a>
			</div>
		</form>
	</main>

	<script>
		import { actions } from 'astro:actions';

		document.getElementById('form-nueva-promo')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const btn = document.getElementById('btn-submit-promo') as HTMLButtonElement;
			btn.disabled = true;
			btn.innerText = 'Guardando...';

			const nombre = (document.getElementById('input-nombre') as HTMLInputElement).value;
			const tipo = (document.getElementById('input-tipo') as HTMLSelectElement).value;
			const valor = parseFloat((document.getElementById('input-valor') as HTMLInputElement).value || '0');
			const desde = (document.getElementById('input-desde') as HTMLInputElement).value;
			const hasta = (document.getElementById('input-hasta') as HTMLInputElement).value;
			const estado = (document.getElementById('input-estado-promo') as HTMLSelectElement).value;

			const { data, error } = await actions.createPromocion({
				nombre,
				tipo,
				valor,
				desde,
				hasta,
				estado
			});

			if (error || !data?.success) {
				alert('Error al crear la promoción: ' + (error?.message || data?.error));
				btn.disabled = false;
				btn.innerText = 'Crear promoción';
				return;
			}

			alert('¡Promoción creada con éxito!');
			window.location.href = '/admin/promociones';
		});
	</script>
</AdminLayout>
