---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/server/settings';

const settings = await getSiteSettings();
const whatsappNumberClean = settings.whatsapp_number.replace(/\D/g, '');
---

<Layout title="Contacto | UrbanPoint">
    <div class="pt-24 pb-16 bg-slate-50 min-h-screen">
        <div class="max-w-4xl mx-auto px-6">
            
            <div class="text-center mb-16">
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">Contactanos</h1>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">Estamos para ayudarte. Elegí el canal que te resulte más cómodo para comunicarte con nuestro equipo.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                
                <!-- Card WhatsApp -->
                <a href={`https://wa.me/${whatsappNumberClean}?text=Hola%20UrbanPoint`} target="_blank" rel="noopener noreferrer" class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:border-[#25D366]/50 transition-all group flex flex-col items-center text-center">
                    <div class="w-20 h-20 bg-emerald-50 text-[#25D366] rounded-full flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-[#25D366] group-hover:text-white transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Escribinos por WhatsApp</h3>
                    <p class="text-slate-500 mb-6">Respuestas rápidas de Lunes a Viernes de 9 a 18 hs.</p>
                    <span class="text-[#25D366] font-bold text-sm">Abrir chat →</span>
                </a>

                <!-- Card Email -->
                <a href={`mailto:${settings.contact_email}`} class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm hover:shadow-xl hover:border-blue-500/50 transition-all group flex flex-col items-center text-center">
                    <div class="w-20 h-20 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Envianos un Correo</h3>
                    <p class="text-slate-500 mb-6">Para consultas institucionales, reclamos o sugerencias.</p>
                    <span class="text-blue-500 font-bold text-sm">{settings.contact_email}</span>
                </a>

            </div>

            <!-- FAQ Section -->
            <div class="bg-white rounded-3xl p-8 md:p-12 border border-slate-200 shadow-sm">
                <h2 class="text-2xl font-extrabold text-slate-900 mb-8 text-center">Preguntas Frecuentes</h2>
                <div class="space-y-6">
                    <div class="border-b border-slate-100 pb-6">
                        <h4 class="font-bold text-slate-900 mb-2">¿Cómo funciona el retiro en los Canillitas?</h4>
                        <p class="text-slate-600 text-sm">Una vez que tu pago es procesado y el pedido está listo, recibirás un Código QR en tu cuenta. Solo debés acercarte al puesto de diarios elegido, mostrarle el código al canillita y retirar tu bolsa.</p>
                    </div>
                    <div class="border-b border-slate-100 pb-6">
                        <h4 class="font-bold text-slate-900 mb-2">¿Qué pasa si mi pedido dice "Cancelado"?</h4>
                        <p class="text-slate-600 text-sm">Si el pago no se completa dentro de las 24 horas, el sistema cancela automáticamente la reserva de stock. Podés volver a realizar la compra desde el catálogo.</p>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-900 mb-2">Quiero sumar mi local como Punto de Retiro</h4>
                        <p class="text-slate-600 text-sm">¡Nos encanta crecer! Escribinos a <a href={`mailto:${settings.contact_email}`} class="text-indigo-600 font-semibold hover:underline">{settings.contact_email}</a> con el asunto "Postulación Canillita" o usa la sección <a href="/sumate-como-canillita" class="text-indigo-600 font-semibold hover:underline">Sumate como Canillita</a>.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</Layout>
