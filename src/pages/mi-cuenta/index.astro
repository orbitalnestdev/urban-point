---
import ClientLayout from '../../layouts/ClientLayout.astro';
import { getClientProfile } from '../../lib/server/auth';

export const prerender = false;

const profile = await getClientProfile(Astro.cookies);
if (!profile) return Astro.redirect('/login');
---

<ClientLayout title="Mi Cuenta | UrbanPoint" activeTab="dashboard">
	<div class="space-y-6">
		<h2 class="text-2xl font-extrabold text-slate-900 mb-6">Resumen de Cuenta</h2>
		
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
			<!-- Quick Stats -->
			<div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm flex items-center gap-4">
				<div class="w-14 h-14 rounded-2xl bg-emerald-50 flex items-center justify-center text-[#2D5A27]">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
				</div>
				<div>
					<p class="text-sm font-semibold text-slate-500">Mis Pedidos</p>
					<p class="text-2xl font-black text-slate-900">
						<a href="/mi-cuenta/pedidos" class="text-[#2D5A27] text-base font-bold hover:underline">Ver historial →</a>
					</p>
				</div>
			</div>

			<div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm flex items-center gap-4">
				<div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
				</div>
				<div>
					<p class="text-sm font-semibold text-slate-500">Mis Datos</p>
					<p class="text-slate-900 font-bold truncate max-w-[150px]">{profile.email}</p>
					<a href="/mi-cuenta/perfil" class="text-blue-600 text-xs font-bold hover:underline">Editar perfil</a>
				</div>
			</div>
		</div>

		<!-- Recent Activity / Promos -->
		<div class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm mt-8">
			<h3 class="text-lg font-bold text-slate-900 mb-4">Descubrí las ventajas de UrbanPoint</h3>
			<ul class="space-y-3">
				<li class="flex items-start gap-3">
					<svg class="w-5 h-5 text-[#2D5A27] mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg>
					<p class="text-sm text-slate-600"><strong>Retiro gratuito:</strong> Comprá online y retirás sin costo de envío en tu punto de barrio más cercano.</p>
				</li>
				<li class="flex items-start gap-3">
					<svg class="w-5 h-5 text-[#2D5A27] mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg>
					<p class="text-sm text-slate-600"><strong>Precios directos:</strong> Accedé a mercadería de primera línea sin intermediarios extra.</p>
				</li>
				<li class="flex items-start gap-3">
					<svg class="w-5 h-5 text-[#2D5A27] mt-0.5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg>
					<p class="text-sm text-slate-600"><strong>Apoyá a tu comercio:</strong> Cada compra suma comisiones para el Canillita de tu barrio, impulsando la economía local.</p>
				</li>
			</ul>
		</div>
	</div>
</ClientLayout>
