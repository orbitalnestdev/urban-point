---
import ClientLayout from '../../layouts/ClientLayout.astro';
import { getClientProfile } from '../../lib/server/auth';

export const prerender = false;

const profile = await getClientProfile(Astro.cookies);
if (!profile) return Astro.redirect('/login');

const userName = profile.nombre ? profile.nombre.split(' ')[0] : profile.email.split('@')[0];
---

<ClientLayout title="Mi Cuenta | UrbanPoint" activeTab="dashboard">
	
	<!-- Header / Greeting -->
	<div class="mb-10 bg-white rounded-3xl p-8 border border-slate-200/60 shadow-sm relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-6">
		<div class="relative z-10">
			<span class="inline-block px-3 py-1 bg-emerald-100 text-[#2D5A27] text-xs font-black uppercase tracking-wider rounded-lg mb-3">
				Cliente Activo
			</span>
			<h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
				Hola, <span class="text-[#2D5A27]">{userName}</span>
			</h2>
			<p class="text-slate-500 font-medium mt-2 max-w-lg">
				Bienvenido a tu panel de control. Acá podés ver tus compras, gestionar tu perfil y acceder rápidamente a los beneficios de UrbanPoint.
			</p>
		</div>
		
		<div class="relative z-10 shrink-0">
			<a href="/productos" class="inline-flex items-center justify-center px-6 py-3.5 bg-[#2D5A27] text-white font-bold rounded-xl hover:bg-[#20421c] transition-colors shadow-lg hover:shadow-xl hover:-translate-y-0.5">
				Ir a comprar
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
			</a>
		</div>

		<!-- Decorative Background Element -->
		<div class="absolute right-0 top-0 w-64 h-64 bg-emerald-50 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 opacity-60 pointer-events-none"></div>
	</div>

	<!-- Dashboard Grid -->
	<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
		
		<!-- Card: Mis Pedidos -->
		<a href="/mi-cuenta/pedidos" class="group flex flex-col bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-[#2D5A27]/30 transition-all relative overflow-hidden h-full">
			<div class="absolute right-0 top-0 w-32 h-32 bg-emerald-50 rounded-bl-full transition-transform group-hover:scale-110 opacity-70"></div>
			<div class="relative z-10 flex-1 flex flex-col">
				<div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center text-[#2D5A27] mb-6 group-hover:scale-110 transition-transform shadow-sm shrink-0">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
				</div>
				<h3 class="text-xl font-bold text-slate-900 mb-2">Mis Pedidos</h3>
				<p class="text-sm text-slate-500 mb-6 flex-1 leading-relaxed">Revisá el estado y el historial de todas tus compras.</p>
				<span class="text-[#2D5A27] font-bold text-sm inline-flex items-center gap-1 group-hover:underline mt-auto">
					Ver pedidos
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
				</span>
			</div>
		</a>

		<!-- Card: Mi Perfil -->
		<a href="/mi-cuenta/perfil" class="group flex flex-col bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-blue-500/30 transition-all relative overflow-hidden h-full">
			<div class="absolute right-0 top-0 w-32 h-32 bg-blue-50 rounded-bl-full transition-transform group-hover:scale-110 opacity-70"></div>
			<div class="relative z-10 flex-1 flex flex-col">
				<div class="w-14 h-14 rounded-2xl bg-blue-100 flex items-center justify-center text-blue-600 mb-6 group-hover:scale-110 transition-transform shadow-sm shrink-0">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
				</div>
				<h3 class="text-xl font-bold text-slate-900 mb-2">Mis Datos</h3>
				<p class="text-sm text-slate-500 mb-6 flex-1 leading-relaxed truncate">{profile.email}</p>
				<span class="text-blue-600 font-bold text-sm inline-flex items-center gap-1 group-hover:underline mt-auto">
					Editar perfil
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
				</span>
			</div>
		</a>
	</div>

	<!-- Benefits Box (Full Width, 3 Columns) -->
	<div class="bg-white rounded-3xl p-8 md:p-10 border border-slate-200/80 shadow-sm relative overflow-hidden">
		<div class="absolute right-0 top-0 w-64 h-64 bg-amber-50 rounded-bl-full opacity-70 pointer-events-none -z-0"></div>
		<div class="relative z-10">
			<h3 class="text-xl font-bold text-slate-900 mb-8 flex items-center gap-3">
				<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-amber-500"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
				Ventajas UrbanPoint
			</h3>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="flex flex-col gap-3">
					<div class="w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-600 border border-slate-100 shadow-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
					</div>
					<div>
						<p class="font-bold text-slate-900 text-base mb-1.5">Retiro Gratis</p>
						<p class="text-sm text-slate-500 leading-relaxed">Comprá hoy, retirá mañana en el canillita de tu barrio sin costo extra.</p>
					</div>
				</div>
				<div class="flex flex-col gap-3">
					<div class="w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-600 border border-slate-100 shadow-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
					</div>
					<div>
						<p class="font-bold text-slate-900 text-base mb-1.5">Mejores Precios</p>
						<p class="text-sm text-slate-500 leading-relaxed">Precios directos de fábrica en productos importados.</p>
					</div>
				</div>
				<div class="flex flex-col gap-3">
					<div class="w-12 h-12 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-600 border border-slate-100 shadow-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
					</div>
					<div>
						<p class="font-bold text-slate-900 text-base mb-1.5">Economía Local</p>
						<p class="text-sm text-slate-500 leading-relaxed">Cada compra ayuda a los canillitas a sumar ingresos extra.</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</ClientLayout>
