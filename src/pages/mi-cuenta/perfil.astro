---
import ClientLayout from '../../layouts/ClientLayout.astro';
import { getClientProfile } from '../../lib/server/auth';
import { createAdminClient } from '../../lib/server/appwrite';

export const prerender = false;

const profile = await getClientProfile(Astro.cookies);
if (!profile) return Astro.redirect('/login');

let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
	try {
		const formData = await Astro.request.formData();
		const nombre = formData.get('nombre')?.toString() || '';
		const telefono = formData.get('telefono')?.toString() || '';
		
		if (!nombre) {
			throw new Error('El nombre es obligatorio.');
		}
		
		const { databases } = createAdminClient();
		await databases.updateDocument('urbanpoint', 'profiles', profile.$id, {
			nombre,
			telefono
		});
		
		profile.nombre = nombre;
		profile.telefono = telefono;
		successMsg = 'Perfil actualizado correctamente.';
	} catch (e: any) {
		errorMsg = e.message || 'Error al actualizar el perfil.';
	}
}
---

<ClientLayout title="Mi Perfil | UrbanPoint" activeTab="perfil">
	<div class="bg-white rounded-3xl p-6 md:p-8 border border-slate-200/80 shadow-sm max-w-2xl">
		<h2 class="text-2xl font-extrabold text-slate-900 mb-6">Mi Perfil</h2>
		
		{successMsg && (
			<div class="bg-emerald-50 border border-emerald-200 text-[#2D5A27] px-4 py-3 rounded-xl text-sm font-semibold mb-6">
				{successMsg}
			</div>
		)}
		
		{errorMsg && (
			<div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm font-semibold mb-6">
				{errorMsg}
			</div>
		)}

		<form method="POST" class="space-y-6">
			<div>
				<label for="email" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Email (No se puede cambiar)</label>
				<input type="email" id="email" value={profile.email} disabled class="w-full px-4 py-3.5 bg-slate-100 border border-slate-200 rounded-xl text-slate-500 font-medium text-sm cursor-not-allowed" />
			</div>
			
			<div>
				<label for="nombre" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Nombre y Apellido</label>
				<input type="text" id="nombre" name="nombre" value={profile.nombre} required class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" />
			</div>
			
			<div>
				<label for="telefono" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Teléfono</label>
				<input type="tel" id="telefono" name="telefono" value={profile.telefono || ''} placeholder="Ej: 11 5555-5555" class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#2D5A27] focus:outline-none transition-all font-medium text-slate-900 text-sm" />
			</div>
			
			<div class="pt-4 border-t border-slate-100">
				<button type="submit" class="px-6 py-3.5 bg-[#2D5A27] text-white font-bold text-sm rounded-xl hover:bg-[#1E3E1B] transition-colors shadow-sm w-full sm:w-auto">
					Guardar Cambios
				</button>
			</div>
		</form>
	</div>
</ClientLayout>
