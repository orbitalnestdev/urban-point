	<!-- Client-side localStorage backup for active node -->
	<script is:inline set:html={`
		(function() {
			const activeNode = ${JSON.stringify({
				id: activeNode.$id,
				nombre: activeNode.nombre_comercial,
				slug: activeNode.slug,
				direccion: activeNode.direccion,
				localidad: activeNode.localidad,
				horarios: activeNode.horarios,
				canillitaId: typeof activeNode.profile_id === 'string' ? activeNode.profile_id : activeNode.profile_id?.$id,
				telefono: activeNode.telefono || '(11) 2478-5603'
			})};
			try {
				localStorage.setItem('up_active_node', JSON.stringify(activeNode));
			} catch (e) {}
		})();

		document.addEventListener('DOMContentLoaded', () => {
			const catPills = document.querySelectorAll('.cat-pill');
			const prodItems = document.querySelectorAll('.prod-item');

			catPills.forEach(pill => {
				pill.addEventListener('click', () => {
					const catId = pill.getAttribute('data-category');
					catPills.forEach(p => {
						p.classList.remove('active', 'bg-[#2D5A27]', 'text-white');
						p.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
					});
					pill.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
					pill.classList.add('active', 'bg-[#2D5A27]', 'text-white');

					prodItems.forEach(item => {
						const itemCat = item.getAttribute('data-cat-id');
						if (catId === 'all' || itemCat === catId) {
							(item as HTMLElement).style.display = 'flex';
						} else {
							(item as HTMLElement).style.display = 'none';
						}
					});
				});
			});
		});
	`} />

