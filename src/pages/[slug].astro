						const precioMinorista = precioDeVentaCentavos(prod) / 100;
						const listaCentavos = precioListaCentavos(prod);
						const precioLista = listaCentavos === null ? null : listaCentavos / 100;

						return (
							<div 
								class="prod-item group bg-white rounded-3xl border border-slate-200/70 p-5 shadow-sm hover:shadow-2xl hover:border-[#2D5A27]/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between relative overflow-hidden" 
