---
import Layout from '../../layouts/Layout.astro';
import RegistrationForm from '../../components/canillitas/RegistrationForm';
---

<Layout title="Registro de Canillita | UrbanPoint">
	<nav class="w-full z-50 bg-white border-b border-slate-200">
		<div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
			<a href="/sumate-como-canillita" class="flex items-center gap-2 text-slate-600 hover:text-indigo-600 font-medium transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
				Volver
			</a>
			<span class="text-xl font-extrabold tracking-tight text-slate-900">UrbanPoint</span>
		</div>
	</nav>

	<main class="min-h-[calc(100vh-64px)] bg-slate-50 py-12">
		<div class="max-w-3xl mx-auto px-6">
			<RegistrationForm client:only="react" />
		</div>
	</main>
</Layout>
