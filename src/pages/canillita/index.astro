---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { Query } from 'node-appwrite';
import { createAdminClient } from '../../lib/server/appwrite';
import {
  ETIQUETAS,
  puedeEntregarse,
  normalizarEstadoPedido,
  type EstadoPedido
} from '../../lib/orderStates';

const user = Astro.locals.user;
if (!user || (user.role !== 'canillita' && user.role !== 'admin')) {
  return Astro.redirect('/');
}

const { databases: db } = createAdminClient();

let point: any = null;
let referralCodeDoc: any = null;
let ordersList: any[] = [];
let ledgerList: any[] = [];

let totalAcumuladoCentavos = 0;
let totalPendienteCentavos = 0;
let totalLiquidadoCentavos = 0;

const estadoFiltro = Astro.url.searchParams.get('estado') || 'todos';

try {
  const points = await db.listDocuments('urbanpoint', 'pickup_points', [
    Query.equal('profile_id', user.profileId)
  ]);

  if (points.documents.length > 0) {
    point = points.documents[0];
  } else if (user.role === 'admin') {
    // For admin previewing the page
    const allPoints = await db.listDocuments('urbanpoint', 'pickup_points', [Query.limit(1)]);
    if (allPoints.documents.length > 0) point = allPoints.documents[0];
  }

  if (point) {
    // 1. Referral Code
    const refRes = await db.listDocuments('urbanpoint', 'referral_codes', [
      Query.equal('owner_id', point.profile_id?.$id || point.profile_id || user.profileId),
      Query.limit(1)
    ]);
    if (refRes.documents.length > 0) referralCodeDoc = refRes.documents[0];

    // 2. Orders assigned to this pickup point
    const orderQueries = [
      Query.equal('pickup_point_id', point.$id),
      Query.orderDesc('$createdAt'),
      Query.limit(100)
    ];
    if (estadoFiltro !== 'todos') {
      // El tab "Listos" apuntaba al estado inexistente 'listo' y devolvía vacío.
      const estadoCanonico = normalizarEstadoPedido(estadoFiltro);
      if (estadoCanonico) {
        orderQueries.unshift(Query.equal('estado', estadoCanonico));
      }
    }
    const fetchedOrders = await db.listDocuments('urbanpoint', 'orders', orderQueries);
    ordersList = fetchedOrders.documents;

    // 3. Order Items for names/skus
    const orderIds = ordersList.map(o => o.$id);
    if (orderIds.length > 0) {
      const itemsRes = await db.listDocuments('urbanpoint', 'order_items', [
        Query.equal('order_id', orderIds),
        Query.limit(200)
      ]);
      const itemsByOrder: Record<string, any[]> = {};
      for (const item of itemsRes.documents) {
        const oId = typeof item.order_id === 'string' ? item.order_id : item.order_id?.$id;
        if (oId) {
          if (!itemsByOrder[oId]) itemsByOrder[oId] = [];
          itemsByOrder[oId].push(item);
        }
      }
      ordersList.forEach(o => {
        o.items = itemsByOrder[o.$id] || [];
      });
    }

    // 4. Commission Ledger
    const ledgerRes = await db.listDocuments('urbanpoint', 'commission_ledger', [
      Query.equal('profile_id', point.profile_id?.$id || point.profile_id || user.profileId),
      Query.orderDesc('$createdAt'),
      Query.limit(100)
    ]);
    ledgerList = ledgerRes.documents;

    // "Comisiones totales" es lo ganado: suma sólo los devengos, sin los
    // asientos de reversa (negativos) ni los ya revertidos, que antes se
    // mezclaban y distorsionaban el número.
    totalAcumuladoCentavos = ledgerList
      .filter(l => l.tipo !== 'reversa' && l.tipo !== 'liquidacion' && l.estado !== 'revertido')
      .reduce((acc, curr) => acc + (curr.monto_centavos || 0), 0);
    totalPendienteCentavos = ledgerList.filter(l => l.estado === 'pendiente').reduce((acc, curr) => acc + (curr.monto_centavos || 0), 0);
    // El enum del ledger es pendiente|disponible|liquidado|revertido: filtrar
    // por 'pagado' daba siempre $0.
    totalLiquidadoCentavos = ledgerList.filter(l => l.estado === 'liquidado').reduce((acc, curr) => acc + (curr.monto_centavos || 0), 0);
  }
} catch (e) {
  console.error("Canillita Dashboard Error:", e);
}

const isPending = point?.estado === 'pendiente';
const isSuspended = point?.estado === 'suspendido';
const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });
const shareUrl = referralCodeDoc ? `https://urbanpoint.com.ar/?ref=${referralCodeDoc.code}` : '';
---

<Layout title="Panel de Canillita | UrbanPoint">
	<nav class="w-full z-50 bg-white border-b border-slate-200">
		<div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
			<div class="flex items-center gap-3">
				<div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-black">
					C
				</div>
				<div>
					<span class="text-lg font-extrabold tracking-tight text-slate-900 block leading-tight">Panel Canillita</span>
					<span class="text-xs text-slate-500 font-medium">{point ? point.nombre_comercial : 'Sin Local'}</span>
				</div>
			</div>
			<div class="flex items-center gap-4">
				<span class="text-sm font-semibold text-slate-700 hidden sm:inline">{user.name}</span>
				<a href="/canillita/liquidaciones" class="text-xs font-bold px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-lg transition-colors">
					Mis Cobros
				</a>
				<form method="post" action={'/_actions/auth_logout'}>
					<button class="text-xs text-rose-600 font-bold hover:text-rose-700 cursor-pointer">Salir</button>
				</form>
			</div>
		</div>
	</nav>

	<main class="min-h-[calc(100vh-64px)] bg-slate-50 py-8">
		<div class="max-w-7xl mx-auto px-4 sm:px-6">

			{/* Status Banners */}
			{isPending && (
				<div class="bg-amber-500 text-white rounded-2xl p-6 mb-8 shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4">
					<div>
						<h2 class="text-xl font-bold mb-1">¡Cuenta Pendiente de Activación!</h2>
						<p class="text-amber-100 text-sm">Tu local fue registrado. Para empezar a operar necesitás completar tu CBU y datos fiscales.</p>
					</div>
					<a href="/canillita/activar" class="px-6 py-2.5 bg-white text-amber-800 font-bold text-sm rounded-xl hover:bg-amber-50 transition-all shrink-0">
						Activar Cuenta
					</a>
				</div>
			)}

			{isSuspended && (
				<div class="bg-rose-600 text-white rounded-2xl p-6 mb-8 shadow-lg">
					<h2 class="text-xl font-bold mb-1">Punto de Retiro Suspendido</h2>
					<p class="text-rose-100 text-sm">Tu cuenta o punto de retiro se encuentra inactivo temporalmente. Ponete en contacto con administración para regularizar tu situación.</p>
				</div>
			)}

			{/* Metric Cards */}
			<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
				<div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200">
					<h3 class="text-slate-400 font-bold text-xs uppercase tracking-wider mb-2">Entregas Pendientes</h3>
					<p class="text-3xl font-black text-slate-900">{ordersList.filter(o => puedeEntregarse(o.estado)).length}</p>
				</div>
				<div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200">
					<h3 class="text-slate-400 font-bold text-xs uppercase tracking-wider mb-2">Comisiones Totales</h3>
					<p class="text-3xl font-black text-indigo-600">{formateador.format(totalAcumuladoCentavos / 100)}</p>
				</div>
				<div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200">
					<h3 class="text-slate-400 font-bold text-xs uppercase tracking-wider mb-2">Pendiente de Liquidar</h3>
					<p class="text-3xl font-black text-emerald-600">{formateador.format(totalPendienteCentavos / 100)}</p>
				</div>
				<div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200">
					<h3 class="text-slate-400 font-bold text-xs uppercase tracking-wider mb-2">Total Ya Liquidado</h3>
					<p class="text-3xl font-black text-slate-700">{formateador.format(totalLiquidadoCentavos / 100)}</p>
				</div>
			</div>

			{/* Sección 1 — Entregas */}
			<div class="bg-white rounded-3xl shadow-xs border border-slate-200 p-6 md:p-8 mb-8">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
					<div>
						<h2 class="text-2xl font-black text-slate-900">Entregas y Paquetes</h2>
						<p class="text-xs text-slate-500 mt-0.5">Gestioná los paquetes recibidos para retiro en tu local.</p>
					</div>
					<div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-xl text-xs font-bold">
						<a href="?estado=todos" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoFiltro === 'todos' ? 'bg-white text-slate-900 shadow-xs' : 'text-slate-600'}`}>Todos</a>
						<a href="?estado=listo" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoFiltro === 'listo' ? 'bg-white text-indigo-700 shadow-xs' : 'text-slate-600'}`}>Listos / Pagados</a>
						<a href="?estado=entregado" class={`px-3 py-1.5 rounded-lg transition-colors ${estadoFiltro === 'entregado' ? 'bg-white text-emerald-700 shadow-xs' : 'text-slate-600'}`}>Entregados</a>
					</div>
				</div>

				{ordersList.length > 0 ? (
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-sm">
							<thead>
								<tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
									<th class="p-4">Pedido #</th>
									<th class="p-4">Fecha</th>
									<th class="p-4">Ítems</th>
									<th class="p-4 text-center">Código Retiro</th>
									<th class="p-4 text-center">Estado</th>
									<th class="p-4 text-right">Acción</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								{ordersList.map(order => (
									<tr class="hover:bg-slate-50 transition-colors">
										<td class="p-4 font-bold text-indigo-700 font-mono">
											{order.numero || order.$id.substring(0,8).toUpperCase()}
										</td>
										<td class="p-4 text-slate-600 text-xs font-medium">
											{new Date(order.$createdAt).toLocaleDateString('es-AR')}
										</td>
										<td class="p-4 text-slate-800">
											{order.items && order.items.length > 0 ? (
												<ul class="text-xs space-y-1">
													{order.items.map((it: any) => (
														<li><span class="font-bold">{it.cantidad}x</span> {it.nombre_snapshot}</li>
													))}
												</ul>
											) : (
												<span class="text-xs text-slate-400">Ver pedido en detalle</span>
											)}
										</td>
										<td class="p-4 text-center">
											<span class="inline-block px-3 py-1 bg-slate-100 border border-slate-200 text-slate-700 font-mono font-bold tracking-widest rounded-lg text-xs">
												{order.pickup_code_hash || 'Sin código'}
											</span>
										</td>
										<td class="p-4 text-center">
											{order.estado === 'pendiente_pago' ? (
												<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">Pendiente de pago</span>
											) : (
												<span class={`px-2.5 py-1 rounded-full text-xs font-bold border ${order.estado === 'entregado' || order.estado === 'retirado' ? 'bg-emerald-100 text-emerald-800 border-emerald-200' : 'bg-indigo-100 text-indigo-800 border-indigo-200'}`}>
													{ETIQUETAS[order.estado as EstadoPedido] || order.estado}
												</span>
											)}
										</td>
										<td class="p-4 text-right">
											{order.estado === 'pendiente_pago' ? (
												<span class="text-xs font-semibold text-amber-700">
													No entregar: sin pago acreditado
												</span>
											) : puedeEntregarse(order.estado) ? (
												<button
													class="btn-entregar-pedido px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs transition-all cursor-pointer"
													data-id={order.$id}
													data-code={order.pickup_code_hash || ''}
												>
													Marcar Entregado
												</button>
											) : (
												<span class="text-xs text-slate-400 font-medium">Completado</span>
											)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				) : (
					<div class="text-center py-12 text-slate-500">
						<p class="font-bold text-slate-700">No hay paquetes registrados en este estado.</p>
					</div>
				)}
			</div>

			{/* Sección 2 — Comisiones */}
			<div class="bg-white rounded-3xl shadow-xs border border-slate-200 p-6 md:p-8 mb-8">
				<div class="mb-6">
					<h2 class="text-2xl font-black text-slate-900">Historial de Comisiones Devengadas</h2>
					<p class="text-xs text-slate-500 mt-0.5">Detalle por venta y porcentajes aplicados congelados en la compra.</p>
				</div>

				{ledgerList.length > 0 ? (
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-sm">
							<thead>
								<tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
									<th class="p-4">Fecha</th>
									<th class="p-4">Tipo</th>
									<th class="p-4 text-center">Tasa Aplicada</th>
									<th class="p-4 text-right">Monto Comisión</th>
									<th class="p-4 text-center">Estado</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100">
								{ledgerList.map(leg => (
									<tr class="hover:bg-slate-50">
										<td class="p-4 text-xs font-medium text-slate-600">
											{new Date(leg.$createdAt).toLocaleString('es-AR')}
										</td>
										<td class="p-4 font-semibold text-slate-800 text-xs uppercase tracking-wider">
											{leg.tipo || 'Comisión Venta'}
										</td>
										<td class="p-4 text-center font-mono text-xs font-bold text-indigo-600">
											{((leg.tasa_bp_snapshot || 0) / 100).toFixed(1)}%
										</td>
										<td class="p-4 text-right font-black text-slate-900">
											{formateador.format((leg.monto_centavos || 0) / 100)}
										</td>
										<td class="p-4 text-center">
											{leg.estado === 'liquidado' ? (
												<span class="px-2 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-full">Liquidado</span>
											) : leg.estado === 'revertido' ? (
												<span class="px-2 py-1 bg-rose-100 text-rose-800 text-xs font-bold rounded-full">Revertido</span>
											) : (
												<span class="px-2 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full">Pendiente</span>
											)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				) : (
					<div class="text-center py-8 text-slate-400 text-sm">
						Aún no registrás comisiones acumuladas.
					</div>
				)}
			</div>

			{/* Sección 3 — Link de Referido, WhatsApp y QR */}
			{referralCodeDoc && (
				<div class="bg-white rounded-3xl shadow-xs border border-slate-200 p-8 space-y-6">
					<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 border-b border-slate-100 pb-6">
						<div>
							<span class="inline-block px-3 py-1 bg-indigo-50 text-indigo-700 font-bold text-xs rounded-full uppercase tracking-wider mb-2">
								Link Exclusivo de Referido
							</span>
							<h3 class="text-2xl font-black text-slate-900">
								Tu Código: <span class="text-indigo-600 font-mono tracking-wider">{referralCodeDoc.code}</span>
							</h3>
							<p class="text-slate-500 text-xs mt-1">Compartí este link con tus clientes para sumar comisiones del {point.comision_pct || 10.0}% en cada venta.</p>
						</div>

						<div class="flex flex-col sm:flex-row items-center gap-3">
							<input type="text" readonly value={shareUrl} class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono text-slate-700 w-full sm:w-80 outline-none" />
							<button id="btn-copiar-link" data-url={shareUrl} class="px-5 py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-md transition-all shrink-0 cursor-pointer">
								Copiar Link
							</button>
							<a 
								href={`https://wa.me/?text=${encodeURIComponent(`¡Hola! Te comparto mi link exclusivo para comprar en UrbanPoint: ${shareUrl}`)}`}
								target="_blank" 
								rel="noopener noreferrer"
								class="px-5 py-3 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center gap-2 shrink-0"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
								Compartir por WhatsApp
							</a>
						</div>
					</div>

					{/* Código QR para Impresión en Kiosco */}
					<div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-slate-50 p-6 rounded-2xl border border-slate-100">
						<div class="flex items-center gap-4">
							<div class="w-24 h-24 bg-white p-2 border border-slate-200 rounded-xl shadow-sm shrink-0 flex items-center justify-center">
								<img 
									src={`https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(shareUrl)}`} 
									alt="Código QR Referido Canillita" 
									class="w-full h-full object-contain" 
								/>
							</div>
							<div>
								<h4 class="font-bold text-slate-900 text-sm">Código QR para tu Local</h4>
								<p class="text-xs text-slate-500 mt-1 max-w-md">Imprimí este código QR y pegalo en tu Kiosco de Diarios para que tus vecinos escaneen y compren directo desde tu punto.</p>
							</div>
						</div>
						<button 
							onclick="window.print()" 
							class="px-4 py-2.5 bg-white border border-slate-200 text-slate-700 font-bold text-xs rounded-xl hover:bg-slate-100 transition-colors shadow-sm flex items-center gap-2 shrink-0 cursor-pointer"
						>
							🬀 Imprimir Cartel con QR
						</button>
					</div>
				</div>
			)}
		</div>
	</main>

	<script>
		import { actions } from 'astro:actions';

		document.querySelectorAll('.btn-entregar-pedido').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const el = e.currentTarget as HTMLElement;
				const orderId = el.dataset.id;
				const expectedCode = el.dataset.code;

				let inputCode = '';
				if (expectedCode) {
					const val = prompt(`Ingresá el código de retiro proporcionado por el cliente (${expectedCode}):`);
					if (!val) return;
					inputCode = val;
				} else {
					if (!confirm('¿Confirmás que el cliente retiró el paquete de tu local?')) return;
				}

				el.setAttribute('disabled', 'true');
				el.innerHTML = 'Procesando...';

				try {
					const { data, error } = await actions.deliverOrder({ orderId: orderId!, pickupCode: inputCode });
					if (error || !data?.success) {
						alert(error?.message || 'Error al procesar la entrega.');
						el.removeAttribute('disabled');
						el.innerHTML = 'Marcar Entregado';
					} else {
						alert('¡Pedido marcado como entregado exitosamente!');
						window.location.reload();
					}
				} catch (err) {
					alert('Error de conexión');
					el.removeAttribute('disabled');
					el.innerHTML = 'Marcar Entregado';
				}
			});
		});

		document.getElementById('btn-copiar-link')?.addEventListener('click', (e) => {
			const btn = e.currentTarget as HTMLButtonElement;
			const url = btn.dataset.url || '';
			if (!url) return;
			navigator.clipboard.writeText(url).then(() => {
				btn.innerText = '¡Copiado!';
				setTimeout(() => btn.innerText = 'Copiar Link', 2000);
			});
		});
	</script>
</Layout>
