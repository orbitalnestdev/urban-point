---
import Layout from '../../layouts/Layout.astro';
import { Query } from 'node-appwrite';
import { createAdminClient } from '../../lib/server/appwrite';
import { ChevronLeft, WalletCards, ArrowDownLeft, Clock } from 'lucide-react';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.role !== 'canillita') {
  return Astro.redirect('/');
}

const { databases: db } = createAdminClient();

// 1. Obtener saldo pendiente
const ledgerRes = await db.listDocuments('urbanpoint', 'commission_ledger', [
  Query.equal('profile_id', user.profileId),
  Query.equal('estado', 'pendiente'),
  Query.limit(500)
]);

const saldoPendiente = ledgerRes.documents.reduce((acc, curr) => acc + (curr.monto_centavos || 0), 0);

// 2. Obtener historial de payouts
const payoutsRes = await db.listDocuments('urbanpoint', 'payouts', [
  Query.equal('profile_id', user.profileId),
  Query.orderDesc('pagado_at'),
  Query.limit(50)
]);

const payouts = payoutsRes.documents;
---

<Layout title="Mis Cobros | Panel Canillita">
  <nav class="w-full z-50 bg-white border-b border-slate-200">
		<div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
			<a href="/canillita" class="flex items-center gap-2 text-slate-600 hover:text-indigo-600 font-medium transition-colors">
				<ChevronLeft className="w-5 h-5" />
				Volver al Panel
			</a>
			<span class="text-xl font-extrabold tracking-tight text-slate-900">Mis Cobros</span>
		</div>
	</nav>

  <main class="min-h-[calc(100vh-64px)] bg-slate-50 py-12">
    <div class="max-w-4xl mx-auto px-6 space-y-8">
      
      {/* Saldo Pendiente */}
      <div class="bg-indigo-600 rounded-2xl p-8 text-white shadow-xl shadow-indigo-600/20 relative overflow-hidden flex items-center justify-between">
        <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 mix-blend-overlay pointer-events-none"></div>
        <div class="relative z-10">
          <p class="text-indigo-100 font-medium flex items-center gap-2 mb-1">
            <Clock className="w-4 h-4" />
            Saldo Pendiente de Liquidar
          </p>
          <h2 class="text-5xl font-black">${(saldoPendiente / 100).toFixed(2)}</h2>
        </div>
        <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center relative z-10 backdrop-blur-md">
          <WalletCards className="w-8 h-8 text-white" />
        </div>
      </div>

      {/* Historial de Payouts */}
      <div>
        <h3 class="text-xl font-bold text-slate-900 mb-4">Historial de Transferencias</h3>
        
        {payouts.length === 0 ? (
          <div class="bg-white p-8 rounded-2xl text-center border border-slate-200">
            <p class="text-slate-500">Todavía no has recibido ninguna liquidación.</p>
          </div>
        ) : (
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="divide-y divide-slate-100">
              {payouts.map((p) => (
                <div class="p-6 flex items-center justify-between hover:bg-slate-50 transition-colors">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center">
                      <ArrowDownLeft className="w-6 h-6" />
                    </div>
                    <div>
                      <p class="font-bold text-slate-900">Liquidación recibida</p>
                      <p class="text-sm text-slate-500 flex gap-2">
                        <span>{new Date(p.pagado_at).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                        <span>•</span>
                        <span>{p.medio_pago}</span>
                      </p>
                    </div>
                  </div>
                  <div class="text-right">
                    <p class="text-xl font-black text-green-600">+ ${(p.monto_centavos / 100).toFixed(2)}</p>
                    <p class="text-xs font-mono text-slate-400 mt-1">Ref: {p.referencia_pago}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

    </div>
  </main>
</Layout>
