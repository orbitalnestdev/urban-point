---
import Layout from '../../layouts/Layout.astro';
import { Query } from 'node-appwrite';
import { createAdminClient } from '../../lib/server/appwrite';
import { getCanillitaStats } from '../../lib/commissions';

export const prerender = false;

const user = Astro.locals.user;
if (!user || (user.role !== 'canillita' && user.role !== 'admin')) {
  return Astro.redirect('/canillita/login');
}

const { databases: db } = createAdminClient();

let stats = {
  comisionesMesCentavos: 0,
  totalPendienteCentavos: 0,
  totalLiquidadoCentavos: 0,
  ventasAtribuidasMesCount: 0,
  entregasPendientesCount: 0
};
let payouts: any[] = [];
let ledgerByPayout: Record<string, any[]> = {};
let loadError = false;

try {
  // Stats y payouts no dependen entre sí: en paralelo
  const [statsRes, payoutsRes] = await Promise.all([
    getCanillitaStats(user.profileId),
    db.listDocuments('urbanpoint', 'payouts', [
      Query.equal('profile_id', user.profileId),
      Query.orderDesc('pagado_at'),
      Query.limit(50)
    ])
  ]);

  stats = statsRes;
  payouts = payoutsRes.documents;

  // Obtener asientos asignados a cada payout (máx. 50 ids, no hace falta trocear)
  const payoutIds = payouts.map(p => p.$id);
  if (payoutIds.length > 0) {
    const ledgerRes = await db.listDocuments('urbanpoint', 'commission_ledger', [
      Query.equal('payout_id', payoutIds),
      Query.limit(500)
    ]);
    for (const item of ledgerRes.documents) {
      const pId = typeof item.payout_id === 'string' ? item.payout_id : item.payout_id?.$id;
      if (pId) {
        if (!ledgerByPayout[pId]) ledgerByPayout[pId] = [];
        ledgerByPayout[pId].push(item);
      }
    }
  }
} catch (e) {
  // Antes cualquier falla acá tiraba un 500 crudo; mejor un banner amable.
  console.error('Liquidaciones Canillita Error:', e);
  loadError = true;
}

// Panel financiero: los centavos importan, no se truncan.
const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<Layout title="Mis Cobros | Panel Canillita">
  <nav class="w-full z-50 bg-white border-b border-slate-200">
		<div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
			<a href="/canillita" class="flex items-center gap-2 text-slate-600 hover:text-indigo-600 font-bold text-xs transition-colors">
				<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
				Volver al Panel
			</a>
			<span class="text-base font-extrabold tracking-tight text-slate-900">Histórico de Cobros y Liquidaciones</span>
		</div>
	</nav>

  <main class="min-h-[calc(100vh-64px)] bg-slate-50 py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">

      {/* Error de carga: distinto del estado sin liquidaciones */}
      {loadError && (
        <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 flex items-start gap-3">
          <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <p class="text-sm font-bold text-rose-800">No pudimos cargar tus datos, recargá la página.</p>
        </div>
      )}

      {/* Saldo Pendiente */}
      <div class="bg-indigo-600 rounded-3xl p-8 text-white shadow-xl shadow-indigo-600/15 relative overflow-hidden flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
          <p class="text-indigo-100 text-xs font-bold uppercase tracking-wider flex items-center gap-2 mb-2">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Saldo Pendiente de Liquidación
          </p>
          <h2 class="text-4xl sm:text-5xl font-black tracking-tight">{formateador.format(stats.totalPendienteCentavos / 100)}</h2>
          <p class="text-xs text-indigo-200 mt-2">Corresponde a comisiones devengadas y confirmadas aún no liquidadas.</p>
        </div>
        <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center shrink-0 backdrop-blur-xs border border-white/20">
          <svg class="w-8 h-8 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </div>
      </div>

      {/* Historial de Payouts */}
      <div class="space-y-4">
        <h3 class="text-lg font-black text-slate-900">Transferencias y Pagos Recibidos</h3>
        
        {payouts.length === 0 ? (
          <div class="bg-white p-8 rounded-3xl text-center border border-slate-200">
            <p class="text-xs text-slate-500 font-medium">Todavía no has recibido ninguna liquidación enviada por administración.</p>
          </div>
        ) : (
          <div class="bg-white rounded-3xl shadow-xs border border-slate-200 overflow-hidden divide-y divide-slate-100">
            {payouts.map((p) => {
              const items = ledgerByPayout[p.$id] || [];
              return (
                <details class="group p-6 hover:bg-slate-50/50 transition-colors">
                  <summary class="flex items-center justify-between cursor-pointer list-none">
                    <div class="flex items-center gap-4">
                      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-100">
                        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                      </div>
                      <div>
                        <p class="font-bold text-slate-900 text-sm">Liquidación recibida</p>
                        <p class="text-xs text-slate-500 flex items-center gap-2 mt-0.5">
                          <span>{p.pagado_at ? new Date(p.pagado_at).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Reciente'}</span>
                          <span>•</span>
                          <span>{p.medio_pago || 'Transferencia'}</span>
                        </p>
                      </div>
                    </div>
                    <div class="text-right flex items-center gap-3">
                      <div>
                        <p class="text-lg font-black text-emerald-600">+ {formateador.format((p.monto_centavos || 0) / 100)}</p>
                        <p class="text-[11px] font-mono text-slate-400">Ref: {p.referencia_pago || 'N/A'}</p>
                      </div>
                      <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
                    </div>
                  </summary>

                  {/* Asientos Incluidos en la Liquidación */}
                  <div class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs">
                    <p class="font-bold text-slate-700">Asientos incluidos en este pago ({items.length}):</p>
                    {items.length > 0 ? (
                      <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 space-y-1.5 font-mono text-[11px]">
                        {items.map((it: any) => (
                          <div class="flex justify-between items-center text-slate-700">
                            <span>Orden #{typeof it.order_id === 'string' ? it.order_id.substring(0,8).toUpperCase() : (it.order_id?.$id?.substring(0,8).toUpperCase() || 'N/A')} - {it.motivo || 'Comisión'}</span>
                            <span class="font-bold text-slate-900">{formateador.format((it.monto_centavos || 0) / 100)}</span>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <p class="text-slate-400 italic">Desglose acumulado incluido en el recibo general.</p>
                    )}
                  </div>
                </details>
              );
            })}
          </div>
        )}
      </div>

    </div>
  </main>
</Layout>
