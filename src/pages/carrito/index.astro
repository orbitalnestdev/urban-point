---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = false;
---

<Layout title="Mi Carrito de Compras | UrbanPoint">
	<Header activePage="catalogo" />

	<main class="py-12 bg-slate-50 min-h-screen">
		<div class="max-w-5xl mx-auto px-6">
			
			<!-- Breadcrumbs -->
			<nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6">
				<a href="/" class="hover:text-[#2D5A27] transition-colors">Inicio</a>
				<svg class="w-3.5 h-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
				<a href="/productos" class="hover:text-[#2D5A27] transition-colors">Catálogo</a>
				<svg class="w-3.5 h-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
				<span class="text-slate-900 font-bold">Mi Carrito</span>
			</nav>

			<div class="flex items-center justify-between mb-8">
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
					<div class="w-10 h-10 rounded-2xl bg-[#F2F7F3] border border-[#D4E5D6] text-[#2D5A27] flex items-center justify-center">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
					</div>
					Tu Carrito de Compras
				</h1>
				<a href="/productos" class="text-xs font-bold text-[#2D5A27] hover:underline flex items-center gap-1">
					← Volver al catálogo
				</a>
			</div>

			<!-- Full Cart Container -->
			<div id="full-cart-container" class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
				
				<!-- Left Column: Products List & Coupon -->
				<div class="lg:col-span-2 space-y-6">
					
					<div id="cart-items-wrapper">
						<div class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xs text-center text-slate-500 py-16">
							<p class="font-bold text-slate-700">Cargando productos de tu carrito...</p>
						</div>
					</div>

					<!-- Coupon / Discount Code Input Box -->
					<div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs">
						<h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-3 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[#2D5A27]"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
							¿Tenés un código de descuento?
						</h3>
						<div class="flex gap-2">
							<input 
								type="text" 
								id="coupon-input" 
								placeholder="Ingresá tu código (ej: UPBARRIO)..." 
								class="flex-1 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-xs font-semibold uppercase focus:outline-none focus:ring-2 focus:ring-[#2D5A27]"
							/>
							<button 
								id="btn-apply-coupon" 
								class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition-all shadow-xs cursor-pointer"
							>
								Aplicar
							</button>
						</div>
						<div id="coupon-msg" class="hidden mt-2 text-xs font-semibold"></div>
					</div>
				</div>

				<!-- Right Column: Summary & Checkout Box -->
				<div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-5 sticky top-24">
					<h2 class="text-lg font-extrabold text-slate-900 border-b border-slate-100 pb-3">Resumen de Compra</h2>
					
					<!-- Installments & Perks Box -->
					<div class="p-3.5 bg-[#F2F7F3] rounded-2xl border border-[#D4E5D6] space-y-1.5 text-xs text-[#2D5A27] font-bold mt-4">
						<div class="flex items-center justify-between">
							<span class="flex items-center gap-1.5">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
								3 cuotas sin interés:
							</span>
							<span id="full-installment-amount">$ 0</span>
						</div>
						<p class="text-[11px] font-bold text-[#2D5A27] flex items-center gap-1.5">
							<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
							<span>Retiro 100% GRATIS</span>
						</p>
					</div>

					<!-- Total Price -->
					<div class="border-t border-slate-100 pt-4 flex justify-between items-baseline mb-4">
						<span class="text-sm font-bold text-slate-500">Total</span>
						<span id="full-cart-total" class="text-3xl font-black text-slate-900">$ 0</span>
					</div>

					<!-- Delivery Method Selection (Envío a domicilio desactivado) -->
					<div class="space-y-2">
						<label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Forma de entrega</label>
						<div class="p-3.5 bg-[#F2F7F3] border-2 border-[#2D5A27] text-[#2D5A27] rounded-xl flex items-center justify-between">
							<div class="flex items-center gap-2.5 text-xs font-bold">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
								<div>
									<span class="block">Retiro en Punto UrbanPoint</span>
									<span class="text-[11px] text-slate-500 font-normal">Retirá gratis en el comercio de tu zona</span>
								</div>
							</div>
							<span class="text-xs text-emerald-600 font-extrabold uppercase px-2 py-0.5 bg-emerald-100 rounded-md">GRATIS</span>
						</div>
					</div>

					<!-- Checkout Button -->
					<a 
						href="/checkout/retiro"
						id="full-checkout-btn" 
						class="w-full bg-[#2D5A27] hover:bg-[#23471F] text-white font-extrabold py-4 px-6 rounded-xl shadow-lg shadow-[#2D5A27]/20 transition-all flex items-center justify-center gap-2 text-sm pointer-events-none opacity-50"
					>
						Retirar en Canillita (Gratis)
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
					</a>

					<!-- Trust Badges -->
					<div class="space-y-2 pt-3 border-t border-slate-100 text-[11px] text-slate-500 font-semibold">
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[#2D5A27] shrink-0"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
							<span>Pago seguro con Mercado Pago</span>
						</div>
						<div class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[#2D5A27] shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
							<span>Garantía oficial de 30 días</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<script>
	import { cartItems, removeCartItem, updateItemQuantity, clearCart } from '../../store/cart';

	const formateador = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });

	function renderFullCart() {
		const wrapper = document.getElementById('cart-items-wrapper');
		const totalEl = document.getElementById('full-cart-total');
		const installmentEl = document.getElementById('full-installment-amount');
		const checkoutBtn = document.getElementById('full-checkout-btn') as HTMLAnchorElement;

		if (!wrapper) return;

		const cart = cartItems.get();
		const items = Object.values(cart);

		if (items.length === 0) {
			wrapper.innerHTML = `
				<div class="bg-white rounded-3xl p-12 border border-slate-200/80 text-center space-y-4">
					<div class="w-16 h-16 rounded-full bg-[#F2F7F3] text-[#2D5A27] flex items-center justify-center mx-auto">
						<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
					</div>
					<h3 class="text-xl font-bold text-slate-900">Tu carrito está vacío</h3>
					<p class="text-sm text-slate-500 max-w-sm mx-auto">Explorá nuestro catálogo minorista y aprovechá 3 cuotas sin interés con retiro gratis en tu barrio.</p>
					<a href="/productos" class="inline-flex items-center gap-2 px-6 py-3 bg-[#2D5A27] text-white font-bold rounded-xl text-sm hover:bg-[#23471F] transition-all shadow-md">
						Explorar productos
					</a>
				</div>
			`;
			if (totalEl) totalEl.textContent = '$ 0';
			if (installmentEl) installmentEl.textContent = '$ 0';
			if (checkoutBtn) checkoutBtn.classList.add('pointer-events-none', 'opacity-50');
			return;
		}

		let totalSum = 0;
		let html = `
			<div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs">
				<div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-4">
					<span class="text-xs font-extrabold text-slate-800 uppercase tracking-wider">Productos en tu pedido (${items.length})</span>
					<button id="btn-clear-all-cart" class="text-xs font-bold text-slate-400 hover:text-red-500 transition-colors cursor-pointer">
						Vaciar carrito
					</button>
				</div>
				<div class="divide-y divide-slate-100">
		`;

		items.forEach(item => {
			const subtotal = item.precio * item.cantidad;
			totalSum += subtotal;

			html += `
				<div class="py-4 first:pt-0 last:pb-0 flex flex-col sm:flex-row items-center gap-4 justify-between">
					<div class="flex items-center gap-4 w-full sm:w-auto">
						<div class="w-20 h-20 bg-slate-50 rounded-2xl border border-slate-100 p-1 shrink-0 overflow-hidden flex items-center justify-center">
							<img src="${item.imagen}" alt="${item.nombre}" class="w-full h-full object-contain mix-blend-multiply" />
						</div>
						<div>
							<h3 class="font-bold text-slate-900 text-sm leading-snug mb-1">${item.nombre}</h3>
							<p class="text-[#2D5A27] font-black text-sm">${formateador.format(item.precio)}</p>
						</div>
					</div>

					<div class="flex items-center gap-6 justify-between w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100">
						<div class="flex items-center border border-slate-200 rounded-xl bg-slate-50">
							<button data-action="dec" data-id="${item.id}" class="btn-qty px-3 py-1.5 text-slate-600 hover:text-[#2D5A27] font-bold text-sm hover:bg-slate-200 rounded-l-xl transition-colors cursor-pointer">-</button>
							<span class="px-4 text-xs font-black text-slate-900">${item.cantidad}</span>
							<button data-action="inc" data-id="${item.id}" class="btn-qty px-3 py-1.5 text-slate-600 hover:text-[#2D5A27] font-bold text-sm hover:bg-slate-200 rounded-r-xl transition-colors cursor-pointer">+</button>
						</div>

						<div class="text-right">
							<span class="text-base font-black text-slate-900 block">${formateador.format(subtotal)}</span>
							<button data-action="remove" data-id="${item.id}" class="btn-remove text-xs font-semibold text-slate-400 hover:text-red-500 transition-colors cursor-pointer">Quitar</button>
						</div>
					</div>
				</div>
			`;
		});

		html += '</div></div>';
		wrapper.innerHTML = html;

		if (totalEl) totalEl.textContent = formateador.format(totalSum);
		if (installmentEl) installmentEl.textContent = formateador.format(Math.round(totalSum / 3));

		if (checkoutBtn) checkoutBtn.classList.remove('pointer-events-none', 'opacity-50');

		// Bind clear all
		const clearBtn = document.getElementById('btn-clear-all-cart');
		if (clearBtn) {
			clearBtn.addEventListener('click', () => {
				if (confirm('¿Seguro que querés vaciar tu carrito?')) {
					clearCart();
				}
			});
		}

		// Bind buttons inside wrapper
		wrapper.querySelectorAll('.btn-qty').forEach(btn => {
			btn.addEventListener('click', () => {
				const id = btn.getAttribute('data-id');
				const action = btn.getAttribute('data-action');
				const curItem = cart[id || ''];
				if (curItem && id) {
					if (action === 'inc') updateItemQuantity(id, curItem.cantidad + 1);
					if (action === 'dec') updateItemQuantity(id, curItem.cantidad - 1);
				}
			});
		});

		wrapper.querySelectorAll('.btn-remove').forEach(btn => {
			btn.addEventListener('click', () => {
				const id = btn.getAttribute('data-id');
				if (id) removeCartItem(id);
			});
		});
	}

	cartItems.listen(renderFullCart);
	renderFullCart();

	// Coupon Handler
	const couponBtn = document.getElementById('btn-apply-coupon');
	const couponInput = document.getElementById('coupon-input') as HTMLInputElement;
	const couponMsg = document.getElementById('coupon-msg');

	if (couponBtn && couponInput && couponMsg) {
		couponBtn.addEventListener('click', () => {
			const code = couponInput.value.trim().toUpperCase();
			if (!code) {
				couponMsg.textContent = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="inline-block align-[-2px] shrink-0"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> Ingresá un código válido.';
				couponMsg.className = 'mt-2 text-xs font-semibold text-amber-600';
				couponMsg.classList.remove('hidden');
				return;
			}
			couponMsg.textContent = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="inline-block align-[-2px] shrink-0"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg> ¡Cupón "${code}" aplicado con éxito! Descuento activo.`;
			couponMsg.className = 'mt-2 text-xs font-semibold text-[#2D5A27]';
			couponMsg.classList.remove('hidden');
		});
	}
</script>
