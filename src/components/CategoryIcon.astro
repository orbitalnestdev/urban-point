---
/**
 * Ícono de línea (24x24, stroke-width 2) por grupo temático de categorías.
 * Ver src/lib/categoryGroups.ts para la asignación categoría -> grupo.
 */
interface Props {
	icono: string;
	class?: string;
}
const { icono, class: className = 'w-4 h-4' } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className}>
	{icono === 'auto' && (
		<Fragment>
			<path d="M5 11l1.6-4.2A2 2 0 0 1 8.5 5.5h7a2 2 0 0 1 1.9 1.3L19 11"></path>
			<rect x="3" y="11" width="18" height="5.5" rx="2"></rect>
			<circle cx="7.5" cy="18.5" r="1.6"></circle>
			<circle cx="16.5" cy="18.5" r="1.6"></circle>
		</Fragment>
	)}
	{icono === 'musica' && (
		<Fragment>
			<path d="M9 18V5l12-2v13"></path>
			<circle cx="6" cy="18" r="3"></circle>
			<circle cx="18" cy="16" r="3"></circle>
		</Fragment>
	)}
	{icono === 'pop' && (
		<Fragment>
			<rect x="2" y="3" width="20" height="18" rx="2"></rect>
			<line x1="7" y1="3" x2="7" y2="21"></line>
			<line x1="17" y1="3" x2="17" y2="21"></line>
			<line x1="2" y1="9" x2="7" y2="9"></line>
			<line x1="2" y1="15" x2="7" y2="15"></line>
			<line x1="17" y1="9" x2="22" y2="9"></line>
			<line x1="17" y1="15" x2="22" y2="15"></line>
		</Fragment>
	)}
	{icono === 'cocina' && (
		<Fragment>
			<path d="M4 2v6a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2V2"></path>
			<line x1="6" y1="2" x2="6" y2="22"></line>
			<path d="M18 2c-1.8 0-3 2-3 5s.6 4.5 2 5v10"></path>
		</Fragment>
	)}
	{icono === 'hogar' && (
		<Fragment>
			<path d="M3 11.5 12 4l9 7.5"></path>
			<path d="M5 10v10a1 1 0 0 0 1 1h3v-7h6v7h3a1 1 0 0 0 1-1V10"></path>
		</Fragment>
	)}
	{icono === 'pastel' && (
		<Fragment>
			<path d="M4 21v-6.5A3.5 3.5 0 0 1 7.5 11h9a3.5 3.5 0 0 1 3.5 3.5V21"></path>
			<path d="M12 11V7"></path>
			<path d="M9.5 7a2.5 2.5 0 0 1 5 0"></path>
			<line x1="3" y1="21" x2="21" y2="21"></line>
			<line x1="4" y1="17" x2="20" y2="17"></line>
		</Fragment>
	)}
	{icono === 'libro' && (
		<Fragment>
			<path d="M3 4h5a3 3 0 0 1 3 3v13a2.5 2.5 0 0 0-2.5-2.5H3z"></path>
			<path d="M21 4h-5a3 3 0 0 0-3 3v13a2.5 2.5 0 0 1 2.5-2.5H21z"></path>
		</Fragment>
	)}
	{icono === 'coleccion' && (
		<Fragment>
			<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z"></path>
			<path d="M3.3 7 12 12l8.7-5"></path>
			<line x1="12" y1="22" x2="12" y2="12"></line>
		</Fragment>
	)}
	{icono === 'infantil' && (
		<Fragment>
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
			<line x1="9" y1="9" x2="9.01" y2="9"></line>
			<line x1="15" y1="9" x2="15.01" y2="9"></line>
		</Fragment>
	)}
	{icono === 'anteojos' && (
		<Fragment>
			<circle cx="6.5" cy="15" r="3.5"></circle>
			<circle cx="17.5" cy="15" r="3.5"></circle>
			<path d="M10 15a2 2 0 0 1 4 0"></path>
			<path d="M2.5 13 5 7.5C5.6 6.3 6.4 5.5 8 5.5"></path>
			<path d="M21.5 13 19 7.5c-.6-1.2-1.4-2-3-2"></path>
		</Fragment>
	)}
	{icono === 'revista' && (
		<Fragment>
			<rect x="4" y="3" width="16" height="18" rx="1.5"></rect>
			<line x1="7.5" y1="8" x2="16.5" y2="8"></line>
			<line x1="7.5" y1="12" x2="16.5" y2="12"></line>
			<line x1="7.5" y1="16" x2="13" y2="16"></line>
		</Fragment>
	)}
	{icono === 'cuidado' && (
		<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"></path>
	)}
	{icono === 'grid' && (
		<Fragment>
			<rect x="3" y="3" width="7.5" height="7.5" rx="1.5"></rect>
			<rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"></rect>
			<rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"></rect>
			<rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"></rect>
		</Fragment>
	)}
</svg>
