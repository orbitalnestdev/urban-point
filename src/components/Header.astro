---
import Logo from './Logo.astro';
import CartDrawer from './shop/CartDrawer';
import { getCachedCatalog } from '../lib/server/catalogCache';
import { getVistaCatalogo } from '../lib/server/catalogView';

interface Props {
  activePage?: string;
  showAnnouncement?: boolean;
}

const { activePage = '', showAnnouncement = true } = Astro.props;
const user = Astro.locals.user;
const isLoggedIn = !!user;
const accountHref = user?.role === 'canillita' ? '/canillita' : (user?.role === 'admin' ? '/admin' : '/mi-cuenta');
const accountText = user?.role === 'canillita' ? 'Panel Canillita' : (user?.role === 'admin' ? 'Panel Admin' : 'Mi Cuenta');

// Árbol de categorías para el menú lateral. Se apoya en el mismo caché de
// catálogo (TTL de 5 min) que ya usan /productos y las home: no es una
// consulta nueva a Appwrite, es la misma que ya se comparte entre requests.
let categoriasPadre: any[] = [];
const hijasPorPadre = new Map<string, any[]>();
try {
  const cache = await getCachedCatalog();
  const vista = getVistaCatalogo(cache, user?.role);
  categoriasPadre = vista.categoriasPadre;
  for (const c of vista.categorias) {
    const pid = typeof c.parent_id === 'string' ? c.parent_id : c.parent_id?.$id;
    if (!pid || c.productCount <= 0) continue;
    const lista = hijasPorPadre.get(pid);
    if (lista) lista.push(c);
    else hijasPorPadre.set(pid, [c]);
  }
} catch (e) {
  console.error('No se pudo cargar el árbol de categorías del menú lateral:', e);
}
---

<header class="sticky top-0 z-50 w-full transition-all duration-300">
  <!-- Top Announcement Bar (Animated Rotating Ticker) -->
  {showAnnouncement && (
    <div class="bg-[#2D5A27] text-white text-xs font-semibold py-2 px-4 text-center tracking-wide shadow-xs flex items-center justify-center h-8 overflow-hidden relative">
      <div id="announcement-ticker" class="relative h-full w-full flex items-center justify-center">
        
        <span class="ticker-item active flex items-center justify-center gap-1.5 transition-all duration-500 absolute inset-0 opacity-100 translate-y-0">
          <svg class="w-3.5 h-3.5 text-emerald-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"></path></svg>
          Retiro GRATIS en Puntos de Barrio
        </span>

        <span class="ticker-item flex items-center justify-center gap-1.5 transition-all duration-500 absolute inset-0 opacity-0 translate-y-4 pointer-events-none">
          <svg class="w-3.5 h-3.5 text-emerald-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          3 cuotas sin interés con todas las tarjetas
        </span>

        <span class="ticker-item flex items-center justify-center gap-1.5 transition-all duration-500 absolute inset-0 opacity-0 translate-y-4 pointer-events-none">
          <svg class="w-3.5 h-3.5 text-emerald-200" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Garantía oficial y compra directa protegida
        </span>

      </div>
    </div>
  )}

  <!-- Floating Pill Navbar Container -->
  <div class="pt-3 pb-1 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto bg-white/95 backdrop-blur-md rounded-full shadow-xl shadow-slate-900/10 border border-slate-200/80 px-4 sm:px-6 py-2.5 flex items-center justify-between transition-all duration-300">
      
      <!-- Brand Logo + Menú lateral -->
      <div class="flex items-center gap-2 sm:gap-3">
        <button
          id="btn-open-side-menu"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="side-menu-panel"
          class="p-2 text-slate-700 hover:text-[#2D5A27] hover:bg-slate-100 rounded-full transition-colors shrink-0 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <Logo height={38} />
      </div>

      <!-- Center Navigation Links -->
      <nav class="hidden lg:flex items-center gap-7 font-medium text-xs sm:text-sm text-slate-600">
        <a 
          href="/productos" 
          class={`hover:text-[#2D5A27] transition-colors py-1 ${activePage === 'catalogo' ? 'text-[#2D5A27] font-bold' : ''}`}
        >
          Catálogo
        </a>
        <a 
          href="/#como-funciona" 
          class="hover:text-[#2D5A27] transition-colors py-1"
        >
          Cómo funciona
        </a>
        <a 
          href="/puntos-de-retiro" 
          class={`hover:text-[#2D5A27] transition-colors py-1 ${activePage === 'puntos' ? 'text-[#2D5A27] font-bold' : ''}`}
        >
          Puntos UrbanPoint
        </a>
      </nav>

      <!-- Right Actions: Ingresar, Crear cuenta pill, Cart icon -->
      <div class="flex items-center gap-3 sm:gap-4">
        {isLoggedIn ? (
          <a 
            href={accountHref} 
            class="px-4 sm:px-5 py-2 bg-[#2D5A27] hover:bg-[#23471F] text-white rounded-full text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-[1.02]"
          >
            {accountText}
          </a>
        ) : (
          <Fragment>
            <a 
              href="/login" 
              class="hidden sm:inline-block text-xs sm:text-sm font-semibold text-slate-700 hover:text-[#2D5A27] transition-colors px-2 py-1"
            >
              Ingresar
            </a>
            
            <a 
              href="/login" 
              class="px-4 sm:px-5 py-2 bg-[#2D5A27] hover:bg-[#23471F] text-white rounded-full text-xs sm:text-sm font-bold shadow-md transition-all hover:scale-[1.02] flex items-center gap-1.5"
            >
              Crear cuenta
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </Fragment>
        )}

        <!-- Shopping Cart Button with Green Count Badge -->
        <button 
          id="btn-open-cart-floating" 
          class="relative p-2 text-slate-700 hover:text-[#2D5A27] transition-colors rounded-full hover:bg-slate-100"
          aria-label="Ver Carrito"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <!-- Arranca oculto: mostrar "0" permanente es ruido; el script lo
               muestra recién cuando hay al menos un ítem en el carrito. -->
          <span
            id="cart-badge-count"
            class="hidden absolute -top-1 -right-1 w-4 h-4 bg-[#2D5A27] text-white font-extrabold text-[10px] rounded-full items-center justify-center shadow-sm"
          >
            0
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú lateral: mismo panel y comportamiento en mobile y escritorio,
       sin recargar la página (overlay + panel con display:none por
       defecto, sin dependencia de React). -->
  <div id="side-menu-overlay" hidden class="fixed inset-0 bg-slate-900/50 z-[70] transition-opacity opacity-0"></div>
  <aside
    id="side-menu-panel"
    hidden
    aria-hidden="true"
    class="fixed top-0 left-0 h-full w-[85vw] max-w-sm bg-white z-[80] shadow-2xl -translate-x-full transition-transform duration-300 flex flex-col"
  >
    <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-slate-100 shrink-0">
      <Logo height={30} />
      <button
        id="btn-close-side-menu"
        type="button"
        aria-label="Cerrar menú"
        class="p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-full transition-colors cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="overflow-y-auto flex-1 px-5 py-5">
      <!-- Accesos directos -->
      <div class="flex flex-col gap-2 mb-6">
        <a
          href={accountHref}
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-[#F2F7F3] text-[#2D5A27] font-bold text-sm hover:bg-[#E4EFE6] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          {isLoggedIn ? accountText : 'Mi Cuenta'}
        </a>
        <a
          href="/puntos-de-retiro"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-slate-50 text-slate-700 font-bold text-sm hover:bg-slate-100 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Puntos de Retiro
        </a>
      </div>

      <!-- Árbol de categorías -->
      <h2 class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider mb-2 px-1">Categorías</h2>
      {categoriasPadre.length === 0 ? (
        <p class="text-xs text-slate-400 font-medium px-1 py-2">No hay categorías disponibles por el momento.</p>
      ) : (
        <nav class="flex flex-col gap-0.5">
          {categoriasPadre.map((parent) => {
            const hijas = hijasPorPadre.get(parent.$id) || [];
            return hijas.length > 0 ? (
              <details class="group">
                <summary class="list-none flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl hover:bg-slate-50 cursor-pointer transition-colors">
                  <a href={`/productos?categoria=${parent.$id}`} class="flex-1 text-sm font-semibold text-slate-700 hover:text-[#2D5A27] truncate">
                    {parent.nombre}
                  </a>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 shrink-0 transition-transform group-open:rotate-180"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                <div class="pl-4 flex flex-col gap-0.5 pb-1">
                  {hijas.map((child: any) => (
                    <a
                      href={`/productos?categoria=${child.$id}`}
                      class="px-3 py-2 rounded-lg text-[13px] font-medium text-slate-600 hover:bg-slate-50 hover:text-[#2D5A27] transition-colors truncate"
                    >
                      {child.nombre}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={`/productos?categoria=${parent.$id}`}
                class="px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#2D5A27] transition-colors truncate"
              >
                {parent.nombre}
              </a>
            );
          })}
        </nav>
      )}

      <div class="mt-6 pt-5 border-t border-slate-100 flex flex-col gap-0.5">
        <a href="/productos" class="px-3 py-2.5 rounded-xl text-sm font-bold text-[#2D5A27] hover:bg-[#F2F7F3] transition-colors">
          Ver todo el catálogo
        </a>
        <a href="/#como-funciona" class="px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
          Cómo funciona
        </a>
      </div>
    </div>
  </aside>

  <!-- Cart Drawer Component Mounted Globally.
       client:only: el contenido del drawer sale de cartItems, un store
       persistido en localStorage. Renderizarlo en el servidor lo pintaba
       siempre vacío —'Tu Carrito de Compras (0)'— y al hidratar, con el
       carrito ya cargado, React encontraba otro texto y tiraba
       'Hydration failed', dejando la consola con un error en cada página.
       No se pierde nada por no renderizarlo en el servidor: arranca cerrado
       y fuera de pantalla, y no aporta ni SEO ni primer pintado. -->
  <CartDrawer client:only="react" />
</header>

<script>
  // Menú lateral (categorías + accesos directos): mismo panel para mobile y
  // escritorio, abre/cierra sin recargar la página.
  const btnOpenSideMenu = document.getElementById('btn-open-side-menu');
  const btnCloseSideMenu = document.getElementById('btn-close-side-menu');
  const sideMenuOverlay = document.getElementById('side-menu-overlay');
  const sideMenuPanel = document.getElementById('side-menu-panel');

  function abrirMenuLateral() {
    if (!sideMenuOverlay || !sideMenuPanel) return;
    sideMenuOverlay.hidden = false;
    sideMenuPanel.hidden = false;
    // requestAnimationFrame para que el navegador registre "hidden" removido
    // antes de animar la transición de opacidad/transform.
    requestAnimationFrame(() => {
      sideMenuOverlay.classList.remove('opacity-0');
      sideMenuPanel.classList.remove('-translate-x-full');
    });
    sideMenuPanel.setAttribute('aria-hidden', 'false');
    btnOpenSideMenu?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('overflow-hidden');
  }

  function cerrarMenuLateral() {
    if (!sideMenuOverlay || !sideMenuPanel) return;
    sideMenuOverlay.classList.add('opacity-0');
    sideMenuPanel.classList.add('-translate-x-full');
    sideMenuPanel.setAttribute('aria-hidden', 'true');
    btnOpenSideMenu?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('overflow-hidden');
    window.setTimeout(() => {
      sideMenuOverlay.hidden = true;
      sideMenuPanel.hidden = true;
    }, 300);
  }

  btnOpenSideMenu?.addEventListener('click', abrirMenuLateral);
  btnCloseSideMenu?.addEventListener('click', cerrarMenuLateral);
  sideMenuOverlay?.addEventListener('click', cerrarMenuLateral);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarMenuLateral();
  });

  // Open Cart drawer event
  // El drawer es client:only, así que no existe hasta que React lo monta. Un
  // "agregar al carrito" en ese intervalo disparaba cart:open sin oyente y el
  // drawer no abría: el producto entraba al carrito, pero sin feedback. Acá se
  // anota la intención y el drawer la consume al montarse.
  const anotarAperturaPendiente = () => {
    (window as any).__upCartOpenPendiente = true;
  };
  window.addEventListener('cart:open', anotarAperturaPendiente);
  document.addEventListener('cart:open', anotarAperturaPendiente);

  const cartBtn = document.getElementById('btn-open-cart-floating');
  if (cartBtn) {
    cartBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      window.dispatchEvent(new CustomEvent('cart:open'));
      document.dispatchEvent(new CustomEvent('cart:open'));
    });
  }

  // El badge sólo se muestra cuando hay ítems: con 0 queda oculto.
  const actualizarBadge = (count: number) => {
    const badge = document.getElementById('cart-badge-count');
    if (!badge) return;
    badge.textContent = count.toString();
    badge.classList.toggle('hidden', count <= 0);
    badge.classList.toggle('flex', count > 0);
  };

  // Listen to cart update event to update badge count
  window.addEventListener('cart:updated', (e: any) => {
    if (e.detail && typeof e.detail.count === 'number') {
      actualizarBadge(e.detail.count);
    }
  });

  // Calculate initial total items from localStorage keys starting with urbanpoint_cart:
  try {
    let totalCount = 0;
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith('urbanpoint_cart:')) {
        const val = localStorage.getItem(key);
        if (val) {
          const item = JSON.parse(val);
          if (item && item.cantidad) totalCount += Number(item.cantidad);
        }
      }
    }
    actualizarBadge(totalCount);
  } catch (e) {}

  // Rotating Announcement Bar Ticker Animation
  const tickerItems = document.querySelectorAll('.ticker-item');
  if (tickerItems.length > 1) {
    let activeIndex = 0;
    setInterval(() => {
      const current = tickerItems[activeIndex] as HTMLElement;
      activeIndex = (activeIndex + 1) % tickerItems.length;
      const next = tickerItems[activeIndex] as HTMLElement;

      if (current && next) {
        // Fade out current
        current.classList.remove('opacity-100', 'translate-y-0');
        current.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');

        // Fade in next
        next.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        next.classList.add('opacity-100', 'translate-y-0');

        // Reset previous position after transition
        setTimeout(() => {
          current.classList.remove('-translate-y-4');
          current.classList.add('translate-y-4');
        }, 500);
      }
    }, 3200);
  }
</script>
