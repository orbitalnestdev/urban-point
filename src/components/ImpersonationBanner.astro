---
const isImpersonating = Astro.locals?.isImpersonating || false;
const currentUser = Astro.locals?.user;
const adminName = Astro.locals?.impersonatorAdminName || 'Administrador';
---

{isImpersonating && currentUser && (
	<div class="fixed top-0 left-0 right-0 z-[9999] bg-gradient-to-r from-amber-500 via-amber-600 to-amber-700 text-white shadow-xl py-2 px-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs font-bold font-sans animate-in slide-in-from-top duration-300">
		<div class="flex items-center gap-2.5 min-w-0">
			<span class="flex h-3 w-3 relative shrink-0">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
				<span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
			</span>
			<div class="truncate">
				<span class="uppercase tracking-wider font-extrabold text-[11px] bg-black/20 px-2 py-0.5 rounded-full mr-2">
					Modo Monitoreo Activo
				</span>
				<span>
					Estás navegando como <strong class="underline decoration-amber-200 underline-offset-2 font-black">{currentUser.name}</strong> ({currentUser.email || currentUser.role})
				</span>
			</div>
		</div>

		<form action="/api/admin/stop-impersonating" method="POST" class="shrink-0">
			<button 
				type="submit" 
				class="px-3.5 py-1 bg-slate-900 hover:bg-black text-white text-[11px] font-black rounded-lg transition-all shadow-sm flex items-center gap-1.5 cursor-pointer border border-amber-300/30 hover:scale-105 active:scale-95"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
				Volver a Mi Cuenta Admin ({adminName})
			</button>
		</form>
	</div>
)}
