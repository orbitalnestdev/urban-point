# Copiá este archivo como `.env.local` y completá los valores.
#
#   cp .env.local.ejemplo .env.local
#
# `.env.local` está en .gitignore: no se sube al repositorio.
# Los scripts y el servidor lo leen solos, así que nadie más necesita ver
# los valores para poder ejecutarlos.
#
# Para comprobar que quedó bien, sin exponer nada:
#   npx tsx scripts/check_env.ts


# ─── Appwrite ────────────────────────────────────────────────────────────────
# La clave está en Dokploy → ADAMAS → urbanpoint → Environment.
# Con esto alcanza para correr los scripts de esquema.
APPWRITE_API_KEY=
PUBLIC_APPWRITE_ENDPOINT=https://aw.orbitalnest.net/v1
PUBLIC_APPWRITE_PROJECT_ID=6a6a5321001439f06817


# ─── Mercado Pago — pruebas ──────────────────────────────────────────────────
# Access token del usuario de prueba VENDEDOR. Empieza con TEST-.
# Se crea en el panel de desarrolladores de Mercado Pago.
MP_ACCESS_TOKEN=

# Fuerza el checkout de sandbox aunque no estemos en modo desarrollo.
MP_USE_SANDBOX=true

# Secreto del webhook, del panel de Mercado Pago.
# Sin esto el webhook responde 503 a propósito y ningún pago se acredita.
MP_WEBHOOK_SECRET=


# ─── BIND PSP — en evaluación ────────────────────────────────────────────────
# https://psp.bind.com.ar/developers · en evaluación, todavía NO se usa en
# ningún flujo real (ver src/lib/server/bind.ts y src/pages/api/webhooks/bind.ts).
#
# OJO: BIND no tiene alta de sandbox autoservicio. El client_id, el
# client_secret Y el scope los entrega a mano el equipo de soporte de
# integraciones de BIND, por ambiente — hay que pedírselos, no se generan
# solos desde ningún panel.
BIND_CLIENT_ID=
BIND_CLIENT_SECRET=
BIND_SCOPE=
BIND_ENV=staging


# ─── URL pública ─────────────────────────────────────────────────────────────
# Define la notification_url que se le manda a Mercado Pago.
#
# OJO: si la dejás vacía o apuntando a localhost, el sistema usa
# https://urbanpoints.com.ar y el webhook le llega a PRODUCCIÓN, no a tu
# máquina. Para la prueba completa hace falta un túnel:
#
#   cloudflared tunnel --url http://localhost:4321
#
# y pegar acá la URL pública que te devuelve.
PUBLIC_SITE_URL=
